# Estilo calculado: qué reglas CSS se aplican a cada elemento (selectores), cuál gana
# (cascada: importancia, origen, especificidad, orden), herencia y atajos desplegados.
#
#   hojas = estilo_hojas(doc, "http://ejemplo.org/")   # la del navegador + <style>, <link>, @import
#   estilo_aplicar(doc, hojas)                          # cada elemento: nodo.estilo["color"]...
#
# Los valores quedan como texto, salvo font-size, que se guarda en píxeles ("16px"). El tamaño
# normal (medium) es 13 píxeles: lo que cabe bien en una pantalla de Amiga con sus fuentes.

import "dom.dash"
import "css.dash"
import "http.dash"

const ESTILO_MEDIUM = 13
const ESTILO_ORDEN_HOJA = 100000     # orden de la primera regla de cada hoja (una hoja puede tener miles)

# Un selector de una regla, en el índice de las hojas
struct Entrada
    sel: Selector
    regla: Regla
    autor: Bool
    # lo que tiene que haber entre los antecesores ("#id", ".clase" o la etiqueta de cada parte de
    # antes de un combinador de descendiente o hijo): sin ello el selector no se prueba
    antes: [String] = nil
end

# Cuántos antecesores del nodo que se está mirando tienen cada etiqueta, "#id" y ".clase" (el filtro de
# antecesores de los navegadores: un selector como ".menu a" se descarta sin subir por el árbol)
var _antepasados: {String: Int} = {}

func _antepasado(clave: String, cuanto: Int)
    if _antepasados.has(clave)
        _antepasados[clave] = _antepasados[clave] + cuanto
    else
        _antepasados[clave] = cuanto
    end
end

func _antepasados_cambiar(n: Nodo, cuanto: Int)
    _antepasado(n.nombre, cuanto)
    if dom_id(n) != ""
        _antepasado("#" + dom_id(n), cuanto)
    end
    for c in dom_clases(n)
        _antepasado("." + c, cuanto)
    end
end

# Las claves que el selector pide a los antecesores (solo por la cadena de descendiente/hijo desde el sujeto)
func _requisitos(sel: Selector) -> [String]
    var r: [String] = []
    i = sel.partes.length - 1
    while i > 0
        comb = sel.partes[i].combinador
        if comb != CSS_DESCENDIENTE and comb != CSS_HIJO
            break
        end
        k = _clave(sel.partes[i - 1].simple)
        if k != ""
            r.push(k)
        end
        i = i - 1
    end
    if r.length == 0
        var nada: [String] = nil
        return nada
    end
    return r
end

struct Hojas
    lista: [HojaCSS]
    autor: [Bool]
    traidas: {String: String} = nil    # textos de hojas ya traídos (lib/recursos.dash): no se piden otra vez
    # los selectores por su parte de la derecha: "#id", ".clase" o la etiqueta; los demás en universales
    indice: {String: [Entrada]} = nil
    universales: [Entrada] = nil
    indice_ancho: Int = -1             # el ancho de la página con que se hizo (por los @media)
end

# La hoja del navegador se lee una vez por programa (en un A1200 leerla son segundos)
var estilo_ua_leida: HojaCSS = nil

# Hoja por defecto del navegador (orden negativo: va antes que todo lo del autor)
func estilo_hoja_navegador() -> HojaCSS
    if estilo_ua_leida == nil
        estilo_ua_leida = _estilo_leer_navegador()
    end
    return estilo_ua_leida
end

func _estilo_leer_navegador() -> HojaCSS
    c = "html, body, div, p, h1, h2, h3, h4, h5, h6, ul, ol, li, dl, dt, dd, pre, blockquote, form, "
    c = c + "table, center, address, hr, header, footer, nav, section, article, aside, main, figure, "
    c = c + "fieldset, legend, details, summary, menu, dir, noscript { display: block } "
    c = c + "head, script, style, title, meta, link, base, template, [hidden] { display: none } "
    c = c + "li { display: list-item } table { display: table } tr { display: table-row } "
    c = c + "td, th { display: table-cell; padding: 1px } thead, tbody, tfoot { display: table-row-group } "
    c = c + "body { margin: 8px } p, dl, blockquote, pre, ul, ol, figure { margin-top: 1em; margin-bottom: 1em } "
    c = c + "h1 { font-size: 2em; margin: 0.67em 0; font-weight: bold } "
    c = c + "h2 { font-size: 1.5em; margin: 0.83em 0; font-weight: bold } "
    c = c + "h3 { font-size: 1.17em; margin: 1em 0; font-weight: bold } "
    c = c + "h4 { margin: 1.33em 0; font-weight: bold } h5 { font-size: 0.83em; margin: 1.67em 0; font-weight: bold } "
    c = c + "h6 { font-size: 0.67em; margin: 2.33em 0; font-weight: bold } "
    c = c + "b, strong, th { font-weight: bold } i, em, cite, var, dfn, address { font-style: italic } "
    c = c + "u, ins { text-decoration: underline } s, strike, del { text-decoration: line-through } "
    c = c + "pre, code, tt, kbd, samp { font-family: monospace } pre { white-space: pre } "
    c = c + "ul, ol { padding-left: 40px } ol { list-style-type: decimal } ul { list-style-type: disc } "
    c = c + "ul ul { list-style-type: circle } blockquote { margin-left: 40px; margin-right: 40px } "
    c = c + "dd { margin-left: 40px } center, th { text-align: center } "
    c = c + "a:link { color: #0000ee; text-decoration: underline } small { font-size: smaller } big { font-size: larger } "
    c = c + "hr { border: 1px inset; margin: 0.5em 0 } sub, sup { font-size: smaller } "
    c = c + "img { display: inline }"
    hoja = css_leer(c, -10000)
    return hoja
end

# Las hojas del documento, en orden: la del navegador, luego <style> y <link rel=stylesheet>
# como aparecen (con sus @import delante). base: URL de la página, para las relativas.
func estilo_hojas(doc: Nodo, base: String) -> Hojas
    var traidas: {String: String} = {}
    return estilo_hojas_con(doc, base, traidas)
end

# Lo mismo con las hojas externas ya traídas (dirección -> texto en Latin-1); las que falten se piden
func estilo_hojas_con(doc: Nodo, base: String, traidas: {String: String}) -> Hojas
    var lista: [HojaCSS] = [estilo_hoja_navegador()]
    var autor: [Bool] = [false]
    h = Hojas(lista, autor)
    h.traidas = traidas
    _estilo_recoger(h, doc, url_parse(base))
    return h
end

func _estilo_recoger(h: Hojas, n: Nodo, base: Url)
    if n.tipo == DOM_ELEMENTO and n.nombre == "style"
        _estilo_agregar(h, css_leer(dom_texto(n), h.lista.length * ESTILO_ORDEN_HOJA), base, 0)
    elif n.tipo == DOM_ELEMENTO and n.nombre == "link" and str_find(str_lower(dom_atributo(n, "rel")), "stylesheet") >= 0
        _estilo_cargar(h, url_text(url_resolve(base, dom_atributo(n, "href"))), 0)
    end
    for hijo in n.hijos
        _estilo_recoger(h, hijo, base)
    end
end

func _estilo_agregar(h: Hojas, hoja: HojaCSS, base: Url, nivel: Int)
    if nivel < 4
        for imp in hoja.importes
            _estilo_cargar(h, url_text(url_resolve(base, imp)), nivel + 1)
        end
    end
    h.lista.push(hoja)
    h.autor.push(true)
end

# Una hoja por URL: http(s), o un fichero (file: o una ruta del Amiga)
func _estilo_cargar(h: Hojas, direccion: String, nivel: Int)
    u = url_parse(direccion)
    texto = ""
    if h.traidas != nil and h.traidas.has(direccion)
        _estilo_agregar(h, css_leer(h.traidas[direccion], h.lista.length * ESTILO_ORDEN_HOJA), u, nivel)
        return
    end
    if u.esquema == "http" or u.esquema == "https"
        r = http_get(direccion, 15000)
        if r.error != "" or r.estado != 200
            return
        end
        texto = http_texto(r)
    else
        ruta = direccion
        if u.esquema == "file"
            ruta = u.ruta
            if str_starts(ruta, "/")
                ruta = ruta[1:]
            end
        end
        leido = file_read_text(ruta)
        if leido == nil
            return
        end
        texto = utf8_a_latin1(leido)
    end
    _estilo_agregar(h, css_leer(texto, h.lista.length * ESTILO_ORDEN_HOJA), u, nivel)
end

# === Selectores ===

func _anterior_elemento(n: Nodo) -> Nodo
    var nada: Nodo = nil
    p = n.padre
    if p == nil
        return nada
    end
    var previo: Nodo = nil
    for h in p.hijos
        if h == n
            return previo
        end
        if h.tipo == DOM_ELEMENTO
            previo = h
        end
    end
    return nada
end

func _es_primero(n: Nodo) -> Bool
    return _anterior_elemento(n) == nil
end

func _es_ultimo(n: Nodo) -> Bool
    p = n.padre
    if p == nil
        return true
    end
    visto = false
    for h in p.hijos
        if visto and h.tipo == DOM_ELEMENTO
            return false
        end
        if h == n
            visto = true
        end
    end
    return true
end

# Las clases ya partidas del nodo (dom_clases)
func _tiene_clase(n: Nodo, clase: String) -> Bool
    for c in dom_clases(n)
        if c == clase
            return true
        end
    end
    return false
end

func _cumple_atributo(n: Nodo, a: SelAtributo) -> Bool
    if not dom_tiene_atributo(n, a.nombre)
        return false
    end
    v = dom_atributo(n, a.nombre)
    if a.op == ""
        return true
    elif a.op == "="
        return v == a.valor
    elif a.op == "~="
        return str_find(" " + v + " ", " " + a.valor + " ") >= 0
    elif a.op == "|="
        return v == a.valor or str_starts(v, a.valor + "-")
    elif a.op == "^="
        return a.valor != "" and str_starts(v, a.valor)
    elif a.op == "$="
        return a.valor != "" and str_ends(v, a.valor)
    elif a.op == "*="
        return a.valor != "" and str_find(v, a.valor) >= 0
    end
    return false
end

# Pseudo-clases que se saben sin interacción; las demás (hover, focus...) no se cumplen
func _cumple_pseudo(n: Nodo, p: String) -> Bool
    if p == "first-child"
        return _es_primero(n)
    elif p == "last-child"
        return _es_ultimo(n)
    elif p == "only-child"
        return _es_primero(n) and _es_ultimo(n)
    elif p == "link" or p == "any-link"
        return n.nombre == "a" and dom_tiene_atributo(n, "href")
    elif p == "root"
        return n.padre != nil and n.padre.tipo == DOM_DOCUMENTO
    elif p == "empty"
        return n.hijos.length == 0
    elif p == "checked"
        return (n.nombre == "input" and dom_tiene_atributo(n, "checked")) or (n.nombre == "option" and dom_tiene_atributo(n, "selected"))
    elif p == "disabled"
        return _se_desactiva(n.nombre) and dom_tiene_atributo(n, "disabled")
    elif p == "enabled"
        return _se_desactiva(n.nombre) and not dom_tiene_atributo(n, "disabled")
    elif p == "first-of-type"
        return _posicion(n, true, false) == 1
    elif p == "last-of-type"
        return _posicion(n, true, true) == 1
    elif p == "only-of-type"
        return _posicion(n, true, false) == 1 and _posicion(n, true, true) == 1
    elif str_starts(p, "nth-child(")
        return _nth(p[10:p.length - 1], _posicion(n, false, false))
    elif str_starts(p, "nth-last-child(")
        return _nth(p[15:p.length - 1], _posicion(n, false, true))
    elif str_starts(p, "nth-of-type(")
        return _nth(p[12:p.length - 1], _posicion(n, true, false))
    elif str_starts(p, "not(")
        for parte in css_partir(p[4:p.length - 1], 44)
            sel = css_selector(parte)
            if sel != nil and estilo_cumple(n, sel)
                return false
            end
        end
        return true
    end
    return false
end

# Las pseudo-clases que se saben sin interacción (las demás, :hover, :focus..., nunca se cumplen;
# querySelector da un error con ellas, como los navegadores con las que no conocen)
func css_pseudo_conocida(p: String) -> Bool
    if p == "first-child" or p == "last-child" or p == "only-child" or p == "link" or p == "any-link" or p == "root" or p == "empty"
        return true
    end
    if p == "checked" or p == "disabled" or p == "enabled" or p == "first-of-type" or p == "last-of-type" or p == "only-of-type"
        return true
    end
    if str_starts(p, "nth-child(") or str_starts(p, "nth-last-child(") or str_starts(p, "nth-of-type(")
        return true
    end
    if str_starts(p, "not(")
        for parte in css_partir(p[4:p.length - 1], 44)
            sel = css_selector(parte)
            if sel == nil or not estilo_puede_cumplirse(sel)
                return false
            end
        end
        return true
    end
    return false
end

func _se_desactiva(nombre: String) -> Bool
    return nombre == "input" or nombre == "button" or nombre == "select" or nombre == "textarea" or nombre == "option" or nombre == "fieldset" or nombre == "optgroup"
end

# El puesto de n entre los elementos hermanos (desde 1; desde el final si al_reves; solo los de su
# etiqueta si del_tipo)
func _posicion(n: Nodo, del_tipo: Bool, al_reves: Bool) -> Int
    p = n.padre
    if p == nil
        return 1
    end
    k = 0
    puesto = 0
    for h in p.hijos
        if h.tipo == DOM_ELEMENTO and (not del_tipo or h.nombre == n.nombre)
            k = k + 1
            if h == n
                puesto = k
            end
        end
    end
    if al_reves
        return k - puesto + 1
    end
    return puesto
end

# an+b (odd, even, 3, 2n+1, -n+3) contra el puesto
func _nth(expr: String, puesto: Int) -> Bool
    e = str_replace(str_lower(str_trim(expr)), " ", "")
    a = 0
    b = 0
    if e == "odd"
        a = 2
        b = 1
    elif e == "even"
        a = 2
    else
        pn = str_find(e, "n")
        if pn < 0
            b = Int(e)
        else
            delante = e[:pn]
            if delante == "" or delante == "+"
                a = 1
            elif delante == "-"
                a = -1
            else
                a = Int(delante)
            end
            detras = e[pn + 1:]
            if str_starts(detras, "+")
                detras = detras[1:]
            end
            if detras != ""
                b = Int(detras)
            end
        end
    end
    if a == 0
        return puesto == b
    end
    d = puesto - b
    return d / a >= 0 and d % a == 0
end

func _cumple_simple(n: Nodo, s: SelSimple) -> Bool
    if n.tipo != DOM_ELEMENTO or s.pseudo_elemento != ""
        return false
    end
    if s.etiqueta != "" and s.etiqueta != n.nombre
        return false
    end
    if s.id != "" and dom_id(n) != s.id
        return false
    end
    for c in s.clases
        if not _tiene_clase(n, c)
            return false
        end
    end
    for a in s.atributos
        if not _cumple_atributo(n, a)
            return false
        end
    end
    for p in s.pseudo
        if not _cumple_pseudo(n, p)
            return false
        end
    end
    return true
end

# ¿Se cumple el selector, partes 0..i, con n como sujeto de la parte i?
func _cumple_desde(n: Nodo, sel: Selector, i: Int) -> Bool
    parte = sel.partes[i]
    if not _cumple_simple(n, parte.simple)
        return false
    end
    if i == 0
        return true
    end
    if parte.combinador == CSS_HIJO
        p = n.padre
        return p != nil and _cumple_desde(p, sel, i - 1)
    elif parte.combinador == CSS_DESCENDIENTE
        p = n.padre
        while p != nil
            if _cumple_desde(p, sel, i - 1)
                return true
            end
            p = p.padre
        end
        return false
    elif parte.combinador == CSS_ADYACENTE
        a = _anterior_elemento(n)
        return a != nil and _cumple_desde(a, sel, i - 1)
    elif parte.combinador == CSS_HERMANO
        a = _anterior_elemento(n)
        while a != nil
            if _cumple_desde(a, sel, i - 1)
                return true
            end
            a = _anterior_elemento(a)
        end
        return false
    end
    return false
end

func estilo_cumple(n: Nodo, sel: Selector) -> Bool
    return _cumple_desde(n, sel, sel.partes.length - 1)
end

# === Índice ===
# Cada elemento solo prueba los selectores que pueden cumplirse con él: los de su etiqueta, su id,
# sus clases y los universales (como los navegadores). Los que nunca se cumplen (::before, :hover...)
# no entran.

# ¿Puede cumplirse alguna vez? (no si lleva ::before o una pseudo-clase de interacción)
func estilo_puede_cumplirse(sel: Selector) -> Bool
    for parte in sel.partes
        if parte.simple.pseudo_elemento != ""
            return false
        end
        for p in parte.simple.pseudo
            if not css_pseudo_conocida(p)
                return false
            end
        end
    end
    return true
end

func _clave(s: SelSimple) -> String
    if s.id != ""
        return "#" + s.id
    elif s.clases.length > 0
        return "." + s.clases[0]
    end
    return s.etiqueta
end

func _estilo_indexar(h: Hojas)
    var indice: {String: [Entrada]} = {}
    var universales: [Entrada] = []
    for k in (0..h.lista.length - 1)
        for regla in h.lista[k].reglas
            if not css_regla_vale(regla)
                continue
            end
            for sel in regla.selectores
                if estilo_puede_cumplirse(sel)
                    e = Entrada(sel, regla, h.autor[k])
                    e.antes = _requisitos(sel)
                    clave = _clave(sel.partes[sel.partes.length - 1].simple)
                    if clave == ""
                        universales.push(e)
                    elif indice.has(clave)
                        indice[clave].push(e)
                    else
                        var lista: [Entrada] = [e]
                        indice[clave] = lista
                    end
                end
            end
        end
    end
    h.indice = indice
    h.universales = universales
    h.indice_ancho = css_vista_ancho()
end

# ¿Cambia el estilo si la página pasa a medir ancho? (algún @media cambia de lado)
func estilo_cambia_con(h: Hojas, ancho: Int) -> Bool
    for hoja in h.lista
        for regla in hoja.reglas
            if regla.medios != nil and css_regla_vale(regla) != css_regla_vale_con(regla, ancho)
                return true
            end
        end
    end
    return false
end

func _antepasados_tienen(claves: [String]) -> Bool
    for k in claves
        if not _antepasados.has(k) or _antepasados[k] <= 0
            return false
        end
    end
    return true
end

func _probar(n: Nodo, entradas: [Entrada], ganadoras: {String: Candidata})
    for e in entradas
        if e.antes != nil and not _antepasados_tienen(e.antes)
            continue
        end
        if estilo_cumple(n, e.sel)
            for d in e.regla.declaraciones
                _declarar(ganadoras, d, e.autor, e.sel.especificidad, e.regla.orden)
            end
        end
    end
end

# === Cascada ===

# Quién gana para una propiedad: el peso más alto
struct Candidata
    valor: String
    importante: Bool
    autor: Bool
    especificidad: Int
    orden: Int
end

func _gana(nueva: Candidata, vieja: Candidata) -> Bool
    if nueva.importante != vieja.importante
        return nueva.importante
    end
    if nueva.autor != vieja.autor
        # normal: el autor gana; !important: el navegador (no hay hoja del usuario)
        return nueva.autor != nueva.importante
    end
    if nueva.especificidad != vieja.especificidad
        return nueva.especificidad > vieja.especificidad
    end
    return nueva.orden >= vieja.orden
end

func _proponer(ganadoras: {String: Candidata}, propiedad: String, c: Candidata)
    if not ganadoras.has(propiedad) or _gana(c, ganadoras[propiedad])
        ganadoras[propiedad] = c
    end
end

# Una declaración, con los atajos ya repartidos en sus propiedades
func _declarar(ganadoras: {String: Candidata}, d: Declaracion, autor: Bool, esp: Int, orden: Int)
    p = d.propiedad
    v = d.valor
    if p == "margin" or p == "padding"
        _cuatro(ganadoras, p + "-", "", v, d.importante, autor, esp, orden)
    elif p == "border-width" or p == "border-style" or p == "border-color"
        _cuatro(ganadoras, "border-", p[6:], v, d.importante, autor, esp, orden)
    elif p == "border" or p == "border-top" or p == "border-right" or p == "border-bottom" or p == "border-left"
        lados = ["top", "right", "bottom", "left"]
        if p != "border"
            lados = [p[7:]]
        end
        ancho = "medium"
        tipo = "none"
        color = "currentcolor"
        for t in _palabras(v)
            if _es_estilo_borde(t)
                tipo = t
            elif _es_longitud(t) or t == "thin" or t == "medium" or t == "thick"
                ancho = t
            else
                color = t
            end
        end
        for lado in lados
            _proponer(ganadoras, "border-" + lado + "-width", Candidata(ancho, d.importante, autor, esp, orden))
            _proponer(ganadoras, "border-" + lado + "-style", Candidata(tipo, d.importante, autor, esp, orden))
            _proponer(ganadoras, "border-" + lado + "-color", Candidata(color, d.importante, autor, esp, orden))
        end
    elif p == "background"
        color = "transparent"
        imagen = "none"
        repetir = "repeat"
        var lugar: [String] = []
        tam = "auto"
        for t in _palabras(v)
            tl = str_lower(t)
            if str_starts(tl, "url(")
                imagen = t
            elif tl == "repeat" or tl == "no-repeat" or tl == "repeat-x" or tl == "repeat-y"
                repetir = tl
            elif tl == "center" or tl == "top" or tl == "bottom" or tl == "left" or tl == "right" or str_ends(tl, "%")
                lugar.push(tl)
            elif str_starts(tl, "/")
                tam = tl[1:]
            elif tl == "cover" or tl == "contain"
                tam = tl
            elif tl == "fixed" or tl == "scroll" or tl == "local" or tl == "none"
                tam = tam
            elif _es_color(t)
                color = t
            end
        end
        posicion = "0% 0%"
        if lugar.length == 1
            posicion = lugar[0]
        elif lugar.length >= 2
            posicion = lugar[0] + " " + lugar[1]
        end
        _proponer(ganadoras, "background-color", Candidata(color, d.importante, autor, esp, orden))
        _proponer(ganadoras, "background-image", Candidata(imagen, d.importante, autor, esp, orden))
        _proponer(ganadoras, "background-repeat", Candidata(repetir, d.importante, autor, esp, orden))
        _proponer(ganadoras, "background-position", Candidata(posicion, d.importante, autor, esp, orden))
        _proponer(ganadoras, "background-size", Candidata(tam, d.importante, autor, esp, orden))
    elif p == "list-style"
        for t in _palabras(v)
            if t != "inside" and t != "outside" and not str_starts(t, "url(")
                _proponer(ganadoras, "list-style-type", Candidata(t, d.importante, autor, esp, orden))
            end
        end
    elif p == "font"
        _fuente(ganadoras, v, d.importante, autor, esp, orden)
    else
        _proponer(ganadoras, p, Candidata(v, d.importante, autor, esp, orden))
    end
end

# margin: 1 a 4 valores -> top right bottom left
func _cuatro(g: {String: Candidata}, prefijo: String, sufijo: String, v: String, imp: Bool, autor: Bool, esp: Int, orden: Int)
    t = _palabras(v)
    if t.length == 0
        return
    end
    arriba = t[0]
    derecha = arriba
    abajo = arriba
    izquierda = arriba
    if t.length >= 2
        derecha = t[1]
        izquierda = t[1]
    end
    if t.length >= 3
        abajo = t[2]
    end
    if t.length >= 4
        izquierda = t[3]
    end
    _proponer(g, prefijo + "top" + sufijo, Candidata(arriba, imp, autor, esp, orden))
    _proponer(g, prefijo + "right" + sufijo, Candidata(derecha, imp, autor, esp, orden))
    _proponer(g, prefijo + "bottom" + sufijo, Candidata(abajo, imp, autor, esp, orden))
    _proponer(g, prefijo + "left" + sufijo, Candidata(izquierda, imp, autor, esp, orden))
end

# font: [style] [weight] size[/line-height] family
func _fuente(g: {String: Candidata}, v: String, imp: Bool, autor: Bool, esp: Int, orden: Int)
    t = _palabras(v)
    i = 0
    while i < t.length
        x = str_lower(t[i])
        if x == "italic" or x == "oblique"
            _proponer(g, "font-style", Candidata(x, imp, autor, esp, orden))
        elif x == "bold" or x == "bolder" or x == "lighter" or (x.length == 3 and str_ends(x, "00"))
            _proponer(g, "font-weight", Candidata(x, imp, autor, esp, orden))
        elif _es_longitud(x) or str_find(x, "/") > 0 or x == "small" or x == "medium" or x == "large" or str_ends(x, "-small") or str_ends(x, "-large")
            barra = str_find(x, "/")
            if barra > 0
                _proponer(g, "line-height", Candidata(x[barra + 1:], imp, autor, esp, orden))
                x = x[:barra]
            end
            _proponer(g, "font-size", Candidata(x, imp, autor, esp, orden))
            familia = ""
            for k in (i + 1..t.length - 1)
                familia = familia + " " + t[k]
            end
            if familia != ""
                _proponer(g, "font-family", Candidata(str_trim(familia), imp, autor, esp, orden))
            end
            return
        end
        i = i + 1
    end
end

func _palabras(v: String) -> [String]
    var r: [String] = []
    for p in css_partir(str_replace(str_replace(v, "\t", " "), "\n", " "), 32)
        if str_trim(p) != ""
            r.push(str_trim(p))
        end
    end
    return r
end

func _es_estilo_borde(t: String) -> Bool
    return t == "none" or t == "hidden" or t == "solid" or t == "dashed" or t == "dotted" or t == "double" or t == "groove" or t == "ridge" or t == "inset" or t == "outset"
end

func _es_longitud(t: String) -> Bool
    if t == "0"
        return true
    end
    c = str_code(t, 0)
    return (c >= 48 and c <= 57) or c == 46 or c == 45
end

func _es_color(t: String) -> Bool
    return str_starts(t, "#") or str_starts(t, "rgb") or str_starts(t, "hsl") or (not _es_longitud(t) and not str_starts(t, "url(") and t != "none" and t != "no-repeat" and t != "repeat" and t != "repeat-x" and t != "repeat-y" and t != "center" and t != "top" and t != "left" and t != "right" and t != "bottom" and t != "fixed" and t != "scroll")
end

# Propiedades que se heredan si el elemento no dice nada
func _se_hereda(p: String) -> Bool
    return p == "color" or p == "font-family" or p == "font-size" or p == "font-weight" or p == "font-style" or p == "line-height" or p == "text-align" or p == "white-space" or p == "list-style-type" or p == "visibility" or p == "text-indent" or p == "letter-spacing" or p == "word-spacing" or p == "text-transform"
end

# Calcula el estilo de todo el árbol
func estilo_aplicar(doc: Nodo, hojas: Hojas)
    if hojas.indice == nil or hojas.indice_ancho != css_vista_ancho()
        _estilo_indexar(hojas)
    end
    var limpios: {String: Int} = {}
    _antepasados = limpios
    var raiz: {String: String} = {"color": "black", "font-family": "sans-serif", "font-size": "" + ESTILO_MEDIUM + "px", "font-weight": "normal", "font-style": "normal", "text-align": "left", "white-space": "normal", "list-style-type": "disc", "visibility": "visible", "display": "block"}
    for h in doc.hijos
        _estilo_nodo(h, hojas, raiz)
    end
end

func _estilo_nodo(n: Nodo, hojas: Hojas, padre: {String: String})
    if n.tipo != DOM_ELEMENTO
        return
    end
    var ganadoras: {String: Candidata} = {}
    # una regla con varios selectores que se cumplen se declara una vez por cada uno: gana la
    # especificidad más alta, como si se tomara la mejor
    _probar(n, hojas.universales, ganadoras)
    if hojas.indice.has(n.nombre)
        _probar(n, hojas.indice[n.nombre], ganadoras)
    end
    id = dom_id(n)
    if id != "" and hojas.indice.has("#" + id)
        _probar(n, hojas.indice["#" + id], ganadoras)
    end
    for c in dom_clases(n)
        if hojas.indice.has("." + c)
            _probar(n, hojas.indice["." + c], ganadoras)
        end
    end
    if dom_tiene_atributo(n, "style")
        for d in css_declaraciones(dom_atributo(n, "style"))
            _declarar(ganadoras, d, true, 1000000, 1000000)
        end
    end
    # lo heredado, y encima lo propio
    var e: {String: String} = {}
    for p in padre.keys()
        if _se_hereda(p)
            e[p] = padre[p]
        end
    end
    e["display"] = "inline"
    for p in ganadoras.keys()
        v = ganadoras[p].valor
        if str_lower(v) == "inherit"
            if padre.has(p)
                e[p] = padre[p]
            end
        elif p != "font-size"
            e[p] = v
        end
    end
    if ganadoras.has("font-size")
        e["font-size"] = "" + estilo_tamano(ganadoras["font-size"].valor, estilo_px(padre["font-size"], 0, 0)) + "px"
    end
    if _oculto_a_la_vista(e)
        e["display"] = "none"
    end
    n.estilo = e
    _antepasados_cambiar(n, 1)
    for h in n.hijos
        _estilo_nodo(h, hojas, e)
    end
    _antepasados_cambiar(n, -1)
end

# El texto solo para lectores de pantalla ("Saltar al contenido", .screen-reader-text): fuera del
# flujo y recortado a nada. Sin position ni clip saldría en medio de la página.
func _oculto_a_la_vista(e: {String: String}) -> Bool
    if not e.has("position") or str_lower(e["position"]) != "absolute"
        return false
    end
    if e.has("clip") and str_starts(str_lower(e["clip"]), "rect(")
        return true
    end
    if e.has("clip-path") and str_starts(str_lower(e["clip-path"]), "inset(")
        return true
    end
    return _px_diminuto(e, "width") and _px_diminuto(e, "height")
end

# 0px o 1px dichos así (auto o un tanto por ciento no cuentan)
func _px_diminuto(e: {String: String}, p: String) -> Bool
    if not e.has(p)
        return false
    end
    v = str_lower(str_trim(e[p]))
    return v == "0" or v == "0px" or v == "1px"
end

# font-size en píxeles, según el del padre
func estilo_tamano(v: String, padre: Int) -> Int
    x = str_lower(str_trim(v))
    if x == "xx-small"
        return ESTILO_MEDIUM * 3 / 5
    elif x == "x-small"
        return ESTILO_MEDIUM * 3 / 4
    elif x == "small"
        return ESTILO_MEDIUM * 8 / 9
    elif x == "medium"
        return ESTILO_MEDIUM
    elif x == "large"
        return ESTILO_MEDIUM * 6 / 5
    elif x == "x-large"
        return ESTILO_MEDIUM * 3 / 2
    elif x == "xx-large"
        return ESTILO_MEDIUM * 2
    elif x == "smaller"
        return padre * 5 / 6
    elif x == "larger"
        return padre * 6 / 5
    end
    return estilo_px(x, padre, padre)
end

# Una longitud CSS en píxeles: px, pt, em (respecto a em_px), % (respecto a cien), sin unidad = px.
# Decimales con hasta dos cifras ("1.5em"). Lo que no se entiende vale 0.
func estilo_px(v: String, em_px: Int, cien: Int) -> Int
    x = str_lower(str_trim(v))
    n = x.length
    i = 0
    signo = 1
    if i < n and str_code(x, i) == 45
        signo = -1
        i = i + 1
    end
    entero = 0
    while i < n and str_code(x, i) >= 48 and str_code(x, i) <= 57
        entero = entero * 10 + str_code(x, i) - 48
        i = i + 1
    end
    centesimas = 0
    if i < n and str_code(x, i) == 46
        i = i + 1
        cifras = 0
        while i < n and str_code(x, i) >= 48 and str_code(x, i) <= 57
            if cifras < 2
                centesimas = centesimas * 10 + str_code(x, i) - 48
                cifras = cifras + 1
            end
            i = i + 1
        end
        if cifras == 1
            centesimas = centesimas * 10
        end
    end
    valor = entero * 100 + centesimas
    unidad = x[i:]
    r = valor / 100
    if unidad == "em" or unidad == "rem"
        r = valor * em_px / 100
    elif unidad == "ex"
        r = valor * em_px / 200
    elif unidad == "%"
        r = valor * cien / 10000
    elif unidad == "pt"
        r = valor * 4 / 300
    elif unidad == "pc"
        r = valor * 16 / 100
    elif unidad == "in"
        r = valor * 96 / 100
    elif unidad == "cm"
        r = valor * 3780 / 10000
    elif unidad == "mm"
        r = valor * 378 / 10000
    elif unidad != "px" and unidad != ""
        r = 0
    end
    return signo * r
end
