# Estilo calculado: qué reglas CSS se aplican a cada elemento (selectores), cuál gana
# (cascada: importancia, origen, especificidad, orden), herencia y atajos desplegados.
#
#   hojas = estilo_hojas(doc, "http://ejemplo.org/")   # la del navegador + <style>, <link>, @import
#   estilo_aplicar(doc, hojas)                          # cada elemento: nodo.estilo["color"]...
#
# Los valores quedan como texto, salvo font-size, que se guarda en píxeles ("16px"). El tamaño
# normal (medium) es 13 píxeles: lo que cabe bien en una pantalla de Amiga con sus fuentes.

import "dom.dash"
import "css.dash"
import "http.dash"

const ESTILO_MEDIUM = 13
const ESTILO_ORDEN_HOJA = 100000     # orden de la primera regla de cada hoja (una hoja puede tener miles)

# Un selector de una regla, en el índice de las hojas
struct Entrada
    sel: Selector
    regla: Regla
    autor: Bool
    # lo que tiene que haber entre los antecesores ("#id", ".clase" o la etiqueta de cada parte de
    # antes de un combinador de descendiente o hijo): sin ello el selector no se prueba
    antes: [String] = nil
    num: Int = 0         # su número en el índice (la clave de _ganadoras_hechas)
end

# Cuántos antecesores del nodo que se está mirando tienen cada etiqueta, "#id" y ".clase" (el filtro de
# antecesores de los navegadores: un selector como ".menu a" se descarta sin subir por el árbol)
var _antepasados: {String: Int} = {}
# Hojas.vars_usadas de las hojas que se están aplicando (nil: se guardan todas)
var _vars_usadas: {String: Int} = nil
# Las propiedades --x del último _calcular: van aparte del estilo y un hijo comparte las de su padre
# (el mismo diccionario) mientras no declare otro valor
var _calc_vars: {String: String} = nil
# Lo que declaran las reglas que cumple un elemento, por la lista de sus números ("3,17,40"): muchos
# elementos cumplen las mismas reglas (todos los <p> sin clase...) y no hace falta repasarlas otra vez
var _ganadoras_hechas: {String: {String: Candidata}} = {}
# Se puede apagar para medir o depurar (estuvo apagada hasta que Dash llevó bien un diccionario de diccionarios)
var _ganadoras_cache: Bool = true

func _antepasado(clave: String, cuanto: Int)
    if _antepasados.has(clave)
        _antepasados[clave] = _antepasados[clave] + cuanto
    else
        _antepasados[clave] = cuanto
    end
end

func _antepasados_cambiar(n: Nodo, cuanto: Int)
    _antepasado(n.nombre, cuanto)
    if dom_id(n) != ""
        _antepasado("#" + dom_id(n), cuanto)
    end
    for c in dom_clases(n)
        _antepasado("." + c, cuanto)
    end
end

# "before" o "after" si el selector acaba en ese pseudo-elemento y lo demás puede cumplirse; "" si no
func _pseudo_elemento_de(sel: Selector) -> String
    ultima = sel.partes[sel.partes.length - 1].simple
    pe = ultima.pseudo_elemento
    if pe != "before" and pe != "after"
        return ""
    end
    for parte in sel.partes
        if parte.simple.pseudo_elemento != "" and parte.simple != ultima
            return ""
        end
        for p in parte.simple.pseudo
            if not css_pseudo_conocida(p)
                return ""
            end
        end
    end
    return pe
end

# Las claves que el selector pide a los antecesores (solo por la cadena de descendiente/hijo desde el sujeto)
func _requisitos(sel: Selector) -> [String]
    var r: [String] = []
    i = sel.partes.length - 1
    while i > 0
        comb = sel.partes[i].combinador
        if comb != CSS_DESCENDIENTE and comb != CSS_HIJO
            break
        end
        k = _clave(sel.partes[i - 1].simple)
        if k != ""
            r.push(k)
        end
        i = i - 1
    end
    if r.length == 0
        var nada: [String] = nil
        return nada
    end
    return r
end

struct Hojas
    lista: [HojaCSS]
    autor: [Bool]
    traidas: {String: String} = nil    # textos de hojas ya traídos (lib/recursos.dash): no se piden otra vez
    # los selectores por su parte de la derecha: "#id", ".clase" o la etiqueta; los demás en universales
    indice: {String: [Entrada]} = nil
    universales: [Entrada] = nil
    indice_ancho: Int = -1             # el ancho de la página con que se hizo (por los @media)
    # los de ::before y ::after, con la clave "before .clase", "after a"... ("before " los universales)
    indice_pe: {String: [Entrada]} = nil
    # las propiedades --x que algún var() nombra: las demás no se guardan (Tailwind declara unas 45 en cada
    # elemento y WordPress unas 60 que se heredan; copiarlas en cada nodo era lo que más costaba)
    vars_usadas: {String: Int} = nil
    fotogramas: {String: [Declaracion]} = nil   # los @keyframes de todas las hojas (el último de un nombre manda)
    cuadros: {String: [Fotograma]} = nil        # y todos sus fotogramas (lib/animacion.dash)
    # lo que nombran los selectores, para saber si un cambio del JavaScript toca algún estilo (estilo_aplicar_partes)
    con_has: Bool = false              # algún selector usa :has() (un cambio puede tocar el estilo de los de arriba)
    clases_usadas: {String: Int} = nil
    ids_usados: {String: Int} = nil
    atributos_usados: {String: Int} = nil
    hermanos: Int = 0                  # 1: + o :first-child/:last-child; 2: ~, :nth-*, *-of-type, :only-child, :empty
    hermanos_arriba: Bool = false      # algo de hermanos en una parte que no es la última ("li:first-child a", "h1 + p")
    # por cada ".clase", "#id" o "[atributo" que sale antes de la última parte de algún selector: las claves (_clave)
    # de esa última parte: si cambia en un elemento, solo pueden cambiar los de debajo que tengan una de ellas
    invalida: {String: {String: Int}} = nil
    invalida_hermanos: {String: Int} = nil     # los que salen en un selector con + o ~
    con_hover: Bool = false                     # algún selector nombra :hover (lib/documento.dash lo mira)
end

# La hoja del navegador se lee una vez por programa (en un A1200 leerla son segundos)
var estilo_ua_leida: HojaCSS = nil

# Hoja por defecto del navegador (orden negativo: va antes que todo lo del autor)
func estilo_hoja_navegador() -> HojaCSS
    if estilo_ua_leida == nil
        estilo_ua_leida = _estilo_leer_navegador()
    end
    return estilo_ua_leida
end

func _estilo_leer_navegador() -> HojaCSS
    c = "html, body, div, p, h1, h2, h3, h4, h5, h6, ul, ol, li, dl, dt, dd, pre, blockquote, form, "
    c = c + "table, center, address, hr, header, footer, nav, section, article, aside, main, figure, "
    c = c + "fieldset, legend, details, summary, menu, dir, noscript { display: block } "
    c = c + "head, script, style, title, meta, link, base, template, [hidden] { display: none } "
    c = c + "li { display: list-item } table { display: table } tr { display: table-row } "
    c = c + "td, th { display: table-cell; padding: 1px; vertical-align: middle } thead, tbody, tfoot { display: table-row-group } "
    c = c + "table { border-spacing: 2px; border-collapse: separate } caption { text-align: center } "
    c = c + "body { margin: 8px } p, dl, blockquote, pre, ul, ol, figure { margin-top: 1em; margin-bottom: 1em } "
    c = c + "h1 { font-size: 2em; margin: 0.67em 0; font-weight: bold } "
    c = c + "h2 { font-size: 1.5em; margin: 0.83em 0; font-weight: bold } "
    c = c + "h3 { font-size: 1.17em; margin: 1em 0; font-weight: bold } "
    c = c + "h4 { margin: 1.33em 0; font-weight: bold } h5 { font-size: 0.83em; margin: 1.67em 0; font-weight: bold } "
    c = c + "h6 { font-size: 0.67em; margin: 2.33em 0; font-weight: bold } "
    c = c + "b, strong, th { font-weight: bold } i, em, cite, var, dfn, address { font-style: italic } "
    c = c + "u, ins { text-decoration: underline } s, strike, del { text-decoration: line-through } "
    c = c + "pre, code, tt, kbd, samp { font-family: monospace } pre { white-space: pre } "
    c = c + "ul, ol { padding-left: 40px } ol { list-style-type: decimal } ul { list-style-type: disc } "
    c = c + "ul ul { list-style-type: circle } blockquote { margin-left: 40px; margin-right: 40px } "
    c = c + "dd { margin-left: 40px } center, th { text-align: center } "
    c = c + "a:link { color: #0000ee; text-decoration: underline } small { font-size: smaller } big { font-size: larger } "
    c = c + "hr { border: 1px inset; margin: 0.5em 0 } sub, sup { font-size: smaller } "
    c = c + "img { display: inline }"
    hoja = css_leer(c, -10000)
    return hoja
end

# Las hojas del documento, en orden: la del navegador, luego <style> y <link rel=stylesheet>
# como aparecen (con sus @import delante). base: URL de la página, para las relativas.
func estilo_hojas(doc: Nodo, base: String) -> Hojas
    var traidas: {String: String} = {}
    return estilo_hojas_con(doc, base, traidas)
end

# Lo mismo con las hojas externas ya traídas (dirección -> texto en Latin-1); las que falten se piden
func estilo_hojas_con(doc: Nodo, base: String, traidas: {String: String}) -> Hojas
    var lista: [HojaCSS] = [estilo_hoja_navegador()]
    var autor: [Bool] = [false]
    h = Hojas(lista, autor)
    h.traidas = traidas
    css_capas_reiniciar()
    _estilo_recoger(h, doc, url_parse(base))
    return h
end

func _estilo_recoger(h: Hojas, n: Nodo, base: Url)
    if n.tipo == DOM_ELEMENTO and n.nombre == "style"
        _estilo_agregar(h, css_leer(dom_texto(n), h.lista.length * ESTILO_ORDEN_HOJA), base, 0)
    elif n.tipo == DOM_ELEMENTO and n.nombre == "link" and str_find(str_lower(dom_atributo(n, "rel")), "stylesheet") >= 0
        _estilo_cargar(h, url_text(url_resolve(base, dom_atributo(n, "href"))), 0)
    end
    for hijo in n.hijos
        _estilo_recoger(h, hijo, base)
    end
end

func _estilo_agregar(h: Hojas, hoja: HojaCSS, base: Url, nivel: Int)
    # las url() relativas de una hoja son relativas a la hoja (no a la página): se dejan completas
    if hoja.caras != nil
        for c in hoja.caras
            c.src = _css_absolutas(c.src, base)
        end
    end
    for regla in hoja.reglas
        for d in regla.declaraciones
            if str_find(d.valor, "url(") >= 0
                d.valor = _css_absolutas(d.valor, base)
            end
        end
    end
    if nivel < 4
        for imp in hoja.importes
            _estilo_cargar(h, url_text(url_resolve(base, imp)), nivel + 1)
        end
    end
    h.lista.push(hoja)
    h.autor.push(true)
end

# Los @font-face de todas las hojas, en orden
func estilo_caras(h: Hojas) -> [CaraFuente]
    var r: [CaraFuente] = []
    for hoja in h.lista
        if hoja.caras != nil
            for c in hoja.caras
                r.push(c)
            end
        end
    end
    return r
end

# El valor con cada url(x) relativa cambiada por la dirección completa respecto a base (data: y # se quedan)
func _css_absolutas(valor: String, base: Url) -> String
    r = ""
    resto = valor
    p = str_find(resto, "url(")
    while p >= 0
        c = str_find_from(resto, ")", p)
        if c < 0
            break
        end
        dentro = css_url(resto[p:c + 1])
        r = r + resto[:p]
        if dentro == "" or str_starts(dentro, "data:") or str_starts(dentro, "#")
            r = r + resto[p:c + 1]
        else
            r = r + "url(\"" + url_text(url_resolve(base, dentro)) + "\")"
        end
        resto = resto[c + 1:]
        p = str_find(resto, "url(")
    end
    return r + resto
end

# Una hoja por URL: http(s), o un fichero (file: o una ruta del Amiga)
func _estilo_cargar(h: Hojas, direccion: String, nivel: Int)
    u = url_parse(direccion)
    texto = ""
    if h.traidas != nil and h.traidas.has(direccion)
        _estilo_agregar(h, css_leer(h.traidas[direccion], h.lista.length * ESTILO_ORDEN_HOJA), u, nivel)
        return
    end
    if u.esquema == "http" or u.esquema == "https"
        r = http_get(url_fuentes_latin1(direccion), 15000)
        if r.error != "" or r.estado != 200
            return
        end
        texto = http_texto(r)
    else
        ruta = url_fichero(direccion)
        leido = file_read_text(ruta)
        if leido == nil
            return
        end
        texto = utf8_a_latin1(leido)
    end
    _estilo_agregar(h, css_leer(texto, h.lista.length * ESTILO_ORDEN_HOJA), u, nivel)
end

# === Selectores ===

func _anterior_elemento(n: Nodo) -> Nodo
    var nada: Nodo = nil
    p = n.padre
    if p == nil
        return nada
    end
    var previo: Nodo = nil
    for h in p.hijos
        if h == n
            return previo
        end
        if h.tipo == DOM_ELEMENTO
            previo = h
        end
    end
    return nada
end

func _es_primero(n: Nodo) -> Bool
    return _anterior_elemento(n) == nil
end

func _es_ultimo(n: Nodo) -> Bool
    p = n.padre
    if p == nil
        return true
    end
    visto = false
    for h in p.hijos
        if visto and h.tipo == DOM_ELEMENTO
            return false
        end
        if h == n
            visto = true
        end
    end
    return true
end

# Las clases ya partidas del nodo (dom_clases)
func _tiene_clase(n: Nodo, clase: String) -> Bool
    for c in dom_clases(n)
        if c == clase
            return true
        end
    end
    return false
end

func _cumple_atributo(n: Nodo, a: SelAtributo) -> Bool
    if not dom_tiene_atributo(n, a.nombre)
        return false
    end
    v = dom_atributo(n, a.nombre)
    if a.op == ""
        return true
    elif a.op == "="
        return v == a.valor
    elif a.op == "~="
        return str_find(" " + v + " ", " " + a.valor + " ") >= 0
    elif a.op == "|="
        return v == a.valor or str_starts(v, a.valor + "-")
    elif a.op == "^="
        return a.valor != "" and str_starts(v, a.valor)
    elif a.op == "$="
        return a.valor != "" and str_ends(v, a.valor)
    elif a.op == "*="
        return a.valor != "" and str_find(v, a.valor) >= 0
    end
    return false
end

# Pseudo-clases que se saben sin interacción, y :hover (con el ratón); las demás (focus...) no se cumplen
# Los selectores de una lista (la de :not(), :is(), :has()...) ya leídos: se leen una vez por texto (antes se
# leían cada vez que se miraba un elemento: 118.000 veces en freemem.space)
var _selectores_leidos: {String: [Selector]} = nil

func _selectores_de(lista: String) -> [Selector]
    if _selectores_leidos == nil
        var d: {String: [Selector]} = {}
        _selectores_leidos = d
    end
    if _selectores_leidos.has(lista)
        return _selectores_leidos[lista]
    end
    var r: [Selector] = []
    for parte in css_partir(lista, 44)
        sel = css_selector(parte)
        if sel != nil
            r.push(sel)
        end
    end
    _selectores_leidos[lista] = r
    return r
end

func _cumple_pseudo(n: Nodo, p: String) -> Bool
    if p == "hover"
        return n.raton
    elif p == "first-child"
        return _es_primero(n)
    elif p == "last-child"
        return _es_ultimo(n)
    elif p == "only-child"
        return _es_primero(n) and _es_ultimo(n)
    elif p == "link" or p == "any-link"
        return n.nombre == "a" and dom_tiene_atributo(n, "href")
    elif p == "root"
        return n.padre != nil and n.padre.tipo == DOM_DOCUMENTO
    elif p == "empty"
        return n.hijos.length == 0
    elif p == "checked"
        return (n.nombre == "input" and dom_tiene_atributo(n, "checked")) or (n.nombre == "option" and dom_tiene_atributo(n, "selected"))
    elif p == "disabled"
        return _se_desactiva(n.nombre) and dom_tiene_atributo(n, "disabled")
    elif p == "enabled"
        return _se_desactiva(n.nombre) and not dom_tiene_atributo(n, "disabled")
    elif p == "first-of-type"
        return _posicion(n, true, false) == 1
    elif p == "last-of-type"
        return _posicion(n, true, true) == 1
    elif p == "only-of-type"
        return _posicion(n, true, false) == 1 and _posicion(n, true, true) == 1
    elif str_starts(p, "nth-child(")
        return _nth(p[10:p.length - 1], _posicion(n, false, false))
    elif str_starts(p, "nth-last-child(")
        return _nth(p[15:p.length - 1], _posicion(n, false, true))
    elif str_starts(p, "nth-of-type(")
        return _nth(p[12:p.length - 1], _posicion(n, true, false))
    elif str_starts(p, "not(")
        for sel in _selectores_de(p[4:p.length - 1])
            if estilo_cumple(n, sel)
                return false
            end
        end
        return true
    elif str_starts(p, "nth-last-of-type(")
        return _nth(p[17:p.length - 1], _posicion(n, true, true))
    elif str_starts(p, "is(") or str_starts(p, "where(") or str_starts(p, "matches(") or str_starts(p, "-webkit-any(") or str_starts(p, "-moz-any(")
        # alguno de la lista (Selectors 4)
        q = str_find(p, "(")
        for sel in _selectores_de(p[q + 1:p.length - 1])
            if estilo_cumple(n, sel)
                return true
            end
        end
        return false
    elif str_starts(p, "has(")
        for parte in css_partir(p[4:p.length - 1], 44)
            if _tiene(n, str_trim(parte))
                return true
            end
        end
        return false
    end
    return false
end

# :has(): un selector relativo a n (> hijo, + hermano siguiente, ~ hermanos siguientes, o descendiente)
func _tiene(n: Nodo, relativo: String) -> Bool
    comb = " "
    s = relativo
    if str_starts(s, ">") or str_starts(s, "+") or str_starts(s, "~")
        comb = s[:1]
        s = str_trim(s[1:])
    end
    lista = _selectores_de(s)
    if lista.length == 0
        return false
    end
    sel = lista[0]
    if comb == ">"
        for h in n.hijos
            if h.tipo == DOM_ELEMENTO and estilo_cumple(h, sel)
                return true
            end
        end
        return false
    end
    if comb == "+" or comb == "~"
        p = n.padre
        if p == nil
            return false
        end
        visto = false
        for h in p.hijos
            if h == n
                visto = true
            elif visto and h.tipo == DOM_ELEMENTO
                if estilo_cumple(h, sel)
                    return true
                end
                if comb == "+"
                    return false
                end
            end
        end
        return false
    end
    return _tiene_debajo(n, sel)
end

func _tiene_debajo(n: Nodo, sel: Selector) -> Bool
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO
            if estilo_cumple(h, sel) or _tiene_debajo(h, sel)
                return true
            end
        end
    end
    return false
end

# Las pseudo-clases que se saben sin interacción y :hover (las demás, :focus..., nunca se cumplen;
# querySelector da un error con ellas, como los navegadores con las que no conocen)
func css_pseudo_conocida(p: String) -> Bool
    if p == "hover"
        # (con el ratón encima: Nodo.raton, que pone lib/documento.dash)
        return true
    end
    if p == "first-child" or p == "last-child" or p == "only-child" or p == "link" or p == "any-link" or p == "root" or p == "empty"
        return true
    end
    if p == "checked" or p == "disabled" or p == "enabled" or p == "first-of-type" or p == "last-of-type" or p == "only-of-type"
        return true
    end
    if str_starts(p, "nth-child(") or str_starts(p, "nth-last-child(") or str_starts(p, "nth-of-type(") or str_starts(p, "nth-last-of-type(")
        return true
    end
    if str_starts(p, "is(") or str_starts(p, "where(") or str_starts(p, "matches(") or str_starts(p, "-webkit-any(") or str_starts(p, "-moz-any(") or str_starts(p, "has(")
        # (como con :not: lo de dentro tiene que poder cumplirse; en :has, sin su combinador)
        q = str_find(p, "(")
        alguna = false
        for parte in css_partir(p[q + 1:p.length - 1], 44)
            a = str_trim(parte)
            while a != "" and (str_starts(a, ">") or str_starts(a, "+") or str_starts(a, "~"))
                a = str_trim(a[1:])
            end
            sel = css_selector(a)
            if sel != nil and estilo_puede_cumplirse(sel)
                alguna = true
            end
        end
        return alguna
    end
    if str_starts(p, "not(")
        for parte in css_partir(p[4:p.length - 1], 44)
            sel = css_selector(parte)
            if sel == nil or not estilo_puede_cumplirse(sel)
                return false
            end
        end
        return true
    end
    return false
end

func _se_desactiva(nombre: String) -> Bool
    return nombre == "input" or nombre == "button" or nombre == "select" or nombre == "textarea" or nombre == "option" or nombre == "fieldset" or nombre == "optgroup"
end

# El puesto de n entre los elementos hermanos (desde 1; desde el final si al_reves; solo los de su
# etiqueta si del_tipo)
func _posicion(n: Nodo, del_tipo: Bool, al_reves: Bool) -> Int
    p = n.padre
    if p == nil
        return 1
    end
    k = 0
    puesto = 0
    for h in p.hijos
        if h.tipo == DOM_ELEMENTO and (not del_tipo or h.nombre == n.nombre)
            k = k + 1
            if h == n
                puesto = k
            end
        end
    end
    if al_reves
        return k - puesto + 1
    end
    return puesto
end

# an+b (odd, even, 3, 2n+1, -n+3) contra el puesto
func _nth(expr: String, puesto: Int) -> Bool
    e = str_replace(str_lower(str_trim(expr)), " ", "")
    a = 0
    b = 0
    if e == "odd"
        a = 2
        b = 1
    elif e == "even"
        a = 2
    else
        pn = str_find(e, "n")
        if pn < 0
            b = Int(e)
        else
            delante = e[:pn]
            if delante == "" or delante == "+"
                a = 1
            elif delante == "-"
                a = -1
            else
                a = Int(delante)
            end
            detras = e[pn + 1:]
            if str_starts(detras, "+")
                detras = detras[1:]
            end
            if detras != ""
                b = Int(detras)
            end
        end
    end
    if a == 0
        return puesto == b
    end
    d = puesto - b
    return d / a >= 0 and d % a == 0
end

# Mientras se buscan las reglas de un ::before o ::after: su parte final se compara sin el pseudo-elemento
var _con_pseudo_elemento: Bool = false

func _cumple_simple(n: Nodo, s: SelSimple) -> Bool
    if n.tipo != DOM_ELEMENTO or (s.pseudo_elemento != "" and not _con_pseudo_elemento)
        return false
    end
    if s.etiqueta != "" and s.etiqueta != n.nombre
        return false
    end
    if s.id != "" and dom_id(n) != s.id
        return false
    end
    for c in s.clases
        if not _tiene_clase(n, c)
            return false
        end
    end
    for a in s.atributos
        if not _cumple_atributo(n, a)
            return false
        end
    end
    for p in s.pseudo
        if not _cumple_pseudo(n, p)
            return false
        end
    end
    return true
end

# ¿Se cumple el selector, partes 0..i, con n como sujeto de la parte i?
func _cumple_desde(n: Nodo, sel: Selector, i: Int) -> Bool
    parte = sel.partes[i]
    if not _cumple_simple(n, parte.simple)
        return false
    end
    if i == 0
        return true
    end
    if parte.combinador == CSS_HIJO
        p = n.padre
        return p != nil and _cumple_desde(p, sel, i - 1)
    elif parte.combinador == CSS_DESCENDIENTE
        p = n.padre
        while p != nil
            if _cumple_desde(p, sel, i - 1)
                return true
            end
            p = p.padre
        end
        return false
    elif parte.combinador == CSS_ADYACENTE
        a = _anterior_elemento(n)
        return a != nil and _cumple_desde(a, sel, i - 1)
    elif parte.combinador == CSS_HERMANO
        a = _anterior_elemento(n)
        while a != nil
            if _cumple_desde(a, sel, i - 1)
                return true
            end
            a = _anterior_elemento(a)
        end
        return false
    end
    return false
end

func estilo_cumple(n: Nodo, sel: Selector) -> Bool
    return _cumple_desde(n, sel, sel.partes.length - 1)
end

# === Índice ===
# Cada elemento solo prueba los selectores que pueden cumplirse con él: los de su etiqueta, su id,
# sus clases y los universales (como los navegadores). Los que nunca se cumplen (::before, :hover...)
# no entran.

# ¿Puede cumplirse alguna vez? (no si lleva ::before o una pseudo-clase de interacción)
func estilo_puede_cumplirse(sel: Selector) -> Bool
    for parte in sel.partes
        if parte.simple.pseudo_elemento != ""
            return false
        end
        for p in parte.simple.pseudo
            if not css_pseudo_conocida(p)
                return false
            end
        end
    end
    return true
end

func _clave(s: SelSimple) -> String
    if s.id != ""
        return "#" + s.id
    elif s.clases.length > 0
        return "." + s.clases[0]
    end
    return s.etiqueta
end

# Lo que nombra un selector: clases, ids, atributos, combinadores y pseudoclases de hermanos, :has()
func _estilo_usos(h: Hojas, sel: Selector)
    ultima = sel.partes.length - 1
    clave = _clave(sel.partes[ultima].simple)
    if clave == "*"
        clave = ""
    end
    con_hermanos = false
    for parte in sel.partes
        if parte.combinador == CSS_ADYACENTE or parte.combinador == CSS_HERMANO
            con_hermanos = true
            h.hermanos_arriba = true
        end
    end
    k = 0
    for parte in sel.partes
        rasgos = _estilo_rasgos(parte.simple)
        for r in rasgos
            if con_hermanos
                h.invalida_hermanos[r] = 1
            end
            if k < ultima
                if not h.invalida.has(r)
                    var claves: {String: Int} = {}
                    h.invalida[r] = claves
                end
                var claves_r: {String: Int} = h.invalida[r]
                claves_r[clave] = 1
            end
        end
        if k < ultima
            for ps in parte.simple.pseudo
                if ps == "first-child" or ps == "last-child" or ps == "only-child" or ps == "empty" or str_starts(ps, "nth-") or str_ends(ps, "-of-type")
                    h.hermanos_arriba = true
                end
            end
        end
        k = k + 1
    end
    for parte in sel.partes
        si = parte.simple
        for c in si.clases
            h.clases_usadas[c] = 1
        end
        if si.id != ""
            h.ids_usados[si.id] = 1
        end
        for a in si.atributos
            h.atributos_usados[a.nombre] = 1
        end
        if parte.combinador == CSS_ADYACENTE and h.hermanos < 1
            h.hermanos = 1
        elif parte.combinador == CSS_HERMANO
            h.hermanos = 2
        end
        for ps in si.pseudo
            if ps == "hover"
                h.con_hover = true
            end
            if ps == "first-child" or ps == "last-child"
                if h.hermanos < 1
                    h.hermanos = 1
                end
            elif ps == "only-child" or ps == "empty" or str_starts(ps, "nth-") or str_ends(ps, "-of-type")
                h.hermanos = 2
            end
            if str_find(ps, "(") >= 0
                _estilo_usos_texto(h, ps)
            end
        end
    end
end

# Dentro de :not(), :is(), :has()...: las .clases, #ids y [atributos] que aparecen, y si hay combinadores de hermanos
func _estilo_usos_texto(h: Hojas, t: String)
    if str_starts(t, "has(")
        h.con_has = true
    end
    if str_find(t, "has(") >= 0
        h.con_has = true
    end
    if str_find(t, "+") >= 0 or str_find(t, "~") >= 0 or str_find(t, "nth-") >= 0 or str_find(t, "child") >= 0 or str_find(t, "type") >= 0 or str_find(t, "empty") >= 0
        h.hermanos = 2
    end
    n = t.length
    i = 0
    while i < n
        c = str_code(t, i)
        if c == 46 or c == 35 or c == 91
            j = i + 1
            while j < n and _estilo_letra(str_code(t, j))
                j = j + 1
            end
            if j > i + 1
                nombre = t[i + 1:j]
                if c == 46
                    h.clases_usadas[nombre] = 1
                elif c == 35
                    h.ids_usados[nombre] = 1
                else
                    h.atributos_usados[str_lower(nombre)] = 1
                end
            end
            i = j
        else
            i = i + 1
        end
    end
end

# Las clases, el id y los atributos de una parte de un selector (".c", "#id", "[atr"), también los de dentro de
# :not(), :is()...
func _estilo_rasgos(si: SelSimple) -> [String]
    var r: [String] = []
    for c in si.clases
        r.push("." + c)
    end
    if si.id != ""
        r.push("#" + si.id)
    end
    for a in si.atributos
        r.push("[" + a.nombre)
    end
    for ps in si.pseudo
        if ps == "hover"
            r.push(":hover")
        end
        if str_find(ps, "(") >= 0
            n = ps.length
            i = 0
            while i < n
                c = str_code(ps, i)
                if c == 46 or c == 35 or c == 91
                    j = i + 1
                    while j < n and _estilo_letra(str_code(ps, j))
                        j = j + 1
                    end
                    if j > i + 1
                        if c == 91
                            r.push("[" + str_lower(ps[i + 1:j]))
                        else
                            r.push(ps[i:j])
                        end
                    end
                    i = j
                else
                    i = i + 1
                end
            end
        end
    end
    return r
end

func _estilo_letra(c: Int) -> Bool
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 95 or c >= 128
end

func _estilo_indexar(h: Hojas)
    var cu: {String: Int} = {}
    h.clases_usadas = cu
    var iu: {String: Int} = {}
    h.ids_usados = iu
    var au: {String: Int} = {}
    h.atributos_usados = au
    h.hermanos = 0
    h.hermanos_arriba = false
    h.con_has = false
    var inv: {String: {String: Int}} = {}
    h.invalida = inv
    var invh: {String: Int} = {}
    h.invalida_hermanos = invh
    var indice: {String: [Entrada]} = {}
    var universales: [Entrada] = []
    var indice_pe: {String: [Entrada]} = {}
    numero = 0
    for k in (0..h.lista.length - 1)
        for regla in h.lista[k].reglas
            if not css_regla_vale(regla)
                continue
            end
            for sel in regla.selectores
                _estilo_usos(h, sel)
                pe = _pseudo_elemento_de(sel)
                if pe != ""
                    e = Entrada(sel, regla, h.autor[k])
                    e.antes = _requisitos(sel)
                    numero = numero + 1
                    e.num = numero
                    clave = pe + " " + _clave(sel.partes[sel.partes.length - 1].simple)
                    if indice_pe.has(clave)
                        indice_pe[clave].push(e)
                    else
                        var lista_pe: [Entrada] = [e]
                        indice_pe[clave] = lista_pe
                    end
                elif estilo_puede_cumplirse(sel)
                    e = Entrada(sel, regla, h.autor[k])
                    e.antes = _requisitos(sel)
                    numero = numero + 1
                    e.num = numero
                    clave = _clave(sel.partes[sel.partes.length - 1].simple)
                    if clave == ""
                        universales.push(e)
                    elif indice.has(clave)
                        indice[clave].push(e)
                    else
                        var lista: [Entrada] = [e]
                        indice[clave] = lista
                    end
                end
            end
        end
    end
    h.indice = indice
    h.universales = universales
    h.indice_pe = indice_pe
    var usadas: {String: Int} = {}
    for hoja in h.lista
        for regla in hoja.reglas
            for d in regla.declaraciones
                _vars_nombradas(d.valor, usadas)
            end
        end
    end
    h.vars_usadas = usadas
    var fotogramas: {String: [Declaracion]} = {}
    for hoja in h.lista
        if hoja.fotogramas != nil
            for k in hoja.fotogramas.keys()
                fotogramas[k] = hoja.fotogramas[k]
            end
        end
    end
    h.fotogramas = fotogramas
    var cuadros: {String: [Fotograma]} = {}
    for hoja in h.lista
        if hoja.cuadros != nil
            for k in hoja.cuadros.keys()
                cuadros[k] = hoja.cuadros[k]
            end
        end
    end
    h.cuadros = cuadros
    h.indice_ancho = css_vista_ancho()
end

# ¿Cambia el estilo si la página pasa a medir ancho? (algún @media cambia de lado)
func estilo_cambia_con(h: Hojas, ancho: Int) -> Bool
    for hoja in h.lista
        for regla in hoja.reglas
            if regla.medios != nil and css_regla_vale(regla) != css_regla_vale_con(regla, ancho)
                return true
            end
        end
    end
    return false
end

func _antepasados_tienen(claves: [String]) -> Bool
    for k in claves
        if not _antepasados.has(k) or _antepasados[k] <= 0
            return false
        end
    end
    return true
end

# Las entradas cuyo selector cumple n, a la lista
func _cumplidas(n: Nodo, entradas: [Entrada], cumplidas: [Entrada])
    for e in entradas
        if e.antes != nil and not _antepasados_tienen(e.antes)
            continue
        end
        if estilo_cumple(n, e.sel)
            cumplidas.push(e)
        end
    end
end

# Lo que declaran esas entradas, cada propiedad con la que gana (una regla con varios selectores que se
# cumplen se declara una vez por cada uno: gana la especificidad más alta, como si se tomara la mejor)
func _declarar_todas(cumplidas: [Entrada], ganadoras: {String: Candidata})
    for e in cumplidas
        _declarar_entrada(e, ganadoras)
    end
end

func _probar(n: Nodo, entradas: [Entrada], ganadoras: {String: Candidata})
    for e in entradas
        if e.antes != nil and not _antepasados_tienen(e.antes)
            continue
        end
        if estilo_cumple(n, e.sel)
            _declarar_entrada(e, ganadoras)
        end
    end
end

func _declarar_entrada(e: Entrada, ganadoras: {String: Candidata})
    r = e.regla
    if r.expandidas == nil
        r.expandidas = _expandir(r.declaraciones)
    end
    # la capa (@layer) pesa más que la especificidad
    esp = e.sel.especificidad + r.capa * 1000000
    for d in r.expandidas
        p = d.propiedad
        if _vars_usadas != nil and str_code(p, 0) == 45 and str_starts(p, "--") and not _vars_usadas.has(p)
            continue
        end
        if ganadoras.has(p)
            if not _gana_con(d.importante, e.autor, esp, r.orden, ganadoras[p])
                continue
            end
        end
        ganadoras[p] = Candidata(d.valor, d.importante, e.autor, esp, r.orden)
    end
end

# === Cascada ===

# Quién gana para una propiedad: el peso más alto
struct Candidata
    valor: String
    importante: Bool
    autor: Bool
    especificidad: Int
    orden: Int
end

func _gana(nueva: Candidata, vieja: Candidata) -> Bool
    return _gana_con(nueva.importante, nueva.autor, nueva.especificidad, nueva.orden, vieja)
end

func _gana_con(importante: Bool, autor: Bool, especificidad: Int, orden: Int, vieja: Candidata) -> Bool
    if importante != vieja.importante
        return importante
    end
    if autor != vieja.autor
        # normal: el autor gana; !important: el navegador (no hay hoja del usuario)
        return autor != importante
    end
    if especificidad != vieja.especificidad
        return especificidad > vieja.especificidad
    end
    return orden >= vieja.orden
end

# margin-inline, padding-block, inset-inline-start...: las propiedades físicas a las que van (con -inline y -block, la
# del primer valor y la del segundo); nil si no es una de ellas
func _logica_lados(p: String) -> [String]
    var nada: [String] = nil
    base = ""
    resto = ""
    if str_starts(p, "margin-")
        base = "margin-"
        resto = p[7:]
    elif str_starts(p, "padding-")
        base = "padding-"
        resto = p[8:]
    elif str_starts(p, "inset-")
        resto = p[6:]
    else
        return nada
    end
    if resto == "inline"
        return [base + "left", base + "right"]
    elif resto == "block"
        return [base + "top", base + "bottom"]
    elif resto == "inline-start"
        return [base + "left"]
    elif resto == "inline-end"
        return [base + "right"]
    elif resto == "block-start"
        return [base + "top"]
    elif resto == "block-end"
        return [base + "bottom"]
    end
    return nada
end

func _es_atajo(p: String) -> Bool
    if (str_ends(p, "-inline") or str_ends(p, "-block") or str_ends(p, "-start") or str_ends(p, "-end")) and _logica_lados(p) != nil
        return true
    end
    return p == "margin" or p == "padding" or p == "inset" or p == "place-items" or p == "place-content" or p == "place-self" or p == "border" or p == "border-top" or p == "border-right" or p == "border-bottom" or p == "border-left" or p == "border-width" or p == "border-style" or p == "border-color" or p == "background" or p == "list-style" or p == "font" or p == "flex" or p == "flex-flow" or p == "gap" or p == "grid-gap"
end

# Las declaraciones de una regla con los atajos partidos (margin en margin-top..., border, background,
# font...), en el mismo orden: se hace una vez por regla, no en cada elemento
func _expandir(decl: [Declaracion]) -> [Declaracion]
    var r: [Declaracion] = []
    for d in decl
        var una: {String: Candidata} = {}
        _declarar(una, d, true, 0, 0)
        for k in una.keys()
            r.push(Declaracion(k, una[k].valor, una[k].importante))
        end
    end
    return r
end

func _proponer(ganadoras: {String: Candidata}, propiedad: String, c: Candidata)
    if not ganadoras.has(propiedad) or _gana(c, ganadoras[propiedad])
        ganadoras[propiedad] = c
    end
end

# Una declaración, con los atajos ya repartidos en sus propiedades
func _declarar(ganadoras: {String: Candidata}, d: Declaracion, autor: Bool, esp: Int, orden: Int)
    p = d.propiedad
    v = d.valor
    if str_find(v, "var(") >= 0 and _es_atajo(p)
        # con var() se parte en _calcular, cuando ya se sabe el valor
        _proponer(ganadoras, p, Candidata(v, d.importante, autor, esp, orden))
        return
    end
    lados = _logica_lados(p)
    if lados != nil
        # propiedades lógicas (Tailwind 4: px-4 es padding-inline): en horizontal y de izquierda a derecha
        partes = _palabras(v)
        if partes.length > 0
            _proponer(ganadoras, lados[0], Candidata(partes[0], d.importante, autor, esp, orden))
            if lados.length > 1
                segundo = partes[0]
                if partes.length > 1
                    segundo = partes[1]
                end
                _proponer(ganadoras, lados[1], Candidata(segundo, d.importante, autor, esp, orden))
            end
        end
    elif p == "margin" or p == "padding"
        _cuatro(ganadoras, p + "-", "", v, d.importante, autor, esp, orden)
    elif p == "inset"
        # top, right, bottom y left de una vez (Tailwind: inset-0; tarea 37h)
        _cuatro(ganadoras, "", "", v, d.importante, autor, esp, orden)
    elif p == "place-items" or p == "place-content" or p == "place-self"
        # align-* y justify-* (el segundo valor, o el mismo): "place-items: center" centra en la celda de un grid
        partes = _palabras(v)
        if partes.length > 0
            resto = p[6:]
            _proponer(ganadoras, "align-" + resto, Candidata(partes[0], d.importante, autor, esp, orden))
            segundo = partes[0]
            if partes.length > 1
                segundo = partes[1]
            end
            _proponer(ganadoras, "justify-" + resto, Candidata(segundo, d.importante, autor, esp, orden))
        end
    elif p == "border-width" or p == "border-style" or p == "border-color"
        _cuatro(ganadoras, "border-", p[6:], v, d.importante, autor, esp, orden)
    elif p == "border" or p == "border-top" or p == "border-right" or p == "border-bottom" or p == "border-left"
        lados = ["top", "right", "bottom", "left"]
        if p != "border"
            lados = [p[7:]]
        end
        ancho = "medium"
        tipo = "none"
        color = "currentcolor"
        for t in _palabras(v)
            if _es_estilo_borde(t)
                tipo = t
            elif _es_longitud(t) or t == "thin" or t == "medium" or t == "thick"
                ancho = t
            else
                color = t
            end
        end
        for lado in lados
            _proponer(ganadoras, "border-" + lado + "-width", Candidata(ancho, d.importante, autor, esp, orden))
            _proponer(ganadoras, "border-" + lado + "-style", Candidata(tipo, d.importante, autor, esp, orden))
            _proponer(ganadoras, "border-" + lado + "-color", Candidata(color, d.importante, autor, esp, orden))
        end
    elif p == "background"
        color = "transparent"
        imagen = "none"
        repetir = "repeat"
        var lugar: [String] = []
        tam = "auto"
        for t in _palabras(v)
            tl = str_lower(t)
            if str_starts(tl, "url(") or str_starts(tl, "linear-gradient(") or str_starts(tl, "-webkit-linear-gradient(") or str_starts(tl, "-moz-linear-gradient(") or str_starts(tl, "-o-linear-gradient(")
                imagen = t
            elif tl == "repeat" or tl == "no-repeat" or tl == "repeat-x" or tl == "repeat-y"
                repetir = tl
            elif tl == "center" or tl == "top" or tl == "bottom" or tl == "left" or tl == "right" or str_ends(tl, "%")
                lugar.push(tl)
            elif str_starts(tl, "/")
                tam = tl[1:]
            elif tl == "cover" or tl == "contain"
                tam = tl
            elif tl == "fixed" or tl == "scroll" or tl == "local" or tl == "none"
                tam = tam
            elif _es_color(t)
                color = t
            end
        end
        posicion = "0% 0%"
        if lugar.length == 1
            posicion = lugar[0]
        elif lugar.length >= 2
            posicion = lugar[0] + " " + lugar[1]
        end
        _proponer(ganadoras, "background-color", Candidata(color, d.importante, autor, esp, orden))
        _proponer(ganadoras, "background-image", Candidata(imagen, d.importante, autor, esp, orden))
        _proponer(ganadoras, "background-repeat", Candidata(repetir, d.importante, autor, esp, orden))
        _proponer(ganadoras, "background-position", Candidata(posicion, d.importante, autor, esp, orden))
        _proponer(ganadoras, "background-size", Candidata(tam, d.importante, autor, esp, orden))
    elif p == "list-style"
        for t in _palabras(v)
            if t != "inside" and t != "outside" and not str_starts(t, "url(")
                _proponer(ganadoras, "list-style-type", Candidata(t, d.importante, autor, esp, orden))
            end
        end
    elif p == "font"
        _fuente(ganadoras, v, d.importante, autor, esp, orden)
    elif p == "flex"
        _flex_atajo(ganadoras, v, d.importante, autor, esp, orden)
    elif p == "flex-flow"
        for t in _palabras(v)
            if t == "row" or t == "row-reverse" or t == "column" or t == "column-reverse"
                _proponer(ganadoras, "flex-direction", Candidata(t, d.importante, autor, esp, orden))
            else
                _proponer(ganadoras, "flex-wrap", Candidata(t, d.importante, autor, esp, orden))
            end
        end
    elif p == "gap" or p == "grid-gap"
        t = _palabras(v)
        if t.length > 0
            columnas = t[0]
            if t.length > 1
                columnas = t[1]
            end
            _proponer(ganadoras, "row-gap", Candidata(t[0], d.importante, autor, esp, orden))
            _proponer(ganadoras, "column-gap", Candidata(columnas, d.importante, autor, esp, orden))
        end
    else
        _proponer(ganadoras, p, Candidata(v, d.importante, autor, esp, orden))
    end
end

# flex: none | auto | initial | <grow> [<shrink>] [<basis>] | <basis> (CSS Flexbox 1, 7.2)
func _flex_atajo(g: {String: Candidata}, v: String, imp: Bool, autor: Bool, esp: Int, orden: Int)
    crecer = "0"
    encoger = "1"
    base = "auto"
    var partes: [String] = _palabras(str_lower(v))
    if partes.length == 1 and partes[0] == "none"
        encoger = "0"
    elif partes.length == 1 and partes[0] == "auto"
        crecer = "1"
    elif partes.length == 1 and partes[0] == "initial"
        crecer = "0"
    elif partes.length > 0
        # los números sin unidad son grow y shrink; lo demás (con unidad, %, auto, content) la base
        numeros = 0
        con_base = false
        for palabra in partes
            if _numero_solo(palabra) and numeros < 2
                if numeros == 0
                    crecer = palabra
                else
                    encoger = palabra
                end
                numeros = numeros + 1
            else
                base = palabra
                con_base = true
            end
        end
        if numeros > 0 and not con_base
            base = "0%"
        end
        if numeros == 0
            crecer = "1"
        end
    end
    _proponer(g, "flex-grow", Candidata(crecer, imp, autor, esp, orden))
    _proponer(g, "flex-shrink", Candidata(encoger, imp, autor, esp, orden))
    _proponer(g, "flex-basis", Candidata(base, imp, autor, esp, orden))
end

# "1", "0.5", ".5": un número sin unidad
func _numero_solo(t: String) -> Bool
    if t == ""
        return false
    end
    for i in (0..t.length - 1)
        c = str_code(t, i)
        if not ((c >= 48 and c <= 57) or c == 46 or (i == 0 and c == 45))
            return false
        end
    end
    return true
end

# margin: 1 a 4 valores -> top right bottom left
func _cuatro(g: {String: Candidata}, prefijo: String, sufijo: String, v: String, imp: Bool, autor: Bool, esp: Int, orden: Int)
    t = _palabras(v)
    if t.length == 0
        return
    end
    arriba = t[0]
    derecha = arriba
    abajo = arriba
    izquierda = arriba
    if t.length >= 2
        derecha = t[1]
        izquierda = t[1]
    end
    if t.length >= 3
        abajo = t[2]
    end
    if t.length >= 4
        izquierda = t[3]
    end
    _proponer(g, prefijo + "top" + sufijo, Candidata(arriba, imp, autor, esp, orden))
    _proponer(g, prefijo + "right" + sufijo, Candidata(derecha, imp, autor, esp, orden))
    _proponer(g, prefijo + "bottom" + sufijo, Candidata(abajo, imp, autor, esp, orden))
    _proponer(g, prefijo + "left" + sufijo, Candidata(izquierda, imp, autor, esp, orden))
end

# font: [style] [weight] size[/line-height] family
func _fuente(g: {String: Candidata}, v: String, imp: Bool, autor: Bool, esp: Int, orden: Int)
    t = _palabras(v)
    i = 0
    while i < t.length
        x = str_lower(t[i])
        if x == "italic" or x == "oblique"
            _proponer(g, "font-style", Candidata(x, imp, autor, esp, orden))
        elif x == "bold" or x == "bolder" or x == "lighter" or (x.length == 3 and str_ends(x, "00"))
            _proponer(g, "font-weight", Candidata(x, imp, autor, esp, orden))
        elif _es_longitud(x) or str_find(x, "/") > 0 or x == "small" or x == "medium" or x == "large" or str_ends(x, "-small") or str_ends(x, "-large")
            barra = str_find(x, "/")
            if barra > 0
                _proponer(g, "line-height", Candidata(x[barra + 1:], imp, autor, esp, orden))
                x = x[:barra]
            end
            _proponer(g, "font-size", Candidata(x, imp, autor, esp, orden))
            familia = ""
            for k in (i + 1..t.length - 1)
                familia = familia + " " + t[k]
            end
            if familia != ""
                _proponer(g, "font-family", Candidata(str_trim(familia), imp, autor, esp, orden))
            end
            return
        end
        i = i + 1
    end
end

func _palabras(v: String) -> [String]
    var r: [String] = []
    for p in css_partir(str_replace(str_replace(v, "\t", " "), "\n", " "), 32)
        if str_trim(p) != ""
            r.push(str_trim(p))
        end
    end
    return r
end

func _es_estilo_borde(t: String) -> Bool
    return t == "none" or t == "hidden" or t == "solid" or t == "dashed" or t == "dotted" or t == "double" or t == "groove" or t == "ridge" or t == "inset" or t == "outset"
end

func _es_longitud(t: String) -> Bool
    if t == "0"
        return true
    end
    c = str_code(t, 0)
    return (c >= 48 and c <= 57) or c == 46 or c == 45
end

func _es_color(t: String) -> Bool
    return str_starts(t, "#") or str_starts(t, "rgb") or str_starts(t, "hsl") or (not _es_longitud(t) and not str_starts(t, "url(") and t != "none" and t != "no-repeat" and t != "repeat" and t != "repeat-x" and t != "repeat-y" and t != "center" and t != "top" and t != "left" and t != "right" and t != "bottom" and t != "fixed" and t != "scroll")
end

# (para la maqueta: el estilo de una caja anónima, lo que hereda de su padre)
func estilo_se_hereda(p: String) -> Bool
    return _se_hereda(p)
end

# Propiedades que se heredan si el elemento no dice nada
func _se_hereda(p: String) -> Bool
    return p == "color" or p == "font-family" or p == "font-size" or p == "font-weight" or p == "font-style" or p == "line-height" or p == "text-align" or p == "white-space" or p == "list-style-type" or p == "visibility" or p == "text-indent" or p == "letter-spacing" or p == "word-spacing" or p == "text-transform" or p == "text-shadow" or p == "overflow-wrap" or p == "word-wrap" or p == "word-break" or p == "-webkit-text-fill-color"
end

# Apunta en usadas los nombres de los var(--x) de un valor
func _vars_nombradas(v: String, usadas: {String: Int})
    i = str_find(v, "var(")
    while i >= 0
        j = i + 4
        while j < v.length and str_code(v, j) == 32
            j = j + 1
        end
        k = j
        while k < v.length and str_code(v, k) != 44 and str_code(v, k) != 41 and str_code(v, k) != 32
            k = k + 1
        end
        if k > j
            usadas[v[j:k]] = 1
        end
        i = str_find_from(v, "var(", k)
    end
end

# Calcula el estilo de todo el árbol
func estilo_aplicar(doc: Nodo, hojas: Hojas)
    if hojas.indice == nil or hojas.indice_ancho != css_vista_ancho()
        _estilo_indexar(hojas)
    end
    var limpios: {String: Int} = {}
    _antepasados = limpios
    _vars_usadas = hojas.vars_usadas
    var hechas: {String: {String: Candidata}} = {}
    _ganadoras_hechas = hechas
    var raiz: {String: String} = {"color": "black", "font-family": "sans-serif", "font-size": "" + ESTILO_MEDIUM + "px", "font-weight": "normal", "font-style": "normal", "text-align": "left", "white-space": "normal", "list-style-type": "disc", "visibility": "visible", "display": "block"}
    var sin_vars: {String: String} = {}
    for h in doc.hijos
        _estilo_nodo(h, hojas, raiz, sin_vars)
    end
end

# Tras los cambios del JavaScript (Toque, apuntados en el documento por lib/jsdom.dash), el estilo solo de lo que
# pueden haber cambiado (como las "invalidation sets" de los navegadores):
# - una clase, id o atributo que ningún selector nombra: nada (salvo los de presentación: el elemento);
# - si lo nombra: el elemento solo; si su estilo cambia, todo lo suyo; si no, solo los de debajo que tengan alguna
#   de las claves de los selectores que lo nombran antes de su última parte (".menu a" -> los <a>); con + o ~,
#   todos los hijos de su padre;
# - el atributo style: el elemento solo, y todo lo suyo si cambia;
# - un elemento que entra: él con todo lo suyo; sus vecinos (si hay + o :first-child), ellos solos;
#   con ~ o :nth-child, todo el padre.
# false si no se puede (:has() en las hojas, demasiados cambios, o hay que rehacer <html> entero): estilo_aplicar.
func estilo_aplicar_partes(doc: Nodo, hojas: Hojas, toques: [Toque]) -> Bool
    if hojas.con_has or hojas.indice == nil or hojas.indice_ancho != css_vista_ancho() or hojas.invalida == nil
        if traza_activa
            traza("estilo entero: :has() " + hojas.con_has)
        end
        return false
    end
    var limpios: {String: Int} = {}
    _antepasados = limpios
    _vars_usadas = hojas.vars_usadas
    var hechas: {String: {String: Candidata}} = {}
    _ganadoras_hechas = hechas
    var hechos: [Nodo] = []
    _partes_hechas = hechos
    _partes_cuantas = 0
    for t in toques
        n = t.nodo
        arriba = n
        while arriba.padre != nil
            arriba = arriba.padre
        end
        if arriba != doc
            continue
        end
        if not _estilo_toque(t, hojas)
            if traza_activa
                traza("estilo entero: " + t.tipo + " " + t.nombre + " [" + t.antes + "] -> [" + t.despues + "] en " + t.nodo.nombre)
            end
            return false
        end
    end
    if traza_activa
        traza("estilo de " + _partes_cuantas + " partes (" + toques.length + " cambios)")
    end
    return true
end

var _partes_hechas: [Nodo] = nil
var _partes_cuantas: Int = 0

func _estilo_toque(t: Toque, hojas: Hojas) -> Bool
    n = t.nodo
    if t.tipo == TOQUE_TODO
        return false
    end
    if n.tipo != DOM_ELEMENTO
        return true
    end
    if t.tipo == TOQUE_ATRIBUTO
        var rasgos: [String] = []
        propio = t.nombre == "style" or str_find(" align background bgcolor border cellspacing cellpadding height text valign width hidden ", " " + t.nombre + " ") >= 0
        if t.nombre == "class"
            for c in _estilo_clases_distintas(t.antes, t.despues)
                if hojas.clases_usadas.has(c)
                    rasgos.push("." + c)
                end
            end
        elif t.nombre == "id"
            if t.antes != "" and hojas.ids_usados.has(t.antes)
                rasgos.push("#" + t.antes)
            end
            if t.despues != "" and hojas.ids_usados.has(t.despues)
                rasgos.push("#" + t.despues)
            end
        elif t.nombre == ":hover"
            rasgos.push(":hover")
        elif hojas.atributos_usados.has(t.nombre)
            rasgos.push("[" + t.nombre)
        end
        if rasgos.length == 0 and not propio
            return true
        end
        for r in rasgos
            if hojas.invalida_hermanos.has(r)
                return _estilo_subarbol(n.padre, hojas)
            end
        end
        if _estilo_solo(n, hojas)
            return _estilo_subarbol(n, hojas)
        end
        var claves: {String: Int} = {}
        for r in rasgos
            if hojas.invalida.has(r)
                var de_r: {String: Int} = hojas.invalida[r]
                for ck in de_r.keys()
                    claves[ck] = 1
                end
            end
        end
        if claves.has("")
            return _estilo_subarbol(n, hojas)
        end
        if claves.length > 0
            _estilo_cadena(n.padre, 1)
            _estilo_invalidar(n, hojas, claves)
            _estilo_cadena(n.padre, -1)
        end
        return true
    end
    if t.tipo == TOQUE_CONTENIDO or t.tipo == TOQUE_SALE
        # (los hijos nuevos se apuntan aparte: aquí solo cuentan :empty, :nth-child...)
        if hojas.hermanos == 2 and n.nombre != "html"
            return _estilo_subarbol(n, hojas)
        end
        return true
    end
    # (bajo <html> solo están head y body: un :nth-child que cuente ahí no tiene sentido; un elemento que entra
    # directamente en <html>, como el <div> con que se mide la barra de desplazamiento, no mueve nada)
    en_html = n.padre != nil and n.padre.nombre == "html"
    if t.tipo == TOQUE_VECINO
        if hojas.hermanos == 0 or en_html
            return true
        end
        if hojas.hermanos == 2 and not en_html
            return _estilo_subarbol(n.padre, hojas)
        end
        if hojas.hermanos_arriba or _estilo_solo(n, hojas)
            return _estilo_subarbol(n, hojas)
        end
        return true
    end
    # TOQUE_ENTRA
    if hojas.hermanos == 2 and not en_html
        return _estilo_subarbol(n.padre, hojas)
    end
    return _estilo_subarbol(n, hojas)
end

# Los antecesores de n (y n) en el filtro de antecesores (cuanto 1) o fuera (-1)
func _estilo_cadena(n: Nodo, cuanto: Int)
    p = n
    while p != nil and p.tipo == DOM_ELEMENTO
        _antepasados_cambiar(p, cuanto)
        p = p.padre
    end
end

# n con todo lo suyo; false si n es <html> (o no está bajo un elemento): entonces todo
func _estilo_subarbol(n: Nodo, hojas: Hojas) -> Bool
    if n == nil or n.tipo != DOM_ELEMENTO or n.nombre == "html" or n.padre == nil or n.padre.tipo != DOM_ELEMENTO
        return false
    end
    # ya hecho (él o un antecesor)
    p = n
    while p != nil
        for o in _partes_hechas
            if o == p
                return true
            end
        end
        p = p.padre
    end
    _partes_hechas.push(n)
    _partes_cuantas = _partes_cuantas + 1
    _estilo_cadena(n.padre, 1)
    _estilo_nodo(n, hojas, n.padre.estilo, _estilo_vars_de(n.padre))
    _estilo_cadena(n.padre, -1)
    return true
end

func _estilo_vars_de(n: Nodo) -> {String: String}
    if n.vars == nil
        var sin: {String: String} = {}
        return sin
    end
    return n.vars
end

# El estilo de n solo, sin sus hijos; true si cambió (lo calculado o sus --x). <html> cuenta siempre como cambiado.
func _estilo_solo(n: Nodo, hojas: Hojas) -> Bool
    if n.padre == nil or n.padre.tipo != DOM_ELEMENTO
        return true
    end
    viejo = n.estilo
    viejas = n.vars
    _partes_cuantas = _partes_cuantas + 1
    _estilo_cadena(n.padre, 1)
    _estilo_propio(n, hojas, n.padre.estilo, _estilo_vars_de(n.padre))
    _estilo_cadena(n.padre, -1)
    if not _estilo_iguales(viejas, n.vars)
        return true
    end
    # lo que cambia y no llega a los de dentro (view-transition-name de React, transform y opacity de GSAP): solo él
    # (tarea 37e3; _estilo_propio ya lo apuntó en estilo_cambios)
    if _estilo_solo_suyo(viejo, n.estilo)
        return false
    end
    return not _estilo_iguales(viejo, n.estilo)
end

func _estilo_solo_suyo(a: {String: String}, b: {String: String}) -> Bool
    if a == nil or b == nil
        return false
    end
    for k in a.keys()
        if (not b.has(k) or b[k] != a[k]) and not _estilo_no_baja(k)
            return false
        end
    end
    for k in b.keys()
        if not a.has(k) and not _estilo_no_baja(k)
            return false
        end
    end
    return true
end

# Propiedades que no se heredan ni las mira nadie de dentro (salvo un "inherit" explícito, que no se usa con ellas)
func _estilo_no_baja(k: String) -> Bool
    return k == "view-transition-name" or k == "view-transition-class" or k == "transform" or k == "translate" or k == "scale" or k == "rotate" or k == "opacity" or k == "will-change" or str_starts(k, "transition") or k == "cursor" or k == "z-index"
end

func _estilo_iguales(a: {String: String}, b: {String: String}) -> Bool
    if a == nil or b == nil
        return a == nil and b == nil
    end
    if a.length != b.length
        return false
    end
    for k in a.keys()
        if not b.has(k) or b[k] != a[k]
            return false
        end
    end
    return true
end

# Debajo de n (ya en el filtro de antecesores con los suyos): los que tienen alguna de las claves, con todo lo suyo
func _estilo_invalidar(n: Nodo, hojas: Hojas, claves: {String: Int})
    _antepasados_cambiar(n, 1)
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO
            if _estilo_tiene_clave(h, claves)
                _partes_cuantas = _partes_cuantas + 1
                _estilo_nodo(h, hojas, n.estilo, _estilo_vars_de(n))
            else
                _estilo_invalidar(h, hojas, claves)
            end
        end
    end
    _antepasados_cambiar(n, -1)
end

func _estilo_tiene_clave(n: Nodo, claves: {String: Int}) -> Bool
    if claves.has(n.nombre)
        return true
    end
    id = dom_id(n)
    if id != "" and claves.has("#" + id)
        return true
    end
    for c in dom_clases(n)
        if claves.has("." + c)
            return true
        end
    end
    return false
end

# Las clases que están en una lista y no en la otra
func _estilo_clases_distintas(a: String, b: String) -> [String]
    var r: [String] = []
    la = _palabras(a)
    lb = _palabras(b)
    for c in la
        if not _estilo_en(lb, c)
            r.push(c)
        end
    end
    for c in lb
        if not _estilo_en(la, c)
            r.push(c)
        end
    end
    return r
end

func _estilo_en(l: [String], x: String) -> Bool
    for y in l
        if y == x
            return true
        end
    end
    return false
end

func _estilo_nodo(n: Nodo, hojas: Hojas, padre: {String: String}, padre_vars: {String: String})
    if n.tipo != DOM_ELEMENTO
        return
    end
    _estilo_propio(n, hojas, padre, padre_vars)
    _antepasados_cambiar(n, 1)
    for h in n.hijos
        _estilo_nodo(h, hojas, n.estilo, n.vars)
    end
    _antepasados_cambiar(n, -1)
end

# El estilo de n (y de sus ::before y ::after), sin sus hijos
func _estilo_propio(n: Nodo, hojas: Hojas, padre: {String: String}, padre_vars: {String: String})
    var cumplidas: [Entrada] = []
    _cumplidas(n, hojas.universales, cumplidas)
    if hojas.indice.has(n.nombre)
        _cumplidas(n, hojas.indice[n.nombre], cumplidas)
    end
    id = dom_id(n)
    if id != "" and hojas.indice.has("#" + id)
        _cumplidas(n, hojas.indice["#" + id], cumplidas)
    end
    for c in dom_clases(n)
        if hojas.indice.has("." + c)
            _cumplidas(n, hojas.indice["." + c], cumplidas)
        end
    end
    var ganadoras: {String: Candidata} = nil
    pistas = _pistas_html(n)
    if dom_tiene_atributo(n, "style") or pistas.length > 0
        var propias: {String: Candidata} = {}
        ganadoras = propias
        _declarar_todas(cumplidas, ganadoras)
        # los atributos de presentación (width, bgcolor, align...): de autor, pero por debajo de cualquier regla
        for d in pistas
            _declarar(ganadoras, d, true, -1, -1)
        end
        for d in css_declaraciones(dom_atributo(n, "style"))
            _declarar(ganadoras, d, true, 1500000000, 1000000)
        end
    else
        clave = ""
        for ce in cumplidas
            clave = clave + ce.num + ","
        end
        if _ganadoras_cache and _ganadoras_hechas.has(clave)
            ganadoras = _ganadoras_hechas[clave]
        else
            var nuevas: {String: Candidata} = {}
            ganadoras = nuevas
            _declarar_todas(cumplidas, ganadoras)
            if _ganadoras_cache
                _ganadoras_hechas[clave] = ganadoras
            end
        end
    end
    var debajo: [Declaracion] = nil
    if ganadoras.has("animation") or ganadoras.has("animation-name") or ganadoras.has("-webkit-animation")
        final = _animacion_final(ganadoras, hojas)
        if final.length > 0
            # sobre una copia: las ganadoras pueden estar compartidas con otros elementos (_ganadoras_hechas)
            var con: {String: Candidata} = {}
            for k in ganadoras.keys()
                con[k] = ganadoras[k]
            end
            # (lo que había debajo del estado final: el origen de una animación sin fotograma 0 %, tarea 37d4)
            var bajo: [Declaracion] = []
            for d in final
                if ganadoras.has(d.propiedad)
                    bajo.push(Declaracion(d.propiedad, ganadoras[d.propiedad].valor, false))
                end
                _declarar(con, Declaracion(d.propiedad, d.valor, false), true, 2000000000, 2000000)
            end
            debajo = bajo
            ganadoras = con
        end
    end
    e = _calcular(ganadoras, padre, padre_vars, "inline")
    if debajo != nil
        for d in debajo
            e["~" + d.propiedad] = d.valor
        end
    end
    vars = _calc_vars
    if _oculto_a_la_vista(e)
        e["display"] = "none"
    end
    viejo = n.estilo
    antes_a = n.pseudo_antes
    antes_d = n.pseudo_despues
    n.estilo = e
    n.vars = vars
    if n.nombre == "html" and e.has("font-size")
        estilo_rem = estilo_px(e["font-size"], 0, 0)       # 1rem: el font-size de <html>
    end
    n.pseudo_antes = _pseudo_nodo(n, _estilo_pseudo(n, hojas, e, vars, "before"), "::before")
    n.pseudo_despues = _pseudo_nodo(n, _estilo_pseudo(n, hojas, e, vars, "after"), "::after")
    if estilo_apuntar or estilo_marcar
        pseudo = not _pseudo_iguales(antes_a, n.pseudo_antes) or not _pseudo_iguales(antes_d, n.pseudo_despues)
        if pseudo or not _estilo_iguales(viejo, e)
            if estilo_apuntar
                estilo_cambios.push(EstiloCambio(n, viejo, pseudo))
            end
            if estilo_marcar
                dom_tocar(n)
            end
        end
    end
end

# Con estilo_apuntar (lib/documento.dash, tarea 37d), cada elemento cuyo estilo calculado cambió al rehacerlo,
# con el de antes (pseudo: cambió su ::before o ::after)
struct EstiloCambio
    nodo: Nodo
    viejo: {String: String}
    pseudo: Bool
end

var estilo_apuntar: Bool = false
# Con estilo_marcar, cada elemento cuyo estilo cambió se marca con dom_tocar (lo medido en la maqueta anterior ya no
# vale para él ni para los de fuera; tarea 37e6)
var estilo_marcar: Bool = false
var estilo_cambios: [EstiloCambio] = nil

func _pseudo_iguales(a: Nodo, b: Nodo) -> Bool
    if a == nil or b == nil
        return a == nil and b == nil
    end
    return a.texto == b.texto and _estilo_iguales(a.estilo, b.estilo)
end

# CSS Animations sin animar: lo que deja puesto la animación al acabar. Solo con animation-fill-mode forwards o
# both y un número finito de vueltas (si no, al acabar vuelve el estilo de siempre o no acaba nunca): las
# declaraciones de su último fotograma, o del primero si acaba al revés (reverse, alternate con vueltas pares,
# alternate-reverse con impares). Van por encima de todo lo que no es !important.
func _animacion_final(g: {String: Candidata}, hojas: Hojas) -> [Declaracion]
    var r: [Declaracion] = []
    if hojas.fotogramas == nil or hojas.fotogramas.length == 0
        return r
    end
    var nombres: [String] = []
    var rellenos: [String] = []
    var vueltas: [String] = []
    var sentidos: [String] = []
    atajo = ""
    if g.has("animation")
        atajo = g["animation"].valor
    elif g.has("-webkit-animation")
        atajo = g["-webkit-animation"].valor
    end
    if atajo != ""
        for item in css_partir(atajo, 44)
            nombre = ""
            relleno = "none"
            cuantas = "1"
            sentido = "normal"
            for t in _palabras(item)
                c = str_code(t, 0)
                if str_find(t, "(") >= 0
                    continue
                elif (c >= 48 and c <= 57) or c == 46
                    if not str_ends(t, "s")
                        cuantas = t
                    end
                elif t == "infinite"
                    cuantas = t
                elif t == "forwards" or t == "backwards" or t == "both" or t == "none"
                    relleno = t
                elif t == "normal" or t == "reverse" or t == "alternate" or t == "alternate-reverse"
                    sentido = t
                elif t == "ease" or t == "linear" or t == "ease-in" or t == "ease-out" or t == "ease-in-out" or t == "step-start" or t == "step-end" or t == "running" or t == "paused" or t == "initial" or t == "inherit"
                    continue
                elif nombre == "" and not str_starts(t, "-")
                    nombre = t
                elif nombre == "" and c == 45 and t.length > 1 and not ((str_code(t, 1) >= 48 and str_code(t, 1) <= 57) or str_code(t, 1) == 46)
                    nombre = t
                end
            end
            nombres.push(nombre)
            rellenos.push(relleno)
            vueltas.push(cuantas)
            sentidos.push(sentido)
        end
    end
    _animacion_lista(g, "animation-name", nombres)
    _animacion_lista(g, "animation-fill-mode", rellenos)
    _animacion_lista(g, "animation-iteration-count", vueltas)
    _animacion_lista(g, "animation-direction", sentidos)
    i = 0
    while i < nombres.length
        nombre = nombres[i]
        relleno = "none"
        if rellenos.length > 0
            relleno = rellenos[i % rellenos.length]
        end
        cuantas = "1"
        if vueltas.length > 0
            cuantas = vueltas[i % vueltas.length]
        end
        sentido = "normal"
        if sentidos.length > 0
            sentido = sentidos[i % sentidos.length]
        end
        if (relleno == "forwards" or relleno == "both") and cuantas != "infinite" and nombre != "" and nombre != "none"
            n = estilo_px(cuantas, 0, 0)
            al_reves = sentido == "reverse" or (sentido == "alternate" and n % 2 == 0) or (sentido == "alternate-reverse" and n % 2 == 1)
            clave = nombre
            if al_reves
                clave = nombre + " 0"
            end
            if hojas.fotogramas.has(clave)
                var fotograma: [Declaracion] = hojas.fotogramas[clave]
                for d in fotograma
                    r.push(d)
                end
            end
        end
        i = i + 1
    end
    return r
end

# Una propiedad animation-* suelta (lista con comas) sustituye a lo que dijo el atajo
func _animacion_lista(g: {String: Candidata}, p: String, lista: [String])
    v = ""
    if g.has(p)
        v = g[p].valor
    elif g.has("-webkit-" + p)
        v = g["-webkit-" + p].valor
    end
    if v == ""
        return
    end
    partes = css_partir(v, 44)
    i = 0
    while i < partes.length
        if i < lista.length
            lista[i] = str_trim(partes[i])
        else
            lista.push(str_trim(partes[i]))
        end
        i = i + 1
    end
end

# Lo heredado del padre y encima lo propio; var() resuelto; font-size en px. Las --x quedan en _calc_vars:
# las del padre (el mismo diccionario) o, si alguna cambia, una copia con los cambios.
func _calcular(ganadoras: {String: Candidata}, padre: {String: String}, padre_vars: {String: String}, display: String) -> {String: String}
    var e: {String: String} = {}
    for p in padre.keys()
        if _se_hereda(p)
            e[p] = padre[p]
        end
    end
    e["display"] = display
    vars = padre_vars
    propias = false
    # primero las --x (las demás pueden usarlas): todas tal cual y luego sus var(), que pueden nombrar otra del mismo
    # elemento en cualquier orden (--font-reloj: var(--font-doto) con las dos en <html>, tarea 37g)
    var con_var: [String] = []
    for p in ganadoras.keys()
        if str_starts(p, "--")
            v = ganadoras[p].valor
            if str_find(v, "var(") >= 0
                con_var.push(p)
            end
            if not vars.has(p) or vars[p] != v
                if not propias
                    var copia: {String: String} = {}
                    for k in vars.keys()
                        copia[k] = vars[k]
                    end
                    vars = copia
                    propias = true
                end
                vars[p] = v
            end
        end
    end
    for p in con_var
        r = _resolver_var(vars[p], vars, 0)
        if r != vars[p]
            if not propias
                var copia2: {String: String} = {}
                for k in vars.keys()
                    copia2[k] = vars[k]
                end
                vars = copia2
                propias = true
            end
            vars[p] = r
        end
    end
    # los atajos con var(): se sustituye y se parte; cada parte compite en la cascada con la propiedad suelta (el
    # padding: 0 de un * no le gana al padding-inline: var(...) de una clase)
    var de_atajo: {String: Candidata} = {}
    for p in ganadoras.keys()
        if _es_atajo(p)
            ca = ganadoras[p]
            var partes: {String: Candidata} = {}
            _declarar(partes, Declaracion(p, _resolver_var(ca.valor, vars, 0), false), true, 0, 0)
            for k in partes.keys()
                if k != "font-size" and (not de_atajo.has(k) or _gana(ca, de_atajo[k]))
                    e[k] = partes[k].valor
                    de_atajo[k] = ca
                end
            end
        end
    end
    for p in ganadoras.keys()
        v = ganadoras[p].valor
        if str_starts(p, "--") or _es_atajo(p)
            continue
        elif de_atajo.has(p) and not _gana(ganadoras[p], de_atajo[p])
            # (en la misma regla tienen el mismo orden: entonces gana la suelta, que suele ir detrás)
            continue
        elif str_lower(v) == "inherit"
            if padre.has(p)
                e[p] = padre[p]
            end
        elif p != "font-size"
            if str_find(v, "var(") >= 0
                v = _resolver_var(v, vars, 0)
            end
            e[p] = v
        end
    end
    if ganadoras.has("font-size")
        e["font-size"] = "" + estilo_tamano(_resolver_var(ganadoras["font-size"].valor, vars, 0), estilo_px(padre["font-size"], 0, 0)) + "px"
    end
    _calc_vars = vars
    return e
end

# var(--nombre, respaldo): el valor de la propiedad personalizada, o el respaldo (también anidado)
# Los var(--x) de v con las variables que le llegan a n (un atributo de SVG: fill="var(--color-lima)")
func estilo_resolver_var(v: String, n: Nodo) -> String
    if n.vars == nil or str_find(v, "var(") < 0
        return v
    end
    return _resolver_var(v, n.vars, 0)
end

func _resolver_var(v: String, e: {String: String}, nivel: Int) -> String
    p = str_find(v, "var(")
    if p < 0 or nivel > 8
        return v
    end
    # el paréntesis que cierra este var(
    hondo = 0
    i = p + 4
    fin = -1
    coma = -1
    while i < v.length and fin < 0
        c = str_code(v, i)
        if c == 40
            hondo = hondo + 1
        elif c == 41
            if hondo == 0
                fin = i
            else
                hondo = hondo - 1
            end
        elif c == 44 and hondo == 0 and coma < 0
            coma = i
        end
        i = i + 1
    end
    if fin < 0
        return v
    end
    nombre = ""
    respaldo = ""
    if coma > 0
        nombre = str_trim(v[p + 4:coma])
        respaldo = str_trim(v[coma + 1:fin])
    else
        nombre = str_trim(v[p + 4:fin])
    end
    valor = respaldo
    if e.has(nombre)
        valor = e[nombre]
    end
    return _resolver_var(v[:p] + valor + v[fin + 1:], e, nivel + 1)
end

# El estilo de n::before o n::after si alguna regla le da un content que se pinta; nil si no
func _estilo_pseudo(n: Nodo, hojas: Hojas, e: {String: String}, vars: {String: String}, cual: String) -> {String: String}
    var nada: {String: String} = nil
    if hojas.indice_pe == nil or hojas.indice_pe.length == 0
        return nada
    end
    # solo si alguna de las reglas que podrían aplicarse da un content (Tailwind pone ::before y ::after
    # con sus --tw en todos los elementos, sin content)
    _con_pseudo_elemento = true
    algo = _con_content(n, hojas.indice_pe, cual + " ")
    if not algo
        algo = _con_content(n, hojas.indice_pe, cual + " " + n.nombre)
    end
    if not algo and dom_id(n) != ""
        algo = _con_content(n, hojas.indice_pe, cual + " #" + dom_id(n))
    end
    if not algo
        for c in dom_clases(n)
            if _con_content(n, hojas.indice_pe, cual + " ." + c)
                algo = true
                break
            end
        end
    end
    _con_pseudo_elemento = false
    if not algo
        return nada
    end
    var ganadoras: {String: Candidata} = {}
    _con_pseudo_elemento = true
    if hojas.indice_pe.has(cual + " ")
        _probar(n, hojas.indice_pe[cual + " "], ganadoras)
    end
    if hojas.indice_pe.has(cual + " " + n.nombre)
        _probar(n, hojas.indice_pe[cual + " " + n.nombre], ganadoras)
    end
    if dom_id(n) != "" and hojas.indice_pe.has(cual + " #" + dom_id(n))
        _probar(n, hojas.indice_pe[cual + " #" + dom_id(n)], ganadoras)
    end
    for c in dom_clases(n)
        if hojas.indice_pe.has(cual + " ." + c)
            _probar(n, hojas.indice_pe[cual + " ." + c], ganadoras)
        end
    end
    _con_pseudo_elemento = false
    if not ganadoras.has("content")
        return nada
    end
    pe = _calcular(ganadoras, e, vars, "inline")
    c = str_trim(pe["content"])
    if c == "none" or c == "normal" or pe["display"] == "none"
        return nada
    end
    # un content vacío solo cuenta si es una caja que se ve (los iconos dibujados con CSS)
    if (c == "\"\"" or c == "''") and not (pe.has("width") or pe.has("height") or pe.has("background-color") or pe.has("border-top-style"))
        return nada
    end
    return pe
end

# ¿Cumple n alguna de las entradas de esa clave que son de una regla que declara content?
func _con_content(n: Nodo, indice: {String: [Entrada]}, clave: String) -> Bool
    if not indice.has(clave)
        return false
    end
    for e in indice[clave]
        r = e.regla
        if r.con_content < 0
            r.con_content = 0
            for d in r.declaraciones
                if d.propiedad == "content"
                    r.con_content = 1
                end
            end
        end
        if r.con_content == 1 and (e.antes == nil or _antepasados_tienen(e.antes)) and estilo_cumple(n, e.sel)
            return true
        end
    end
    return false
end

# El nodo de un ::before o ::after con ese estilo (nil si no hay): sus hijos, lo que dice el content
func _pseudo_nodo(n: Nodo, pe: {String: String}, nombre: String) -> Nodo
    var nada: Nodo = nil
    if pe == nil
        return nada
    end
    p = dom_nodo(DOM_ELEMENTO, nombre, "")
    p.estilo = pe
    p.padre = n
    familia = ""
    if pe.has("font-family")
        familia = str_lower(pe["font-family"])
    end
    for trozo in _contenido_trozos(n, pe["content"])
        if trozo.length > 0 and str_code(trozo, 0) == 1
            # un icono: "\x01" y el código en hexadecimal
            i = dom_nodo(DOM_ELEMENTO, "::icono", "")
            i.estilo = pe
            i.atributos.push(Atributo("codigo", trozo[1:]))
            dom_agregar(p, i)
        elif trozo != ""
            dom_agregar(p, dom_nodo(DOM_TEXTO, "", trozo))
        end
    end
    return p
end

# Los trozos de un content: textos entre comillas (con \hex), attr(nombre); los caracteres de la zona
# privada de Unicode (Font Awesome y otras fuentes de iconos) van como "\x01" + código hexadecimal
func _contenido_trozos(n: Nodo, c: String) -> [String]
    var r: [String] = []
    i = 0
    k = c.length
    while i < k
        ch = str_code(c, i)
        if ch == 34 or ch == 39
            fin_comilla = ch
            i = i + 1
            texto = ""
            while i < k and str_code(c, i) != fin_comilla
                if str_code(c, i) == 92 and i + 1 < k
                    # \hex (hasta 6 cifras y un blanco) o \carácter
                    j = i + 1
                    hex = ""
                    while j < k and hex.length < 6 and _es_hex(str_code(c, j))
                        hex = hex + c[j:j + 1]
                        j = j + 1
                    end
                    if hex == ""
                        texto = texto + c[i + 1:i + 2]
                        i = i + 2
                    else
                        if j < k and str_code(c, j) == 32
                            j = j + 1
                        end
                        codigo = str_to_int(hex, 16)
                        if codigo >= 57344 and codigo <= 63743
                            if texto != ""
                                r.push(texto)
                                texto = ""
                            end
                            r.push(str_char(1) + hex)
                        else
                            texto = texto + _latin1_de(codigo)
                        end
                        i = j
                    end
                else
                    texto = texto + c[i:i + 1]
                    i = i + 1
                end
            end
            if texto != ""
                r.push(texto)
            end
            i = i + 1
        elif str_starts(str_lower(c[i:]), "attr(")
            fin = str_find_from(c, ")", i)
            if fin < 0
                return r
            end
            r.push(dom_atributo(n, str_lower(str_trim(c[i + 5:fin]))))
            i = fin + 1
        else
            i = i + 1
        end
    end
    return r
end

func _es_hex(c: Int) -> Bool
    return (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
end

# Un código de Unicode en Latin-1 (lo que no cabe, lo más parecido)
func _latin1_de(c: Int) -> String
    if c < 256
        return str_char(c)
    elif c == 8211 or c == 8212
        return "-"
    elif c == 8216 or c == 8217
        return "'"
    elif c == 8220 or c == 8221
        return "\""
    elif c == 8226
        return str_char(183)
    elif c == 8230
        return "..."
    elif c == 8594 or c == 8250
        return ">"
    elif c == 8592 or c == 8249
        return "<"
    end
    return ""
end

# El texto solo para lectores de pantalla ("Saltar al contenido", .screen-reader-text): fuera del
# flujo y recortado a nada. Sin position ni clip saldría en medio de la página.
func _oculto_a_la_vista(e: {String: String}) -> Bool
    if not e.has("position") or str_lower(e["position"]) != "absolute"
        return false
    end
    if e.has("clip") and str_starts(str_lower(e["clip"]), "rect(")
        return true
    end
    if e.has("clip-path") and str_starts(str_lower(e["clip-path"]), "inset(")
        return true
    end
    return _px_diminuto(e, "width") and _px_diminuto(e, "height")
end

# 0px o 1px dichos así (auto o un tanto por ciento no cuentan)
func _px_diminuto(e: {String: String}, p: String) -> Bool
    if not e.has(p)
        return false
    end
    v = str_lower(str_trim(e[p]))
    return v == "0" or v == "0px" or v == "1px"
end

# font-size en píxeles, según el del padre
func estilo_tamano(v: String, padre: Int) -> Int
    x = str_lower(str_trim(v))
    if x == "xx-small"
        return ESTILO_MEDIUM * 3 / 5
    elif x == "x-small"
        return ESTILO_MEDIUM * 3 / 4
    elif x == "small"
        return ESTILO_MEDIUM * 8 / 9
    elif x == "medium"
        return ESTILO_MEDIUM
    elif x == "large"
        return ESTILO_MEDIUM * 6 / 5
    elif x == "x-large"
        return ESTILO_MEDIUM * 3 / 2
    elif x == "xx-large"
        return ESTILO_MEDIUM * 2
    elif x == "smaller"
        return padre * 5 / 6
    elif x == "larger"
        return padre * 6 / 5
    end
    return estilo_px(x, padre, padre)
end

# Una longitud CSS en píxeles: px, pt, em (respecto a em_px), % (respecto a cien), sin unidad = px.
# Decimales con hasta dos cifras ("1.5em"). Lo que no se entiende vale 0.
func _minuscula(c: Int) -> Int
    if c >= 65 and c <= 90
        return c + 32
    end
    return c
end

func estilo_px(v: String, em_px: Int, cien: Int) -> Int
    # sin crear textos (se llama decenas de miles de veces al maquetar): se mira el valor en su sitio
    n = v.length
    i = 0
    while i < n and str_code(v, i) == 32
        i = i + 1
    end
    while n > i and str_code(v, n - 1) == 32
        n = n - 1
    end
    # calc(), min(), max(), clamp() (empiezan por letra; lo demás que empieza por letra, como auto, vale 0)
    if i < n and (str_code(v, i) == 99 or str_code(v, i) == 109 or str_code(v, i) == 67 or str_code(v, i) == 77)
        l = Calc(v[i:n], 0, em_px, cien)
        return _calc_suma(l).v / 100
    end
    signo = 1
    if i < n and str_code(v, i) == 45
        signo = -1
        i = i + 1
    end
    entero = 0
    while i < n and str_code(v, i) >= 48 and str_code(v, i) <= 57
        entero = entero * 10 + str_code(v, i) - 48
        i = i + 1
    end
    centesimas = 0
    if i < n and str_code(v, i) == 46
        i = i + 1
        cifras = 0
        while i < n and str_code(v, i) >= 48 and str_code(v, i) <= 57
            if cifras < 2
                centesimas = centesimas * 10 + str_code(v, i) - 48
                cifras = cifras + 1
            end
            i = i + 1
        end
        if cifras == 1
            centesimas = centesimas * 10
        end
    end
    valor = entero * 100 + centesimas
    r = valor / 100
    k = n - i
    if k > 0
        # la unidad, en minúsculas
        a = _minuscula(str_code(v, i))
        b = 0
        if k >= 2
            b = _minuscula(str_code(v, i + 1))
        end
        if k == 2 and a == 112 and b == 120
            r = valor / 100
        elif k == 2 and a == 101 and b == 109
            r = valor * em_px / 100
        elif k == 3 and a == 114 and b == 101 and _minuscula(str_code(v, i + 2)) == 109
            r = valor * estilo_rem / 100
        elif k == 2 and a == 118 and b == 119
            r = valor * estilo_vw / 10000
        elif k == 2 and a == 118 and b == 104
            r = valor * estilo_vh / 10000
        elif k == 3 and (a == 115 or a == 108 or a == 100) and b == 118 and _minuscula(str_code(v, i + 2)) == 104
            # svh, lvh, dvh: como vh (en una ventana del Amiga no hay barras que aparezcan y se escondan)
            r = valor * estilo_vh / 10000
        elif k == 3 and (a == 115 or a == 108 or a == 100) and b == 118 and _minuscula(str_code(v, i + 2)) == 119
            r = valor * estilo_vw / 10000
        elif k == 4 and a == 118 and b == 109
            menor = estilo_vw
            if estilo_vh < menor
                menor = estilo_vh
            end
            if _minuscula(str_code(v, i + 2)) == 97
                menor = estilo_vw + estilo_vh - menor
            end
            r = valor * menor / 10000
        elif k == 2 and a == 99 and b == 104
            r = valor * em_px / 200
        elif k == 2 and a == 101 and b == 120
            r = valor * em_px / 200
        elif k == 1 and a == 37
            r = valor * cien / 10000
        elif k == 2 and a == 112 and b == 116
            r = valor * 4 / 300
        elif k == 2 and a == 112 and b == 99
            r = valor * 16 / 100
        elif k == 2 and a == 105 and b == 110
            r = valor * 96 / 100
        elif k == 2 and a == 99 and b == 109
            r = valor * 3780 / 10000
        elif k == 2 and a == 109 and b == 109
            r = valor * 378 / 10000
        else
            r = 0
        end
    end
    return signo * r
end

# === calc(), min(), max(), clamp() (CSS Values 4) ===
# En centésimas de píxel. Una longitud (px, em, rem, %, vw...) pasa a px; un número sin unidad multiplica o
# divide. El tanto por ciento es de cien (lo mismo que en estilo_px).

# Lo que mide el sitio donde se ve la página (vw, vh: lo pone la maqueta) y 1rem (el font-size de <html>)
var estilo_vw: Int = 940
var estilo_vh: Int = 614
var estilo_rem: Int = ESTILO_MEDIUM

struct Calc
    expr: String
    i: Int
    em: Int
    cien: Int
end

struct CalcValor
    v: Int              # px x 100, o el número x 100 si no tiene unidad
    unidad: Bool
end

func _calc_blancos(l: Calc)
    while l.i < l.expr.length and (str_code(l.expr, l.i) == 32 or str_code(l.expr, l.i) == 9 or str_code(l.expr, l.i) == 10)
        l.i = l.i + 1
    end
end

func _calc_suma(l: Calc) -> CalcValor
    a = _calc_producto(l)
    while true
        _calc_blancos(l)
        if l.i >= l.expr.length
            break
        end
        c = str_code(l.expr, l.i)
        if c != 43 and c != 45
            break
        end
        l.i = l.i + 1
        b = _calc_producto(l)
        if c == 43
            a.v = a.v + b.v
        else
            a.v = a.v - b.v
        end
        a.unidad = a.unidad or b.unidad
    end
    return a
end

func _calc_producto(l: Calc) -> CalcValor
    a = _calc_factor(l)
    while true
        _calc_blancos(l)
        if l.i >= l.expr.length
            break
        end
        c = str_code(l.expr, l.i)
        if c != 42 and c != 47
            break
        end
        l.i = l.i + 1
        b = _calc_factor(l)
        if c == 42
            # uno de los dos es un número
            a = CalcValor(a.v * b.v / 100, a.unidad or b.unidad)
        elif b.v != 0
            a = CalcValor(a.v * 100 / b.v, a.unidad)
        end
    end
    return a
end

func _calc_factor(l: Calc) -> CalcValor
    _calc_blancos(l)
    if l.i >= l.expr.length
        return CalcValor(0, false)
    end
    c = str_code(l.expr, l.i)
    if c == 40
        l.i = l.i + 1
        r = _calc_suma(l)
        _calc_cerrar(l)
        return r
    end
    if (c >= 97 and c <= 122) or (c >= 65 and c <= 90)
        # una función: calc( min( max( clamp( (otra cosa: 0)
        p = str_find_from(l.expr, "(", l.i)
        if p < 0
            l.i = l.expr.length
            return CalcValor(0, false)
        end
        nombre = str_lower(l.expr[l.i:p])
        l.i = p + 1
        var args: [CalcValor] = []
        while true
            args.push(_calc_suma(l))
            _calc_blancos(l)
            if l.i < l.expr.length and str_code(l.expr, l.i) == 44
                l.i = l.i + 1
            else
                break
            end
        end
        _calc_cerrar(l)
        r = args[0]
        if nombre == "min" or nombre == "-webkit-min"
            for a in args
                if a.v < r.v
                    r = a
                end
            end
        elif nombre == "max"
            for a in args
                if a.v > r.v
                    r = a
                end
            end
        elif nombre == "clamp" and args.length == 3
            r = args[1]
            if r.v > args[2].v
                r = args[2]
            end
            if r.v < args[0].v
                r = args[0]
            end
        end
        return r
    end
    # un número con su unidad
    ini = l.i
    if c == 43 or c == 45
        l.i = l.i + 1
    end
    while l.i < l.expr.length
        d = str_code(l.expr, l.i)
        if not ((d >= 48 and d <= 57) or d == 46 or (d >= 97 and d <= 122) or (d >= 65 and d <= 90) or d == 37)
            break
        end
        l.i = l.i + 1
    end
    t = l.expr[ini:l.i]
    u = str_lower(t)
    con_unidad = str_ends(u, "%") or str_ends(u, "px") or str_ends(u, "em") or str_ends(u, "rem") or str_ends(u, "vw") or str_ends(u, "vh") or str_ends(u, "vmin") or str_ends(u, "vmax") or str_ends(u, "ch") or str_ends(u, "ex") or str_ends(u, "pt") or str_ends(u, "pc") or str_ends(u, "in") or str_ends(u, "cm") or str_ends(u, "mm")
    if con_unidad
        # en centésimas: la misma conversión que fuera de calc, con el valor x 100
        return CalcValor(estilo_px(_calc_por_cien(t), l.em, l.cien), true)
    end
    return CalcValor(estilo_px(_calc_por_cien(t), 0, 0), false)
end

func _calc_cerrar(l: Calc)
    _calc_blancos(l)
    if l.i < l.expr.length and str_code(l.expr, l.i) == 41
        l.i = l.i + 1
    end
end

# "1.5rem" -> "150rem" (para que estilo_px dé centésimas)
func _calc_por_cien(t: String) -> String
    i = 0
    if i < t.length and (str_code(t, i) == 45 or str_code(t, i) == 43)
        i = i + 1
    end
    entero = ""
    while i < t.length and str_code(t, i) >= 48 and str_code(t, i) <= 57
        entero = entero + t[i]
        i = i + 1
    end
    frac = ""
    if i < t.length and str_code(t, i) == 46
        i = i + 1
        while i < t.length and str_code(t, i) >= 48 and str_code(t, i) <= 57
            if frac.length < 2
                frac = frac + t[i]
            end
            i = i + 1
        end
    end
    while frac.length < 2
        frac = frac + "0"
    end
    signo = ""
    if t.length > 0 and str_code(t, 0) == 45
        signo = "-"
    end
    if entero == ""
        entero = "0"
    end
    return signo + entero + frac + t[i:]
end

# === Atributos de presentación de HTML (HTML, "Rendering": las pistas de presentación) ===

# "100" -> "100px"; "50%" se queda; otra cosa: ""
func _html_largo(v: String) -> String
    x = str_trim(v)
    if x == ""
        return ""
    end
    c = str_code(x, 0)
    if not (c >= 48 and c <= 57)
        return ""
    end
    if str_ends(x, "%")
        return x
    end
    i = 0
    while i < x.length and str_code(x, i) >= 48 and str_code(x, i) <= 57
        i = i + 1
    end
    return x[:i] + "px"
end

func _pista(r: [Declaracion], p: String, v: String)
    if v != ""
        r.push(Declaracion(p, v, false))
    end
end

# La tabla de una celda o fila (para cellpadding y border)
func _tabla_de(n: Nodo) -> Nodo
    p = n.padre
    while p != nil
        if p.tipo == DOM_ELEMENTO and p.nombre == "table"
            return p
        end
        p = p.padre
    end
    var nada: Nodo = nil
    return nada
end

func _pistas_html(n: Nodo) -> [Declaracion]
    var r: [Declaracion] = []
    if n.atributos.length == 0 and n.nombre != "td" and n.nombre != "th"
        return r
    end
    nombre = n.nombre
    if nombre == "table" or nombre == "td" or nombre == "th" or nombre == "col" or nombre == "colgroup" or nombre == "hr" or nombre == "iframe" or nombre == "embed" or nombre == "object" or nombre == "canvas"
        _pista(r, "width", _html_largo(dom_atributo(n, "width")))
    end
    if nombre == "table" or nombre == "td" or nombre == "th" or nombre == "tr" or nombre == "iframe" or nombre == "embed" or nombre == "object" or nombre == "canvas"
        _pista(r, "height", _html_largo(dom_atributo(n, "height")))
    end
    if nombre == "body" or nombre == "table" or nombre == "tr" or nombre == "td" or nombre == "th" or nombre == "thead" or nombre == "tbody" or nombre == "tfoot"
        _pista(r, "background-color", str_trim(dom_atributo(n, "bgcolor")))
        if dom_atributo(n, "background") != ""
            _pista(r, "background-image", "url(" + dom_atributo(n, "background") + ")")
        end
    end
    if nombre == "body"
        _pista(r, "color", str_trim(dom_atributo(n, "text")))
    end
    al = str_lower(str_trim(dom_atributo(n, "align")))
    if al != ""
        if nombre == "table"
            if al == "center"
                _pista(r, "margin-left", "auto")
                _pista(r, "margin-right", "auto")
            elif al == "left" or al == "right"
                _pista(r, "float", al)
            end
        elif nombre == "img" or nombre == "iframe" or nombre == "object" or nombre == "embed"
            if al == "left" or al == "right"
                _pista(r, "float", al)
            end
        elif al == "left" or al == "right" or al == "center" or al == "justify"
            _pista(r, "text-align", al)
        end
    end
    va = str_lower(str_trim(dom_atributo(n, "valign")))
    if va != ""
        _pista(r, "vertical-align", va)
    end
    if nombre == "table"
        b = dom_atributo(n, "border")
        if dom_tiene_atributo(n, "border")
            px = _html_largo(b)
            if b == ""
                px = "1px"
            end
            if px != "0px" and px != ""
                _pista(r, "border-top-width", px)
                _pista(r, "border-right-width", px)
                _pista(r, "border-bottom-width", px)
                _pista(r, "border-left-width", px)
                for lado in ["top", "right", "bottom", "left"]
                    _pista(r, "border-" + lado + "-style", "outset")
                    _pista(r, "border-" + lado + "-color", "gray")
                end
            end
        end
        _pista(r, "border-spacing", _html_largo(dom_atributo(n, "cellspacing")))
    end
    if nombre == "td" or nombre == "th"
        tabla = _tabla_de(n)
        if tabla != nil
            cp = _html_largo(dom_atributo(tabla, "cellpadding"))
            if cp != ""
                for lado in ["top", "right", "bottom", "left"]
                    _pista(r, "padding-" + lado, cp)
                end
            end
            if dom_tiene_atributo(tabla, "border") and dom_atributo(tabla, "border") != "0"
                for lado in ["top", "right", "bottom", "left"]
                    _pista(r, "border-" + lado + "-width", "1px")
                    _pista(r, "border-" + lado + "-style", "inset")
                    _pista(r, "border-" + lado + "-color", "gray")
                end
            end
        end
        if dom_tiene_atributo(n, "nowrap")
            _pista(r, "white-space", "nowrap")
        end
    end
    if nombre == "font"
        _pista(r, "color", str_trim(dom_atributo(n, "color")))
        _pista(r, "font-family", str_trim(dom_atributo(n, "face")))
        tam = str_trim(dom_atributo(n, "size"))
        if tam != ""
            # 1..7 (o +n/-n desde 3): xx-small .. xxx-large
            k = 3
            if str_starts(tam, "+")
                k = 3 + Int(tam[1:])
            elif str_starts(tam, "-")
                k = 3 - Int(tam[1:])
            else
                k = Int(tam)
            end
            tamanos = ["x-small", "x-small", "small", "medium", "large", "x-large", "xx-large", "xx-large"]
            if k < 1
                k = 1
            end
            if k > 7
                k = 7
            end
            _pista(r, "font-size", tamanos[k])
        end
    end
    return r
end

# === Tamaño de un <svg> dentro de la página (lib/imagenes.dash y lib/maqueta.dash) ===

# El tamaño con que se ve un <svg>: CSS (px), sus atributos o, si no, el de los navegadores (300x150; con viewBox,
# el alto en proporción)
func svg_ancho(n: Nodo) -> Int
    e = n.estilo
    if e.has("width") and e["width"] != "auto" and not str_ends(e["width"], "%")
        w = estilo_px(e["width"], estilo_px(_svg_val(e, "font-size", "16px"), 0, 0), 0)
        if w > 0
            return w
        end
    end
    w = Int(dom_atributo(n, "width"))
    if w > 0 and not str_ends(dom_atributo(n, "width"), "%")
        return w
    end
    return 300
end

func svg_alto(n: Nodo) -> Int
    e = n.estilo
    if e.has("height") and e["height"] != "auto" and not str_ends(e["height"], "%")
        h = estilo_px(e["height"], estilo_px(_svg_val(e, "font-size", "16px"), 0, 0), 0)
        if h > 0
            return h
        end
    end
    h = Int(dom_atributo(n, "height"))
    if h > 0 and not str_ends(dom_atributo(n, "height"), "%")
        return h
    end
    # con viewBox: en proporción al ancho
    vb = css_partir(str_trim(str_replace(svg_viewbox(n), ",", " ")), 32)
    if vb.length == 4 and Int(vb[2]) > 0
        return svg_ancho(n) * Int(vb[3]) / Int(vb[2])
    end
    return 150
end

func _svg_val(e: {String: String}, p: String, d: String) -> String
    if e.has(p)
        return e[p]
    end
    return d
end

func svg_viewbox(n: Nodo) -> String
    return dom_atributo(n, "viewbox")
end

