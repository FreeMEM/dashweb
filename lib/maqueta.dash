# Maquetación: del árbol con estilo (lib/estilo.dash) a una lista de dibujo con posiciones.
#
#   p = maquetar(doc, 600)          # ancho disponible en píxeles
#   for d in p.dibujos              # D_RECT, D_TEXTO, D_LINEA, D_IMAGEN
#       ...
#   end
#   Print p.alto                    # alto total de la página
#
# Mide el texto con las fuentes del Amiga (font_ de Dash), así que necesita un RastPort
# (una ventana abierta, o la zona de dibujo de MUI). Flujo normal: cajas de bloque (márgenes
# que se funden entre hermanos, bordes, relleno, width/height, fondos) y líneas de texto
# (cortes, espacios colapsados o pre, text-align); listas con su marca; tablas sencillas
# (celdas del mismo ancho); imágenes como un hueco de su tamaño; float en filas (el texto aún no los
# rodea). position, más adelante.

import "estilo.dash"
import "colores.dash"

const D_RECT = 1
const D_TEXTO = 2
const D_LINEA = 3
const D_IMAGEN = 4
const D_CONTROL = 5      # un control de formulario (input, select, button): lo pinta el pintor según su nodo
const D_ICONO = 7        # un icono de una fuente de iconos (Font Awesome): texto, su código en hexadecimal
const D_FONDO = 6        # la imagen de fondo de una caja (texto: su dirección); background-size, -position y
                         # -repeat los mira el pintor en el estilo del nodo
const D_ELIPSE = 8       # una caja redonda (border-radius: 50 %): estilo, el grosor del borde (0: rellena)
const D_DEGRADADO = 10   # un linear-gradient de fondo: color/estilo, el primer color y su alfa (0-255);
                         # fuente/espaciado, el último; texto "v" (de arriba abajo) o "h" (de izquierda a derecha)
const D_REDONDO = 12     # una caja con las esquinas redondeadas (border-radius): radio, los cuatro radios (1 byte
                         # cada uno: arriba-izq, arriba-der, abajo-der, abajo-izq); estilo, el grosor del borde
                         # (0: rellena); espaciado > 0: con esa opacidad
const D_VIDEO = 11       # un vídeo (<video>): texto, su dirección; nodo, el elemento (lib/videos.dash lo pinta)
const D_TRAZO = 9        # una barra girada 45 grados (transform: rotate): estilo 0 de arriba a la izquierda
                         # abajo a la derecha, 1 de abajo a la izquierda arriba a la derecha; fuente, su grosor

const EST_SUBRAYADO = 1
const EST_NEGRITA = 2
const EST_CURSIVA = 4

struct Dibujo
    tipo: Int
    x: Int
    y: Int
    ancho: Int
    alto: Int
    color: Int
    texto: String
    fuente: Int
    estilo: Int
    enlace: String
    nodo: Nodo = nil     # el elemento que lo puso (para saber qué hay bajo un clic)
    espaciado: Int = 0   # letter-spacing: px de más detrás de cada letra (el pintor las pone una a una)
    radio: Int = 0       # D_REDONDO: los cuatro radios
    capa: Int = 0        # z-index del contexto de apilado donde está (se pintan de menor a mayor)
    recorte: Bool = false   # overflow: solo se pinta lo que cae en rx0..rx1, ry0..ry1 (coordenadas de página)
    rx0: Int = 0
    ry0: Int = 0
    rx1: Int = 0
    ry1: Int = 0
end

struct Pagina
    dibujos: [Dibujo]
    ancho: Int
    alto: Int
    fondo: Int
end

# Un trozo de una línea: una palabra (o una imagen, o un salto de línea forzado)
struct Pieza
    texto: String
    ancho: Int
    alto: Int
    base: Int
    fuente: Int
    estilo: Int
    color: Int
    tachado: Bool
    enlace: String
    espacio: Int
    salto: Bool
    imagen: Bool
    pegada: Bool = false     # sin blanco con la anterior: no se puede cortar la línea entre las dos
    nodo: Nodo = nil         # el elemento de la palabra o la imagen
    control: Bool = false    # un control de formulario (nodo: el input, select o button)
    espaciado: Int = 0       # letter-spacing en px
    icono: Bool = false      # un icono (texto: su código en hexadecimal)
    caja: Nodo = nil         # un inline-block maquetado como bloque en su sitio de la línea (ancho: con márgenes)
    video: Bool = false      # un <video> (texto: su dirección)
end

# Los hijos de n con su ::before delante y su ::after detrás (lib/estilo.dash)
func _hijos(n: Nodo) -> [Nodo]
    if n.pseudo_antes == nil and n.pseudo_despues == nil
        return n.hijos
    end
    var r: [Nodo] = []
    if n.pseudo_antes != nil
        r.push(n.pseudo_antes)
    end
    for h in n.hijos
        r.push(h)
    end
    if n.pseudo_despues != nil
        r.push(n.pseudo_despues)
    end
    return r
end

struct Maquetador
    pagina: Pagina
    fuentes: {String: Int}
    topaz: Int
    blanco: Int = 0      # un blanco detrás de una imagen: el ancho del espacio que toma la pieza siguiente
    ancho_linea: Int = 0 # el ancho de las líneas del bloque que se está maquetando
end

# Para depurar (tools/traza_maqueta.dash): cuántos niveles de cajas se escriben al maquetar (0: ninguno)
var maqueta_traza: Int = 0
var _maqueta_nivel: Int = 0

func _trazar(n: Nodo, x: Int, y: Int, ancho: Int, alto: Int, que: String)
    if _maqueta_nivel > maqueta_traza
        return
    end
    sangria = ""
    for i in (1.._maqueta_nivel)
        sangria = sangria + "  "
    end
    nombre = n.nombre
    if dom_atributo(n, "id") != ""
        nombre = nombre + "#" + dom_atributo(n, "id")
    end
    if dom_atributo(n, "class") != ""
        nombre = nombre + "." + str_replace(str_trim(dom_atributo(n, "class")), " ", ".")
    end
    Print sangria + nombre + " " + que + " [" + x + "," + y + " " + ancho + "x" + alto + "] " + n.estilo["display"]
end

func _dibujo(tipo: Int, x: Int, y: Int, ancho: Int, alto: Int, color: Int) -> Dibujo
    return Dibujo(tipo, x, y, ancho, alto, color, "", 0, 0, "")
end

# === Fuentes ===

# Fuente del Amiga para una familia CSS y un tamaño: la de mapa de bits si tiene ese tamaño (nítida),
# si no la vectorial parecida (CGTriumvirate, CGTimes, LetterGothic: bullet.library las dibuja a
# cualquier tamaño) y, si no hay, la de mapa de bits más cercana; la topaz de la ROM si no hay otra
func _fuente(m: Maquetador, familia: String, tam: Int) -> Int
    # primero por el font-family tal cual (suele ser una lista larga: mirarla entera cuesta)
    cruda = familia + "|" + tam
    if m.fuentes.has(cruda)
        return m.fuentes[cruda]
    end
    h = _fuente_de(m, familia, tam)
    m.fuentes[cruda] = h
    return h
end

func _fuente_de(m: Maquetador, familia: String, tam: Int) -> Int
    f = str_lower(familia)
    nombre = "helvetica"
    vectorial = "CGTriumvirate"
    if str_find(f, "mono") >= 0 or str_find(f, "courier") >= 0 or str_find(f, "consol") >= 0
        nombre = "courier"
        vectorial = "LetterGothic"
    elif (str_find(f, "serif") >= 0 and str_find(f, "sans") < 0) or str_find(f, "times") >= 0 or str_find(f, "georgia") >= 0
        nombre = "times"
        vectorial = "CGTimes"
    end
    clave = nombre + "/" + tam
    if m.fuentes.has(clave)
        return m.fuentes[clave]
    end
    h = 0
    if not _tamano_de_mapa(nombre, tam)
        # el tamaño de una vectorial del Amiga es el alto de la línea entera: las letras salen más bajas
        # que con el mismo font-size en un navegador (medido con freemem.space contra Chrome)
        h = font_open(vectorial + ".font", tam * 6 / 5)
    end
    if h == 0
        h = font_open(nombre + ".font", tam)
    end
    if h == 0
        h = m.topaz
    end
    m.fuentes[clave] = h
    return h
end

# Los tamaños que traen las fuentes de mapa de bits del Workbench
func _tamano_de_mapa(nombre: String, tam: Int) -> Bool
    if tam == 11 or tam == 13 or tam == 15 or tam == 18 or tam == 24
        return true
    end
    return nombre == "helvetica" and tam == 9
end

func _estilo_texto(e: {String: String}) -> Int
    r = 0
    w = e["font-weight"]
    if w == "bold" or w == "bolder" or w == "700" or w == "800" or w == "900" or w == "600"
        r = r + EST_NEGRITA
    end
    if e["font-style"] == "italic" or e["font-style"] == "oblique"
        r = r + EST_CURSIVA
    end
    return r
end

func _px(e: {String: String}, prop: String, cien: Int) -> Int
    if not e.has(prop)
        return 0
    end
    return estilo_px(e[prop], estilo_px(e["font-size"], 0, 0), cien)
end

func _borde(e: {String: String}, lado: String) -> Int
    tipo = "none"
    if e.has("border-" + lado + "-style")
        tipo = e["border-" + lado + "-style"]
    end
    if tipo == "none" or tipo == "hidden"
        return 0
    end
    a = "medium"
    if e.has("border-" + lado + "-width")
        a = e["border-" + lado + "-width"]
    end
    if a == "thin"
        return 1
    elif a == "medium"
        return 3
    elif a == "thick"
        return 5
    end
    return estilo_px(a, estilo_px(e["font-size"], 0, 0), 0)
end

func _es_bloque(n: Nodo) -> Bool
    if n.tipo != DOM_ELEMENTO
        return false
    end
    d = n.estilo["display"]
    return d == "block" or d == "list-item" or d == "table" or d == "table-row" or d == "table-row-group" or d == "table-cell" or d == "flex" or d == "grid"
end

func _oculto(n: Nodo) -> Bool
    return n.tipo == DOM_ELEMENTO and n.estilo["display"] == "none"
end

# === Página ===

# Las fuentes abiertas, para todas las páginas del programa (abrir una, sobre todo vectorial, cuesta;
# antes se abrían otra vez, sin cerrarse, cada vez que se maquetaba)
var _fuentes_abiertas: {String: Int} = {}
var _topaz: Int = 0

func maquetar(doc: Nodo, ancho: Int) -> Pagina
    estilo_vw = ancho              # (vw: el ancho de donde se ve la página)
    _alto_definido = -1
    var dibujos: [Dibujo] = []
    p = Pagina(dibujos, ancho, 0, 16777215)
    if _topaz == 0
        _topaz = font_open("topaz.font", 8)
    end
    m = Maquetador(p, _fuentes_abiertas, _topaz)
    html = dom_buscar(doc, "html")
    if html == nil
        return p
    end
    cuerpo = dom_buscar(html, "body")
    for raiz in [html, cuerpo]
        if raiz != nil and raiz.estilo.has("background-color") and css_color(raiz.estilo["background-color"]) >= 0
            p.fondo = css_color(raiz.estilo["background-color"])
        end
    end
    p.alto = _bloque(m, html, 0, 0, ancho)
    _por_capas(p)
    return p
end

# z-index: los dibujos de menor a mayor capa, sin cambiar el orden dentro de cada una
func _por_capas(p: Pagina)
    hay = false
    for d in p.dibujos
        if d.capa != 0
            hay = true
            break
        end
    end
    if not hay
        return
    end
    var capas: [Int] = []
    var vistas: {String: Bool} = {}
    for d in p.dibujos
        if not vistas.has("" + d.capa)
            vistas["" + d.capa] = true
            capas.push(d.capa)
        end
    end
    # (pocas capas: inserción)
    i = 1
    while i < capas.length
        j = i
        while j > 0 and capas[j - 1] > capas[j]
            c = capas[j - 1]
            capas[j - 1] = capas[j]
            capas[j] = c
            j = j - 1
        end
        i = i + 1
    end
    var orden: [Dibujo] = []
    for c in capas
        for d in p.dibujos
            if d.capa == c
                orden.push(d)
            end
        end
    end
    p.dibujos = orden
end

# Coloca un elemento de bloque en (x, y) con ese ancho; devuelve el alto que ocupa, márgenes incluidos
func _bloque(m: Maquetador, n: Nodo, x: Int, y: Int, ancho: Int) -> Int
    return _bloque_de(m, n, x, y, ancho, ancho)
end

# Lo mismo con los tantos por ciento (width, márgenes, rellenos) del ancho del contenedor: un flotante
# o un absoluto recibe su ancho ya resuelto (el 25 % del contenedor) y no hay que volver a aplicarlo
func _bloque_de(m: Maquetador, n: Nodo, x: Int, y: Int, ancho: Int, contenedor: Int) -> Int
    _maqueta_nivel = _maqueta_nivel + 1
    antes = m.pagina.dibujos.length
    r = _bloque_en(m, n, x, y, ancho, contenedor)
    t = _transformacion(n.estilo)
    if t != ""
        _transformar(m, n, t, antes)
    end
    # position: relative: se desplaza lo dibujado (left o right, top o bottom) sin mover a los demás (CSS 2.1, 9.4.3)
    if _val(n.estilo, "position", "static") == "relative"
        _relativo(m, n, antes, contenedor)
    end
    # z-index en un elemento posicionado: un contexto de apilado con todo lo suyo (el de fuera manda)
    if n.estilo.has("z-index") and n.estilo["z-index"] != "auto" and _val(n.estilo, "position", "static") != "static"
        z = Int(n.estilo["z-index"])
        i = antes
        while i < m.pagina.dibujos.length
            m.pagina.dibujos[i].capa = z
            i = i + 1
        end
    end
    if _invisible(n)
        # ocupa su sitio pero no se pinta (visibility: hidden, opacity: 0)
        while m.pagina.dibujos.length > antes
            m.pagina.dibujos.pop()
        end
    end
    _maqueta_nivel = _maqueta_nivel - 1
    if maqueta_traza > 0
        _trazar(n, x, y, ancho, r, "")
    end
    return r
end

# El alto del contenido de la caja que se está maquetando, si es fijo (height en px, o en % de otro fijo); -1 si
# no. Con él se resuelve un height en % (CSS 2.1, 10.5); el de html y body no se fija (como antes)
var _alto_definido: Int = -1

func _bloque_en(m: Maquetador, n: Nodo, x: Int, y: Int, ancho: Int, contenedor: Int) -> Int
    e = n.estilo
    inicio = m.pagina.dibujos.length
    mt = _px(e, "margin-top", contenedor)
    mb = _px(e, "margin-bottom", contenedor)
    ml = _px(e, "margin-left", contenedor)
    mr = _px(e, "margin-right", contenedor)
    bt = _borde(e, "top")
    bb = _borde(e, "bottom")
    bl = _borde(e, "left")
    br = _borde(e, "right")
    pt = _px(e, "padding-top", contenedor)
    pb = _px(e, "padding-bottom", contenedor)
    pl = _px(e, "padding-left", contenedor)
    pr = _px(e, "padding-right", contenedor)
    interior = ancho - ml - mr - bl - br - pl - pr
    if e.has("width") and e["width"] != "auto"
        w = _px(e, "width", contenedor)
        if e.has("box-sizing") and e["box-sizing"] == "border-box"
            w = w - bl - br - pl - pr
        end
        if w > 0 and w <= interior
            # margin: auto a los dos lados centra
            if e.has("margin-left") and e.has("margin-right") and e["margin-left"] == "auto" and e["margin-right"] == "auto"
                ml = (ancho - w - bl - br - pl - pr) / 2
            end
            interior = w
        end
    end
    if e.has("max-width") and e["max-width"] != "none"
        mx = _px(e, "max-width", contenedor)
        if e.has("box-sizing") and e["box-sizing"] == "border-box"
            mx = mx - bl - br - pl - pr
        end
        if mx > 0 and interior > mx
            if e.has("margin-left") and e.has("margin-right") and e["margin-left"] == "auto" and e["margin-right"] == "auto"
                ml = (ancho - mx - bl - br - pl - pr) / 2
            end
            interior = mx
        end
    end
    if interior < 1
        interior = 1
    end
    # el fondo va antes que el contenido: se pone ahora y se mide al final
    fondo = -1
    alfa_fondo = 255
    if e.has("background-color")
        fondo = css_color_opaco(e["background-color"])
        alfa_fondo = css_alfa(e["background-color"])
        if alfa_fondo == 0
            fondo = -1
        end
    end
    # opacity entre 0 y 1: el fondo, mezclado (lo de dentro se pinta entero: el pintor no mezcla texto)
    if fondo >= 0 and e.has("opacity") and e["opacity"] != "1"
        o = e["opacity"]
        mil = 1000
        if str_ends(o, "%")
            mil = _mil(o[:o.length - 1]) / 100
        else
            mil = _mil(o)
        end
        if mil >= 0 and mil < 1000
            alfa_fondo = alfa_fondo * mil / 1000
        end
    end
    # background-clip: text: el fondo solo se ve dentro de las letras (las pinta _palabras con su color)
    recorta_texto = _clip_texto(e)
    if recorta_texto
        fondo = -1
    end
    # box-shadow (la primera que no es inset), debajo del fondo
    var sombra: Dibujo = nil
    sombra_v = [0, 0, 0, 0]
    if e.has("box-shadow") and e["box-shadow"] != "none"
        sombra = _sombra(e["box-shadow"], estilo_px(_val(e, "font-size", "16px"), 0, 0), sombra_v)
        if sombra != nil
            sombra.x = x + ml + sombra_v[0] - sombra_v[3]
            sombra.y = y + mt + sombra_v[1] - sombra_v[3]
            sombra.ancho = interior + bl + br + pl + pr + sombra_v[3] * 2
            sombra.nodo = n
            m.pagina.dibujos.push(sombra)
        end
    end
    var caja_fondo: Dibujo = nil
    if fondo >= 0
        caja_fondo = _dibujo(D_RECT, x + ml, y + mt, interior + bl + br + pl + pr, 0, fondo)
        caja_fondo.nodo = n
        if alfa_fondo < 255
            caja_fondo.espaciado = alfa_fondo     # un rectángulo con espaciado > 0: mezclado con esa opacidad
        end
        m.pagina.dibujos.push(caja_fondo)
    end
    var degradado: Dibujo = nil
    if e.has("background-image") and _es_degradado(e["background-image"]) and not recorta_texto
        degradado = _degradado(e["background-image"], x + ml, y + mt, interior + bl + br + pl + pr)
        if degradado != nil
            degradado.nodo = n
            m.pagina.dibujos.push(degradado)
        end
    end
    var imagen_fondo: Dibujo = nil
    if e.has("background-image") and css_url(e["background-image"]) != "" and not recorta_texto
        imagen_fondo = _dibujo(D_FONDO, x + ml + bl, y + mt + bt, interior + pl + pr, 0, 0)
        imagen_fondo.texto = css_url(e["background-image"])
        imagen_fondo.nodo = n
        m.pagina.dibujos.push(imagen_fondo)
    end
    cx = x + ml + bl + pl
    cy = y + mt + bt + pt
    # height en %: del alto del contenedor, si es fijo (_alto_definido); los hijos ven el de esta caja
    alto_pct = -1
    if e.has("height") and str_ends(e["height"], "%") and _alto_definido >= 0
        alto_pct = _px(e, "height", _alto_definido)
        if e.has("box-sizing") and e["box-sizing"] == "border-box"
            alto_pct = alto_pct - bt - bb - pt - pb
        end
        if alto_pct < 0
            alto_pct = 0
        end
    end
    antes_definido = _alto_definido
    _alto_definido = alto_pct
    if e.has("height") and e["height"] != "auto" and not str_ends(e["height"], "%")
        _alto_definido = _px(e, "height", 0)
        if e.has("box-sizing") and e["box-sizing"] == "border-box"
            _alto_definido = _alto_definido - bt - bb - pt - pb
        end
        if _alto_definido < 0
            _alto_definido = 0
        end
    end
    alto = 0
    if e["display"] == "table"
        alto = _tabla(m, n, cx, cy, interior)
    elif e["display"] == "flex" or e["display"] == "inline-flex" or e["display"] == "grid" or e["display"] == "inline-grid"
        # el alto del contenido si está fijado (lo necesitan las columnas y el estirado de una línea)
        alto_fijo = alto_pct
        if e.has("height") and e["height"] != "auto" and not str_ends(e["height"], "%")
            alto_fijo = _px(e, "height", 0)
            if e.has("box-sizing") and e["box-sizing"] == "border-box"
                alto_fijo = alto_fijo - bt - bb - pt - pb
            end
            if alto_fijo < 0
                alto_fijo = 0
            end
        end
        if e["display"] == "grid" or e["display"] == "inline-grid"
            alto = _grid(m, n, cx, cy, interior, alto_fijo)
        else
            alto = _flex(m, n, cx, cy, interior, alto_fijo)
        end
    else
        alto = _contenido(m, n, cx, cy, interior)
    end
    _alto_definido = antes_definido
    if alto_pct >= 0
        alto = alto_pct
    end
    if e["display"] == "list-item"
        _marca(m, n, cx, cy)
    end
    if e.has("height") and e["height"] != "auto" and not str_ends(e["height"], "%")
        alto = _px(e, "height", 0)
        if e.has("box-sizing") and e["box-sizing"] == "border-box"
            alto = alto - bt - bb - pt - pb
        end
    end
    # aspect-ratio con el alto sin fijar: el alto que da la proporción con el ancho (o el contenido, si es más)
    if e.has("aspect-ratio") and e["aspect-ratio"] != "auto" and _val(e, "height", "auto") == "auto"
        proporcion = _proporcion(e["aspect-ratio"])
        if proporcion > 0
            por_ancho = interior * 1000 / proporcion
            if alto < por_ancho
                alto = por_ancho
            end
        end
    end
    if e.has("min-height") and not str_ends(e["min-height"], "%")
        minimo = _px(e, "min-height", 0)
        if e.has("box-sizing") and e["box-sizing"] == "border-box"
            minimo = minimo - bt - bb - pt - pb
        end
        if alto < minimo
            alto = minimo
        end
    end
    if alto < 0
        alto = 0
    end
    # los hijos con position absolute o fixed, encima, respecto a esta caja (su relleno)
    for h in _hijos(n)
        if _fuera_del_flujo(h) and not _oculto(h)
            _absoluto(m, h, x + ml + bl, y + mt + bt, interior + pl + pr, pt + alto + pb, pl, pt)
        end
    end
    alto_caja = bt + pt + alto + pb + bb
    redonda = _redonda(e, interior + bl + br + pl + pr, alto_caja)
    radios = 0
    if not redonda
        radios = _radios(e, interior + bl + br + pl + pr, alto_caja)
    end
    if sombra != nil
        sombra.alto = alto_caja + sombra_v[3] * 2
        if radios != 0
            sombra.radio = radios
            sombra.tipo = D_REDONDO
            sombra.estilo = 0
        end
    end
    if caja_fondo != nil
        caja_fondo.alto = alto_caja
        if redonda
            caja_fondo.tipo = D_ELIPSE
            caja_fondo.estilo = 0
        elif radios != 0
            caja_fondo.tipo = D_REDONDO
            caja_fondo.radio = radios
            caja_fondo.estilo = 0
        end
    end
    if imagen_fondo != nil
        imagen_fondo.alto = pt + alto + pb
    end
    if degradado != nil
        degradado.alto = alto_caja
    end
    if redonda and bt > 0 and bt == br and bt == bb and bt == bl
        borde = _dibujo(D_ELIPSE, x + ml, y + mt, interior + bl + br + pl + pr, alto_caja, _color_borde(e, "top"))
        borde.estilo = bt
        borde.nodo = n
        m.pagina.dibujos.push(borde)
    elif radios != 0 and bt > 0 and bt == br and bt == bb and bt == bl and _val(e, "border-top-style", "none") != "none"
        borde = _dibujo(D_REDONDO, x + ml, y + mt, interior + bl + br + pl + pr, alto_caja, _color_borde(e, "top"))
        borde.estilo = bt
        borde.radio = radios
        borde.nodo = n
        m.pagina.dibujos.push(borde)
    else
        k = m.pagina.dibujos.length
        _bordes(m, e, x + ml, y + mt, interior + bl + br + pl + pr, alto_caja, bt, br, bb, bl)
        # (los bordes son de esta caja: las celdas de una tabla mueven su contenido sin sus bordes)
        while k < m.pagina.dibujos.length
            if m.pagina.dibujos[k].nodo == nil
                m.pagina.dibujos[k].nodo = n
            end
            k = k + 1
        end
    end
    # overflow (hidden, clip, auto, scroll): lo de dentro, recortado a su caja
    if _recorta(e)
        _recortar(m, inicio, x + ml, y + mt, x + ml + interior + bl + br + pl + pr - 1, y + mt + alto_caja - 1)
    end
    return mt + alto_caja + mb
end

func _recorta(e: {String: String}) -> Bool
    for p in ["overflow", "overflow-x", "overflow-y"]
        if e.has(p)
            v = e[p]
            if v == "hidden" or v == "clip" or v == "auto" or v == "scroll"
                return true
            end
        end
    end
    return false
end

# Los dibujos desde inicio, recortados a x0..x1, y0..y1 (con el recorte que ya tuvieran)
func _recortar(m: Maquetador, inicio: Int, x0: Int, y0: Int, x1: Int, y1: Int)
    i = inicio
    while i < m.pagina.dibujos.length
        d = m.pagina.dibujos[i]
        if not d.recorte
            d.recorte = true
            d.rx0 = x0
            d.ry0 = y0
            d.rx1 = x1
            d.ry1 = y1
        else
            if x0 > d.rx0
                d.rx0 = x0
            end
            if y0 > d.ry0
                d.ry0 = y0
            end
            if x1 < d.rx1
                d.rx1 = x1
            end
            if y1 < d.ry1
                d.ry1 = y1
            end
        end
        i = i + 1
    end
end

# linear-gradient(...), también con prefijo (-webkit-, -moz-, -o-: la sintaxis vieja)
func _es_degradado(v: String) -> Bool
    l = str_lower(str_trim(v))
    return str_starts(l, "linear-gradient(") or str_starts(l, "-webkit-linear-gradient(") or str_starts(l, "-moz-linear-gradient(") or str_starts(l, "-o-linear-gradient(")
end

# Un linear-gradient: la dirección (to top/bottom/left/right o un ángulo) y su primer y último color
# (sin las posiciones de cada parada); nil si no se entiende
func _degradado(v: String, x: Int, y: Int, ancho: Int) -> Dibujo
    var nada: Dibujo = nil
    a = str_find(v, "(")
    z = str_find_from(v, ")", a)
    k = v.length - 1
    while k > a and str_code(v, k) != 41
        k = k - 1
    end
    if a < 0 or k <= a
        return nada
    end
    partes = css_partir(v[a + 1:k], 44)
    vertical = true
    al_reves = false
    primera = 0
    d = str_lower(str_trim(partes[0]))
    if str_code(str_trim(v), 0) == 45
        # con prefijo, la dirección es el lado donde empieza: top = to bottom, left = to right...
        if d == "top" or d == "bottom" or d == "left" or d == "right"
            if d == "top"
                d = "to bottom"
            elif d == "bottom"
                d = "to top"
            elif d == "left"
                d = "to right"
            else
                d = "to left"
            end
        end
    end
    if str_starts(d, "to ") or str_ends(d, "deg") or str_ends(d, "turn")
        primera = 1
        if d == "to top"
            al_reves = true
        elif d == "to right"
            vertical = false
        elif d == "to left"
            vertical = false
            al_reves = true
        elif str_ends(d, "deg")
            g = ((Int(d[:d.length - 3]) % 360) + 360) % 360
            if g < 45 or g >= 315
                al_reves = true
            elif g < 135
                vertical = false
            elif g >= 225
                vertical = false
                al_reves = true
            end
        end
    end
    if partes.length - primera < 2
        return nada
    end
    c1 = _parada(partes[primera])
    c2 = _parada(partes[partes.length - 1])
    if al_reves
        t = c1
        c1 = c2
        c2 = t
    end
    r = _dibujo(D_DEGRADADO, x, y, ancho, 0, css_color_opaco(c1))
    r.estilo = css_alfa(c1)
    r.fuente = css_color_opaco(c2)
    r.espaciado = css_alfa(c2)
    r.texto = "v"
    if not vertical
        r.texto = "h"
    end
    if r.color < 0 or r.fuente < 0 or (r.estilo == 0 and r.espaciado == 0)
        return nada
    end
    return r
end

# El color de una parada ("rgba(0,0,0,.5) 0px", "red 40%"): lo de antes del primer blanco fuera de paréntesis
func _clip_texto(e: {String: String}) -> Bool
    return _val(e, "background-clip", "") == "text" or _val(e, "-webkit-background-clip", "") == "text"
end

# El color de unas letras con el fondo recortado a ellas (background-clip: text en n o un antepasado cercano): el
# color de en medio de su degradado, o su background-color; si no hay, defecto
func _color_recortado(n: Nodo, defecto: Int) -> Int
    a = n
    k = 0
    while a != nil and k < 6
        if a.tipo == DOM_ELEMENTO and _clip_texto(a.estilo)
            e = a.estilo
            if e.has("background-image") and _es_degradado(e["background-image"])
                v = e["background-image"]
                ini = str_find(v, "(")
                fin = v.length - 1
                while fin > ini and str_code(v, fin) != 41
                    fin = fin - 1
                end
                if ini >= 0 and fin > ini
                    var colores: [Int] = []
                    for parte in css_partir(v[ini + 1:fin], 44)
                        c = css_color(_parada(parte))
                        if c >= 0
                            colores.push(c)
                        end
                    end
                    if colores.length > 0
                        return colores[colores.length / 2]
                    end
                end
            end
            if e.has("background-color") and css_color(e["background-color"]) >= 0
                return css_color(e["background-color"])
            end
            return defecto
        end
        a = a.padre
        k = k + 1
    end
    return defecto
end

func _parada(p: String) -> String
    s = str_trim(p)
    b = css_partir(s, 32)
    return b[0]
end

# border-radius de la mitad (o más) del lado menor en una caja casi cuadrada: un círculo o una elipse
func _redonda(e: {String: String}, ancho: Int, alto: Int) -> Bool
    if not e.has("border-radius") or ancho < 2 or alto < 2 or ancho > alto * 2 or alto > ancho * 2
        return false         # una barra con las puntas redondas se queda en rectángulo
    end
    r = str_trim(e["border-radius"])
    if str_find(r, " ") >= 0 or str_find(r, "/") >= 0
        return false
    end
    if str_ends(r, "%")
        return Int(r[:r.length - 1]) >= 50
    end
    menor = ancho
    if alto < menor
        menor = alto
    end
    return estilo_px(r, estilo_px(e["font-size"], 0, 0), 0) * 2 >= menor
end

# transform (CSS Transforms 1 y 2): translate, scale y matrix sin giro mueven y escalan lo dibujado alrededor de
# transform-origin (el texto se mueve pero no cambia de letra; scale(0) lo oculta). rotate solo gira una barra
# (una caja que es un solo rectángulo), al múltiplo de 45 grados más cercano; skew y los giros 3D no se pintan
func _transformar(m: Maquetador, n: Nodo, t: String, antes: Int)
    total = m.pagina.dibujos.length - antes
    if total <= 0
        return
    end
    # la caja: lo que abarca lo dibujado
    x1 = 1000000
    y1 = 1000000
    x2 = -1000000
    y2 = -1000000
    i = antes
    while i < m.pagina.dibujos.length
        d = m.pagina.dibujos[i]
        if d.x < x1
            x1 = d.x
        end
        if d.y < y1
            y1 = d.y
        end
        if d.x + d.ancho > x2
            x2 = d.x + d.ancho
        end
        if d.y + d.alto > y2
            y2 = d.y + d.alto
        end
        i = i + 1
    end
    em = estilo_px(_val(n.estilo, "font-size", "16px"), 0, 0)
    w = x2 - x1
    h = y2 - y1
    # la matriz: escala en milésimas, desplazamiento en px (se compone de izquierda a derecha)
    sx = 1000
    sy = 1000
    dx = 0
    dy = 0
    giro = 0
    resto = str_lower(t)
    while true
        p = str_find(resto, "(")
        if p < 0
            break
        end
        c = _cierre(resto, p)
        if c < 0
            break
        end
        f = str_trim(resto[:p])
        args = _transform_args(resto[p + 1:c])
        resto = resto[c + 1:]
        a = ""
        b = ""
        if args.length > 0
            a = args[0]
        end
        if args.length > 1
            b = args[1]
        end
        tx = 0
        ty = 0
        if f == "translatex"
            tx = estilo_px(a, em, w)
        elif f == "translatey"
            ty = estilo_px(a, em, h)
        elif f == "translate" or f == "translate3d"
            tx = estilo_px(a, em, w)
            if b != ""
                ty = estilo_px(b, em, h)
            end
        elif f == "scale" or f == "scale3d"
            ka = _escala(a)
            kb = ka
            if b != ""
                kb = _escala(b)
            end
            sx = sx * ka / 1000
            sy = sy * kb / 1000
        elif f == "scalex"
            sx = sx * _escala(a) / 1000
        elif f == "scaley"
            sy = sy * _escala(a) / 1000
        elif f == "rotate" or f == "rotatez"
            giro = giro + _grados(a)
        elif f == "matrix" or f == "matrix3d"
            # sin giro ni sesgo (b y c a 0): escala y desplazamiento; con giro, solo el desplazamiento
            ia = 0
            ib = 1
            ic = 2
            id = 3
            ie = 4
            jf = 5
            if f == "matrix3d"
                ib = 1
                ic = 4
                id = 5
                ie = 12
                jf = 13
            end
            if args.length > jf
                tx = _mil_signo(args[ie]) / 1000
                ty = _mil_signo(args[jf]) / 1000
                if _mil_signo(args[ib]) == 0 and _mil_signo(args[ic]) == 0
                    sx = sx * _mil_signo(args[ia]) / 1000
                    sy = sy * _mil_signo(args[id]) / 1000
                end
            end
        end
        dx = dx + tx * sx / 1000
        dy = dy + ty * sy / 1000
    end
    if sx == 0 or sy == 0
        # scale(0): no se ve
        while m.pagina.dibujos.length > antes
            m.pagina.dibujos.pop()
        end
        return
    end
    giro = ((giro % 360) + 360) % 360
    if giro % 180 != 0 and total == 1 and m.pagina.dibujos[antes].tipo == D_RECT
        _girar_barra(m.pagina.dibujos[antes], (giro + 22) / 45 * 45)
    end
    if sx == 1000 and sy == 1000 and dx == 0 and dy == 0
        return
    end
    # transform-origin (por omisión, el centro de la caja)
    ox = x1 + w / 2
    oy = y1 + h / 2
    if n.estilo.has("transform-origin")
        partes = _transform_args(n.estilo["transform-origin"])
        if partes.length > 0
            ox = x1 + _origen(partes[0], w, em)
            if partes[0] == "top" or partes[0] == "bottom"
                ox = x1 + w / 2
                oy = y1 + _origen(partes[0], h, em)
            end
        end
        if partes.length > 1
            if partes[1] == "left" or partes[1] == "right"
                ox = x1 + _origen(partes[1], w, em)
                oy = y1 + _origen(partes[0], h, em)
            else
                oy = y1 + _origen(partes[1], h, em)
            end
        end
    end
    i = antes
    while i < m.pagina.dibujos.length
        d = m.pagina.dibujos[i]
        texto = d.tipo == D_TEXTO or d.tipo == D_ICONO or d.tipo == D_CONTROL or d.tipo == D_LINEA
        nx = ox + dx + (d.x - ox) * sx / 1000
        ny = oy + dy + (d.y - oy) * sy / 1000
        if not texto
            fx = ox + dx + (d.x + d.ancho - ox) * sx / 1000
            fy = oy + dy + (d.y + d.alto - oy) * sy / 1000
            if fx < nx
                cambio = nx
                nx = fx
                fx = cambio
            end
            if fy < ny
                cambio = ny
                ny = fy
                fy = cambio
            end
            d.ancho = fx - nx
            d.alto = fy - ny
        end
        d.x = nx
        d.y = ny
        if d.recorte
            rx0 = ox + dx + (d.rx0 - ox) * sx / 1000
            rx1 = ox + dx + (d.rx1 - ox) * sx / 1000
            ry0 = oy + dy + (d.ry0 - oy) * sy / 1000
            ry1 = oy + dy + (d.ry1 - oy) * sy / 1000
            d.rx0 = rx0
            d.rx1 = rx1
            d.ry0 = ry0
            d.ry1 = ry1
            if rx1 < rx0
                d.rx0 = rx1
                d.rx1 = rx0
            end
            if ry1 < ry0
                d.ry0 = ry1
                d.ry1 = ry0
            end
        end
        i = i + 1
    end
end

# Gira una barra sobre su centro un múltiplo de 45 grados (a 0 o 90: horizontal o vertical; si no, un trazo)
func _girar_barra(d: Dibujo, giro: Int)
    largo = d.ancho
    grueso = d.alto
    angulo = giro
    if d.alto > d.ancho
        largo = d.alto
        grueso = d.ancho
        angulo = angulo + 90
    end
    angulo = ((angulo % 180) + 180) % 180
    cx = d.x + d.ancho / 2
    cy = d.y + d.alto / 2
    if angulo == 0
        d.x = cx - largo / 2
        d.y = cy - grueso / 2
        d.ancho = largo
        d.alto = grueso
    elif angulo == 90
        d.x = cx - grueso / 2
        d.y = cy - largo / 2
        d.ancho = grueso
        d.alto = largo
    else
        mitad = largo * 707 / 2000
        d.tipo = D_TRAZO
        d.x = cx - mitad
        d.y = cy - mitad
        d.ancho = mitad * 2 + 1
        d.alto = mitad * 2 + 1
        d.fuente = grueso
        d.estilo = 0
        if angulo == 135
            d.estilo = 1
        end
    end
end

# El paréntesis que cierra el abierto en p (con calc() y otros dentro); -1 si no hay
func _cierre(v: String, p: Int) -> Int
    nivel = 0
    i = p
    while i < v.length
        c = str_code(v, i)
        if c == 40
            nivel = nivel + 1
        elif c == 41
            nivel = nivel - 1
            if nivel == 0
                return i
            end
        end
        i = i + 1
    end
    return -1
end

# Los argumentos de una función de transform: separados por comas o, si no hay, por espacios (fuera de paréntesis)
func _transform_args(v: String) -> [String]
    var r: [String] = []
    comas = false
    nivel = 0
    for i in (0..v.length - 1)
        c = str_code(v, i)
        if c == 40
            nivel = nivel + 1
        elif c == 41
            nivel = nivel - 1
        elif c == 44 and nivel == 0
            comas = true
        end
    end
    actual = ""
    nivel = 0
    i = 0
    while i < v.length
        c = str_code(v, i)
        corta = false
        if c == 40
            nivel = nivel + 1
        elif c == 41
            nivel = nivel - 1
        elif nivel == 0 and (c == 44 or (not comas and (c == 32 or c == 9 or c == 10)))
            corta = true
        end
        if corta
            if str_trim(actual) != ""
                r.push(str_trim(actual))
            end
            actual = ""
        else
            actual = actual + v[i:i + 1]
        end
        i = i + 1
    end
    if str_trim(actual) != ""
        r.push(str_trim(actual))
    end
    return r
end

# Un número con signo (y quizá exponente, como en matrix()) en milésimas
func _mil_signo(v: String) -> Int
    a = str_trim(v)
    signo = 1
    if str_starts(a, "-")
        signo = -1
        a = a[1:]
    elif str_starts(a, "+")
        a = a[1:]
    end
    e = str_find(a, "e")
    if e >= 0
        exp = Int(a[e + 1:])
        r = _mil(a[:e])
        while exp > 0
            r = r * 10
            exp = exp - 1
        end
        while exp < 0
            r = r / 10
            exp = exp + 1
        end
        return signo * r
    end
    return signo * _mil(a)
end

# Un factor de scale (1.5, -1, 50 %) en milésimas
func _escala(v: String) -> Int
    a = str_trim(v)
    if str_ends(a, "%")
        return _mil_signo(a[:a.length - 1]) / 100
    end
    return _mil_signo(a)
end

# Un ángulo (deg, rad, grad, turn) en grados
func _grados(v: String) -> Int
    a = str_trim(v)
    if str_ends(a, "deg")
        return _mil_signo(a[:a.length - 3]) / 1000
    elif str_ends(a, "grad")
        return _mil_signo(a[:a.length - 4]) * 9 / 10000
    elif str_ends(a, "rad")
        return _mil_signo(a[:a.length - 3]) * 180 / 3142
    elif str_ends(a, "turn")
        return _mil_signo(a[:a.length - 4]) * 360 / 1000
    end
    return 0
end

# Una coordenada de transform-origin (left, center, right, top, bottom, % o longitud) dentro de un tamaño
func _origen(v: String, tam: Int, em: Int) -> Int
    if v == "left" or v == "top"
        return 0
    elif v == "right" or v == "bottom"
        return tam
    elif v == "center"
        return tam / 2
    end
    return estilo_px(v, em, tam)
end

# transform más las propiedades sueltas translate, rotate y scale (se aplican antes, en ese orden); "" si nada
func _transformacion(e: {String: String}) -> String
    t = ""
    if e.has("translate") and e["translate"] != "none"
        t = "translate(" + e["translate"] + ") "
    end
    if e.has("rotate") and e["rotate"] != "none"
        partes = _transform_args(e["rotate"])
        if partes.length > 0
            t = t + "rotate(" + partes[partes.length - 1] + ") "
        end
    end
    if e.has("scale") and e["scale"] != "none"
        t = t + "scale(" + e["scale"] + ") "
    end
    if e.has("transform") and e["transform"] != "none"
        t = t + e["transform"]
    end
    return t
end

# float: left o right; "" si no flota. Un inline-block que lleva bloques dentro, o tiene width o
# height, va como uno de la izquierda (en una fila con sus hermanos)
func _flota(n: Nodo) -> String
    if n.tipo != DOM_ELEMENTO or _fuera_del_flujo(n)
        return ""
    end
    if n.estilo.has("float")
        f = n.estilo["float"]
        if f == "left" or f == "right"
            return f
        end
    end
    if _caja_en_linea(n) and not _alineado(n)
        return "left"
    end
    return ""
end

# Un inline-block que lleva bloques dentro o tiene width o height: se maqueta como un bloque. Con el
# texto del padre centrado o a la derecha va en la línea (una pieza); si no, flota a la izquierda.
func _caja_en_linea(n: Nodo) -> Bool
    if n.estilo["display"] == "inline-block" or n.estilo["display"] == "inline-flex" or n.estilo["display"] == "inline-grid"
        if (n.estilo.has("width") and n.estilo["width"] != "auto") or (n.estilo.has("height") and n.estilo["height"] != "auto")
            return true
        end
        for h in n.hijos
            if _es_bloque(h) and not _oculto(h)
                return true
            end
        end
    end
    return false
end

func _alineado(n: Nodo) -> Bool
    if n.padre == nil
        return false
    end
    a = n.padre.estilo["text-align"]
    return a == "center" or a == "right"
end

func _invisible(n: Nodo) -> Bool
    e = n.estilo
    if e.has("visibility") and (e["visibility"] == "hidden" or e["visibility"] == "collapse")
        return true
    end
    return e.has("opacity") and (e["opacity"] == "0" or str_starts(e["opacity"], "0.0") or e["opacity"] == ".0")
end

func _fuera_del_flujo(n: Nodo) -> Bool
    if n.tipo != DOM_ELEMENTO or not n.estilo.has("position")
        return false
    end
    p = n.estilo["position"]
    return p == "absolute" or p == "fixed"
end

# Un elemento con position absolute (o fixed) dentro de la caja (cx, cy, cw, ch): top/left/right/
# bottom; sin left ni right, a la izquierda; sin top ni bottom, arriba. El ancho: left y right, su
# width, o lo que mide su contenido.
func _absoluto(m: Maquetador, n: Nodo, cx: Int, cy: Int, cw: Int, ch: Int, pl: Int, pt: Int)
    e = n.estilo
    tiene_l = e.has("left") and e["left"] != "auto"
    tiene_r = e.has("right") and e["right"] != "auto"
    tiene_t = e.has("top") and e["top"] != "auto" and e["top"] != "inherit"
    tiene_b = e.has("bottom") and e["bottom"] != "auto"
    l = 0
    r = 0
    if tiene_l
        l = _px(e, "left", cw)
    end
    if tiene_r
        r = _px(e, "right", cw)
    end
    w = 0
    if tiene_l and tiene_r and not (e.has("width") and e["width"] != "auto")
        w = cw - l - r
    else
        w = _ancho_flotante(m, n, cw)
    end
    if w > cw
        w = cw
    end
    if w < 1
        w = 1
    end
    ax = cx + l
    if not tiene_l and tiene_r
        ax = cx + cw - r - w
    elif not tiene_l
        ax = cx + pl         # sin left ni right: donde estaría (al principio del contenido)
    end
    # un vídeo con position absolute (WordPress: el iframe de YouTube llena una caja con la proporción hecha en
    # CSS): su recuadro sale de left/right/top/bottom y del width/height en % del contenedor
    if dom_es_video(n)
        vy = cy
        vh = 0
        if tiene_t
            vy = cy + _px(e, "top", ch)
        end
        if tiene_t and tiene_b
            vh = ch - _px(e, "top", ch) - _px(e, "bottom", ch)
        elif e.has("height") and e["height"] != "auto"
            vh = _px(e, "height", ch)
        end
        if tiene_l and tiene_r and e.has("width") and e["width"] != "auto"
            w = _px(e, "width", cw)
        end
        if vh <= 0
            aw = Int(dom_atributo(n, "width"))
            ah = Int(dom_atributo(n, "height"))
            vh = w * 9 / 16
            if aw > 0 and ah > 0
                vh = w * ah / aw
            end
        end
        if not tiene_t and tiene_b
            vy = cy + ch - _px(e, "bottom", ch) - vh
        end
        vd = _dibujo(D_VIDEO, ax, vy, w, vh, 0)
        vd.texto = video_src(n)
        vd.nodo = n
        m.pagina.dibujos.push(vd)
        return
    end
    # con top y bottom y sin height, su alto es el hueco entre los dos (una capa que tapa su contenedor: inset 0);
    # se pone un height de un momento y se quita después (el estilo se vuelve a usar al maquetar otra vez)
    # (y un height en %: del alto del contenedor, que en un absoluto ya se sabe)
    alto_css = _val(e, "height", "auto")
    estirado = tiene_t and tiene_b and alto_css == "auto"
    if estirado
        h = ch - _px(e, "top", ch) - _px(e, "bottom", ch) - _px(e, "margin-top", cw) - _px(e, "margin-bottom", cw)
        if _val(e, "box-sizing", "content-box") != "border-box"
            h = h - _borde(e, "top") - _borde(e, "bottom") - _px(e, "padding-top", cw) - _px(e, "padding-bottom", cw)
        end
        if h < 0
            h = 0
        end
        e["height"] = "" + h + "px"
    elif str_ends(alto_css, "%")
        h = _px(e, "height", ch)
        if _val(e, "box-sizing", "content-box") == "border-box"
            h = h - _borde(e, "top") - _borde(e, "bottom") - _px(e, "padding-top", cw) - _px(e, "padding-bottom", cw)
        end
        if h < 0
            h = 0
        end
        e["height"] = "" + h + "px"
    end
    # se maqueta arriba y luego se baja a su sitio (bottom necesita su alto)
    antes = m.pagina.dibujos.length
    alto = _bloque_de(m, n, ax, cy, w, cw)
    if estirado
        e.remove("height")
    elif str_ends(alto_css, "%")
        e["height"] = alto_css
    end
    dy = 0
    if tiene_t
        dy = _px(e, "top", ch)
    elif tiene_b
        dy = ch - _px(e, "bottom", ch) - alto
    else
        dy = pt
    end
    if dy != 0
        i = antes
        while i < m.pagina.dibujos.length
            _mover(m.pagina.dibujos[i], 0, dy)
            i = i + 1
        end
    end
end

func _relativo(m: Maquetador, n: Nodo, antes: Int, contenedor: Int)
    e = n.estilo
    rx = 0
    ry = 0
    if _val(e, "left", "auto") != "auto"
        rx = _px(e, "left", contenedor)
    elif _val(e, "right", "auto") != "auto"
        rx = -_px(e, "right", contenedor)
    end
    if _val(e, "top", "auto") != "auto" and not str_ends(e["top"], "%")
        ry = _px(e, "top", 0)
    elif _val(e, "bottom", "auto") != "auto" and not str_ends(e["bottom"], "%")
        ry = -_px(e, "bottom", 0)
    end
    if rx == 0 and ry == 0
        return
    end
    i = antes
    while i < m.pagina.dibujos.length
        _mover(m.pagina.dibujos[i], rx, ry)
        i = i + 1
    end
end

# Mueve un dibujo y, si va recortado (overflow), su zona de recorte con él (está en coordenadas de página)
func _mover(d: Dibujo, dx: Int, dy: Int)
    d.x = d.x + dx
    d.y = d.y + dy
    if d.recorte
        d.rx0 = d.rx0 + dx
        d.rx1 = d.rx1 + dx
        d.ry0 = d.ry0 + dy
        d.ry1 = d.ry1 + dy
    end
end

# El ancho que ocupa un flotante, márgenes incluidos: su width, o lo que mide su contenido
# (maquetándolo aparte y deshaciendo lo dibujado)
func _ancho_flotante(m: Maquetador, h: Nodo, ancho: Int) -> Int
    e = h.estilo
    extra = _px(e, "margin-left", ancho) + _px(e, "margin-right", ancho)
    caja = _borde(e, "left") + _borde(e, "right") + _px(e, "padding-left", ancho) + _px(e, "padding-right", ancho)
    if e.has("width") and e["width"] != "auto"
        w = _px(e, "width", ancho)
        if w > 0
            if e.has("box-sizing") and e["box-sizing"] == "border-box"
                return w + extra
            end
            return w + caja + extra
        end
    end
    # de lo más a la izquierda a lo más a la derecha (con texto centrado, el borde derecho no basta)
    antes = m.pagina.dibujos.length
    _bloque_de(m, h, 0, 0, ancho, ancho)
    derecha = 0
    izquierda = ancho
    i = antes
    while i < m.pagina.dibujos.length
        d = m.pagina.dibujos[i]
        # el contenido cuenta siempre; las cajas (fondos, bordes) solo las de un elemento con width fijado (las
        # demás se estiran a lo que haya)
        decoracion = d.tipo == D_RECT or d.tipo == D_LINEA or d.tipo == D_FONDO or d.tipo == D_DEGRADADO or d.tipo == D_REDONDO or d.tipo == D_ELIPSE
        cuenta = not decoracion
        if decoracion and d.nodo != nil and d.nodo != h
            w = _val(d.nodo.estilo, "width", "auto")
            cuenta = w != "auto" and not str_ends(w, "%")
        end
        if cuenta
            if d.x + d.ancho > derecha
                derecha = d.x + d.ancho
            end
            if d.x < izquierda
                izquierda = d.x
            end
        end
        i = i + 1
    end
    while m.pagina.dibujos.length > antes
        m.pagina.dibujos.pop()
    end
    if derecha <= izquierda
        return caja + extra
    end
    return derecha - izquierda + caja + extra
end

# Un flotante ya colocado
struct Flotante
    x: Int
    y: Int
    ancho: Int
    alto: Int
    izquierda: Bool
end

# El contenido de un bloque: hijos de bloque uno debajo de otro y lo de en medio, en líneas. Cada
# flotante va al primer sitio desde arriba donde cabe junto a los ya puestos (los de la izquierda
# pegados a la izquierda, los de la derecha a la derecha; nunca más arriba que el anterior), como en
# CSS; lo que no flota va debajo de ellos (como con clear: el texto aún no los rodea) y el bloque
# crece hasta abarcarlos (como clearfix).
func _contenido(m: Maquetador, n: Nodo, x: Int, y: Int, ancho: Int) -> Int
    ancho_previo = m.ancho_linea
    m.ancho_linea = ancho
    cy = y
    var piezas: [Pieza] = []
    m.blanco = 0
    margen_previo = 0
    en_fila = false
    fila_y = 0
    fondo = 0
    var flotantes: [Flotante] = []
    for h in _hijos(n)
        if _oculto(h) or _fuera_del_flujo(h)
            continue
        end
        lado = _flota(h)
        if lado != ""
            if piezas.length > 0
                cy = cy + _lineas(m, piezas, x, cy, ancho, n.estilo)
                piezas.clear()
            end
            if not en_fila
                en_fila = true
                fila_y = cy
                fondo = cy
                flotantes.clear()
            end
            w = _ancho_flotante(m, h, ancho)
            if w > ancho
                w = ancho
            end
            # el primer sitio desde fila_y (la altura del flotante anterior) donde cabe
            fy = fila_y
            izq = x
            der = x + ancho
            vueltas = 0
            while vueltas < 100
                izq = x
                der = x + ancho
                siguiente = -1
                for f in flotantes
                    if f.y <= fy and f.y + f.alto > fy
                        if f.izquierda and f.x + f.ancho > izq
                            izq = f.x + f.ancho
                        end
                        if not f.izquierda and f.x < der
                            der = f.x
                        end
                        if siguiente < 0 or f.y + f.alto < siguiente
                            siguiente = f.y + f.alto
                        end
                    end
                end
                if der - izq >= w or siguiente < 0
                    break
                end
                fy = siguiente
                vueltas = vueltas + 1
            end
            alto = 0
            fx = izq
            if lado != "left"
                fx = der - w
            end
            alto = _bloque_de(m, h, fx, fy, w, ancho)
            flotantes.push(Flotante(fx, fy, w, alto, lado == "left"))
            fila_y = fy
            if fy + alto > fondo
                fondo = fy + alto
            end
            margen_previo = 0
            continue
        end
        # un vídeo (<video>, el <iframe> de YouTube) va como una pieza aunque su CSS diga display: block
        bloque = _es_bloque(h) and not dom_es_video(h)
        if en_fila and (bloque or not _solo_blanco(h))
            en_fila = false
            if fondo > cy
                cy = fondo
            end
        end
        if bloque
            if piezas.length > 0
                cy = cy + _lineas(m, piezas, x, cy, ancho, n.estilo)
                piezas.clear()
                margen_previo = 0
            end
            # márgenes de hermanos seguidos: cuenta el mayor, no la suma
            mt = _px(h.estilo, "margin-top", ancho)
            solape = margen_previo
            if mt < solape
                solape = mt
            end
            if solape < 0
                solape = 0
            end
            cy = cy - solape + _bloque(m, h, x, cy - solape, ancho)
            margen_previo = _px(h.estilo, "margin-bottom", ancho)
        else
            _piezas(m, h, n.estilo, piezas, "")
        end
    end
    if piezas.length > 0
        cy = cy + _lineas(m, piezas, x, cy, ancho, n.estilo)
    end
    if en_fila and fondo > cy
        cy = fondo
    end
    m.ancho_linea = ancho_previo
    return cy - y
end

# Un texto de solo blancos (entre flotantes no corta la fila)
func _solo_blanco(n: Nodo) -> Bool
    if n.tipo == DOM_COMENTARIO
        return true
    end
    if n.tipo != DOM_TEXTO
        return false
    end
    i = 0
    while i < n.texto.length
        if str_code(n.texto, i) > 32
            return false
        end
        i = i + 1
    end
    return true
end

# Las piezas en línea de un nodo (texto, elementos en línea, br, img)
func _piezas(m: Maquetador, n: Nodo, e_padre: {String: String}, piezas: [Pieza], enlace: String)
    if n.tipo == DOM_TEXTO
        _palabras(m, n.texto, e_padre, piezas, enlace, n.padre)
        return
    end
    if n.tipo != DOM_ELEMENTO or _oculto(n)
        return
    end
    e = n.estilo
    if n.nombre == "br"
        piezas.push(Pieza("", 0, 0, 0, 0, 0, 0, false, enlace, 0, true, false))
        return
    end
    if n.nombre == "img"
        w = Int(dom_atributo(n, "width"))
        h = Int(dom_atributo(n, "height"))
        if w <= 0
            w = 16
        end
        if h <= 0
            h = 16
        end
        medida = _img_medida(m, e, w, h)
        w = medida[0]
        h = medida[1]
        img = Pieza(dom_img_src(n), w, h, h, 0, 0, 0, false, enlace, m.blanco, false, true)
        img.nodo = n
        piezas.push(img)
        m.blanco = 0
        return
    end
    if n.nombre == "svg"
        # SVG dentro de la página: una imagen (lib/imagenes.dash lo escribe en un fichero), a su tamaño
        img = Pieza(dom_atributo(n, "data-dashweb-svg"), svg_ancho(n), svg_alto(n), svg_alto(n), 0, 0, 0, false, enlace, m.blanco, false, true)
        img.nodo = n
        piezas.push(img)
        m.blanco = 0
        return
    end
    if dom_es_video(n)
        # como en los navegadores: 300x150 si no dice más; width en px o en % (del ancho de la línea) y el
        # alto con la proporción de sus atributos
        w = Int(dom_atributo(n, "width"))
        h = Int(dom_atributo(n, "height"))
        if w <= 0
            w = 300
        end
        if h <= 0
            h = w / 2
        end
        if e.has("width") and e["width"] != "auto"
            cw = _px(e, "width", m.ancho_linea)
            if cw > 0
                h = h * cw / w
                w = cw
            end
        end
        if e.has("height") and e["height"] != "auto" and not str_ends(e["height"], "%")
            ch = _px(e, "height", 0)
            if ch > 0
                h = ch
            end
        end
        # max-width (WordPress: 100 %) y nunca más ancho que la línea, con la misma proporción
        mx = m.ancho_linea
        if e.has("max-width") and e["max-width"] != "none"
            mw = _px(e, "max-width", m.ancho_linea)
            if mw > 0 and mw < mx
                mx = mw
            end
        end
        if mx > 0 and w > mx
            h = h * mx / w
            w = mx
        end
        vid = Pieza(video_src(n), w, h, h, 0, 0, 0, false, enlace, m.blanco, false, false)
        vid.video = true
        vid.nodo = n
        piezas.push(vid)
        m.blanco = 0
        return
    end
    if n.nombre == "::icono"
        tam = estilo_px(e["font-size"], 0, 0)
        font_use(_fuente(m, "sans-serif", tam))
        color = css_color(e["color"])
        if color < 0
            color = 0
        end
        ic = Pieza(dom_atributo(n, "codigo"), tam, font_height(), font_baseline(), _fuente(m, "sans-serif", tam), 0, color, false, enlace, m.blanco, false, false)
        ic.icono = true
        ic.nodo = n.padre
        piezas.push(ic)
        m.blanco = 0
        return
    end
    if (e["display"] == "inline-block" or e["display"] == "inline-flex" or e["display"] == "inline-grid") and not (e.has("float") and (e["float"] == "left" or e["float"] == "right"))
        _pieza_caja(m, n, piezas, enlace)
        return
    end
    if (n.nombre == "input" or n.nombre == "select" or n.nombre == "button" or n.nombre == "textarea") and not _boton_propio(n)
        _control(m, n, e, piezas, enlace)
        return
    end
    destino = enlace
    if n.nombre == "a" and dom_tiene_atributo(n, "href")
        destino = dom_atributo(n, "href")
    end
    for h in _hijos(n)
        _piezas(m, h, e, piezas, destino)
    end
end

# Un inline-block en la línea (una pieza que no se corta): mide su ancho y su alto maquetándolo aparte;
# _poner_linea lo maqueta en su sitio. Su línea base, la de su último texto (sin texto, abajo).
func _pieza_caja(m: Maquetador, n: Nodo, piezas: [Pieza], enlace: String)
    w = _ancho_flotante(m, n, m.ancho_linea)
    if w > m.ancho_linea
        w = m.ancho_linea
    end
    antes = m.pagina.dibujos.length
    h = _bloque_de(m, n, 0, 0, w, m.ancho_linea)
    base = h
    i = m.pagina.dibujos.length - 1
    while i >= antes
        d = m.pagina.dibujos[i]
        if (d.tipo == D_TEXTO or d.tipo == D_ICONO) and d.fuente != 0
            font_use(d.fuente)
            base = d.y + font_baseline()
            break
        end
        i = i - 1
    end
    while m.pagina.dibujos.length > antes
        m.pagina.dibujos.pop()
    end
    pz = Pieza("", w, h, base, 0, 0, 0, false, enlace, m.blanco, false, false)
    pz.caja = n
    pz.nodo = n
    piezas.push(pz)
    m.blanco = 0
end

# Un <button> con elementos dentro o sin texto: lo dibuja su CSS (un icono, unas barras...), no es
# el botón de siempre
func _boton_propio(n: Nodo) -> Bool
    if n.nombre != "button"
        return false
    end
    for h in _hijos(n)
        if h.tipo == DOM_ELEMENTO
            return true
        end
    end
    return str_trim(dom_texto(n)) == ""
end

# Un control de formulario: una pieza de su tamaño (lo dibuja el pintor con lo que tenga el nodo)
func _control(m: Maquetador, n: Nodo, e: {String: String}, piezas: [Pieza], enlace: String)
    tipo = str_lower(dom_atributo(n, "type"))
    if n.nombre == "input" and tipo == "hidden"
        return
    end
    f = _fuente(m, e["font-family"], estilo_px(e["font-size"], 0, 0))
    font_use(f)
    font_style(0)
    alto_texto = font_height()
    base = font_baseline()
    w = 0
    h = alto_texto + 6
    b = 3 + base
    if n.nombre == "select"
        for o in n.hijos
            if o.tipo == DOM_ELEMENTO and o.nombre == "option" and font_text_width(str_trim(dom_texto(o))) > w
                w = font_text_width(str_trim(dom_texto(o)))
            end
        end
        w = w + 24
    elif n.nombre == "button" or tipo == "submit" or tipo == "reset" or tipo == "button"
        w = font_text_width(formulario_etiqueta(n)) + 16
        h = alto_texto + 8
        b = 4 + base
    elif tipo == "checkbox" or tipo == "radio"
        w = alto_texto
        if w < 11
            w = 11
        end
        h = w
        b = w - 1
    elif n.nombre == "textarea"
        cols = Int(dom_atributo(n, "cols"))
        if cols <= 0
            cols = 20
        end
        filas = Int(dom_atributo(n, "rows"))
        if filas <= 0
            filas = 2
        end
        w = cols * font_text_width("n") + 6
        h = filas * alto_texto + 6
    else
        cols = Int(dom_atributo(n, "size"))
        if cols <= 0
            cols = 20
        end
        w = cols * font_text_width("n") + 6
    end
    pz = Pieza("", w, h, b, f, 0, 0, false, enlace, m.blanco, false, false)
    pz.control = true
    pz.nodo = n
    piezas.push(pz)
    m.blanco = 0
end

# El texto de un botón: el del <button> o el value; si no, el de siempre
func formulario_etiqueta(n: Nodo) -> String
    if n.nombre == "button"
        t = str_trim(dom_texto(n))
        if t != ""
            return t
        end
        return "Enviar"
    end
    if dom_tiene_atributo(n, "value")
        return dom_atributo(n, "value")
    end
    if str_lower(dom_atributo(n, "type")) == "reset"
        return "Borrar"
    end
    return "Enviar"
end

# La opción elegida de un <select> (la que tiene selected, si no la primera); nil si no tiene
func formulario_opcion(n: Nodo) -> Nodo
    var primera: Nodo = nil
    for o in n.hijos
        if o.tipo == DOM_ELEMENTO and o.nombre == "option"
            if dom_tiene_atributo(o, "selected")
                return o
            end
            if primera == nil
                primera = o
            end
        end
    end
    return primera
end

# El tamaño de una <img> en la línea: el suyo (w x h: sus atributos, o lo que mide la imagen ya cargada) con el
# width y el height del CSS (en px, o width en % de la línea); el que sea auto sale de la proporción. Luego
# max-width y max-height, también con la proporción
func _img_medida(m: Maquetador, e: {String: String}, w0: Int, h0: Int) -> [Int]
    w = w0
    h = h0
    cw = 0
    ch = 0
    if e.has("width") and e["width"] != "auto"
        cw = _px(e, "width", m.ancho_linea)
    end
    if e.has("height") and e["height"] != "auto" and not str_ends(e["height"], "%")
        ch = _px(e, "height", 0)
    end
    if cw > 0 and ch > 0
        w = cw
        h = ch
    elif cw > 0
        h = h * cw / w
        w = cw
    elif ch > 0
        w = w * ch / h
        h = ch
    end
    if e.has("max-width") and e["max-width"] != "none"
        mw = _px(e, "max-width", m.ancho_linea)
        if mw > 0 and w > mw
            if ch <= 0
                h = h * mw / w
            end
            w = mw
        end
    end
    if e.has("max-height") and e["max-height"] != "none" and not str_ends(e["max-height"], "%")
        mh = _px(e, "max-height", 0)
        if mh > 0 and h > mh
            if cw <= 0
                w = w * mh / h
            end
            h = mh
        end
    end
    if w < 1
        w = 1
    end
    if h < 1
        h = 1
    end
    return [w, h]
end

# Palabras de un texto con el estilo de su elemento
func _palabras(m: Maquetador, texto_dom: String, e: {String: String}, piezas: [Pieza], enlace: String, elemento: Nodo)
    tam = estilo_px(e["font-size"], 0, 0)
    texto = texto_dom
    transformar = ""
    if e.has("text-transform")
        transformar = e["text-transform"]
    end
    if transformar == "uppercase"
        texto = str_upper(texto)
    elif transformar == "lowercase"
        texto = str_lower(texto)
    end
    ls = 0
    if e.has("letter-spacing") and e["letter-spacing"] != "normal"
        ls = estilo_px(e["letter-spacing"], tam, 0)
        if ls < 0
            ls = 0
        end
    end
    f = _fuente(m, e["font-family"], tam)
    estilo = _estilo_texto(e)
    deco = ""
    if e.has("text-decoration")
        deco = e["text-decoration"]
    end
    if str_find(deco, "underline") >= 0
        estilo = estilo + EST_SUBRAYADO
    end
    tachado = str_find(deco, "line-through") >= 0
    color = css_color(e["color"])
    if color < 0
        color = 0
    end
    # -webkit-text-fill-color: el color de las letras; transparente con background-clip: text, el del fondo
    if e.has("-webkit-text-fill-color") and str_lower(e["-webkit-text-fill-color"]) != "currentcolor"
        relleno = css_color(e["-webkit-text-fill-color"])
        if relleno >= 0
            color = relleno
        elif elemento != nil
            color = _color_recortado(elemento, color)
        end
    end
    font_use(f)
    font_style(estilo)
    alto = font_height()
    base = font_baseline()
    espacio_ancho = font_text_width(" ")
    if e["white-space"] == "pre" or e["white-space"] == "pre-wrap"
        # cada línea tal cual; los saltos de línea cortan
        inicio = 0
        p = str_find(texto, "\n")
        while p >= 0
            linea = str_replace(texto[inicio:p], "\t", "        ")
            pz = Pieza(linea, font_text_width(linea), alto, base, f, estilo, color, tachado, enlace, 0, false, false)
            pz.nodo = elemento
            piezas.push(pz)
            piezas.push(Pieza("", 0, alto, base, f, estilo, color, false, enlace, 0, true, false))
            inicio = p + 1
            p = str_find_from(texto, "\n", inicio)
        end
        linea = str_replace(texto[inicio:], "\t", "        ")
        if linea != ""
            pz = Pieza(linea, font_text_width(linea), alto, base, f, estilo, color, tachado, enlace, 0, false, false)
            pz.nodo = elemento
            piezas.push(pz)
        end
        return
    end
    n = texto.length
    i = 0
    hubo_blanco = false
    # white-space: nowrap: no se corta la línea entre sus palabras (van pegadas)
    sin_cortes = e["white-space"] == "nowrap"
    primera = true
    while i < n
        c = str_code(texto, i)
        if c == 32 or c == 9 or c == 10 or c == 13 or c == 12
            hubo_blanco = true
            i = i + 1
        else
            j = i
            while j < n and str_code(texto, j) != 32 and str_code(texto, j) != 9 and str_code(texto, j) != 10 and str_code(texto, j) != 13 and str_code(texto, j) != 12
                j = j + 1
            end
            palabra = texto[i:j]
            if transformar == "capitalize"
                palabra = str_upper(palabra[:1]) + palabra[1:]
            end
            # un blanco antes cuenta una vez: si la pieza anterior ya acaba en espacio, no otro
            espacio = 0
            if (hubo_blanco or m.blanco > 0) and not (piezas.length > 0 and _termina_en_blanco(piezas))
                espacio = espacio_ancho
            end
            m.blanco = 0
            if ls > 0 and espacio > 0
                espacio = espacio + ls
            end
            pz = Pieza(palabra, font_text_width(palabra) + ls * palabra.length, alto, base, f, estilo, color, tachado, enlace, espacio, false, false)
            pz.nodo = elemento
            pz.espaciado = ls
            if not hubo_blanco and piezas.length > 0
                anterior = piezas[piezas.length - 1]
                pz.pegada = not anterior.salto and not anterior.imagen and not anterior.control and not str_ends(anterior.texto, " ")
            end
            if sin_cortes and piezas.length > 0 and (not primera or hubo_blanco)
                pz.pegada = true
            end
            primera = false
            piezas.push(pz)
            hubo_blanco = false
            i = j
        end
    end
    if hubo_blanco and piezas.length > 0
        # el blanco final se nota en la siguiente palabra (de otro elemento)
        ultima = piezas[piezas.length - 1]
        if ultima.imagen or ultima.control
            m.blanco = espacio_ancho
        elif not ultima.salto
            ultima.texto = ultima.texto + " "
            ultima.ancho = ultima.ancho + espacio_ancho
        end
    end
end

func _termina_en_blanco(piezas: [Pieza]) -> Bool
    u = piezas[piezas.length - 1]
    return str_ends(u.texto, " ")
end

# Reparte las piezas en líneas de ese ancho; devuelve el alto
func _lineas(m: Maquetador, todas: [Pieza], x: Int, y: Int, ancho: Int, e: {String: String}) -> Int
    cy = y
    var linea: [Pieza] = []
    ocupado = 0
    piezas = todas
    if _partir_palabras(e)
        piezas = _palabras_partidas(todas, ancho)
    end
    # text-indent: la primera línea empieza tanto más a la derecha (o a la izquierda, si es negativo: -9999px
    # esconde el texto de un logo que se pinta como fondo) y tiene ese ancho menos
    sangria = 0
    if e.has("text-indent") and e["text-indent"] != "0" and e["text-indent"] != "0px"
        sangria = estilo_px(e["text-indent"], estilo_px(_val(e, "font-size", "16px"), 0, 0), ancho)
    end
    for p in piezas
        if p.salto
            cy = cy + _poner_linea(m, linea, x + sangria, cy, ancho - sangria, e, p.alto)
            sangria = 0
            linea.clear()
            ocupado = 0
            continue
        end
        hueco = p.espacio
        if linea.length == 0
            hueco = 0
        end
        if linea.length > 0 and ocupado + hueco + p.ancho > ancho - sangria
            # se corta antes de la última pieza no pegada: las pegadas pasan juntas a la siguiente
            k = linea.length
            if p.pegada
                k = linea.length - 1
                while k > 0 and linea[k].pegada
                    k = k - 1
                end
            end
            if k > 0
                var resto: [Pieza] = []
                while linea.length > k
                    resto.insert(0, linea.pop())
                end
                cy = cy + _poner_linea(m, linea, x + sangria, cy, ancho - sangria, e, 0)
                sangria = 0
                linea.clear()
                ocupado = 0
                for r in resto
                    if linea.length == 0
                        r.espacio = 0
                    end
                    linea.push(r)
                    ocupado = ocupado + r.espacio + r.ancho
                end
                hueco = p.espacio
                if linea.length == 0
                    hueco = 0
                end
            end
        end
        p.espacio = hueco
        linea.push(p)
        ocupado = ocupado + hueco + p.ancho
    end
    if linea.length > 0
        cy = cy + _poner_linea(m, linea, x + sangria, cy, ancho - sangria, e, 0)
    end
    return cy - y
end

# overflow-wrap (o word-wrap): break-word o anywhere, o word-break: break-all o break-word: una palabra más
# larga que la línea se parte donde haga falta
func _partir_palabras(e: {String: String}) -> Bool
    o = _val(e, "overflow-wrap", _val(e, "word-wrap", "normal"))
    w = _val(e, "word-break", "normal")
    return o == "break-word" or o == "anywhere" or w == "break-all" or w == "break-word"
end

# Las piezas con las palabras de texto más anchas que la línea partidas en trozos que caben
func _palabras_partidas(piezas: [Pieza], ancho: Int) -> [Pieza]
    var r: [Pieza] = []
    for p in piezas
        if p.ancho <= ancho or ancho <= 0 or p.salto or p.imagen or p.control or p.icono or p.video or p.caja != nil or p.texto.length < 2
            r.push(p)
            continue
        end
        font_use(p.fuente)
        font_style(p.estilo)
        resto = p.texto
        primero = true
        while resto != ""
            k = 1
            while k < resto.length and font_text_width(resto[:k + 1]) + p.espaciado * (k + 1) <= ancho
                k = k + 1
            end
            trozo = resto[:k]
            resto = resto[k:]
            pz = Pieza(trozo, font_text_width(trozo) + p.espaciado * trozo.length, p.alto, p.base, p.fuente, p.estilo, p.color, p.tachado, p.enlace, 0, false, false)
            pz.nodo = p.nodo
            pz.espaciado = p.espaciado
            if primero
                pz.espacio = p.espacio
                pz.pegada = p.pegada
            end
            primero = false
            r.push(pz)
        end
    end
    return r
end

# Una línea: alto y línea base de lo más alto, alineación, y las palabras seguidas con el mismo
# aspecto juntas en un solo texto (pintar texto es lo que más cuesta)
func _poner_linea(m: Maquetador, linea: [Pieza], x: Int, y: Int, ancho: Int, e: {String: String}, alto_vacia: Int) -> Int
    if linea.length == 0
        return alto_vacia
    end
    alto = 0
    base = 0
    total = 0
    for p in linea
        if p.base > base
            base = p.base
        end
        total = total + p.espacio + p.ancho
    end
    for p in linea
        if base - p.base + p.alto > alto
            alto = base - p.base + p.alto
        end
    end
    alto = alto + 2
    desplaza = 0
    alinea = e["text-align"]
    if alinea == "center"
        desplaza = (ancho - total) / 2
    elif alinea == "right"
        desplaza = ancho - total
    end
    if desplaza < 0
        desplaza = 0
    end
    cx = x + desplaza
    var actual: Dibujo = nil
    var sombra: Dibujo = nil
    inicio = m.pagina.dibujos.length
    for p in linea
        cx = cx + p.espacio
        if p.caja != nil
            _bloque_de(m, p.caja, cx, y + base - p.base + 1, p.ancho, ancho)
            actual = nil
        elif p.control
            ctl = _dibujo(D_CONTROL, cx, y + base - p.base + 1, p.ancho, p.alto, 0)
            ctl.fuente = p.fuente
            ctl.nodo = p.nodo
            ctl.enlace = p.enlace
            m.pagina.dibujos.push(ctl)
            actual = nil
        elif p.video
            vd = _dibujo(D_VIDEO, cx, y + base - p.base + 1, p.ancho, p.alto, 0)
            vd.texto = p.texto
            vd.enlace = p.enlace
            vd.nodo = p.nodo
            m.pagina.dibujos.push(vd)
            actual = nil
        elif p.icono
            ic = _dibujo(D_ICONO, cx, y + base - p.base + 1, p.ancho, p.alto, p.color)
            ic.texto = p.texto
            ic.fuente = p.fuente
            ic.enlace = p.enlace
            ic.nodo = p.nodo
            m.pagina.dibujos.push(ic)
            actual = nil
        elif p.imagen
            img = _dibujo(D_IMAGEN, cx, y + base - p.base + 1, p.ancho, p.alto, 0)
            img.texto = p.texto
            img.enlace = p.enlace
            img.nodo = p.nodo
            m.pagina.dibujos.push(img)
            actual = nil
        elif actual != nil and actual.fuente == p.fuente and actual.estilo == p.estilo and actual.color == p.color and actual.enlace == p.enlace and actual.nodo == p.nodo and actual.espaciado == p.espaciado
            actual.texto = actual.texto + _espacios(p.espacio, actual) + p.texto
            actual.ancho = cx + p.ancho - actual.x
            if sombra != nil
                sombra.texto = actual.texto
                sombra.ancho = actual.ancho
            end
        else
            sombra = nil
            if p.nodo != nil and p.nodo.estilo.has("text-shadow") and p.nodo.estilo["text-shadow"] != "none"
                sombra = _sombra_texto(p.nodo.estilo, p.color)
                if sombra != nil
                    sombra.x = cx + sombra.x
                    sombra.y = y + base - p.base + 1 + sombra.y
                    sombra.ancho = p.ancho
                    sombra.alto = p.alto
                    sombra.texto = p.texto
                    sombra.fuente = p.fuente
                    sombra.estilo = p.estilo
                    sombra.nodo = p.nodo
                    sombra.espaciado = p.espaciado
                    m.pagina.dibujos.push(sombra)
                end
            end
            actual = _dibujo(D_TEXTO, cx, y + base - p.base + 1, p.ancho, p.alto, p.color)
            actual.texto = p.texto
            actual.fuente = p.fuente
            actual.estilo = p.estilo
            actual.enlace = p.enlace
            actual.nodo = p.nodo
            actual.espaciado = p.espaciado
            m.pagina.dibujos.push(actual)
        end
        if p.tachado
            m.pagina.dibujos.push(_dibujo(D_LINEA, cx, y + base - p.base + 1 + p.alto / 2, p.ancho, 1, p.color))
        end
        cx = cx + p.ancho
    end
    # text-overflow: ellipsis en una caja que recorta: lo que no cabe se cambia por "..."
    if desplaza + total > ancho and _val(e, "text-overflow", "clip") == "ellipsis" and (_val(e, "overflow", "visible") != "visible" or _val(e, "overflow-x", "visible") != "visible")
        _puntos(m, inicio, x + ancho)
    end
    return alto
end

# Los textos de una línea (desde el dibujo inicio) cortados en limite: el que lo cruza acaba en "...", los de
# después se vacían
func _puntos(m: Maquetador, inicio: Int, limite: Int)
    i = inicio
    while i < m.pagina.dibujos.length
        d = m.pagina.dibujos[i]
        if d.tipo == D_TEXTO
            if d.x >= limite
                d.texto = ""
                d.ancho = 0
            elif d.x + d.ancho > limite
                font_use(d.fuente)
                font_style(d.estilo)
                puntos = font_text_width("...")
                k = d.texto.length
                while k > 0 and font_text_width(d.texto[:k]) + d.espaciado * k + puntos > limite - d.x
                    k = k - 1
                end
                d.texto = str_trim(d.texto[:k]) + "..."
                d.ancho = font_text_width(d.texto) + d.espaciado * d.texto.length
            end
        end
        i = i + 1
    end
end

# text-shadow: la primera sombra como una copia del texto desplazada (x e y del dibujo: el desplazamiento), con
# su color; nil si no hay, si es casi transparente o muy difuminada (un halo: sin difuminar quedaría peor)
func _sombra_texto(e: {String: String}, color_texto: Int) -> Dibujo
    var nada: Dibujo = nil
    valor = e["text-shadow"]
    primera = css_partir(valor, 44)[0]
    con_color = false
    for t in css_partir(str_trim(primera), 32)
        c = str_code(str_trim(t) + " ", 0)
        if str_trim(t) != "" and not ((c >= 48 and c <= 57) or c == 45 or c == 46)
            con_color = true
        end
    end
    v = [0, 0, 0, 0]
    d = _sombra(primera, estilo_px(_val(e, "font-size", "16px"), 0, 0), v)
    if d == nil or v[2] > 4 or (v[0] == 0 and v[1] == 0) or (d.espaciado > 0 and d.espaciado < 128)
        return nada
    end
    s = _dibujo(D_TEXTO, v[0], v[1], 0, 0, d.color)
    if not con_color
        s.color = color_texto
    end
    return s
end

# El hueco entre dos palabras dentro de un mismo texto: un espacio (si no lo trae ya)
func _espacios(hueco: Int, d: Dibujo) -> String
    if hueco > 0 and not str_ends(d.texto, " ")
        return " "
    end
    return ""
end

# La marca de un elemento de lista, a la izquierda de su primera línea
func _marca(m: Maquetador, n: Nodo, x: Int, y: Int)
    tipo = n.estilo["list-style-type"]
    if tipo == "none"
        return
    end
    tam = estilo_px(n.estilo["font-size"], 0, 0)
    color = css_color(n.estilo["color"])
    if color < 0
        color = 0
    end
    if tipo == "decimal"
        numero = 1
        if n.padre != nil
            for h in n.padre.hijos
                if h == n
                    break
                end
                if h.tipo == DOM_ELEMENTO and h.estilo["display"] == "list-item"
                    numero = numero + 1
                end
            end
        end
        f = _fuente(m, n.estilo["font-family"], tam)
        font_use(f)
        font_style(0)
        texto = "" + numero + "."
        d = _dibujo(D_TEXTO, x - font_text_width(texto) - 4, y + 1, font_text_width(texto), font_height(), color)
        d.texto = texto
        d.fuente = f
        m.pagina.dibujos.push(d)
    else
        lado = tam / 3
        if lado < 3
            lado = 3
        end
        m.pagina.dibujos.push(_dibujo(D_RECT, x - lado - 6, y + tam / 2 - lado / 2 + 1, lado, lado, color))
    end
end

# Bordes como rectángulos llenos
func _bordes(m: Maquetador, e: {String: String}, x: Int, y: Int, ancho: Int, alto: Int, bt: Int, br: Int, bb: Int, bl: Int)
    if bt > 0
        m.pagina.dibujos.push(_dibujo(D_RECT, x, y, ancho, bt, _color_borde(e, "top")))
    end
    if bb > 0
        m.pagina.dibujos.push(_dibujo(D_RECT, x, y + alto - bb, ancho, bb, _color_borde(e, "bottom")))
    end
    if bl > 0
        m.pagina.dibujos.push(_dibujo(D_RECT, x, y, bl, alto, _color_borde(e, "left")))
    end
    if br > 0
        m.pagina.dibujos.push(_dibujo(D_RECT, x + ancho - br, y, br, alto, _color_borde(e, "right")))
    end
end

func _color_borde(e: {String: String}, lado: String) -> Int
    c = -1
    if e.has("border-" + lado + "-color")
        c = css_color(e["border-" + lado + "-color"])
    end
    if c < 0
        c = css_color(e["color"])
    end
    if c < 0
        c = 0
    end
    return c
end

# Tabla sencilla: filas una debajo de otra, celdas del mismo ancho
# Una tabla (CSS 2.1, 17.5): la rejilla con colspan y rowspan, el ancho de las columnas (automático: el mínimo y
# el máximo de su contenido o su width; table-layout: fixed con la primera fila), border-spacing (0 con
# border-collapse), el alto de las filas, el fondo de las filas y vertical-align en cada celda (middle por omisión).
# Cada celda se maqueta en 0,0 y sus dibujos se mueven a su sitio.
struct Celda
    nodo: Nodo
    fila: Int
    col: Int
    filas: Int = 1
    cols: Int = 1
    alto: Int = 0
    ancho: Int = 0
    dibujos: [Dibujo] = nil
end

func _tabla(m: Maquetador, t: Nodo, x: Int, y: Int, ancho: Int) -> Int
    e = t.estilo
    esp = 0
    if _val(e, "border-collapse", "separate") != "collapse"
        partes = css_partir(str_trim(_val(e, "border-spacing", "0")), 32)
        esp = estilo_px(partes[0], estilo_px(_val(e, "font-size", "16px"), 0, 0), ancho)
    end
    cy = y
    for h in t.hijos
        if h.tipo == DOM_ELEMENTO and h.nombre == "caption" and not _oculto(h)
            cy = cy + _bloque(m, h, x, cy, ancho)
        end
    end
    var filas: [Nodo] = []
    _filas(t, filas)
    var celdas: [Celda] = []
    var ocupado: {String: Bool} = {}
    ncols = 0
    for r in (0..filas.length - 1)
        c = 0
        for h in filas[r].hijos
            if h.tipo != DOM_ELEMENTO or (h.nombre != "td" and h.nombre != "th") or _oculto(h)
                continue
            end
            while ocupado.has("" + r + "," + c)
                c = c + 1
            end
            cs = Int(dom_atributo(h, "colspan"))
            if cs < 1 or cs > 1000
                cs = 1
            end
            rs = Int(dom_atributo(h, "rowspan"))
            if dom_atributo(h, "rowspan") == "0" or r + rs > filas.length
                rs = filas.length - r
            end
            if rs < 1
                rs = 1
            end
            cel = Celda(h, r, c, rs, cs)
            celdas.push(cel)
            for i in (r..r + rs - 1)
                for j in (c..c + cs - 1)
                    ocupado["" + i + "," + j] = true
                end
            end
            c = c + cs
            if c > ncols
                ncols = c
            end
        end
    end
    if ncols == 0 or celdas.length == 0
        return cy - y
    end
    # ancho de las columnas
    var minc: [Int] = []
    var maxc: [Int] = []
    var fija: [Bool] = []
    for i in (0..ncols - 1)
        minc.push(0)
        maxc.push(0)
        fija.push(false)
    end
    fijo = _val(e, "table-layout", "auto") == "fixed" and _val(e, "width", "auto") != "auto"
    for span in (1..ncols)
        for cel in celdas
            if cel.cols != span or (fijo and cel.fila > 0)
                continue
            end
            ce = cel.nodo.estilo
            con_ancho = _val(ce, "width", "auto") != "auto"
            mn = 0
            mx = 0
            if con_ancho
                mn = _ancho_flotante(m, cel.nodo, ancho)
                mx = mn
                if not fijo
                    # el contenido no cabe en menos que su mínimo
                    minimo = _ancho_flotante(m, cel.nodo, 1)
                    if minimo > mn
                        mn = minimo
                        mx = minimo
                    end
                end
            elif not fijo
                mn = _ancho_flotante(m, cel.nodo, 1)
                mx = _ancho_flotante(m, cel.nodo, FLEX_GRANDE)
            end
            if span == 1
                if mn > minc[cel.col]
                    minc[cel.col] = mn
                end
                if mx > maxc[cel.col]
                    maxc[cel.col] = mx
                end
                if con_ancho
                    fija[cel.col] = true
                end
            else
                tiene_n = esp * (span - 1)
                tiene_x = esp * (span - 1)
                for j in (cel.col..cel.col + span - 1)
                    tiene_n = tiene_n + minc[j]
                    tiene_x = tiene_x + maxc[j]
                end
                if mn > tiene_n
                    for j in (cel.col..cel.col + span - 1)
                        minc[j] = minc[j] + (mn - tiene_n + span - 1) / span
                    end
                end
                if mx > tiene_x
                    for j in (cel.col..cel.col + span - 1)
                        maxc[j] = maxc[j] + (mx - tiene_x + span - 1) / span
                    end
                end
            end
        end
    end
    suma_min = 0
    suma_max = 0
    for i in (0..ncols - 1)
        if maxc[i] < minc[i]
            maxc[i] = minc[i]
        end
        suma_min = suma_min + minc[i]
        suma_max = suma_max + maxc[i]
    end
    disponible = ancho - esp * (ncols + 1)
    ancho_tabla = disponible
    con_ancho_tabla = _val(e, "width", "auto") != "auto"
    if not con_ancho_tabla and suma_max < ancho_tabla
        ancho_tabla = suma_max
    end
    var anchos: [Int] = []
    if fijo
        # fixed: las columnas con ancho de la primera fila, el resto a partes iguales
        resto = ancho_tabla
        libres = 0
        for i in (0..ncols - 1)
            if fija[i] or maxc[i] > 0
                resto = resto - maxc[i]
            else
                libres = libres + 1
            end
        end
        for i in (0..ncols - 1)
            if fija[i] or maxc[i] > 0
                anchos.push(maxc[i])
            elif libres > 0 and resto > 0
                anchos.push(resto / libres)
            else
                anchos.push(0)
            end
        end
    elif ancho_tabla <= suma_min
        for i in (0..ncols - 1)
            anchos.push(minc[i])
        end
    elif ancho_tabla <= suma_max
        for i in (0..ncols - 1)
            if suma_max > suma_min
                anchos.push(minc[i] + (maxc[i] - minc[i]) * (ancho_tabla - suma_min) / (suma_max - suma_min))
            else
                anchos.push(minc[i])
            end
        end
    else
        # sobra: a las columnas sin ancho fijado, en proporción a su máximo (o a todas)
        extra = ancho_tabla - suma_max
        base = 0
        for i in (0..ncols - 1)
            if not fija[i]
                base = base + maxc[i]
            end
        end
        todas = base == 0
        if todas
            base = suma_max
        end
        for i in (0..ncols - 1)
            a = maxc[i]
            if todas or not fija[i]
                if base > 0
                    a = a + extra * maxc[i] / base
                else
                    a = a + extra / ncols
                end
            end
            anchos.push(a)
        end
    end
    var xs: [Int] = []
    px = x + esp
    for i in (0..ncols - 1)
        xs.push(px)
        px = px + anchos[i] + esp
    end
    # cada celda a su ancho: su alto
    for cel in celdas
        w = esp * (cel.cols - 1)
        for j in (cel.col..cel.col + cel.cols - 1)
            w = w + anchos[j]
        end
        cel.ancho = w
        fh = FlexHijo(cel.nodo)
        cel.alto = _flex_maquetar(m, fh, w, ancho, -1, -1)
        cel.dibujos = fh.dibujos
    end
    var altos: [Int] = []
    for r in (0..filas.length - 1)
        a = 0
        fe = filas[r].estilo
        if _val(fe, "height", "auto") != "auto" and not str_ends(_val(fe, "height", ""), "%")
            a = _px(fe, "height", 0)
        end
        altos.push(a)
    end
    for cel in celdas
        if cel.filas == 1 and cel.alto > altos[cel.fila]
            altos[cel.fila] = cel.alto
        end
    end
    for cel in celdas
        if cel.filas > 1
            tiene = esp * (cel.filas - 1)
            for i in (cel.fila..cel.fila + cel.filas - 1)
                tiene = tiene + altos[i]
            end
            if cel.alto > tiene
                ultima = cel.fila + cel.filas - 1
                altos[ultima] = altos[ultima] + cel.alto - tiene
            end
        end
    end
    var ys: [Int] = []
    py = cy + esp
    for r in (0..filas.length - 1)
        ys.push(py)
        # el fondo de la fila, debajo de sus celdas
        fe = filas[r].estilo
        if fe.has("background-color") and css_alfa(fe["background-color"]) > 0
            fondo = _dibujo(D_RECT, x + esp, py, px - x - esp * 2 + esp, altos[r], css_color_opaco(fe["background-color"]))
            fondo.nodo = filas[r]
            m.pagina.dibujos.push(fondo)
        end
        py = py + altos[r] + esp
    end
    # a su sitio, con vertical-align
    for cel in celdas
        area = esp * (cel.filas - 1)
        for i in (cel.fila..cel.fila + cel.filas - 1)
            area = area + altos[i]
        end
        ce = cel.nodo.estilo
        desplazar = 0
        if area > cel.alto
            mv = _px(ce, "margin-top", ancho) + _px(ce, "margin-bottom", ancho)
            bpv = _borde(ce, "top") + _borde(ce, "bottom") + _px(ce, "padding-top", ancho) + _px(ce, "padding-bottom", ancho)
            natural = cel.alto
            fh = FlexHijo(cel.nodo)
            _flex_maquetar(m, fh, cel.ancho, ancho, -1, area - mv - bpv)
            cel.dibujos = fh.dibujos
            va = _val(ce, "vertical-align", "middle")
            if va == "middle"
                desplazar = (area - natural) / 2
            elif va == "bottom"
                desplazar = area - natural
            end
        end
        dx = xs[cel.col]
        dy = ys[cel.fila]
        for d in cel.dibujos
            _mover(d, dx, dy)
            decoracion = d.nodo == cel.nodo and (d.tipo == D_RECT or d.tipo == D_FONDO or d.tipo == D_DEGRADADO or d.tipo == D_REDONDO or d.tipo == D_ELIPSE or d.tipo == D_LINEA)
            if not decoracion
                _mover(d, 0, desplazar)
            end
            m.pagina.dibujos.push(d)
        end
    end
    return py - y
end

func _filas(n: Nodo, filas: [Nodo])
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO and h.nombre == "tr"
            filas.push(h)
        elif h.tipo == DOM_ELEMENTO and (h.nombre == "thead" or h.nombre == "tbody" or h.nombre == "tfoot")
            _filas(h, filas)
        end
    end
end

# El elemento que hay en el punto x, y de la página (lo último que se pintó allí: un texto, una
# imagen o un fondo de caja), o nil
func maqueta_nodo_en(p: Pagina, x: Int, y: Int) -> Nodo
    i = p.dibujos.length - 1
    while i >= 0
        d = p.dibujos[i]
        if d.nodo != nil and x >= d.x and x < d.x + d.ancho and y >= d.y and y < d.y + d.alto
            return d.nodo
        end
        i = i - 1
    end
    var nada: Nodo = nil
    return nada
end


# === Flexbox (CSS Flexible Box Layout 1) ===
# Los hijos de un display: flex son elementos flex (cada uno como un bloque; el texto suelto y los elementos
# reemplazados, en una caja anónima). Se miden (tamaño base e hipotético, con min/max y el mínimo automático),
# se reparten en líneas (flex-wrap), se resuelve el espacio libre con flex-grow/flex-shrink (congelando a los que
# se pasan de su mínimo o máximo, como en el apartado 9.7), y se colocan: justify-content con los márgenes auto,
# align-items/align-self (stretch vuelve a maquetar con el alto de la línea), align-content entre líneas, order,
# gap y las direcciones invertidas. Cada elemento se maqueta en 0,0 y sus dibujos se mueven a su sitio.

struct FlexHijo
    nodo: Nodo
    base: Int = 0
    hip: Int = 0
    minimo: Int = 0          # -2: el mínimo automático, aún sin medir
    maximo: Int = -1         # -1: sin máximo
    bp: Int = 0              # bordes y rellenos en el eje principal
    mi: Int = 0              # márgenes en el eje principal (0 si son auto)
    mf: Int = 0
    auto_i: Bool = false
    auto_f: Bool = false
    crecer: Int = 0          # flex-grow x 1000
    encoger: Int = 1000      # flex-shrink x 1000
    meta: Int = 0            # el tamaño principal que le toca (del contenido)
    congelado: Bool = false
    cruz: Int = 0            # su tamaño exterior en el eje cruzado (márgenes incluidos)
    dibujos: [Dibujo] = nil  # lo suyo, maquetado en 0,0
    medido: Int = -1         # el tamaño principal con el que se maquetó (-1: aún no)
    ancho_usado: Int = 0     # columnas: el ancho exterior con el que se maquetó
    linea: Int = 0
    pos: Int = 0             # dónde empieza su caja de márgenes en el eje principal
    pos_cruz: Int = 0
end

struct FlexLinea
    ini: Int
    fin: Int                 # (sin incluir)
    cruz: Int = 0
    pos: Int = 0
end

const FLEX_GRANDE = 4000

func _val(e: {String: String}, p: String, defecto: String) -> String
    if e.has(p) and e[p] != ""
        return e[p]
    end
    return defecto
end

# "1", "0.5", ".25" -> x 1000 (negativo o raro: 0)
func _mil(v: String) -> Int
    entero = 0
    frac = 0
    cifras = 0
    punto = false
    for i in (0..v.length - 1)
        c = str_code(v, i)
        if c == 46
            punto = true
        elif c >= 48 and c <= 57
            if punto
                if cifras < 3
                    frac = frac * 10 + c - 48
                    cifras = cifras + 1
                end
            else
                entero = entero * 10 + c - 48
            end
        else
            return 0
        end
    end
    while cifras < 3
        frac = frac * 10
        cifras = cifras + 1
    end
    return entero * 1000 + frac
end

# Un elemento que no tiene hijos que maquetar (se pone como una pieza dentro de una caja anónima)
func _reemplazado(h: Nodo) -> Bool
    n = h.nombre
    return n == "img" or n == "video" or n == "iframe" or n == "input" or n == "select" or n == "textarea" or n == "button" or n == "svg" or n == "canvas" or n == "object" or n == "embed" or dom_es_video(h)
end

# Una caja anónima con lo que hereda de n (el texto suelto de un contenedor flex)
func _anonima(n: Nodo) -> Nodo
    a = dom_nodo(DOM_ELEMENTO, "div", "")
    for k in n.estilo.keys()
        if estilo_se_hereda(k)
            a.estilo[k] = n.estilo[k]
        end
    end
    a.estilo["display"] = "block"
    return a
end

# Los elementos flex de n, ya ordenados por order (estable)
func _flex_hijos(n: Nodo) -> [Nodo]
    var r: [Nodo] = []
    var texto: Nodo = nil
    for h in _hijos(n)
        if _oculto(h) or _fuera_del_flujo(h)
            continue
        end
        if h.tipo != DOM_ELEMENTO
            if _solo_blanco(h)
                continue
            end
            if texto == nil
                texto = _anonima(n)
                r.push(texto)
            end
            texto.hijos.push(h)
            continue
        end
        var nada: Nodo = nil
        texto = nada
        if _reemplazado(h)
            caja = _anonima(n)
            caja.hijos.push(h)
            r.push(caja)
        else
            r.push(h)
        end
    end
    # order: inserción estable
    i = 1
    while i < r.length
        j = i
        while j > 0 and Int(_val(r[j - 1].estilo, "order", "0")) > Int(_val(r[j].estilo, "order", "0"))
            x = r[j - 1]
            r[j - 1] = r[j]
            r[j] = x
            j = j - 1
        end
        i = i + 1
    end
    return r
end

# Maqueta el elemento en 0,0 con ese ancho exterior y, si no son -1, ese ancho y alto de contenido (forzados
# mientras tanto en su estilo); guarda sus dibujos aparte y devuelve el alto exterior (márgenes incluidos)
func _flex_maquetar(m: Maquetador, it: FlexHijo, ancho_ext: Int, contenedor: Int, w: Int, h: Int) -> Int
    e = it.nodo.estilo
    var guardado: {String: String} = {}
    nombres = ["width", "min-width", "max-width", "height", "min-height", "max-height", "box-sizing"]
    for k in nombres
        if e.has(k)
            guardado[k] = e[k]
        end
    end
    if w >= 0
        e["width"] = "" + w + "px"
        e["min-width"] = "0"
        e["max-width"] = "none"
        e["box-sizing"] = "content-box"
    end
    if h >= 0
        e["height"] = "" + h + "px"
        e["min-height"] = "0"
        e["max-height"] = "none"
        e["box-sizing"] = "content-box"
    end
    antes = m.pagina.dibujos.length
    alto = _bloque_de(m, it.nodo, 0, 0, ancho_ext, contenedor)
    var suyos: [Dibujo] = []
    i = antes
    while i < m.pagina.dibujos.length
        suyos.push(m.pagina.dibujos[i])
        i = i + 1
    end
    while m.pagina.dibujos.length > antes
        m.pagina.dibujos.pop()
    end
    it.dibujos = suyos
    for k in nombres
        if guardado.has(k)
            e[k] = guardado[k]
        elif e.has(k)
            e.remove(k)
        end
    end
    return alto
end

# Un tamaño de contenido de una propiedad (width, flex-basis...) con box-sizing; -1 si es auto o no se sabe
func _flex_tam(e: {String: String}, p: String, cien: Int, bp: Int) -> Int
    v = _val(e, p, "auto")
    if v == "auto" or v == "none" or v == "content" or v == "max-content" or v == "min-content" or v == "fit-content"
        return -1
    end
    if str_ends(v, "%") and cien < 0
        return -1
    end
    r = _px(e, p, cien)
    if _val(e, "box-sizing", "content-box") == "border-box"
        r = r - bp
    end
    if r < 0
        r = 0
    end
    return r
end

func _flex_limitar(it: FlexHijo, v: Int) -> Int
    r = v
    if it.maximo >= 0 and r > it.maximo
        r = it.maximo
    end
    if r < it.minimo
        r = it.minimo
    end
    return r
end

# Mide el elemento: márgenes, bordes y rellenos del eje principal, tamaño base e hipotético, mínimo y máximo
func _flex_base(m: Maquetador, it: FlexHijo, fila: Bool, ancho: Int, alto_fijo: Int, estirar: Bool)
    e = it.nodo.estilo
    it.crecer = _mil(_val(e, "flex-grow", "0"))
    it.encoger = _mil(_val(e, "flex-shrink", "1"))
    if fila
        it.auto_i = _val(e, "margin-left", "0") == "auto"
        it.auto_f = _val(e, "margin-right", "0") == "auto"
        it.mi = _px(e, "margin-left", ancho)
        it.mf = _px(e, "margin-right", ancho)
        it.bp = _borde(e, "left") + _borde(e, "right") + _px(e, "padding-left", ancho) + _px(e, "padding-right", ancho)
    else
        it.auto_i = _val(e, "margin-top", "0") == "auto"
        it.auto_f = _val(e, "margin-bottom", "0") == "auto"
        it.mi = _px(e, "margin-top", ancho)
        it.mf = _px(e, "margin-bottom", ancho)
        it.bp = _borde(e, "top") + _borde(e, "bottom") + _px(e, "padding-top", ancho) + _px(e, "padding-bottom", ancho)
    end
    if it.auto_i
        it.mi = 0
    end
    if it.auto_f
        it.mf = 0
    end
    prop = "width"
    cien = ancho
    if not fila
        prop = "height"
        cien = alto_fijo
    end
    base = _flex_tam(e, "flex-basis", cien, it.bp)
    if base < 0 and _val(e, "flex-basis", "auto") == "auto"
        base = _flex_tam(e, prop, cien, it.bp)
    end
    if base < 0
        # el contenido
        if fila
            base = _ancho_flotante(m, it.nodo, FLEX_GRANDE) - it.mi - it.mf - it.bp
        else
            it.ancho_usado = _flex_ancho_columna(m, it, ancho, estirar)
            base = _flex_maquetar(m, it, it.ancho_usado, ancho, -1, -1) - it.mi - it.mf - it.bp
            it.medido = base
        end
    end
    if base < 0
        base = 0
    end
    it.base = base
    it.maximo = _flex_tam(e, "max-" + prop, cien, it.bp)
    minimo = _flex_tam(e, "min-" + prop, cien, it.bp)
    if minimo < 0
        minimo = 0
        # mínimo automático (4.5): en filas, lo menos que ocupa su contenido (sin pasar de su width)
        if fila and _val(e, "overflow", "visible") == "visible"
            minimo = -2
        end
    end
    it.minimo = minimo
    if it.minimo != -2
        it.hip = _flex_limitar(it, base)
    else
        it.hip = base
        if it.maximo >= 0 and it.hip > it.maximo
            it.hip = it.maximo
        end
    end
end

# El mínimo automático de una fila, cuando hace falta (encoger): el contenido más estrecho posible
func _flex_minimo(m: Maquetador, it: FlexHijo)
    if it.minimo != -2
        return
    end
    minimo = _ancho_flotante(m, it.nodo, 1) - it.mi - it.mf - it.bp
    puesto = _flex_tam(it.nodo.estilo, "width", -1, it.bp)
    if puesto >= 0 and puesto < minimo
        minimo = puesto
    end
    if it.maximo >= 0 and minimo > it.maximo
        minimo = it.maximo
    end
    if minimo < 0
        minimo = 0
    end
    it.minimo = minimo
end

# Columnas: el ancho exterior del elemento (stretch con width auto: todo; si no, lo que pide, sin pasarse)
func _flex_ancho_columna(m: Maquetador, it: FlexHijo, ancho: Int, estirar: Bool) -> Int
    if estirar and _val(it.nodo.estilo, "width", "auto") == "auto"
        return ancho
    end
    w = _ancho_flotante(m, it.nodo, ancho)
    if w > ancho
        w = ancho
    end
    return w
end

func _flex_alineacion(n: Nodo, contenedor: {String: String}) -> String
    a = _val(n.estilo, "align-self", "auto")
    if a == "auto"
        a = _val(contenedor, "align-items", "stretch")
    end
    if a == "normal"
        a = "stretch"
    end
    return a
end

# Reparte el espacio libre de una línea (9.7): meta de cada elemento
func _flex_resolver(m: Maquetador, items: [FlexHijo], ini: Int, fin: Int, principal: Int, gap: Int)
    usado = gap * (fin - ini - 1)
    for i in (ini..fin - 1)
        it = items[i]
        usado = usado + it.hip + it.bp + it.mi + it.mf
    end
    crecer = usado < principal
    for i in (ini..fin - 1)
        it = items[i]
        if not crecer
            _flex_minimo(m, it)
            it.hip = _flex_limitar(it, it.base)
        end
        it.meta = it.hip
        it.congelado = false
        factor = it.encoger
        if crecer
            factor = it.crecer
        end
        if factor == 0 or (crecer and it.base > it.hip) or (not crecer and it.base < it.hip)
            it.congelado = true
        end
    end
    vueltas = 0
    while vueltas < 20
        vueltas = vueltas + 1
        libre = principal - gap * (fin - ini - 1)
        suma = 0
        quedan = 0
        for i in (ini..fin - 1)
            it = items[i]
            if it.congelado
                libre = libre - it.meta - it.bp - it.mi - it.mf
            else
                libre = libre - it.base - it.bp - it.mi - it.mf
                quedan = quedan + 1
                if crecer
                    suma = suma + it.crecer
                else
                    suma = suma + it.encoger / 10 * it.base
                end
            end
        end
        if quedan == 0
            break
        end
        # con flex-grow que suman menos de 1, solo esa parte del espacio libre
        if crecer and suma < 1000
            libre = libre * suma / 1000
        end
        violacion = 0
        for i in (ini..fin - 1)
            it = items[i]
            if not it.congelado
                v = it.base
                if crecer and libre > 0 and suma > 0
                    v = it.base + libre * it.crecer / suma
                elif not crecer and libre < 0 and suma > 0
                    v = it.base + libre * (it.encoger / 10 * it.base) / suma
                end
                limitado = _flex_limitar(it, v)
                violacion = violacion + limitado - v
                it.meta = v
            end
        end
        # se congelan todos (sin violación), los que se quedaron cortos (positiva) o los que se pasaron (negativa)
        for i in (ini..fin - 1)
            it = items[i]
            if not it.congelado
                limitado = _flex_limitar(it, it.meta)
                if violacion == 0 or (violacion > 0 and limitado > it.meta) or (violacion < 0 and limitado < it.meta)
                    it.meta = limitado
                    it.congelado = true
                end
            end
        end
    end
end

# Coloca el contenido flex de n en (x, y) con ese ancho; alto_fijo: el alto de su contenido si está fijado (o -1).
# Devuelve el alto del contenido.
func _flex(m: Maquetador, n: Nodo, x: Int, y: Int, ancho: Int, alto_fijo: Int) -> Int
    e = n.estilo
    dir = _val(e, "flex-direction", "row")
    fila = dir == "row" or dir == "row-reverse"
    inverso = str_ends(dir, "-reverse")
    envolver = _val(e, "flex-wrap", "nowrap") != "nowrap"
    gap_fila = 0
    gap_col = 0
    if _val(e, "row-gap", "normal") != "normal"
        gap_fila = _px(e, "row-gap", ancho)
    end
    if _val(e, "column-gap", "normal") != "normal"
        gap_col = _px(e, "column-gap", ancho)
    end
    gap = gap_fila
    gap_c = gap_col
    principal = alto_fijo
    if fila
        gap = gap_col
        gap_c = gap_fila
        principal = ancho
    end
    var items: [FlexHijo] = []
    for h in _flex_hijos(n)
        it = FlexHijo(h)
        _flex_base(m, it, fila, ancho, alto_fijo, _flex_alineacion(h, e) == "stretch")
        items.push(it)
    end
    if items.length == 0
        return 0
    end
    # líneas
    var lineas: [FlexLinea] = []
    ini = 0
    usado = 0
    for i in (0..items.length - 1)
        it = items[i]
        ext = it.hip + it.bp + it.mi + it.mf
        if envolver and principal >= 0 and i > ini and usado + gap + ext > principal
            lineas.push(FlexLinea(ini, i))
            ini = i
            usado = 0
        end
        if i > ini
            usado = usado + gap
        end
        usado = usado + ext
        it.linea = lineas.length
    end
    lineas.push(FlexLinea(ini, items.length))
    # tamaño principal de cada uno
    for l in lineas
        if principal >= 0
            _flex_resolver(m, items, l.ini, l.fin, principal, gap)
        else
            for i in (l.ini..l.fin - 1)
                items[i].meta = _flex_limitar(items[i], items[i].hip)
            end
        end
    end
    # maquetados a su tamaño principal: su tamaño cruzado
    for it in items
        if fila
            it.cruz = _flex_maquetar(m, it, it.meta + it.bp + it.mi + it.mf, ancho, it.meta, -1)
        else
            if it.ancho_usado == 0
                it.ancho_usado = _flex_ancho_columna(m, it, ancho, _flex_alineacion(it.nodo, e) == "stretch")
            end
            if it.medido != it.meta
                _flex_maquetar(m, it, it.ancho_usado, ancho, -1, it.meta)
                it.medido = it.meta
            end
            it.cruz = it.ancho_usado
        end
    end
    # tamaño cruzado de cada línea
    cruz_fija = -1
    if fila
        cruz_fija = alto_fijo
    else
        cruz_fija = ancho
    end
    total_cruz = 0
    for l in lineas
        c = 0
        for i in (l.ini..l.fin - 1)
            if items[i].cruz > c
                c = items[i].cruz
            end
        end
        if lineas.length == 1 and cruz_fija >= 0
            c = cruz_fija
        end
        l.cruz = c
        total_cruz = total_cruz + c
    end
    total_cruz = total_cruz + gap_c * (lineas.length - 1)
    # align-content (varias líneas, con el tamaño cruzado del contenedor fijado)
    inicio_c = 0
    entre_c = gap_c
    if lineas.length > 1 and cruz_fija >= 0
        libre_c = cruz_fija - total_cruz
        ac = _val(e, "align-content", "normal")
        if (ac == "normal" or ac == "stretch") and libre_c > 0
            extra = libre_c / lineas.length
            for l in lineas
                l.cruz = l.cruz + extra
            end
        elif ac == "center"
            inicio_c = libre_c / 2
        elif ac == "flex-end" or ac == "end"
            inicio_c = libre_c
        elif ac == "space-between" and libre_c > 0
            entre_c = gap_c + libre_c / (lineas.length - 1)
        elif ac == "space-around" and libre_c > 0
            inicio_c = libre_c / (lineas.length * 2)
            entre_c = gap_c + libre_c / lineas.length
        elif ac == "space-evenly" and libre_c > 0
            inicio_c = libre_c / (lineas.length + 1)
            entre_c = gap_c + libre_c / (lineas.length + 1)
        end
    end
    pos_c = inicio_c
    for l in lineas
        l.pos = pos_c
        pos_c = pos_c + l.cruz + entre_c
    end
    # stretch: con el tamaño cruzado de su línea
    for it in items
        l = lineas[it.linea]
        ne = it.nodo.estilo
        if _flex_alineacion(it.nodo, e) != "stretch"
            continue
        end
        if fila
            if _val(ne, "height", "auto") == "auto" and _val(ne, "margin-top", "0") != "auto" and _val(ne, "margin-bottom", "0") != "auto" and it.cruz != l.cruz
                mv = _px(ne, "margin-top", ancho) + _px(ne, "margin-bottom", ancho)
                bpv = _borde(ne, "top") + _borde(ne, "bottom") + _px(ne, "padding-top", ancho) + _px(ne, "padding-bottom", ancho)
                h = l.cruz - mv - bpv
                if h >= 0
                    it.cruz = _flex_maquetar(m, it, it.meta + it.bp + it.mi + it.mf, ancho, it.meta, h)
                end
            end
        else
            if _val(ne, "width", "auto") == "auto" and _val(ne, "margin-left", "0") != "auto" and _val(ne, "margin-right", "0") != "auto" and it.ancho_usado != l.cruz
                it.ancho_usado = l.cruz
                _flex_maquetar(m, it, it.ancho_usado, ancho, -1, it.meta)
                it.cruz = it.ancho_usado
            end
        end
    end
    # eje principal: márgenes auto y justify-content, línea a línea
    tam_principal = principal
    if tam_principal < 0
        tam_principal = 0
        for l in lineas
            u = gap * (l.fin - l.ini - 1)
            for i in (l.ini..l.fin - 1)
                u = u + items[i].meta + items[i].bp + items[i].mi + items[i].mf
            end
            if u > tam_principal
                tam_principal = u
            end
        end
    end
    jc = _val(e, "justify-content", "normal")
    for l in lineas
        cuantos = l.fin - l.ini
        u = gap * (cuantos - 1)
        autos = 0
        for i in (l.ini..l.fin - 1)
            it = items[i]
            u = u + it.meta + it.bp + it.mi + it.mf
            if it.auto_i
                autos = autos + 1
            end
            if it.auto_f
                autos = autos + 1
            end
        end
        libre = tam_principal - u
        por_auto = 0
        if autos > 0 and libre > 0
            por_auto = libre / autos
            libre = 0
        end
        inicio = 0
        entre = gap
        if jc == "flex-end" or jc == "end" or jc == "right"
            inicio = libre
        elif jc == "center"
            inicio = libre / 2
        elif jc == "space-between"
            if libre > 0 and cuantos > 1
                entre = gap + libre / (cuantos - 1)
            end
        elif jc == "space-around"
            if libre > 0
                inicio = libre / (cuantos * 2)
                entre = gap + libre / cuantos
            else
                inicio = libre / 2
            end
        elif jc == "space-evenly"
            if libre > 0
                inicio = libre / (cuantos + 1)
                entre = gap + libre / (cuantos + 1)
            else
                inicio = libre / 2
            end
        end
        p = inicio
        for i in (l.ini..l.fin - 1)
            it = items[i]
            if it.auto_i
                p = p + por_auto
            end
            it.pos = p
            p = p + it.meta + it.bp + it.mi + it.mf
            if it.auto_f
                p = p + por_auto
            end
            p = p + entre
            if inverso
                it.pos = tam_principal - it.pos - (it.meta + it.bp + it.mi + it.mf)
            end
            # eje cruzado dentro de la línea
            a = _flex_alineacion(it.nodo, e)
            it.pos_cruz = l.pos
            if a == "flex-end" or a == "end" or a == "self-end"
                it.pos_cruz = l.pos + l.cruz - it.cruz
            elif a == "center"
                it.pos_cruz = l.pos + (l.cruz - it.cruz) / 2
            end
        end
    end
    # a su sitio
    for it in items
        dx = x + it.pos
        dy = y + it.pos_cruz
        if not fila
            dx = x + it.pos_cruz
            dy = y + it.pos
        end
        for d in it.dibujos
            _mover(d, dx, dy)
            m.pagina.dibujos.push(d)
        end
    end
    if fila
        return total_cruz
    end
    return tam_principal
end

# === Grid (CSS Grid Layout 1) ===
# Pistas (grid-template-columns/rows: px, %, fr, auto, min-content, max-content, minmax(), fit-content(),
# repeat() con auto-fill/auto-fit; los nombres de línea se saltan), áreas (grid-template-areas), colocación
# explícita (números, negativos, span, nombres de área) y automática (grid-auto-flow row o column), pistas
# implícitas (grid-auto-rows/columns), tamaño de las pistas (lo que pide el contenido de los elementos de una
# pista, el espacio que sobra hasta su límite, y las fr con lo que queda), gap, justify/align-content de las
# pistas y justify/align-self de cada elemento (stretch vuelve a maquetar con el alto del área). Como en flex,
# cada elemento se maqueta en 0,0 y sus dibujos se mueven a su sitio.

const PISTA_FIJA = 0
const PISTA_AUTO = 1
const PISTA_MIN = 2      # min-content
const PISTA_MAX = 3      # max-content
const PISTA_FR = 4

struct Pista
    tmin: Int = 1
    vmin: Int = 0
    tmax: Int = 1
    vmax: Int = 0        # px, o fr x 1000
    base: Int = 0
    limite: Int = -1     # -1: infinito
    pos: Int = 0
end

struct GridHijo
    nodo: Nodo
    f0: Int = -1         # filas [f0, f1) y columnas [c0, c1); -1: aún sin sitio
    f1: Int = -1
    c0: Int = -1
    c1: Int = -1
    span_f: Int = 1
    span_c: Int = 1
    dibujos: [Dibujo] = nil
    alto: Int = 0        # exterior (márgenes incluidos), maquetado al ancho de su área
    ancho_ext: Int = 0
    minimo: Int = -1     # contribuciones de ancho (exteriores), cuando hacen falta
    maximo: Int = -1
end

# Una medida de pista: "100px", "1fr", "auto", "min-content", "max-content", "20%"; total: el 100 % (-1: no se
# sabe: auto)
func _pista_medida(t: String, total: Int, e: {String: String}) -> [Int]
    x = str_lower(str_trim(t))
    if x == "auto" or x == ""
        return [PISTA_AUTO, 0]
    elif x == "min-content"
        return [PISTA_MIN, 0]
    elif x == "max-content"
        return [PISTA_MAX, 0]
    elif str_ends(x, "fr")
        return [PISTA_FR, _mil(x[:x.length - 2])]
    elif str_ends(x, "%") and total < 0
        return [PISTA_AUTO, 0]
    end
    return [PISTA_FIJA, estilo_px(x, estilo_px(_val(e, "font-size", "16px"), 0, 0), total)]
end

func _pista_de(t: String, total: Int, e: {String: String}) -> Pista
    x = str_lower(str_trim(t))
    p = Pista()
    if str_starts(x, "minmax(") and str_ends(x, ")")
        partes = css_partir(x[7:x.length - 1], 44)
        if partes.length == 2
            a = _pista_medida(partes[0], total, e)
            b = _pista_medida(partes[1], total, e)
            p.tmin = a[0]
            p.vmin = a[1]
            p.tmax = b[0]
            p.vmax = b[1]
            if p.tmin == PISTA_FR
                p.tmin = PISTA_AUTO
            end
            return p
        end
    end
    if str_starts(x, "fit-content(") and str_ends(x, ")")
        # como minmax(auto, max-content) sin pasar del límite
        p.tmin = PISTA_AUTO
        p.tmax = PISTA_FIJA
        p.vmax = estilo_px(x[12:x.length - 1], 16, total)
        return p
    end
    a = _pista_medida(x, total, e)
    p.tmin = a[0]
    p.vmin = a[1]
    p.tmax = a[0]
    p.vmax = a[1]
    if a[0] == PISTA_FR
        p.tmin = PISTA_AUTO
    end
    return p
end

# grid-template-columns/rows en pistas; total: el tamaño del contenedor en ese eje (-1: no se sabe)
func _grid_pistas(v: String, total: Int, gap: Int, e: {String: String}) -> [Pista]
    var r: [Pista] = []
    x = str_trim(v)
    if x == "" or x == "none"
        return r
    end
    for t in css_partir(x, 32)
        tt = str_trim(t)
        if tt == "" or str_starts(tt, "[")
            continue
        end
        if str_starts(str_lower(tt), "repeat(") and str_ends(tt, ")")
            dentro = tt[7:tt.length - 1]
            coma = str_find(dentro, ",")
            if coma < 0
                continue
            end
            cuantas_t = str_lower(str_trim(dentro[:coma]))
            var trozo: [Pista] = _grid_pistas(dentro[coma + 1:], total, gap, e)
            if trozo.length == 0
                continue
            end
            veces = 1
            if cuantas_t == "auto-fill" or cuantas_t == "auto-fit"
                # tantas como quepan (con el tamaño fijo de cada una, o su mínimo fijo)
                mide = 0
                for p in trozo
                    if p.tmax == PISTA_FIJA
                        mide = mide + p.vmax
                    elif p.tmin == PISTA_FIJA
                        mide = mide + p.vmin
                    end
                end
                mide = mide + gap * trozo.length
                if total > 0 and mide > 0
                    veces = (total + gap) / mide
                end
                if veces < 1
                    veces = 1
                end
            else
                veces = Int(cuantas_t)
            end
            for k in (1..veces)
                for p in trozo
                    q = Pista(p.tmin, p.vmin, p.tmax, p.vmax)
                    r.push(q)
                end
            end
        else
            r.push(_pista_de(tt, total, e))
        end
    end
    return r
end

# grid-template-areas: nombre -> [f0, f1, c0, c1]
func _grid_areas(v: String) -> {String: [Int]}
    var r: {String: [Int]} = {}
    fila = 0
    i = 0
    while i < v.length
        if str_code(v, i) == 34 or str_code(v, i) == 39
            q = str_code(v, i)
            j = i + 1
            while j < v.length and str_code(v, j) != q
                j = j + 1
            end
            col = 0
            for nombre in css_partir(str_trim(v[i + 1:j]), 32)
                nn = str_trim(nombre)
                if nn == ""
                    continue
                end
                if not str_starts(nn, ".")
                    if r.has(nn)
                        a = r[nn]
                        if fila + 1 > a[1]
                            a[1] = fila + 1
                        end
                        if col + 1 > a[3]
                            a[3] = col + 1
                        end
                    else
                        r[nn] = [fila, fila + 1, col, col + 1]
                    end
                end
                col = col + 1
            end
            fila = fila + 1
            i = j + 1
        else
            i = i + 1
        end
    end
    return r
end

# Una línea de grid-column/row-start/end: [línea (0..), span] ; línea -1: auto
func _grid_linea(v: String, lineas: Int, areas: {String: [Int]}, fin: Bool, fila: Bool) -> [Int]
    x = str_lower(str_trim(v))
    if x == "" or x == "auto"
        return [-1, 1]
    end
    if str_starts(x, "span")
        n = Int(str_trim(x[4:]))
        if n < 1
            n = 1
        end
        return [-1, n]
    end
    if areas.has(x)
        a = areas[x]
        k = 0
        if fila
            k = 0
        else
            k = 2
        end
        if fin
            return [a[k + 1], 1]
        end
        return [a[k], 1]
    end
    n = Int(x)
    if n > 0
        return [n - 1, 1]
    elif n < 0
        r = lineas + n
        if r < 0
            r = 0
        end
        return [r, 1]
    end
    return [-1, 1]
end

# El sitio de un elemento en un eje: [inicio, fin] (-1: auto) y su span
func _grid_sitio(e: {String: String}, eje: String, lineas: Int, areas: {String: [Int]}, fila: Bool) -> [Int]
    ini = _val(e, "grid-" + eje + "-start", "auto")
    fin = _val(e, "grid-" + eje + "-end", "auto")
    if e.has("grid-" + eje)
        partes = css_partir(e["grid-" + eje], 47)
        ini = str_trim(partes[0])
        fin = "auto"
        if partes.length > 1
            fin = str_trim(partes[1])
        elif areas.has(str_lower(ini))
            fin = ini
        end
    end
    if e.has("grid-area")
        partes = css_partir(e["grid-area"], 47)
        if partes.length == 1
            ini = str_trim(partes[0])
            fin = ini
        else
            k = 0
            if not fila
                k = 1
            end
            if partes.length > k
                ini = str_trim(partes[k])
            end
            if partes.length > k + 2
                fin = str_trim(partes[k + 2])
            end
        end
    end
    a = _grid_linea(ini, lineas, areas, false, fila)
    b = _grid_linea(fin, lineas, areas, true, fila)
    if a[0] >= 0 and b[0] >= 0
        if b[0] <= a[0]
            return [a[0], a[0] + 1, 1]
        end
        return [a[0], b[0], b[0] - a[0]]
    end
    span = a[1]
    if b[1] > span
        span = b[1]
    end
    if a[0] >= 0
        return [a[0], a[0] + span, span]
    end
    if b[0] >= 0
        i = b[0] - span
        if i < 0
            i = 0
        end
        return [i, b[0], span]
    end
    return [-1, -1, span]
end

func _grid_libre(ocupado: {String: Bool}, f0: Int, f1: Int, c0: Int, c1: Int) -> Bool
    for f in (f0..f1 - 1)
        for c in (c0..c1 - 1)
            if ocupado.has("" + f + "," + c)
                return false
            end
        end
    end
    return true
end

func _grid_ocupar(ocupado: {String: Bool}, it: GridHijo)
    for f in (it.f0..it.f1 - 1)
        for c in (it.c0..it.c1 - 1)
            ocupado["" + f + "," + c] = true
        end
    end
end

# Tamaño de las pistas de un eje (12.3-12.7, simplificado): base y límite de cada una por su tipo y por lo que
# piden los elementos de una sola pista (los de varias reparten lo que les falta), el espacio libre hasta los
# límites, las fr con lo que queda y las auto estiradas (justify/align-content normal)
func _grid_medir(pistas: [Pista], items: [GridHijo], columnas: Bool, total: Int, gap: Int, estirar: Bool, m: Maquetador)
    n = pistas.length
    for p in pistas
        p.base = 0
        p.limite = -1
        if p.tmin == PISTA_FIJA
            p.base = p.vmin
        end
        if p.tmax == PISTA_FIJA
            p.limite = p.vmax
            if p.limite < p.base
                p.limite = p.base
            end
        end
    end
    # lo que piden los elementos
    for span in (1..n)
        for it in items
            i0 = it.c0
            i1 = it.c1
            if not columnas
                i0 = it.f0
                i1 = it.f1
            end
            if i1 - i0 != span
                continue
            end
            con_fr = false
            intrinseca = false
            for k in (i0..i1 - 1)
                if pistas[k].tmax == PISTA_FR
                    con_fr = true
                end
                if pistas[k].tmin != PISTA_FIJA or pistas[k].tmax != PISTA_FIJA
                    intrinseca = true
                end
            end
            if not intrinseca or (con_fr and span > 1)
                continue
            end
            pide_min = 0
            pide_max = 0
            if columnas
                if it.minimo < 0
                    it.minimo = _ancho_flotante(m, it.nodo, 1)
                    it.maximo = _ancho_flotante(m, it.nodo, FLEX_GRANDE)
                end
                pide_min = it.minimo
                pide_max = it.maximo
            else
                pide_min = it.alto
                pide_max = it.alto
            end
            # lo que ya tienen sus pistas (con los huecos de en medio)
            tiene_b = gap * (span - 1)
            tiene_l = gap * (span - 1)
            for k in (i0..i1 - 1)
                tiene_b = tiene_b + pistas[k].base
                if pistas[k].limite >= 0
                    tiene_l = tiene_l + pistas[k].limite
                else
                    tiene_l = tiene_l + pistas[k].base
                end
            end
            # el mínimo a las pistas intrínsecas (auto, min-content, max-content), a partes iguales
            cuantas = 0
            for k in (i0..i1 - 1)
                if pistas[k].tmin != PISTA_FIJA
                    cuantas = cuantas + 1
                end
            end
            pide = pide_min
            for k in (i0..i1 - 1)
                if pistas[k].tmin == PISTA_MAX
                    pide = pide_max
                end
            end
            if cuantas > 0 and pide > tiene_b
                extra = (pide - tiene_b + cuantas - 1) / cuantas
                for k in (i0..i1 - 1)
                    if pistas[k].tmin != PISTA_FIJA
                        pistas[k].base = pistas[k].base + extra
                    end
                end
            end
            # el máximo a las pistas con límite intrínseco
            cuantas = 0
            for k in (i0..i1 - 1)
                if pistas[k].tmax == PISTA_AUTO or pistas[k].tmax == PISTA_MAX or pistas[k].tmax == PISTA_MIN
                    cuantas = cuantas + 1
                end
            end
            pide = pide_max
            if cuantas > 0
                ya = gap * (span - 1)
                for k in (i0..i1 - 1)
                    if pistas[k].limite >= 0
                        ya = ya + pistas[k].limite
                    else
                        ya = ya + pistas[k].base
                    end
                end
                for k in (i0..i1 - 1)
                    tk = pistas[k].tmax
                    if tk == PISTA_AUTO or tk == PISTA_MAX or tk == PISTA_MIN
                        if pistas[k].limite < 0
                            pistas[k].limite = pistas[k].base
                        end
                        if pide > ya
                            pistas[k].limite = pistas[k].limite + (pide - ya + cuantas - 1) / cuantas
                        end
                        if tk == PISTA_MIN and pistas[k].limite > pistas[k].base
                            pistas[k].limite = pistas[k].base
                        end
                    end
                end
            end
        end
    end
    for p in pistas
        if p.tmax != PISTA_FR and p.limite >= 0 and p.limite < p.base
            p.limite = p.base
        end
        if p.tmax != PISTA_FR and p.limite < 0
            p.limite = p.base
        end
    end
    if total < 0
        return
    end
    # el espacio libre, hasta los límites, a partes iguales
    usado = gap * (n - 1)
    for p in pistas
        usado = usado + p.base
    end
    libre = total - usado
    vueltas = 0
    while libre > 0 and vueltas < 10
        vueltas = vueltas + 1
        cuantas = 0
        for p in pistas
            if p.tmax != PISTA_FR and p.base < p.limite
                cuantas = cuantas + 1
            end
        end
        if cuantas == 0
            break
        end
        parte = libre / cuantas
        if parte < 1
            parte = 1
        end
        for p in pistas
            if libre > 0 and p.tmax != PISTA_FR and p.base < p.limite
                d = p.limite - p.base
                if d > parte
                    d = parte
                end
                if d > libre
                    d = libre
                end
                p.base = p.base + d
                libre = libre - d
            end
        end
    end
    # las fr: lo que queda, en proporción (sin bajar de su base)
    suma_fr = 0
    for p in pistas
        if p.tmax == PISTA_FR
            suma_fr = suma_fr + p.vmax
        end
    end
    if suma_fr > 0
        quedan = total - gap * (n - 1)
        for p in pistas
            if p.tmax != PISTA_FR
                quedan = quedan - p.base
            end
        end
        # las fr cuya base es mayor que su parte se quedan con su base (y se vuelve a repartir)
        var fija: [Bool] = []
        for p in pistas
            fija.push(false)
        end
        vueltas = 0
        while vueltas < 10
            vueltas = vueltas + 1
            resto = quedan
            sf = 0
            for k in (0..n - 1)
                if pistas[k].tmax == PISTA_FR
                    if fija[k]
                        resto = resto - pistas[k].base
                    else
                        sf = sf + pistas[k].vmax
                    end
                end
            end
            if sf == 0
                break
            end
            if sf < 1000
                sf = 1000
            end
            cambio = false
            for k in (0..n - 1)
                if pistas[k].tmax == PISTA_FR and not fija[k]
                    t = resto * pistas[k].vmax / sf
                    if t < pistas[k].base
                        fija[k] = true
                        cambio = true
                    end
                end
            end
            if not cambio
                for k in (0..n - 1)
                    if pistas[k].tmax == PISTA_FR and not fija[k]
                        t = resto * pistas[k].vmax / sf
                        if t < 0
                            t = 0
                        end
                        pistas[k].base = t
                    end
                end
                break
            end
        end
        libre = 0
    else
        usado = gap * (n - 1)
        for p in pistas
            usado = usado + p.base
        end
        libre = total - usado
    end
    # las auto se estiran con lo que sobre
    if estirar and libre > 0
        cuantas = 0
        for p in pistas
            if p.tmax == PISTA_AUTO
                cuantas = cuantas + 1
            end
        end
        if cuantas > 0
            for p in pistas
                if p.tmax == PISTA_AUTO
                    p.base = p.base + libre / cuantas
                end
            end
        end
    end
end

# Dónde empieza cada pista con justify/align-content; devuelve el tamaño total
func _grid_colocar(pistas: [Pista], total: Int, gap: Int, alineacion: String) -> Int
    n = pistas.length
    usado = gap * (n - 1)
    for p in pistas
        usado = usado + p.base
    end
    inicio = 0
    entre = gap
    libre = total - usado
    if total >= 0 and libre > 0
        if alineacion == "center"
            inicio = libre / 2
        elif alineacion == "end" or alineacion == "flex-end"
            inicio = libre
        elif alineacion == "space-between" and n > 1
            entre = gap + libre / (n - 1)
        elif alineacion == "space-around"
            inicio = libre / (n * 2)
            entre = gap + libre / n
        elif alineacion == "space-evenly"
            inicio = libre / (n + 1)
            entre = gap + libre / (n + 1)
        end
    end
    pos = inicio
    for p in pistas
        p.pos = pos
        pos = pos + p.base + entre
    end
    if n == 0
        return 0
    end
    return pistas[n - 1].pos + pistas[n - 1].base
end

func _grid_pista_auto(v: String, total: Int, e: {String: String}) -> Pista
    var ps: [Pista] = _grid_pistas(v, total, 0, e)
    if ps.length == 0
        return Pista()
    end
    return Pista(ps[0].tmin, ps[0].vmin, ps[0].tmax, ps[0].vmax)
end

# Coloca el contenido grid de n en (x, y) con ese ancho (alto_fijo: el alto del contenido, o -1); su alto
func _grid(m: Maquetador, n: Nodo, x: Int, y: Int, ancho: Int, alto_fijo: Int) -> Int
    e = n.estilo
    gap_f = 0
    gap_c = 0
    if _val(e, "row-gap", "normal") != "normal"
        gap_f = _px(e, "row-gap", ancho)
    end
    if _val(e, "column-gap", "normal") != "normal"
        gap_c = _px(e, "column-gap", ancho)
    end
    var cols: [Pista] = _grid_pistas(_val(e, "grid-template-columns", "none"), ancho, gap_c, e)
    var filas: [Pista] = _grid_pistas(_val(e, "grid-template-rows", "none"), alto_fijo, gap_f, e)
    areas = _grid_areas(_val(e, "grid-template-areas", ""))
    for nombre in areas.keys()
        a = areas[nombre]
        while filas.length < a[1]
            filas.push(_grid_pista_auto(_val(e, "grid-auto-rows", "auto"), alto_fijo, e))
        end
        while cols.length < a[3]
            cols.push(_grid_pista_auto(_val(e, "grid-auto-columns", "auto"), ancho, e))
        end
    end
    explicitas_c = cols.length
    explicitas_f = filas.length
    por_columnas = str_starts(_val(e, "grid-auto-flow", "row"), "column")
    var items: [GridHijo] = []
    for h in _flex_hijos(n)
        it = GridHijo(h)
        sc = _grid_sitio(h.estilo, "column", explicitas_c + 1, areas, false)
        sf = _grid_sitio(h.estilo, "row", explicitas_f + 1, areas, true)
        it.c0 = sc[0]
        it.c1 = sc[1]
        it.span_c = sc[2]
        it.f0 = sf[0]
        it.f1 = sf[1]
        it.span_f = sf[2]
        items.push(it)
    end
    if items.length == 0
        return 0
    end
    # colocación: primero los que tienen sitio, luego los demás por orden (sin dense)
    var ocupado: {String: Bool} = {}
    ancho_rejilla = explicitas_c
    if ancho_rejilla < 1
        ancho_rejilla = 1
    end
    alto_rejilla = explicitas_f
    if alto_rejilla < 1
        alto_rejilla = 1
    end
    for it in items
        if it.c0 >= 0 and it.f0 >= 0
            _grid_ocupar(ocupado, it)
        end
    end
    cf = 0
    cc = 0
    for it in items
        if it.c0 >= 0 and it.f0 >= 0
            continue
        end
        if not por_columnas
            if it.span_c > ancho_rejilla and it.c0 < 0
                ancho_rejilla = it.span_c
            end
            if it.f0 >= 0
                c = 0
                while not _grid_libre(ocupado, it.f0, it.f1, c, c + it.span_c)
                    c = c + 1
                end
                it.c0 = c
                it.c1 = c + it.span_c
            elif it.c0 >= 0
                f = cf
                while not _grid_libre(ocupado, f, f + it.span_f, it.c0, it.c1)
                    f = f + 1
                end
                it.f0 = f
                it.f1 = f + it.span_f
                cf = f
            else
                vueltas = 0
                while vueltas < 10000
                    vueltas = vueltas + 1
                    if cc + it.span_c > ancho_rejilla
                        cc = 0
                        cf = cf + 1
                    end
                    if _grid_libre(ocupado, cf, cf + it.span_f, cc, cc + it.span_c)
                        break
                    end
                    cc = cc + 1
                end
                it.f0 = cf
                it.f1 = cf + it.span_f
                it.c0 = cc
                it.c1 = cc + it.span_c
                cc = cc + it.span_c
            end
        else
            if it.span_f > alto_rejilla and it.f0 < 0
                alto_rejilla = it.span_f
            end
            if it.c0 >= 0
                f = 0
                while not _grid_libre(ocupado, f, f + it.span_f, it.c0, it.c1)
                    f = f + 1
                end
                it.f0 = f
                it.f1 = f + it.span_f
            elif it.f0 >= 0
                c = cc
                while not _grid_libre(ocupado, it.f0, it.f1, c, c + it.span_c)
                    c = c + 1
                end
                it.c0 = c
                it.c1 = c + it.span_c
                cc = c
            else
                vueltas = 0
                while vueltas < 10000
                    vueltas = vueltas + 1
                    if cf + it.span_f > alto_rejilla
                        cf = 0
                        cc = cc + 1
                    end
                    if _grid_libre(ocupado, cf, cf + it.span_f, cc, cc + it.span_c)
                        break
                    end
                    cf = cf + 1
                end
                it.f0 = cf
                it.f1 = cf + it.span_f
                it.c0 = cc
                it.c1 = cc + it.span_c
                cf = cf + it.span_f
            end
        end
        _grid_ocupar(ocupado, it)
    end
    # pistas implícitas
    for it in items
        while cols.length < it.c1
            cols.push(_grid_pista_auto(_val(e, "grid-auto-columns", "auto"), ancho, e))
        end
        while filas.length < it.f1
            filas.push(_grid_pista_auto(_val(e, "grid-auto-rows", "auto"), alto_fijo, e))
        end
    end
    # auto-fit: las columnas repetidas que quedan vacías miden 0 (aquí: las del final sin nadie)
    if str_find(_val(e, "grid-template-columns", ""), "auto-fit") >= 0
        ultima = 0
        for it in items
            if it.c1 > ultima
                ultima = it.c1
            end
        end
        while cols.length > ultima and cols.length > 0
            cols.pop()
        end
    end
    # columnas
    jc = _val(e, "justify-content", "normal")
    _grid_medir(cols, items, true, ancho, gap_c, jc == "normal" or jc == "stretch", m)
    _grid_colocar(cols, ancho, gap_c, jc)
    # cada elemento maquetado al ancho de su área (o al suyo si no se estira): su alto
    ji = _val(e, "justify-items", "normal")
    for it in items
        area = cols[it.c1 - 1].pos + cols[it.c1 - 1].base - cols[it.c0].pos
        js = _val(it.nodo.estilo, "justify-self", "auto")
        if js == "auto"
            js = ji
        end
        # stretch (normal) con width auto: el área entera; con width, o con otra alineación: lo suyo
        w = area
        if _val(it.nodo.estilo, "width", "auto") != "auto" or (js != "normal" and js != "stretch")
            w = _ancho_flotante(m, it.nodo, area)
            if w > area
                w = area
            end
        end
        it.ancho_ext = w
        fh = FlexHijo(it.nodo)
        it.alto = _flex_maquetar(m, fh, w, area, -1, -1)
        it.dibujos = fh.dibujos
    end
    # filas
    ac = _val(e, "align-content", "normal")
    _grid_medir(filas, items, false, alto_fijo, gap_f, ac == "normal" or ac == "stretch", m)
    total_f = _grid_colocar(filas, alto_fijo, gap_f, ac)
    # cada uno en su área: stretch con el alto del área, o start/center/end
    ai = _val(e, "align-items", "normal")
    for it in items
        area_x = cols[it.c0].pos
        area_w = cols[it.c1 - 1].pos + cols[it.c1 - 1].base - area_x
        area_y = filas[it.f0].pos
        area_h = filas[it.f1 - 1].pos + filas[it.f1 - 1].base - area_y
        al = _val(it.nodo.estilo, "align-self", "auto")
        if al == "auto"
            al = ai
        end
        ne = it.nodo.estilo
        if (al == "normal" or al == "stretch") and _val(ne, "height", "auto") == "auto" and it.alto != area_h
            mv = _px(ne, "margin-top", area_w) + _px(ne, "margin-bottom", area_w)
            bpv = _borde(ne, "top") + _borde(ne, "bottom") + _px(ne, "padding-top", area_w) + _px(ne, "padding-bottom", area_w)
            h = area_h - mv - bpv
            if h >= 0
                fh = FlexHijo(it.nodo)
                it.alto = _flex_maquetar(m, fh, it.ancho_ext, area_w, it.ancho_ext - _px(ne, "margin-left", area_w) - _px(ne, "margin-right", area_w) - _borde(ne, "left") - _borde(ne, "right") - _px(ne, "padding-left", area_w) - _px(ne, "padding-right", area_w), h)
                it.dibujos = fh.dibujos
            end
        end
        dy = area_y
        if al == "center"
            dy = area_y + (area_h - it.alto) / 2
        elif al == "end" or al == "flex-end" or al == "self-end"
            dy = area_y + area_h - it.alto
        end
        js = _val(ne, "justify-self", "auto")
        if js == "auto"
            js = _val(e, "justify-items", "normal")
        end
        dx = area_x
        if js == "center"
            dx = area_x + (area_w - it.ancho_ext) / 2
        elif js == "end" or js == "right" or js == "flex-end"
            dx = area_x + area_w - it.ancho_ext
        end
        for d in it.dibujos
            _mover(d, x + dx, y + dy)
            m.pagina.dibujos.push(d)
        end
    end
    if alto_fijo >= 0
        return alto_fijo
    end
    return total_f
end

# border-radius (1 a 4 valores, px, em o %; la parte de después de / se salta): los cuatro radios en un Int (un
# byte cada uno, sin pasar de la mitad del lado menor); 0 si no hay
func _radios(e: {String: String}, ancho: Int, alto: Int) -> Int
    v = _val(e, "border-radius", "")
    if v == "" or v == "0" or v == "0px"
        return 0
    end
    p = str_find(v, "/")
    if p >= 0
        v = v[:p]
    end
    var t: [String] = []
    for x in css_partir(str_trim(v), 32)
        if str_trim(x) != ""
            t.push(str_trim(x))
        end
    end
    if t.length == 0
        return 0
    end
    while t.length < 4
        if t.length == 1
            t.push(t[0])
        elif t.length == 2
            t.push(t[0])
        else
            t.push(t[1])
        end
    end
    menor = ancho
    if alto < menor
        menor = alto
    end
    em = estilo_px(_val(e, "font-size", "16px"), 0, 0)
    r = 0
    for k in (0..3)
        x = estilo_px(t[k], em, menor)
        if x > menor / 2
            x = menor / 2
        end
        if x > 255
            x = 255
        end
        if x < 0
            x = 0
        end
        r = r * 256 + x
    end
    return r
end

# box-shadow: la primera sombra que no es inset: un rectángulo semitransparente (con difuminado, más claro);
# v: [x, y, difuminado, extensión]
func _sombra(valor: String, em: Int, v: [Int]) -> Dibujo
    var nada: Dibujo = nil
    for una in css_partir(valor, 44)
        if str_find(una, "inset") >= 0
            continue
        end
        var largos: [Int] = []
        color = "rgba(0,0,0,0.3)"
        for t in css_partir(str_trim(una), 32)
            tt = str_trim(t)
            if tt == ""
                continue
            end
            c = str_code(tt, 0)
            if (c >= 48 and c <= 57) or c == 45 or c == 46
                largos.push(estilo_px(tt, em, 0))
            else
                color = tt
            end
        end
        if largos.length < 2
            continue
        end
        for k in (0..3)
            if k < largos.length
                v[k] = largos[k]
            else
                v[k] = 0
            end
        end
        rgb = css_color_opaco(color)
        if rgb < 0
            return nada
        end
        alfa = css_alfa(color)
        if v[2] > 0
            alfa = alfa * 3 / 5      # difuminada: más clara
        end
        if alfa <= 0
            return nada
        end
        d = _dibujo(D_RECT, 0, 0, 0, 0, rgb)
        if alfa < 255
            d.espaciado = alfa
        end
        return d
    end
    return nada
end

# aspect-ratio: "16 / 9", "1.5", "auto 4/3": ancho/alto x 1000 (0 si no se entiende)
func _proporcion(v: String) -> Int
    x = str_replace(str_lower(v), "auto", "")
    p = str_find(x, "/")
    if p < 0
        return _mil(str_trim(x))
    end
    a = _mil(str_trim(x[:p]))
    b = _mil(str_trim(x[p + 1:]))
    if b <= 0
        return 0
    end
    return a * 1000 / b
end
