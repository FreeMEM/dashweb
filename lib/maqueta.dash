# Maquetación: del árbol con estilo (lib/estilo.dash) a una lista de dibujo con posiciones.
#
#   p = maquetar(doc, 600)          # ancho disponible en píxeles
#   for d in p.dibujos              # D_RECT, D_TEXTO, D_LINEA, D_IMAGEN
#       ...
#   end
#   Print p.alto                    # alto total de la página
#
# Mide el texto con las fuentes del Amiga (font_ de Dash), así que necesita un RastPort
# (una ventana abierta, o la zona de dibujo de MUI). Flujo normal: cajas de bloque (márgenes
# que se funden entre hermanos, bordes, relleno, width/height, fondos) y líneas de texto
# (cortes, espacios colapsados o pre, text-align); listas con su marca; tablas sencillas
# (celdas del mismo ancho); imágenes como un hueco de su tamaño; float en filas (el texto aún no los
# rodea). position, más adelante.

import "estilo.dash"
import "colores.dash"

const D_RECT = 1
const D_TEXTO = 2
const D_LINEA = 3
const D_IMAGEN = 4
const D_CONTROL = 5      # un control de formulario (input, select, button): lo pinta el pintor según su nodo
const D_ICONO = 7        # un icono de una fuente de iconos (Font Awesome): texto, su código en hexadecimal
const D_FONDO = 6        # la imagen de fondo de una caja (texto: su dirección); background-size, -position y
                         # -repeat los mira el pintor en el estilo del nodo
const D_ELIPSE = 8       # una caja redonda (border-radius: 50 %): estilo, el grosor del borde (0: rellena)
const D_DEGRADADO = 10   # un linear-gradient de fondo: color/estilo, el primer color y su alfa (0-255);
                         # fuente/espaciado, el último; texto "v" (de arriba abajo) o "h" (de izquierda a derecha)
const D_VIDEO = 11       # un vídeo (<video>): texto, su dirección; nodo, el elemento (lib/videos.dash lo pinta)
const D_TRAZO = 9        # una barra girada 45 grados (transform: rotate): estilo 0 de arriba a la izquierda
                         # abajo a la derecha, 1 de abajo a la izquierda arriba a la derecha; fuente, su grosor

const EST_SUBRAYADO = 1
const EST_NEGRITA = 2
const EST_CURSIVA = 4

struct Dibujo
    tipo: Int
    x: Int
    y: Int
    ancho: Int
    alto: Int
    color: Int
    texto: String
    fuente: Int
    estilo: Int
    enlace: String
    nodo: Nodo = nil     # el elemento que lo puso (para saber qué hay bajo un clic)
    espaciado: Int = 0   # letter-spacing: px de más detrás de cada letra (el pintor las pone una a una)
end

struct Pagina
    dibujos: [Dibujo]
    ancho: Int
    alto: Int
    fondo: Int
end

# Un trozo de una línea: una palabra (o una imagen, o un salto de línea forzado)
struct Pieza
    texto: String
    ancho: Int
    alto: Int
    base: Int
    fuente: Int
    estilo: Int
    color: Int
    tachado: Bool
    enlace: String
    espacio: Int
    salto: Bool
    imagen: Bool
    pegada: Bool = false     # sin blanco con la anterior: no se puede cortar la línea entre las dos
    nodo: Nodo = nil         # el elemento de la palabra o la imagen
    control: Bool = false    # un control de formulario (nodo: el input, select o button)
    espaciado: Int = 0       # letter-spacing en px
    icono: Bool = false      # un icono (texto: su código en hexadecimal)
    caja: Nodo = nil         # un inline-block maquetado como bloque en su sitio de la línea (ancho: con márgenes)
    video: Bool = false      # un <video> (texto: su dirección)
end

# Los hijos de n con su ::before delante y su ::after detrás (lib/estilo.dash)
func _hijos(n: Nodo) -> [Nodo]
    if n.pseudo_antes == nil and n.pseudo_despues == nil
        return n.hijos
    end
    var r: [Nodo] = []
    if n.pseudo_antes != nil
        r.push(n.pseudo_antes)
    end
    for h in n.hijos
        r.push(h)
    end
    if n.pseudo_despues != nil
        r.push(n.pseudo_despues)
    end
    return r
end

struct Maquetador
    pagina: Pagina
    fuentes: {String: Int}
    topaz: Int
    blanco: Int = 0      # un blanco detrás de una imagen: el ancho del espacio que toma la pieza siguiente
    ancho_linea: Int = 0 # el ancho de las líneas del bloque que se está maquetando
end

# Para depurar (tools/traza_maqueta.dash): cuántos niveles de cajas se escriben al maquetar (0: ninguno)
var maqueta_traza: Int = 0
var _maqueta_nivel: Int = 0

func _trazar(n: Nodo, x: Int, y: Int, ancho: Int, alto: Int, que: String)
    if _maqueta_nivel > maqueta_traza
        return
    end
    sangria = ""
    for i in (1.._maqueta_nivel)
        sangria = sangria + "  "
    end
    nombre = n.nombre
    if dom_atributo(n, "id") != ""
        nombre = nombre + "#" + dom_atributo(n, "id")
    end
    if dom_atributo(n, "class") != ""
        nombre = nombre + "." + str_replace(str_trim(dom_atributo(n, "class")), " ", ".")
    end
    Print sangria + nombre + " " + que + " [" + x + "," + y + " " + ancho + "x" + alto + "] " + n.estilo["display"]
end

func _dibujo(tipo: Int, x: Int, y: Int, ancho: Int, alto: Int, color: Int) -> Dibujo
    return Dibujo(tipo, x, y, ancho, alto, color, "", 0, 0, "")
end

# === Fuentes ===

# Fuente del Amiga para una familia CSS y un tamaño: la de mapa de bits si tiene ese tamaño (nítida),
# si no la vectorial parecida (CGTriumvirate, CGTimes, LetterGothic: bullet.library las dibuja a
# cualquier tamaño) y, si no hay, la de mapa de bits más cercana; la topaz de la ROM si no hay otra
func _fuente(m: Maquetador, familia: String, tam: Int) -> Int
    # primero por el font-family tal cual (suele ser una lista larga: mirarla entera cuesta)
    cruda = familia + "|" + tam
    if m.fuentes.has(cruda)
        return m.fuentes[cruda]
    end
    h = _fuente_de(m, familia, tam)
    m.fuentes[cruda] = h
    return h
end

func _fuente_de(m: Maquetador, familia: String, tam: Int) -> Int
    f = str_lower(familia)
    nombre = "helvetica"
    vectorial = "CGTriumvirate"
    if str_find(f, "mono") >= 0 or str_find(f, "courier") >= 0 or str_find(f, "consol") >= 0
        nombre = "courier"
        vectorial = "LetterGothic"
    elif (str_find(f, "serif") >= 0 and str_find(f, "sans") < 0) or str_find(f, "times") >= 0 or str_find(f, "georgia") >= 0
        nombre = "times"
        vectorial = "CGTimes"
    end
    clave = nombre + "/" + tam
    if m.fuentes.has(clave)
        return m.fuentes[clave]
    end
    h = 0
    if not _tamano_de_mapa(nombre, tam)
        # el tamaño de una vectorial del Amiga es el alto de la línea entera: las letras salen más bajas
        # que con el mismo font-size en un navegador (medido con freemem.space contra Chrome)
        h = font_open(vectorial + ".font", tam * 6 / 5)
    end
    if h == 0
        h = font_open(nombre + ".font", tam)
    end
    if h == 0
        h = m.topaz
    end
    m.fuentes[clave] = h
    return h
end

# Los tamaños que traen las fuentes de mapa de bits del Workbench
func _tamano_de_mapa(nombre: String, tam: Int) -> Bool
    if tam == 11 or tam == 13 or tam == 15 or tam == 18 or tam == 24
        return true
    end
    return nombre == "helvetica" and tam == 9
end

func _estilo_texto(e: {String: String}) -> Int
    r = 0
    w = e["font-weight"]
    if w == "bold" or w == "bolder" or w == "700" or w == "800" or w == "900" or w == "600"
        r = r + EST_NEGRITA
    end
    if e["font-style"] == "italic" or e["font-style"] == "oblique"
        r = r + EST_CURSIVA
    end
    return r
end

func _px(e: {String: String}, prop: String, cien: Int) -> Int
    if not e.has(prop)
        return 0
    end
    return estilo_px(e[prop], estilo_px(e["font-size"], 0, 0), cien)
end

func _borde(e: {String: String}, lado: String) -> Int
    tipo = "none"
    if e.has("border-" + lado + "-style")
        tipo = e["border-" + lado + "-style"]
    end
    if tipo == "none" or tipo == "hidden"
        return 0
    end
    a = "medium"
    if e.has("border-" + lado + "-width")
        a = e["border-" + lado + "-width"]
    end
    if a == "thin"
        return 1
    elif a == "medium"
        return 3
    elif a == "thick"
        return 5
    end
    return estilo_px(a, estilo_px(e["font-size"], 0, 0), 0)
end

func _es_bloque(n: Nodo) -> Bool
    if n.tipo != DOM_ELEMENTO
        return false
    end
    d = n.estilo["display"]
    return d == "block" or d == "list-item" or d == "table" or d == "table-row" or d == "table-row-group" or d == "table-cell" or d == "flex" or d == "grid"
end

func _oculto(n: Nodo) -> Bool
    return n.tipo == DOM_ELEMENTO and n.estilo["display"] == "none"
end

# === Página ===

# Las fuentes abiertas, para todas las páginas del programa (abrir una, sobre todo vectorial, cuesta;
# antes se abrían otra vez, sin cerrarse, cada vez que se maquetaba)
var _fuentes_abiertas: {String: Int} = {}
var _topaz: Int = 0

func maquetar(doc: Nodo, ancho: Int) -> Pagina
    var dibujos: [Dibujo] = []
    p = Pagina(dibujos, ancho, 0, 16777215)
    if _topaz == 0
        _topaz = font_open("topaz.font", 8)
    end
    m = Maquetador(p, _fuentes_abiertas, _topaz)
    html = dom_buscar(doc, "html")
    if html == nil
        return p
    end
    cuerpo = dom_buscar(html, "body")
    for raiz in [html, cuerpo]
        if raiz != nil and raiz.estilo.has("background-color") and css_color(raiz.estilo["background-color"]) >= 0
            p.fondo = css_color(raiz.estilo["background-color"])
        end
    end
    p.alto = _bloque(m, html, 0, 0, ancho)
    return p
end

# Coloca un elemento de bloque en (x, y) con ese ancho; devuelve el alto que ocupa, márgenes incluidos
func _bloque(m: Maquetador, n: Nodo, x: Int, y: Int, ancho: Int) -> Int
    return _bloque_de(m, n, x, y, ancho, ancho)
end

# Lo mismo con los tantos por ciento (width, márgenes, rellenos) del ancho del contenedor: un flotante
# o un absoluto recibe su ancho ya resuelto (el 25 % del contenedor) y no hay que volver a aplicarlo
func _bloque_de(m: Maquetador, n: Nodo, x: Int, y: Int, ancho: Int, contenedor: Int) -> Int
    _maqueta_nivel = _maqueta_nivel + 1
    antes = m.pagina.dibujos.length
    r = _bloque_en(m, n, x, y, ancho, contenedor)
    if n.estilo.has("transform") and n.estilo["transform"] != "none"
        _transformar(m, n.estilo["transform"], antes)
    end
    if _invisible(n)
        # ocupa su sitio pero no se pinta (visibility: hidden, opacity: 0)
        while m.pagina.dibujos.length > antes
            m.pagina.dibujos.pop()
        end
    end
    _maqueta_nivel = _maqueta_nivel - 1
    if maqueta_traza > 0
        _trazar(n, x, y, ancho, r, "")
    end
    return r
end

func _bloque_en(m: Maquetador, n: Nodo, x: Int, y: Int, ancho: Int, contenedor: Int) -> Int
    e = n.estilo
    mt = _px(e, "margin-top", contenedor)
    mb = _px(e, "margin-bottom", contenedor)
    ml = _px(e, "margin-left", contenedor)
    mr = _px(e, "margin-right", contenedor)
    bt = _borde(e, "top")
    bb = _borde(e, "bottom")
    bl = _borde(e, "left")
    br = _borde(e, "right")
    pt = _px(e, "padding-top", contenedor)
    pb = _px(e, "padding-bottom", contenedor)
    pl = _px(e, "padding-left", contenedor)
    pr = _px(e, "padding-right", contenedor)
    interior = ancho - ml - mr - bl - br - pl - pr
    if e.has("width") and e["width"] != "auto"
        w = _px(e, "width", contenedor)
        if e.has("box-sizing") and e["box-sizing"] == "border-box"
            w = w - bl - br - pl - pr
        end
        if w > 0 and w <= interior
            # margin: auto a los dos lados centra
            if e.has("margin-left") and e.has("margin-right") and e["margin-left"] == "auto" and e["margin-right"] == "auto"
                ml = (ancho - w - bl - br - pl - pr) / 2
            end
            interior = w
        end
    end
    if e.has("max-width") and e["max-width"] != "none"
        mx = _px(e, "max-width", contenedor)
        if e.has("box-sizing") and e["box-sizing"] == "border-box"
            mx = mx - bl - br - pl - pr
        end
        if mx > 0 and interior > mx
            if e.has("margin-left") and e.has("margin-right") and e["margin-left"] == "auto" and e["margin-right"] == "auto"
                ml = (ancho - mx - bl - br - pl - pr) / 2
            end
            interior = mx
        end
    end
    if interior < 1
        interior = 1
    end
    # el fondo va antes que el contenido: se pone ahora y se mide al final
    fondo = -1
    alfa_fondo = 255
    if e.has("background-color")
        fondo = css_color_opaco(e["background-color"])
        alfa_fondo = css_alfa(e["background-color"])
        if alfa_fondo == 0
            fondo = -1
        end
    end
    var caja_fondo: Dibujo = nil
    if fondo >= 0
        caja_fondo = _dibujo(D_RECT, x + ml, y + mt, interior + bl + br + pl + pr, 0, fondo)
        caja_fondo.nodo = n
        if alfa_fondo < 255
            caja_fondo.espaciado = alfa_fondo     # un rectángulo con espaciado > 0: mezclado con esa opacidad
        end
        m.pagina.dibujos.push(caja_fondo)
    end
    var degradado: Dibujo = nil
    if e.has("background-image") and _es_degradado(e["background-image"])
        degradado = _degradado(e["background-image"], x + ml, y + mt, interior + bl + br + pl + pr)
        if degradado != nil
            degradado.nodo = n
            m.pagina.dibujos.push(degradado)
        end
    end
    var imagen_fondo: Dibujo = nil
    if e.has("background-image") and css_url(e["background-image"]) != ""
        imagen_fondo = _dibujo(D_FONDO, x + ml + bl, y + mt + bt, interior + pl + pr, 0, 0)
        imagen_fondo.texto = css_url(e["background-image"])
        imagen_fondo.nodo = n
        m.pagina.dibujos.push(imagen_fondo)
    end
    cx = x + ml + bl + pl
    cy = y + mt + bt + pt
    alto = 0
    if e["display"] == "table"
        alto = _tabla(m, n, cx, cy, interior)
    else
        alto = _contenido(m, n, cx, cy, interior)
    end
    if e["display"] == "list-item"
        _marca(m, n, cx, cy)
    end
    if e.has("height") and e["height"] != "auto" and not str_ends(e["height"], "%")
        alto = _px(e, "height", 0)
        if e.has("box-sizing") and e["box-sizing"] == "border-box"
            alto = alto - bt - bb - pt - pb
        end
    end
    if e.has("min-height") and not str_ends(e["min-height"], "%")
        minimo = _px(e, "min-height", 0)
        if e.has("box-sizing") and e["box-sizing"] == "border-box"
            minimo = minimo - bt - bb - pt - pb
        end
        if alto < minimo
            alto = minimo
        end
    end
    if alto < 0
        alto = 0
    end
    # los hijos con position absolute o fixed, encima, respecto a esta caja (su relleno)
    for h in _hijos(n)
        if _fuera_del_flujo(h) and not _oculto(h)
            _absoluto(m, h, x + ml + bl, y + mt + bt, interior + pl + pr, pt + alto + pb, pl, pt)
        end
    end
    alto_caja = bt + pt + alto + pb + bb
    redonda = _redonda(e, interior + bl + br + pl + pr, alto_caja)
    if caja_fondo != nil
        caja_fondo.alto = alto_caja
        if redonda
            caja_fondo.tipo = D_ELIPSE
            caja_fondo.estilo = 0
        end
    end
    if imagen_fondo != nil
        imagen_fondo.alto = pt + alto + pb
    end
    if degradado != nil
        degradado.alto = alto_caja
    end
    if redonda and bt > 0 and bt == br and bt == bb and bt == bl
        borde = _dibujo(D_ELIPSE, x + ml, y + mt, interior + bl + br + pl + pr, alto_caja, _color_borde(e, "top"))
        borde.estilo = bt
        borde.nodo = n
        m.pagina.dibujos.push(borde)
    else
        _bordes(m, e, x + ml, y + mt, interior + bl + br + pl + pr, alto_caja, bt, br, bb, bl)
    end
    return mt + alto_caja + mb
end

# linear-gradient(...), también con prefijo (-webkit-, -moz-, -o-: la sintaxis vieja)
func _es_degradado(v: String) -> Bool
    l = str_lower(str_trim(v))
    return str_starts(l, "linear-gradient(") or str_starts(l, "-webkit-linear-gradient(") or str_starts(l, "-moz-linear-gradient(") or str_starts(l, "-o-linear-gradient(")
end

# Un linear-gradient: la dirección (to top/bottom/left/right o un ángulo) y su primer y último color
# (sin las posiciones de cada parada); nil si no se entiende
func _degradado(v: String, x: Int, y: Int, ancho: Int) -> Dibujo
    var nada: Dibujo = nil
    a = str_find(v, "(")
    z = str_find_from(v, ")", a)
    k = v.length - 1
    while k > a and str_code(v, k) != 41
        k = k - 1
    end
    if a < 0 or k <= a
        return nada
    end
    partes = css_partir(v[a + 1:k], 44)
    vertical = true
    al_reves = false
    primera = 0
    d = str_lower(str_trim(partes[0]))
    if str_code(str_trim(v), 0) == 45
        # con prefijo, la dirección es el lado donde empieza: top = to bottom, left = to right...
        if d == "top" or d == "bottom" or d == "left" or d == "right"
            if d == "top"
                d = "to bottom"
            elif d == "bottom"
                d = "to top"
            elif d == "left"
                d = "to right"
            else
                d = "to left"
            end
        end
    end
    if str_starts(d, "to ") or str_ends(d, "deg") or str_ends(d, "turn")
        primera = 1
        if d == "to top"
            al_reves = true
        elif d == "to right"
            vertical = false
        elif d == "to left"
            vertical = false
            al_reves = true
        elif str_ends(d, "deg")
            g = ((Int(d[:d.length - 3]) % 360) + 360) % 360
            if g < 45 or g >= 315
                al_reves = true
            elif g < 135
                vertical = false
            elif g >= 225
                vertical = false
                al_reves = true
            end
        end
    end
    if partes.length - primera < 2
        return nada
    end
    c1 = _parada(partes[primera])
    c2 = _parada(partes[partes.length - 1])
    if al_reves
        t = c1
        c1 = c2
        c2 = t
    end
    r = _dibujo(D_DEGRADADO, x, y, ancho, 0, css_color_opaco(c1))
    r.estilo = css_alfa(c1)
    r.fuente = css_color_opaco(c2)
    r.espaciado = css_alfa(c2)
    r.texto = "v"
    if not vertical
        r.texto = "h"
    end
    if r.color < 0 or r.fuente < 0 or (r.estilo == 0 and r.espaciado == 0)
        return nada
    end
    return r
end

# El color de una parada ("rgba(0,0,0,.5) 0px", "red 40%"): lo de antes del primer blanco fuera de paréntesis
func _parada(p: String) -> String
    s = str_trim(p)
    b = css_partir(s, 32)
    return b[0]
end

# border-radius de la mitad (o más) del lado menor en una caja casi cuadrada: un círculo o una elipse
func _redonda(e: {String: String}, ancho: Int, alto: Int) -> Bool
    if not e.has("border-radius") or ancho < 2 or alto < 2 or ancho > alto * 2 or alto > ancho * 2
        return false         # una barra con las puntas redondas se queda en rectángulo
    end
    r = str_trim(e["border-radius"])
    if str_find(r, " ") >= 0 or str_find(r, "/") >= 0
        return false
    end
    if str_ends(r, "%")
        return Int(r[:r.length - 1]) >= 50
    end
    menor = ancho
    if alto < menor
        menor = alto
    end
    return estilo_px(r, estilo_px(e["font-size"], 0, 0), 0) * 2 >= menor
end

# transform: translate (px o % de la propia caja) mueve lo dibujado; rotate en múltiplos de 45 grados
# gira una barra (una caja que es un solo rectángulo) sobre su centro
func _transformar(m: Maquetador, t: String, antes: Int)
    n = m.pagina.dibujos.length - antes
    if n <= 0
        return
    end
    # la caja: lo que abarca lo dibujado
    x1 = 1000000
    y1 = 1000000
    x2 = -1000000
    y2 = -1000000
    i = antes
    while i < m.pagina.dibujos.length
        d = m.pagina.dibujos[i]
        if d.x < x1
            x1 = d.x
        end
        if d.y < y1
            y1 = d.y
        end
        if d.x + d.ancho > x2
            x2 = d.x + d.ancho
        end
        if d.y + d.alto > y2
            y2 = d.y + d.alto
        end
        i = i + 1
    end
    dx = 0
    dy = 0
    giro = 0
    resto = str_lower(t)
    while true
        p = str_find(resto, "(")
        c = str_find(resto, ")")
        if p < 0 or c < p
            break
        end
        f = str_trim(resto[:p])
        a = resto[p + 1:c]
        b = ""
        coma = str_find(a, ",")
        if coma >= 0
            b = a[coma + 1:]
            a = a[:coma]
        end
        resto = resto[c + 1:]
        if f == "translatex"
            dx = dx + _desplazamiento(a, x2 - x1)
        elif f == "translatey"
            dy = dy + _desplazamiento(a, y2 - y1)
        elif f == "translate"
            dx = dx + _desplazamiento(a, x2 - x1)
            if b != ""
                dy = dy + _desplazamiento(b, y2 - y1)
            end
        elif f == "rotate"
            a = str_trim(a)
            if str_ends(a, "deg")
                giro = giro + Int(a[:a.length - 3])
            end
        end
    end
    if giro % 45 == 0 and giro % 180 != 0 and n == 1 and m.pagina.dibujos[antes].tipo == D_RECT
        d = m.pagina.dibujos[antes]
        largo = d.ancho
        grueso = d.alto
        angulo = giro
        if d.alto > d.ancho
            largo = d.alto
            grueso = d.ancho
            angulo = angulo + 90
        end
        angulo = ((angulo % 180) + 180) % 180
        cx = d.x + d.ancho / 2
        cy = d.y + d.alto / 2
        if angulo == 0
            d.x = cx - largo / 2
            d.y = cy - grueso / 2
            d.ancho = largo
            d.alto = grueso
        elif angulo == 90
            d.x = cx - grueso / 2
            d.y = cy - largo / 2
            d.ancho = grueso
            d.alto = largo
        else
            mitad = largo * 707 / 2000
            d.tipo = D_TRAZO
            d.x = cx - mitad
            d.y = cy - mitad
            d.ancho = mitad * 2 + 1
            d.alto = mitad * 2 + 1
            d.fuente = grueso
            d.estilo = 0
            if angulo == 135
                d.estilo = 1
            end
        end
    end
    if dx != 0 or dy != 0
        i = antes
        while i < m.pagina.dibujos.length
            m.pagina.dibujos[i].x = m.pagina.dibujos[i].x + dx
            m.pagina.dibujos[i].y = m.pagina.dibujos[i].y + dy
            i = i + 1
        end
    end
end

func _desplazamiento(v: String, propio: Int) -> Int
    a = str_trim(v)
    if str_ends(a, "%")
        return Int(a[:a.length - 1]) * propio / 100
    end
    return estilo_px(a, 0, 0)
end

# float: left o right; "" si no flota. Un inline-block que lleva bloques dentro, o tiene width o
# height, va como uno de la izquierda (en una fila con sus hermanos)
func _flota(n: Nodo) -> String
    if n.tipo != DOM_ELEMENTO or _fuera_del_flujo(n)
        return ""
    end
    if n.estilo.has("float")
        f = n.estilo["float"]
        if f == "left" or f == "right"
            return f
        end
    end
    if _caja_en_linea(n) and not _alineado(n)
        return "left"
    end
    return ""
end

# Un inline-block que lleva bloques dentro o tiene width o height: se maqueta como un bloque. Con el
# texto del padre centrado o a la derecha va en la línea (una pieza); si no, flota a la izquierda.
func _caja_en_linea(n: Nodo) -> Bool
    if n.estilo["display"] == "inline-block" or n.estilo["display"] == "inline-flex"
        if (n.estilo.has("width") and n.estilo["width"] != "auto") or (n.estilo.has("height") and n.estilo["height"] != "auto")
            return true
        end
        for h in n.hijos
            if _es_bloque(h) and not _oculto(h)
                return true
            end
        end
    end
    return false
end

func _alineado(n: Nodo) -> Bool
    if n.padre == nil
        return false
    end
    a = n.padre.estilo["text-align"]
    return a == "center" or a == "right"
end

func _invisible(n: Nodo) -> Bool
    e = n.estilo
    if e.has("visibility") and (e["visibility"] == "hidden" or e["visibility"] == "collapse")
        return true
    end
    return e.has("opacity") and (e["opacity"] == "0" or str_starts(e["opacity"], "0.0") or e["opacity"] == ".0")
end

func _fuera_del_flujo(n: Nodo) -> Bool
    if n.tipo != DOM_ELEMENTO or not n.estilo.has("position")
        return false
    end
    p = n.estilo["position"]
    return p == "absolute" or p == "fixed"
end

# Un elemento con position absolute (o fixed) dentro de la caja (cx, cy, cw, ch): top/left/right/
# bottom; sin left ni right, a la izquierda; sin top ni bottom, arriba. El ancho: left y right, su
# width, o lo que mide su contenido.
func _absoluto(m: Maquetador, n: Nodo, cx: Int, cy: Int, cw: Int, ch: Int, pl: Int, pt: Int)
    e = n.estilo
    tiene_l = e.has("left") and e["left"] != "auto"
    tiene_r = e.has("right") and e["right"] != "auto"
    tiene_t = e.has("top") and e["top"] != "auto" and e["top"] != "inherit"
    tiene_b = e.has("bottom") and e["bottom"] != "auto"
    l = 0
    r = 0
    if tiene_l
        l = _px(e, "left", cw)
    end
    if tiene_r
        r = _px(e, "right", cw)
    end
    w = 0
    if tiene_l and tiene_r and not (e.has("width") and e["width"] != "auto")
        w = cw - l - r
    else
        w = _ancho_flotante(m, n, cw)
    end
    if w > cw
        w = cw
    end
    if w < 1
        w = 1
    end
    ax = cx + l
    if not tiene_l and tiene_r
        ax = cx + cw - r - w
    elif not tiene_l
        ax = cx + pl         # sin left ni right: donde estaría (al principio del contenido)
    end
    # se maqueta arriba y luego se baja a su sitio (bottom necesita su alto)
    antes = m.pagina.dibujos.length
    alto = _bloque_de(m, n, ax, cy, w, cw)
    dy = 0
    if tiene_t
        dy = _px(e, "top", ch)
    elif tiene_b
        dy = ch - _px(e, "bottom", ch) - alto
    else
        dy = pt
    end
    if dy != 0
        i = antes
        while i < m.pagina.dibujos.length
            m.pagina.dibujos[i].y = m.pagina.dibujos[i].y + dy
            i = i + 1
        end
    end
end

# El ancho que ocupa un flotante, márgenes incluidos: su width, o lo que mide su contenido
# (maquetándolo aparte y deshaciendo lo dibujado)
func _ancho_flotante(m: Maquetador, h: Nodo, ancho: Int) -> Int
    e = h.estilo
    extra = _px(e, "margin-left", ancho) + _px(e, "margin-right", ancho)
    caja = _borde(e, "left") + _borde(e, "right") + _px(e, "padding-left", ancho) + _px(e, "padding-right", ancho)
    if e.has("width") and e["width"] != "auto"
        w = _px(e, "width", ancho)
        if w > 0
            if e.has("box-sizing") and e["box-sizing"] == "border-box"
                return w + extra
            end
            return w + caja + extra
        end
    end
    # de lo más a la izquierda a lo más a la derecha (con texto centrado, el borde derecho no basta)
    antes = m.pagina.dibujos.length
    _bloque_de(m, h, 0, 0, ancho, ancho)
    derecha = 0
    izquierda = ancho
    i = antes
    while i < m.pagina.dibujos.length
        d = m.pagina.dibujos[i]
        if d.tipo != D_RECT and d.tipo != D_LINEA
            if d.x + d.ancho > derecha
                derecha = d.x + d.ancho
            end
            if d.x < izquierda
                izquierda = d.x
            end
        end
        i = i + 1
    end
    while m.pagina.dibujos.length > antes
        m.pagina.dibujos.pop()
    end
    if derecha <= izquierda
        return caja + extra
    end
    return derecha - izquierda + caja + extra
end

# Un flotante ya colocado
struct Flotante
    x: Int
    y: Int
    ancho: Int
    alto: Int
    izquierda: Bool
end

# El contenido de un bloque: hijos de bloque uno debajo de otro y lo de en medio, en líneas. Cada
# flotante va al primer sitio desde arriba donde cabe junto a los ya puestos (los de la izquierda
# pegados a la izquierda, los de la derecha a la derecha; nunca más arriba que el anterior), como en
# CSS; lo que no flota va debajo de ellos (como con clear: el texto aún no los rodea) y el bloque
# crece hasta abarcarlos (como clearfix).
func _contenido(m: Maquetador, n: Nodo, x: Int, y: Int, ancho: Int) -> Int
    ancho_previo = m.ancho_linea
    m.ancho_linea = ancho
    cy = y
    var piezas: [Pieza] = []
    m.blanco = 0
    margen_previo = 0
    en_fila = false
    fila_y = 0
    fondo = 0
    var flotantes: [Flotante] = []
    for h in _hijos(n)
        if _oculto(h) or _fuera_del_flujo(h)
            continue
        end
        lado = _flota(h)
        if lado != ""
            if piezas.length > 0
                cy = cy + _lineas(m, piezas, x, cy, ancho, n.estilo)
                piezas.clear()
            end
            if not en_fila
                en_fila = true
                fila_y = cy
                fondo = cy
                flotantes.clear()
            end
            w = _ancho_flotante(m, h, ancho)
            if w > ancho
                w = ancho
            end
            # el primer sitio desde fila_y (la altura del flotante anterior) donde cabe
            fy = fila_y
            izq = x
            der = x + ancho
            vueltas = 0
            while vueltas < 100
                izq = x
                der = x + ancho
                siguiente = -1
                for f in flotantes
                    if f.y <= fy and f.y + f.alto > fy
                        if f.izquierda and f.x + f.ancho > izq
                            izq = f.x + f.ancho
                        end
                        if not f.izquierda and f.x < der
                            der = f.x
                        end
                        if siguiente < 0 or f.y + f.alto < siguiente
                            siguiente = f.y + f.alto
                        end
                    end
                end
                if der - izq >= w or siguiente < 0
                    break
                end
                fy = siguiente
                vueltas = vueltas + 1
            end
            alto = 0
            fx = izq
            if lado != "left"
                fx = der - w
            end
            alto = _bloque_de(m, h, fx, fy, w, ancho)
            flotantes.push(Flotante(fx, fy, w, alto, lado == "left"))
            fila_y = fy
            if fy + alto > fondo
                fondo = fy + alto
            end
            margen_previo = 0
            continue
        end
        if en_fila and (_es_bloque(h) or not _solo_blanco(h))
            en_fila = false
            if fondo > cy
                cy = fondo
            end
        end
        if _es_bloque(h)
            if piezas.length > 0
                cy = cy + _lineas(m, piezas, x, cy, ancho, n.estilo)
                piezas.clear()
                margen_previo = 0
            end
            # márgenes de hermanos seguidos: cuenta el mayor, no la suma
            mt = _px(h.estilo, "margin-top", ancho)
            solape = margen_previo
            if mt < solape
                solape = mt
            end
            if solape < 0
                solape = 0
            end
            cy = cy - solape + _bloque(m, h, x, cy - solape, ancho)
            margen_previo = _px(h.estilo, "margin-bottom", ancho)
        else
            _piezas(m, h, n.estilo, piezas, "")
        end
    end
    if piezas.length > 0
        cy = cy + _lineas(m, piezas, x, cy, ancho, n.estilo)
    end
    if en_fila and fondo > cy
        cy = fondo
    end
    m.ancho_linea = ancho_previo
    return cy - y
end

# Un texto de solo blancos (entre flotantes no corta la fila)
func _solo_blanco(n: Nodo) -> Bool
    if n.tipo == DOM_COMENTARIO
        return true
    end
    if n.tipo != DOM_TEXTO
        return false
    end
    i = 0
    while i < n.texto.length
        if str_code(n.texto, i) > 32
            return false
        end
        i = i + 1
    end
    return true
end

# Las piezas en línea de un nodo (texto, elementos en línea, br, img)
func _piezas(m: Maquetador, n: Nodo, e_padre: {String: String}, piezas: [Pieza], enlace: String)
    if n.tipo == DOM_TEXTO
        _palabras(m, n.texto, e_padre, piezas, enlace, n.padre)
        return
    end
    if n.tipo != DOM_ELEMENTO or _oculto(n)
        return
    end
    e = n.estilo
    if n.nombre == "br"
        piezas.push(Pieza("", 0, 0, 0, 0, 0, 0, false, enlace, 0, true, false))
        return
    end
    if n.nombre == "img"
        w = Int(dom_atributo(n, "width"))
        h = Int(dom_atributo(n, "height"))
        if w <= 0
            w = 16
        end
        if h <= 0
            h = 16
        end
        img = Pieza(dom_img_src(n), w, h, h, 0, 0, 0, false, enlace, m.blanco, false, true)
        img.nodo = n
        piezas.push(img)
        m.blanco = 0
        return
    end
    if dom_es_video(n)
        # como en los navegadores: 300x150 si no dice más; width en px o en % (del ancho de la línea) y el
        # alto con la proporción de sus atributos
        w = Int(dom_atributo(n, "width"))
        h = Int(dom_atributo(n, "height"))
        if w <= 0
            w = 300
        end
        if h <= 0
            h = w / 2
        end
        if e.has("width") and e["width"] != "auto"
            cw = _px(e, "width", m.ancho_linea)
            if cw > 0
                h = h * cw / w
                w = cw
            end
        end
        if e.has("height") and e["height"] != "auto" and not str_ends(e["height"], "%")
            ch = _px(e, "height", 0)
            if ch > 0
                h = ch
            end
        end
        vid = Pieza(video_src(n), w, h, h, 0, 0, 0, false, enlace, m.blanco, false, false)
        vid.video = true
        vid.nodo = n
        piezas.push(vid)
        m.blanco = 0
        return
    end
    if n.nombre == "::icono"
        tam = estilo_px(e["font-size"], 0, 0)
        font_use(_fuente(m, "sans-serif", tam))
        color = css_color(e["color"])
        if color < 0
            color = 0
        end
        ic = Pieza(dom_atributo(n, "codigo"), tam, font_height(), font_baseline(), _fuente(m, "sans-serif", tam), 0, color, false, enlace, m.blanco, false, false)
        ic.icono = true
        ic.nodo = n.padre
        piezas.push(ic)
        m.blanco = 0
        return
    end
    if (e["display"] == "inline-block" or e["display"] == "inline-flex") and not (e.has("float") and (e["float"] == "left" or e["float"] == "right"))
        _pieza_caja(m, n, piezas, enlace)
        return
    end
    if (n.nombre == "input" or n.nombre == "select" or n.nombre == "button" or n.nombre == "textarea") and not _boton_propio(n)
        _control(m, n, e, piezas, enlace)
        return
    end
    destino = enlace
    if n.nombre == "a" and dom_tiene_atributo(n, "href")
        destino = dom_atributo(n, "href")
    end
    for h in _hijos(n)
        _piezas(m, h, e, piezas, destino)
    end
end

# Un inline-block en la línea (una pieza que no se corta): mide su ancho y su alto maquetándolo aparte;
# _poner_linea lo maqueta en su sitio. Su línea base, la de su último texto (sin texto, abajo).
func _pieza_caja(m: Maquetador, n: Nodo, piezas: [Pieza], enlace: String)
    w = _ancho_flotante(m, n, m.ancho_linea)
    if w > m.ancho_linea
        w = m.ancho_linea
    end
    antes = m.pagina.dibujos.length
    h = _bloque_de(m, n, 0, 0, w, m.ancho_linea)
    base = h
    i = m.pagina.dibujos.length - 1
    while i >= antes
        d = m.pagina.dibujos[i]
        if (d.tipo == D_TEXTO or d.tipo == D_ICONO) and d.fuente != 0
            font_use(d.fuente)
            base = d.y + font_baseline()
            break
        end
        i = i - 1
    end
    while m.pagina.dibujos.length > antes
        m.pagina.dibujos.pop()
    end
    pz = Pieza("", w, h, base, 0, 0, 0, false, enlace, m.blanco, false, false)
    pz.caja = n
    pz.nodo = n
    piezas.push(pz)
    m.blanco = 0
end

# Un <button> con elementos dentro o sin texto: lo dibuja su CSS (un icono, unas barras...), no es
# el botón de siempre
func _boton_propio(n: Nodo) -> Bool
    if n.nombre != "button"
        return false
    end
    for h in _hijos(n)
        if h.tipo == DOM_ELEMENTO
            return true
        end
    end
    return str_trim(dom_texto(n)) == ""
end

# Un control de formulario: una pieza de su tamaño (lo dibuja el pintor con lo que tenga el nodo)
func _control(m: Maquetador, n: Nodo, e: {String: String}, piezas: [Pieza], enlace: String)
    tipo = str_lower(dom_atributo(n, "type"))
    if n.nombre == "input" and tipo == "hidden"
        return
    end
    f = _fuente(m, e["font-family"], estilo_px(e["font-size"], 0, 0))
    font_use(f)
    font_style(0)
    alto_texto = font_height()
    base = font_baseline()
    w = 0
    h = alto_texto + 6
    b = 3 + base
    if n.nombre == "select"
        for o in n.hijos
            if o.tipo == DOM_ELEMENTO and o.nombre == "option" and font_text_width(str_trim(dom_texto(o))) > w
                w = font_text_width(str_trim(dom_texto(o)))
            end
        end
        w = w + 24
    elif n.nombre == "button" or tipo == "submit" or tipo == "reset" or tipo == "button"
        w = font_text_width(formulario_etiqueta(n)) + 16
        h = alto_texto + 8
        b = 4 + base
    elif tipo == "checkbox" or tipo == "radio"
        w = alto_texto
        if w < 11
            w = 11
        end
        h = w
        b = w - 1
    elif n.nombre == "textarea"
        cols = Int(dom_atributo(n, "cols"))
        if cols <= 0
            cols = 20
        end
        filas = Int(dom_atributo(n, "rows"))
        if filas <= 0
            filas = 2
        end
        w = cols * font_text_width("n") + 6
        h = filas * alto_texto + 6
    else
        cols = Int(dom_atributo(n, "size"))
        if cols <= 0
            cols = 20
        end
        w = cols * font_text_width("n") + 6
    end
    pz = Pieza("", w, h, b, f, 0, 0, false, enlace, m.blanco, false, false)
    pz.control = true
    pz.nodo = n
    piezas.push(pz)
    m.blanco = 0
end

# El texto de un botón: el del <button> o el value; si no, el de siempre
func formulario_etiqueta(n: Nodo) -> String
    if n.nombre == "button"
        t = str_trim(dom_texto(n))
        if t != ""
            return t
        end
        return "Enviar"
    end
    if dom_tiene_atributo(n, "value")
        return dom_atributo(n, "value")
    end
    if str_lower(dom_atributo(n, "type")) == "reset"
        return "Borrar"
    end
    return "Enviar"
end

# La opción elegida de un <select> (la que tiene selected, si no la primera); nil si no tiene
func formulario_opcion(n: Nodo) -> Nodo
    var primera: Nodo = nil
    for o in n.hijos
        if o.tipo == DOM_ELEMENTO and o.nombre == "option"
            if dom_tiene_atributo(o, "selected")
                return o
            end
            if primera == nil
                primera = o
            end
        end
    end
    return primera
end

# Palabras de un texto con el estilo de su elemento
func _palabras(m: Maquetador, texto_dom: String, e: {String: String}, piezas: [Pieza], enlace: String, elemento: Nodo)
    tam = estilo_px(e["font-size"], 0, 0)
    texto = texto_dom
    transformar = ""
    if e.has("text-transform")
        transformar = e["text-transform"]
    end
    if transformar == "uppercase"
        texto = str_upper(texto)
    elif transformar == "lowercase"
        texto = str_lower(texto)
    end
    ls = 0
    if e.has("letter-spacing") and e["letter-spacing"] != "normal"
        ls = estilo_px(e["letter-spacing"], tam, 0)
        if ls < 0
            ls = 0
        end
    end
    f = _fuente(m, e["font-family"], tam)
    estilo = _estilo_texto(e)
    deco = ""
    if e.has("text-decoration")
        deco = e["text-decoration"]
    end
    if str_find(deco, "underline") >= 0
        estilo = estilo + EST_SUBRAYADO
    end
    tachado = str_find(deco, "line-through") >= 0
    color = css_color(e["color"])
    if color < 0
        color = 0
    end
    font_use(f)
    font_style(estilo)
    alto = font_height()
    base = font_baseline()
    espacio_ancho = font_text_width(" ")
    if e["white-space"] == "pre" or e["white-space"] == "pre-wrap"
        # cada línea tal cual; los saltos de línea cortan
        inicio = 0
        p = str_find(texto, "\n")
        while p >= 0
            linea = str_replace(texto[inicio:p], "\t", "        ")
            pz = Pieza(linea, font_text_width(linea), alto, base, f, estilo, color, tachado, enlace, 0, false, false)
            pz.nodo = elemento
            piezas.push(pz)
            piezas.push(Pieza("", 0, alto, base, f, estilo, color, false, enlace, 0, true, false))
            inicio = p + 1
            p = str_find_from(texto, "\n", inicio)
        end
        linea = str_replace(texto[inicio:], "\t", "        ")
        if linea != ""
            pz = Pieza(linea, font_text_width(linea), alto, base, f, estilo, color, tachado, enlace, 0, false, false)
            pz.nodo = elemento
            piezas.push(pz)
        end
        return
    end
    n = texto.length
    i = 0
    hubo_blanco = false
    while i < n
        c = str_code(texto, i)
        if c == 32 or c == 9 or c == 10 or c == 13 or c == 12
            hubo_blanco = true
            i = i + 1
        else
            j = i
            while j < n and str_code(texto, j) != 32 and str_code(texto, j) != 9 and str_code(texto, j) != 10 and str_code(texto, j) != 13 and str_code(texto, j) != 12
                j = j + 1
            end
            palabra = texto[i:j]
            if transformar == "capitalize"
                palabra = str_upper(palabra[:1]) + palabra[1:]
            end
            # un blanco antes cuenta una vez: si la pieza anterior ya acaba en espacio, no otro
            espacio = 0
            if (hubo_blanco or m.blanco > 0) and not (piezas.length > 0 and _termina_en_blanco(piezas))
                espacio = espacio_ancho
            end
            m.blanco = 0
            if ls > 0 and espacio > 0
                espacio = espacio + ls
            end
            pz = Pieza(palabra, font_text_width(palabra) + ls * palabra.length, alto, base, f, estilo, color, tachado, enlace, espacio, false, false)
            pz.nodo = elemento
            pz.espaciado = ls
            if not hubo_blanco and piezas.length > 0
                anterior = piezas[piezas.length - 1]
                pz.pegada = not anterior.salto and not anterior.imagen and not anterior.control and not str_ends(anterior.texto, " ")
            end
            piezas.push(pz)
            hubo_blanco = false
            i = j
        end
    end
    if hubo_blanco and piezas.length > 0
        # el blanco final se nota en la siguiente palabra (de otro elemento)
        ultima = piezas[piezas.length - 1]
        if ultima.imagen or ultima.control
            m.blanco = espacio_ancho
        elif not ultima.salto
            ultima.texto = ultima.texto + " "
            ultima.ancho = ultima.ancho + espacio_ancho
        end
    end
end

func _termina_en_blanco(piezas: [Pieza]) -> Bool
    u = piezas[piezas.length - 1]
    return str_ends(u.texto, " ")
end

# Reparte las piezas en líneas de ese ancho; devuelve el alto
func _lineas(m: Maquetador, piezas: [Pieza], x: Int, y: Int, ancho: Int, e: {String: String}) -> Int
    cy = y
    var linea: [Pieza] = []
    ocupado = 0
    for p in piezas
        if p.salto
            cy = cy + _poner_linea(m, linea, x, cy, ancho, e, p.alto)
            linea.clear()
            ocupado = 0
            continue
        end
        hueco = p.espacio
        if linea.length == 0
            hueco = 0
        end
        if linea.length > 0 and ocupado + hueco + p.ancho > ancho
            # se corta antes de la última pieza no pegada: las pegadas pasan juntas a la siguiente
            k = linea.length
            if p.pegada
                k = linea.length - 1
                while k > 0 and linea[k].pegada
                    k = k - 1
                end
            end
            if k > 0
                var resto: [Pieza] = []
                while linea.length > k
                    resto.insert(0, linea.pop())
                end
                cy = cy + _poner_linea(m, linea, x, cy, ancho, e, 0)
                linea.clear()
                ocupado = 0
                for r in resto
                    if linea.length == 0
                        r.espacio = 0
                    end
                    linea.push(r)
                    ocupado = ocupado + r.espacio + r.ancho
                end
                hueco = p.espacio
                if linea.length == 0
                    hueco = 0
                end
            end
        end
        p.espacio = hueco
        linea.push(p)
        ocupado = ocupado + hueco + p.ancho
    end
    if linea.length > 0
        cy = cy + _poner_linea(m, linea, x, cy, ancho, e, 0)
    end
    return cy - y
end

# Una línea: alto y línea base de lo más alto, alineación, y las palabras seguidas con el mismo
# aspecto juntas en un solo texto (pintar texto es lo que más cuesta)
func _poner_linea(m: Maquetador, linea: [Pieza], x: Int, y: Int, ancho: Int, e: {String: String}, alto_vacia: Int) -> Int
    if linea.length == 0
        return alto_vacia
    end
    alto = 0
    base = 0
    total = 0
    for p in linea
        if p.base > base
            base = p.base
        end
        total = total + p.espacio + p.ancho
    end
    for p in linea
        if base - p.base + p.alto > alto
            alto = base - p.base + p.alto
        end
    end
    alto = alto + 2
    desplaza = 0
    alinea = e["text-align"]
    if alinea == "center"
        desplaza = (ancho - total) / 2
    elif alinea == "right"
        desplaza = ancho - total
    end
    if desplaza < 0
        desplaza = 0
    end
    cx = x + desplaza
    var actual: Dibujo = nil
    for p in linea
        cx = cx + p.espacio
        if p.caja != nil
            _bloque_de(m, p.caja, cx, y + base - p.base + 1, p.ancho, ancho)
            actual = nil
        elif p.control
            ctl = _dibujo(D_CONTROL, cx, y + base - p.base + 1, p.ancho, p.alto, 0)
            ctl.fuente = p.fuente
            ctl.nodo = p.nodo
            ctl.enlace = p.enlace
            m.pagina.dibujos.push(ctl)
            actual = nil
        elif p.video
            vd = _dibujo(D_VIDEO, cx, y + base - p.base + 1, p.ancho, p.alto, 0)
            vd.texto = p.texto
            vd.enlace = p.enlace
            vd.nodo = p.nodo
            m.pagina.dibujos.push(vd)
            actual = nil
        elif p.icono
            ic = _dibujo(D_ICONO, cx, y + base - p.base + 1, p.ancho, p.alto, p.color)
            ic.texto = p.texto
            ic.fuente = p.fuente
            ic.enlace = p.enlace
            ic.nodo = p.nodo
            m.pagina.dibujos.push(ic)
            actual = nil
        elif p.imagen
            img = _dibujo(D_IMAGEN, cx, y + base - p.base + 1, p.ancho, p.alto, 0)
            img.texto = p.texto
            img.enlace = p.enlace
            img.nodo = p.nodo
            m.pagina.dibujos.push(img)
            actual = nil
        elif actual != nil and actual.fuente == p.fuente and actual.estilo == p.estilo and actual.color == p.color and actual.enlace == p.enlace and actual.nodo == p.nodo and actual.espaciado == p.espaciado
            actual.texto = actual.texto + _espacios(p.espacio, actual) + p.texto
            actual.ancho = cx + p.ancho - actual.x
        else
            actual = _dibujo(D_TEXTO, cx, y + base - p.base + 1, p.ancho, p.alto, p.color)
            actual.texto = p.texto
            actual.fuente = p.fuente
            actual.estilo = p.estilo
            actual.enlace = p.enlace
            actual.nodo = p.nodo
            actual.espaciado = p.espaciado
            m.pagina.dibujos.push(actual)
        end
        if p.tachado
            m.pagina.dibujos.push(_dibujo(D_LINEA, cx, y + base - p.base + 1 + p.alto / 2, p.ancho, 1, p.color))
        end
        cx = cx + p.ancho
    end
    return alto
end

# El hueco entre dos palabras dentro de un mismo texto: un espacio (si no lo trae ya)
func _espacios(hueco: Int, d: Dibujo) -> String
    if hueco > 0 and not str_ends(d.texto, " ")
        return " "
    end
    return ""
end

# La marca de un elemento de lista, a la izquierda de su primera línea
func _marca(m: Maquetador, n: Nodo, x: Int, y: Int)
    tipo = n.estilo["list-style-type"]
    if tipo == "none"
        return
    end
    tam = estilo_px(n.estilo["font-size"], 0, 0)
    color = css_color(n.estilo["color"])
    if color < 0
        color = 0
    end
    if tipo == "decimal"
        numero = 1
        if n.padre != nil
            for h in n.padre.hijos
                if h == n
                    break
                end
                if h.tipo == DOM_ELEMENTO and h.estilo["display"] == "list-item"
                    numero = numero + 1
                end
            end
        end
        f = _fuente(m, n.estilo["font-family"], tam)
        font_use(f)
        font_style(0)
        texto = "" + numero + "."
        d = _dibujo(D_TEXTO, x - font_text_width(texto) - 4, y + 1, font_text_width(texto), font_height(), color)
        d.texto = texto
        d.fuente = f
        m.pagina.dibujos.push(d)
    else
        lado = tam / 3
        if lado < 3
            lado = 3
        end
        m.pagina.dibujos.push(_dibujo(D_RECT, x - lado - 6, y + tam / 2 - lado / 2 + 1, lado, lado, color))
    end
end

# Bordes como rectángulos llenos
func _bordes(m: Maquetador, e: {String: String}, x: Int, y: Int, ancho: Int, alto: Int, bt: Int, br: Int, bb: Int, bl: Int)
    if bt > 0
        m.pagina.dibujos.push(_dibujo(D_RECT, x, y, ancho, bt, _color_borde(e, "top")))
    end
    if bb > 0
        m.pagina.dibujos.push(_dibujo(D_RECT, x, y + alto - bb, ancho, bb, _color_borde(e, "bottom")))
    end
    if bl > 0
        m.pagina.dibujos.push(_dibujo(D_RECT, x, y, bl, alto, _color_borde(e, "left")))
    end
    if br > 0
        m.pagina.dibujos.push(_dibujo(D_RECT, x + ancho - br, y, br, alto, _color_borde(e, "right")))
    end
end

func _color_borde(e: {String: String}, lado: String) -> Int
    c = -1
    if e.has("border-" + lado + "-color")
        c = css_color(e["border-" + lado + "-color"])
    end
    if c < 0
        c = css_color(e["color"])
    end
    if c < 0
        c = 0
    end
    return c
end

# Tabla sencilla: filas una debajo de otra, celdas del mismo ancho
func _tabla(m: Maquetador, t: Nodo, x: Int, y: Int, ancho: Int) -> Int
    var filas: [Nodo] = []
    _filas(t, filas)
    cy = y
    for fila in filas
        var celdas: [Nodo] = []
        for c in fila.hijos
            if c.tipo == DOM_ELEMENTO and (c.nombre == "td" or c.nombre == "th") and not _oculto(c)
                celdas.push(c)
            end
        end
        if celdas.length == 0
            continue
        end
        ancho_celda = ancho / celdas.length
        alto_fila = 0
        for i in (0..celdas.length - 1)
            h = _bloque(m, celdas[i], x + i * ancho_celda, cy, ancho_celda)
            if h > alto_fila
                alto_fila = h
            end
        end
        cy = cy + alto_fila
    end
    return cy - y
end

func _filas(n: Nodo, filas: [Nodo])
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO and h.nombre == "tr"
            filas.push(h)
        elif h.tipo == DOM_ELEMENTO and (h.nombre == "thead" or h.nombre == "tbody" or h.nombre == "tfoot")
            _filas(h, filas)
        end
    end
end

# El elemento que hay en el punto x, y de la página (lo último que se pintó allí: un texto, una
# imagen o un fondo de caja), o nil
func maqueta_nodo_en(p: Pagina, x: Int, y: Int) -> Nodo
    i = p.dibujos.length - 1
    while i >= 0
        d = p.dibujos[i]
        if d.nodo != nil and x >= d.x and x < d.x + d.ancho and y >= d.y and y < d.y + d.alto
            return d.nodo
        end
        i = i - 1
    end
    var nada: Nodo = nil
    return nada
end

