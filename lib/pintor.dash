# Pinta una página maquetada (lib/maqueta.dash) con los gfx_ de Dash en el RastPort actual:
# una ventana normal o la zona de dibujo de MUI.
#
#   pintar(p, im, desde_y, x, y, ancho, alto)   # la franja [desde_y, desde_y + alto) de la página
#                                               # en el rectángulo (x, y, ancho, alto)
# im: las imágenes de la página (lib/imagenes.dash), o nil: entonces cada una es un marco gris.
# Los colores RGB se piden como lápices (color_pen, con caché). Las líneas de texto que no
# caben enteras en el rectángulo no se pintan (se verán al desplazar).

import "maqueta.dash"
import "imagenes.dash"
import "videos.dash"

# El campo de formulario con el foco: se dibuja con el borde azul y el cursor
var pintor_foco: Nodo = nil
# Los vídeos de la página que se pinta (lib/videos.dash), o nil: entonces cada uno es un recuadro negro
var pintor_videos: Videos = nil

func _lapiz(rgb: Int) -> Int
    return color_pen(rgb / 65536, (rgb / 256) % 256, rgb % 256)
end

func pintar(p: Pagina, im: Imagenes, desde: Int, x0: Int, y0: Int, ancho: Int, alto: Int)
    if ancho <= 0 or alto <= 0
        return
    end
    gfx_mode(0)
    gfx_pen(_lapiz(p.fondo))
    gfx_rect(x0, y0, x0 + ancho - 1, y0 + alto - 1)
    hasta = desde + alto
    derecha = x0 + ancho - 1
    abajo = y0 + alto - 1
    for d in p.dibujos
        if d.y + d.alto <= desde or d.y >= hasta
            continue
        end
        y = y0 + d.y - desde
        x = x0 + d.x
        if d.tipo == D_TEXTO
            if y >= y0 and y + d.alto - 1 <= abajo and x <= derecha
                font_use(d.fuente)
                font_style(d.estilo)
                gfx_pen(_lapiz(d.color))
                if d.espaciado > 0 and d.texto.length > 0
                    # letter-spacing: letra a letra
                    lx = x
                    for i in (0..d.texto.length - 1)
                        letra = d.texto[i:i + 1]
                        gfx_text_at(lx, y + font_baseline(), letra)
                        lx = lx + font_text_width(letra) + d.espaciado
                    end
                else
                    gfx_text_at(x, y + font_baseline(), d.texto)
                end
            end
        elif d.tipo == D_RECT and d.espaciado > 0
            _mezcla_recortada(x, y, d.ancho, d.alto, x0, y0, derecha, abajo, d.color, d.espaciado)
        elif d.tipo == D_RECT or d.tipo == D_LINEA
            _rect_recortado(x, y, d.ancho, d.alto, x0, y0, derecha, abajo, _lapiz(d.color))
        elif d.tipo == D_CONTROL
            _control_pintar(d, x, y, x0, y0, derecha, abajo)
        elif d.tipo == D_ICONO
            if y >= y0 and y + d.alto - 1 <= abajo and x + d.ancho - 1 <= derecha
                _icono_pintar(d, x, y)
            end
        elif d.tipo == D_ELIPSE
            if y >= y0 and y + d.alto - 1 <= abajo and x + d.ancho - 1 <= derecha
                _elipse_pintar(d, x, y)
            end
        elif d.tipo == D_VIDEO
            _video_dibujo(d, im, x, y, x0, y0, derecha, abajo)
        elif d.tipo == D_DEGRADADO
            _degradado_pintar(d, x, y, x0, y0, derecha, abajo)
        elif d.tipo == D_TRAZO
            if y >= y0 and y + d.alto - 1 <= abajo and x + d.ancho - 1 <= derecha
                gfx_pen(_lapiz(d.color))
                g = d.fuente
                if g < 1
                    g = 1
                end
                for k in (0..g - 1)
                    if d.estilo == 0
                        gfx_line(x + k, y, x + d.ancho - 1 + k, y + d.alto - 1)
                    else
                        gfx_line(x + k, y + d.alto - 1, x + d.ancho - 1 + k, y)
                    end
                end
            end
        elif d.tipo == D_FONDO and im != nil
            _fondo_pintar(im, d, x, y, x0, y0, derecha, abajo)
        elif d.tipo == D_IMAGEN
            img = 0
            if im != nil
                img = imagenes_a_tamano(im, d.texto, d.ancho, d.alto)
            end
            if img != 0
                _imagen_recortada(img, x, y, d.ancho, d.alto, x0, y0, derecha, abajo)
                continue
            end
            # sin imagen: su hueco con un marco gris
            gris = _lapiz(12632256)
            _rect_recortado(x, y, d.ancho, 1, x0, y0, derecha, abajo, gris)
            _rect_recortado(x, y + d.alto - 1, d.ancho, 1, x0, y0, derecha, abajo, gris)
            _rect_recortado(x, y, 1, d.alto, x0, y0, derecha, abajo, gris)
            _rect_recortado(x + d.ancho - 1, y, 1, d.alto, x0, y0, derecha, abajo, gris)
        end
    end
    font_style(0)
end

func _rect_recortado(x: Int, y: Int, ancho: Int, alto: Int, x0: Int, y0: Int, x1: Int, y1: Int, lapiz: Int)
    a = x
    b = y
    c = x + ancho - 1
    e = y + alto - 1
    if a < x0
        a = x0
    end
    if b < y0
        b = y0
    end
    if c > x1
        c = x1
    end
    if e > y1
        e = y1
    end
    if a <= c and b <= e
        gfx_pen(lapiz)
        gfx_rect(a, b, c, e)
    end
end

# La parte de la imagen (en x, y, de ancho x alto) que cae en el rectángulo x0..x1, y0..y1
func _imagen_recortada(img: Int, x: Int, y: Int, ancho: Int, alto: Int, x0: Int, y0: Int, x1: Int, y1: Int)
    a = x
    b = y
    c = x + ancho - 1
    e = y + alto - 1
    if a < x0
        a = x0
    end
    if b < y0
        b = y0
    end
    if c > x1
        c = x1
    end
    if e > y1
        e = y1
    end
    if a <= c and b <= e
        image_draw_part(img, a - x, b - y, a, b, c - a + 1, e - b + 1)
    end
end

# Un control de formulario según lo que tenga su nodo ahora (value, checked, la opción elegida)
func _control_pintar(d: Dibujo, x: Int, y: Int, x0: Int, y0: Int, x1: Int, y1: Int)
    n = d.nodo
    tipo = str_lower(dom_atributo(n, "type"))
    w = d.ancho
    h = d.alto
    claro = _lapiz(16777215)
    oscuro = _lapiz(6316128)
    texto_visible = y >= y0 and y + h - 1 <= y1
    if n.nombre == "button" or tipo == "submit" or tipo == "reset" or tipo == "button"
        _rect_recortado(x, y, w, h, x0, y0, x1, y1, _lapiz(13684944))
        _rect_recortado(x, y, w, 1, x0, y0, x1, y1, claro)
        _rect_recortado(x, y, 1, h, x0, y0, x1, y1, claro)
        _rect_recortado(x, y + h - 1, w, 1, x0, y0, x1, y1, oscuro)
        _rect_recortado(x + w - 1, y, 1, h, x0, y0, x1, y1, oscuro)
        if texto_visible
            font_use(d.fuente)
            font_style(0)
            etiqueta = formulario_etiqueta(n)
            gfx_pen(_lapiz(0))
            gfx_text_at(x + (w - font_text_width(etiqueta)) / 2, y + 4 + font_baseline(), etiqueta)
        end
        return
    end
    _rect_recortado(x, y, w, h, x0, y0, x1, y1, claro)
    borde = oscuro
    if pintor_foco == n
        borde = _lapiz(204)
    end
    _rect_recortado(x, y, w, 1, x0, y0, x1, y1, borde)
    _rect_recortado(x, y + h - 1, w, 1, x0, y0, x1, y1, borde)
    _rect_recortado(x, y, 1, h, x0, y0, x1, y1, borde)
    _rect_recortado(x + w - 1, y, 1, h, x0, y0, x1, y1, borde)
    if tipo == "checkbox" or tipo == "radio"
        if dom_tiene_atributo(n, "checked")
            _rect_recortado(x + 3, y + 3, w - 6, h - 6, x0, y0, x1, y1, _lapiz(0))
        end
        return
    end
    if not texto_visible
        return
    end
    font_use(d.fuente)
    font_style(0)
    hueco = w - 6
    texto = ""
    if n.nombre == "textarea"
        _textarea_pintar(n, x, y, w, h)
        return
    end
    if n.nombre == "select"
        hueco = w - 18
        o = formulario_opcion(n)
        if o != nil
            texto = str_trim(dom_texto(o))
        end
        gfx_pen(_lapiz(0))
        gfx_text_at(x + w - 12, y + 3 + font_baseline(), "v")
        while texto != "" and font_text_width(texto) > hueco
            texto = texto[:texto.length - 1]
        end
    else
        texto = dom_atributo(n, "value")
        if tipo == "password"
            oculto = ""
            for i in (1..texto.length)
                oculto = oculto + "*"
            end
            texto = oculto
        end
        # lo que no cabe se corta por delante: se ve lo último que se escribió
        while texto != "" and font_text_width(texto) > hueco - 2
            texto = texto[1:]
        end
    end
    gfx_pen(_lapiz(0))
    if texto != ""
        gfx_text_at(x + 3, y + 3 + font_baseline(), texto)
    end
    if pintor_foco == n and n.nombre != "select"
        cx = x + 3 + font_text_width(texto)
        gfx_pen(_lapiz(204))
        gfx_rect(cx, y + 2, cx, y + h - 3)
    end
end

# Las últimas líneas de un textarea que caben (cada una cortada por delante si es larga) y el cursor
func _textarea_pintar(n: Nodo, x: Int, y: Int, w: Int, h: Int)
    var lineas: [String] = []
    t = dom_texto(n)
    inicio_linea = 0
    p = str_find(t, "\n")
    while p >= 0
        lineas.push(t[inicio_linea:p])
        inicio_linea = p + 1
        p = str_find_from(t, "\n", inicio_linea)
    end
    lineas.push(t[inicio_linea:])
    alto_linea = font_height()
    caben = (h - 6) / alto_linea
    if caben < 1
        caben = 1
    end
    primera = lineas.length - caben
    if primera < 0
        primera = 0
    end
    gfx_pen(_lapiz(0))
    cy = y + 3
    ultima = ""
    for i in (primera..lineas.length - 1)
        linea = lineas[i]
        while linea != "" and font_text_width(linea) > w - 8
            linea = linea[1:]
        end
        if linea != ""
            gfx_text_at(x + 3, cy + font_baseline(), linea)
        end
        ultima = linea
        cy = cy + alto_linea
    end
    if pintor_foco == n
        cx = x + 3 + font_text_width(ultima)
        gfx_pen(_lapiz(204))
        gfx_rect(cx, cy - alto_linea + 1, cx, cy - 1)
    end
end


# === Imágenes de fondo ===

# La imagen de fondo de una caja (x, y, d.ancho, d.alto) recortada a ella y a la zona visible:
# background-size (auto, cover, contain, px, %), background-position (palabras, %, px) y
# background-repeat (repeat, no-repeat, repeat-x, repeat-y)
func _fondo_pintar(im: Imagenes, d: Dibujo, x: Int, y: Int, x0: Int, y0: Int, x1: Int, y1: Int)
    img = imagenes_cargada(im, d.texto)
    if img == 0 or d.ancho <= 0 or d.alto <= 0
        return
    end
    iw = image_width(img)
    ih = image_height(img)
    if iw <= 0 or ih <= 0
        return
    end
    e = d.nodo.estilo
    bw = d.ancho
    bh = d.alto
    # el tamaño
    tam = "auto"
    if e.has("background-size")
        tam = str_lower(str_trim(e["background-size"]))
    end
    sw = iw
    sh = ih
    if tam == "cover" or tam == "contain"
        ancha = bw * ih > bh * iw
        if ancha == (tam == "cover")
            sw = bw
            sh = ih * bw / iw
        else
            sh = bh
            sw = iw * bh / ih
        end
    elif tam != "auto"
        partes = css_partir(tam, 32)
        if partes.length > 0 and partes[0] != "auto"
            sw = estilo_px(partes[0], 16, bw)
            sh = ih * sw / iw
        end
        if partes.length > 1 and partes[1] != "auto"
            sh = estilo_px(partes[1], 16, bh)
            if partes[0] == "auto"
                sw = iw * sh / ih
            end
        end
    end
    if sw < 1 or sh < 1
        return
    end
    # el sitio
    pos = "0% 0%"
    if e.has("background-position")
        pos = str_lower(str_trim(e["background-position"]))
    end
    px = 0
    py = 0
    partes = css_partir(pos, 32)
    if partes.length == 1
        if partes[0] == "top" or partes[0] == "bottom"
            partes.insert(0, "center")
        else
            partes.push("center")
        end
    end
    if partes.length >= 2
        a = partes[0]
        b = partes[1]
        if a == "top" or a == "bottom"
            c = a
            a = b
            b = c
        end
        px = _fondo_lugar(a, bw - sw)
        py = _fondo_lugar(b, bh - sh)
    end
    # recorte: la caja y lo visible
    cx0 = x
    cy0 = y
    cx1 = x + bw - 1
    cy1 = y + bh - 1
    if cx0 < x0
        cx0 = x0
    end
    if cy0 < y0
        cy0 = y0
    end
    if cx1 > x1
        cx1 = x1
    end
    if cy1 > y1
        cy1 = y1
    end
    if cx0 > cx1 or cy0 > cy1
        return
    end
    escalada = imagenes_a_tamano(im, d.texto, sw, sh)
    if escalada == 0
        return
    end
    rep = "repeat"
    if e.has("background-repeat")
        rep = str_lower(str_trim(e["background-repeat"]))
    end
    # los mosaicos: desde el sitio hacia atrás y hacia delante (como mucho 4000)
    ax = x + px
    ay = y + py
    if rep == "repeat" or rep == "repeat-x"
        while ax > cx0
            ax = ax - sw
        end
    end
    if rep == "repeat" or rep == "repeat-y"
        while ay > cy0
            ay = ay - sh
        end
    end
    cuantos = 0
    ty = ay
    while ty <= cy1 and cuantos < 4000
        tx = ax
        while tx <= cx1 and cuantos < 4000
            _imagen_recortada(escalada, tx, ty, sw, sh, cx0, cy0, cx1, cy1)
            cuantos = cuantos + 1
            if rep != "repeat" and rep != "repeat-x"
                break
            end
            tx = tx + sw
        end
        if rep != "repeat" and rep != "repeat-y"
            break
        end
        ty = ty + sh
    end
end

# left/center/right/top/bottom, % o px dentro del hueco que sobra
func _fondo_lugar(v: String, sobra: Int) -> Int
    if v == "left" or v == "top"
        return 0
    elif v == "center"
        return sobra / 2
    elif v == "right" or v == "bottom"
        return sobra
    elif str_ends(v, "%")
        return sobra * Int(v[:v.length - 1]) / 100
    end
    return estilo_px(v, 16, 0)
end

# === Iconos (Font Awesome) ===
# Los más comunes, dibujados con rectángulos, líneas y círculos en un cuadrado del tamaño de la letra
# (d.ancho) centrado en la línea; los demás, un cuadrado pequeño.

func _icono_pintar(d: Dibujo, x: Int, y: Int)
    s = d.ancho
    if s < 6
        s = 6
    end
    ix = x
    iy = y + (d.alto - s) / 2
    g = s / 8                     # grosor de los trazos
    if g < 1
        g = 1
    end
    gfx_pen(_lapiz(d.color))
    c = str_lower(d.texto)
    m = s / 2
    if c == "f0c9" or c == "f550" or c == "f7a5"
        # menú: tres barras
        for k in (0..2)
            yy = iy + s / 6 + k * (s / 3)
            gfx_rect(ix + 1, yy, ix + s - 2, yy + g - 1)
        end
    elif c == "f002" or c == "f689"
        # lupa: círculo y mango
        r = s * 3 / 10
        cx = ix + r + 1
        cy = iy + r + 1
        for k in (0..g - 1)
            gfx_circle(cx, cy, r - k)
        end
        for k in (0..g)
            gfx_line(cx + r * 7 / 10 + k, cy + r * 7 / 10, ix + s - 2 + k, iy + s - 2)
        end
    elif c == "f073" or c == "f133" or c == "f274" or c == "f783" or c == "f272" or c == "f271"
        # calendario: marco, cabecera y dos anillas
        _icono_marco(ix + 1, iy + s / 6, ix + s - 2, iy + s - 1, g)
        gfx_rect(ix + 1, iy + s / 6, ix + s - 2, iy + s / 6 + s / 5)
        gfx_rect(ix + s / 4, iy, ix + s / 4 + g, iy + s / 4)
        gfx_rect(ix + s * 3 / 4 - g, iy, ix + s * 3 / 4, iy + s / 4)
    elif c == "f075" or c == "f27a" or c == "f086" or c == "f4ad" or c == "f0e5" or c == "f4a6"
        # comentario: bocadillo
        _icono_marco(ix + 1, iy + 1, ix + s - 2, iy + s * 2 / 3, g)
        for k in (0..g)
            gfx_line(ix + s / 4 + k, iy + s * 2 / 3, ix + s / 5 + k, iy + s - 1)
        end
    elif c == "f106" or c == "f077" or c == "f062" or c == "f0d8"
        _icono_flecha(ix, iy, s, g, 0)
    elif c == "f107" or c == "f078" or c == "f063" or c == "f0d7"
        _icono_flecha(ix, iy, s, g, 1)
    elif c == "f104" or c == "f053" or c == "f060" or c == "f0d9"
        _icono_flecha(ix, iy, s, g, 2)
    elif c == "f105" or c == "f054" or c == "f061" or c == "f0da"
        _icono_flecha(ix, iy, s, g, 3)
    elif c == "f007" or c == "f2bd" or c == "f406"
        # usuario: cabeza y hombros
        gfx_circle_fill(ix + m, iy + s / 4 + 1, s / 4)
        gfx_ellipse_fill(ix + m, iy + s - 1, s * 2 / 5, s / 3)
    elif c == "f017" or c == "f1da"
        # reloj
        for k in (0..g - 1)
            gfx_circle(ix + m, iy + m, m - 1 - k)
        end
        gfx_rect(ix + m, iy + m / 2, ix + m + g - 1, iy + m)
        gfx_rect(ix + m, iy + m, ix + m + m / 2, iy + m + g - 1)
    elif c == "f02b" or c == "f02c"
        # etiqueta
        gfx_poly_begin(ix + 1, iy + 1)
        gfx_poly_add(ix + s / 2, iy + 1)
        gfx_poly_add(ix + s - 1, iy + s / 2)
        gfx_poly_add(ix + s / 2, iy + s - 1)
        gfx_poly_add(ix + 1, iy + s / 2)
        gfx_poly_end()
    elif c == "f07b" or c == "f07c"
        # carpeta
        gfx_rect(ix + 1, iy + s / 4, ix + s / 2, iy + s / 3)
        gfx_rect(ix + 1, iy + s / 3, ix + s - 2, iy + s - 2)
    elif c == "f0e0" or c == "f003"
        # sobre
        _icono_marco(ix + 1, iy + s / 5, ix + s - 2, iy + s * 4 / 5, g)
        gfx_line(ix + 1, iy + s / 5, ix + m, iy + m)
        gfx_line(ix + m, iy + m, ix + s - 2, iy + s / 5)
    elif c == "f015"
        # casa
        gfx_poly_begin(ix + m, iy + 1)
        gfx_poly_add(ix + s - 1, iy + m)
        gfx_poly_add(ix + 1, iy + m)
        gfx_poly_end()
        gfx_rect(ix + s / 5, iy + m, ix + s - s / 5, iy + s - 1)
    elif c == "f00d"
        # aspa
        for k in (0..g)
            gfx_line(ix + 2 + k, iy + 2, ix + s - 3 + k, iy + s - 3)
            gfx_line(ix + s - 3 + k, iy + 2, ix + 2 + k, iy + s - 3)
        end
    elif c == "f00c"
        # marca
        for k in (0..g)
            gfx_line(ix + 2, iy + m + k, ix + s / 3, iy + s - 3 + k)
            gfx_line(ix + s / 3, iy + s - 3 + k, ix + s - 2, iy + 3 + k)
        end
    else
        _icono_marco(ix + s / 4, iy + s / 4, ix + s * 3 / 4, iy + s * 3 / 4, 1)
    end
end

func _icono_marco(x1: Int, y1: Int, x2: Int, y2: Int, g: Int)
    gfx_rect(x1, y1, x2, y1 + g - 1)
    gfx_rect(x1, y2 - g + 1, x2, y2)
    gfx_rect(x1, y1, x1 + g - 1, y2)
    gfx_rect(x2 - g + 1, y1, x2, y2)
end

# Un ángulo: 0 arriba, 1 abajo, 2 izquierda, 3 derecha
func _icono_flecha(ix: Int, iy: Int, s: Int, g: Int, hacia: Int)
    a = s / 4
    b = s - s / 4
    m = s / 2
    for k in (0..g)
        if hacia == 0
            gfx_line(ix + a, iy + m + a / 2 + k, ix + m, iy + a + k)
            gfx_line(ix + m, iy + a + k, ix + b, iy + m + a / 2 + k)
        elif hacia == 1
            gfx_line(ix + a, iy + a + k, ix + m, iy + m + a / 2 + k)
            gfx_line(ix + m, iy + m + a / 2 + k, ix + b, iy + a + k)
        elif hacia == 2
            gfx_line(ix + m + a / 2 + k, iy + a, ix + a + k, iy + m)
            gfx_line(ix + a + k, iy + m, ix + m + a / 2 + k, iy + b)
        else
            gfx_line(ix + a + k, iy + a, ix + m + a / 2 + k, iy + m)
            gfx_line(ix + m + a / 2 + k, iy + m, ix + a + k, iy + b)
        end
    end
end

# Una caja redonda: rellena (estilo 0) o su borde de estilo píxeles
func _elipse_pintar(d: Dibujo, x: Int, y: Int)
    gfx_pen(_lapiz(d.color))
    rx = (d.ancho - 1) / 2
    ry = (d.alto - 1) / 2
    cx = x + rx
    cy = y + ry
    if d.estilo == 0
        gfx_ellipse_fill(cx, cy, rx, ry)
        return
    end
    for k in (0..d.estilo - 1)
        if rx - k > 0 and ry - k > 0
            gfx_ellipse(cx, cy, rx - k, ry - k)
        end
    end
end

# Un color semitransparente mezclado con lo que hay debajo (gfx_blend_rect: en RTG de verdad, en pantallas de
# paleta un tramado)
func _mezcla_recortada(x: Int, y: Int, ancho: Int, alto: Int, x0: Int, y0: Int, x1: Int, y1: Int, rgb: Int, alfa: Int)
    a = x
    b = y
    c = x + ancho - 1
    e = y + alto - 1
    if a < x0
        a = x0
    end
    if b < y0
        b = y0
    end
    if c > x1
        c = x1
    end
    if e > y1
        e = y1
    end
    if a <= c and b <= e
        gfx_blend_rect(a, b, c, e, rgb, alfa)
    end
end

# Un linear-gradient recortado al rectángulo, mezclado con lo de debajo (gfx_gradient_rect); los colores
# de los bordes recortados se calculan sobre el degradado entero
func _degradado_pintar(d: Dibujo, x: Int, y: Int, x0: Int, y0: Int, x1: Int, y1: Int)
    if d.ancho <= 0 or d.alto <= 0
        return
    end
    a = x
    b = y
    c = x + d.ancho - 1
    e = y + d.alto - 1
    if a < x0
        a = x0
    end
    if b < y0
        b = y0
    end
    if c > x1
        c = x1
    end
    if e > y1
        e = y1
    end
    if a > c or b > e
        return
    end
    vertical = d.texto != "h"
    largo = d.alto
    desde = b - y
    hasta = e - y
    if not vertical
        largo = d.ancho
        desde = a - x
        hasta = c - x
    end
    gfx_gradient_rect(a, b, c, e, _color_en(d.color, d.fuente, desde, largo), d.estilo + (d.espaciado - d.estilo) * desde / largo, _color_en(d.color, d.fuente, hasta, largo), d.estilo + (d.espaciado - d.estilo) * hasta / largo, vertical)
end

# El color a esa distancia (de 0 a largo) entre dos colores 0xRRGGBB
func _color_en(c1: Int, c2: Int, en: Int, largo: Int) -> Int
    r1 = c1 / 65536
    g1 = (c1 / 256) % 256
    b1 = c1 % 256
    r2 = c2 / 65536
    g2 = (c2 / 256) % 256
    b2 = c2 % 256
    return (r1 + (r2 - r1) * en / largo) * 65536 + (g1 + (g2 - g1) * en / largo) * 256 + b1 + (b2 - b1) * en / largo
end

# Un vídeo (su imagen o el botón de reproducir), también si solo se ve una parte: la zona de dibujo de MUI
# recorta lo que cae fuera (MUI_AddClipping en lib de Dash)
func _video_dibujo(d: Dibujo, im: Imagenes, x: Int, y: Int, x0: Int, y0: Int, x1: Int, y1: Int)
    if x + d.ancho - 1 >= x0 and y + d.alto - 1 >= y0 and x <= x1 and y <= y1
        if im != nil and videos_sin_empezar(pintor_videos, d.nodo) and _video_cartel(im, d, x, y, x0, y0, x1, y1)
            return
        end
        videos_pintar(pintor_videos, d.nodo, x, y, d.ancho, d.alto)
    end
end

# El cartel antes de reproducir, sobre negro: la miniatura de YouTube cubre el recuadro (hqdefault es 4:3
# con franjas negras dentro, como el reproductor de YouTube), el poster de <video> cabe entero (contain)
func _video_cartel(im: Imagenes, d: Dibujo, x: Int, y: Int, x0: Int, y0: Int, x1: Int, y1: Int) -> Bool
    src = dom_atributo(d.nodo, "poster")
    if src == ""
        return false
    end
    img = imagenes_cargada(im, src)
    if img == 0 or d.ancho <= 0 or d.alto <= 0
        return false
    end
    iw = image_width(img)
    ih = image_height(img)
    if iw <= 0 or ih <= 0
        return false
    end
    cubrir = d.nodo.nombre == "iframe"
    sw = d.ancho
    sh = ih * d.ancho / iw
    if (cubrir and sh < d.alto) or (not cubrir and sh > d.alto)
        sh = d.alto
        sw = iw * d.alto / ih
    end
    _rect_recortado(x, y, d.ancho, d.alto, x0, y0, x1, y1, _lapiz(0))
    a = x0
    if x > a
        a = x
    end
    b = y0
    if y > b
        b = y
    end
    c = x1
    if x + d.ancho - 1 < c
        c = x + d.ancho - 1
    end
    e = y1
    if y + d.alto - 1 < e
        e = y + d.alto - 1
    end
    escalada = imagenes_a_tamano(im, src, sw, sh)
    if escalada != 0 and a <= c and b <= e
        _imagen_recortada(escalada, x + (d.ancho - sw) / 2, y + (d.alto - sh) / 2, sw, sh, a, b, c, e)
    end
    videos_boton(pintor_videos, d.nodo, x, y, d.ancho, d.alto)
    return true
end

# Solo los vídeos de la franja [desde, desde + alto) (una imagen nueva: no hace falta pintar la página entera)
func pintar_videos(p: Pagina, desde: Int, x0: Int, y0: Int, ancho: Int, alto: Int)
    for d in p.dibujos
        # (los que aún enseñan su cartel no cambian: necesitan las imágenes, que aquí no están)
        if d.tipo == D_VIDEO and d.y + d.alto > desde and d.y < desde + alto and not videos_sin_empezar(pintor_videos, d.nodo)
            var sin: Imagenes = nil
            _video_dibujo(d, sin, x0 + d.x, y0 + d.y - desde, x0, y0, x0 + ancho - 1, y0 + alto - 1)
        end
    end
end
