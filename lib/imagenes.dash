# Imágenes de una página: las <img> y las imágenes de fondo se traen (HTTP/HTTPS a un fichero de T:, o
# de disco), se decodifican (lib/imagen_dec.dash; si no, los datatypes del sistema) y se pintan.
#
#   im = imagenes_nuevas()
#   imagenes_cargar(im, doc, "http://ejemplo.org/")   # con la ventana ya abierta (colores)
#   pagina = maquetar(doc, ancho)                     # width/height que faltaban ya están puestos
#   pintar(pagina, im, desde, x, y, ancho, alto)      # lib/pintor.dash
#   imagenes_liberar(im)
#
# Sin esperar (navegador): imagenes_pedir(im, doc, base) empieza las descargas (4 a la vez) y vuelve;
# imagenes_avanzar(im, doc) en cada vuelta del bucle dice cuántas llegaron (ya con su tamaño puesto:
# hay que volver a maquetar); imagenes_pendientes(im) cuántas faltan.
#
# Sin width ni height en el HTML, la imagen toma su tamaño real; con uno solo, el otro guarda la
# proporción. Una imagen que no se puede traer o leer se queda como hueco (16x16 si no dice más).

import "http.dash"
import "dom.dash"
import "css.dash"
import "imagen_dec.dash"
import "estilo.dash"
import "colores.dash"
import "fuente_web.dash"

# Una imagen de un fichero: decodificada aquí (lib/imagen_dec.dash, reducida a lo que cabe en una
# pantalla grande) y, si no se puede (otro formato, AmigaOS 3.1), con los datatypes
func imagen_cargar(fichero: String) -> Int
    return imagen_cargar_a(fichero, IMAGEN_MAX_ANCHO, IMAGEN_MAX_ALTO)
end

# Lo mismo sin decodificar más de lo que cabe en maxw x maxh
func imagen_cargar_a(fichero: String, maxw: Int, maxh: Int) -> Int
    img = imagen_decodificar(fichero, maxw, maxh)
    if img == 0
        img = image_load(fichero)
    end
    return img
end

struct Imagenes
    por_src: {String: Int}      # src del HTML -> imagen cargada (0: no se pudo, o aún no ha llegado)
    escaladas: {String: Int}    # "src ancho alto" -> copia a ese tamaño
    ficheros: [String]          # los de T: que se descargaron
    cola: [Pedida]              # las que esperan su turno o están llegando (imagenes_pedir)
    # src -> el tamaño mayor al que se ve en la última maqueta (ancho * 65536 + alto; imagenes_vista):
    # una <img> con width y height se decodifica a ese tamaño y no al de sus atributos
    vistas: {String: Int} = nil
    cambiados: Int = 0          # <img> a los que una imagen llegada les ha puesto tamaño (cambia la maqueta)
    recien: {String: Int} = nil # los src llegados desde el último repintado (para no repintar si no se ven)
    # Como los navegadores: una <img loading=lazy> no se baja hasta que está cerca de lo que se ve, y un fondo
    # (background-image) hasta que algún elemento lo pinta (los de display: none no). posiciones: src -> la y más
    # alta a la que se dibuja en la última maqueta; hasta: la y hasta la que se baja lo perezoso (-1: aún no se sabe)
    posiciones: {String: Int} = nil
    hasta: Int = -1
end

struct Pedida
    src: String
    direccion: String
    fichero: String
    carga: Carga                # nil hasta que le toca
    maxw: Int = 1280            # se decodifica reducida hasta lo que quepa en maxw x maxh (sin bajar de ahí)
    maxh: Int = 1024
    con_medidas: Bool = false   # una <img> con width y height (su tamaño en la página no depende de la imagen)
    llegada: Bool = false       # ya está en su fichero: espera su turno para decodificarse
    dec: Decodificando = nil    # decodificándose en otro proceso (lib/imagen_dec.dash)
    fuente: String = ""         # una fuente de @font-face ("familia|peso|estilo"), no una imagen
    perezosa: Bool = false      # <img loading=lazy>: espera a estar cerca de lo que se ve
    de_fondo: Bool = false      # un background-image: espera a que algo lo pinte
end

# Una imagen grande no se decodifica entera si el HTML ya dice a qué tamaño se ve (width y height)
const IMAGEN_MAX_ANCHO = 1280
const IMAGEN_MAX_ALTO = 1024

const IMAGENES_A_LA_VEZ = 4
# Decodificando a la vez, cada una en su proceso (con una sola, freemem.space tardaba unos 5 s más)
const IMAGENES_DECODIFICANDO = 4
# Las fuentes van aparte, con sus propias descargas: si no, las imágenes esperaban detrás (freemem.space: 4 pesos
# de Inter de 325 KB y 4 de Font Awesome; las imágenes empezaban a bajarse a los 28 s)
const FUENTES_A_LA_VEZ = 4

func imagenes_nuevas() -> Imagenes
    var por_src: {String: Int} = {}
    var escaladas: {String: Int} = {}
    var ficheros: [String] = []
    var cola: [Pedida] = []
    return Imagenes(por_src, escaladas, ficheros, cola)
end

# Empieza a traer las imágenes que falten (las de disco se cargan ya) y vuelve
func imagenes_pedir(im: Imagenes, doc: Nodo, base: String)
    t0 = time_ms()
    _imagenes_pedir_en(im, doc, url_parse(base))
    t1 = time_ms()
    imagenes_avanzar(im, doc)
    if traza_activa
        traza("imágenes: buscarlas " + (t1 - t0) + " ms, avanzar las que llegan " + (time_ms() - t1) + " ms")
    end
end

# La imagen de fondo de un elemento (background-image: url(...)), como dirección completa; "" si no
func imagenes_fondo(n: Nodo, base: Url) -> String
    if n.tipo != DOM_ELEMENTO or not n.estilo.has("background-image")
        return ""
    end
    u = css_url(n.estilo["background-image"])
    if u == ""
        return ""
    end
    completa = u
    if not url_es_data(u)
        completa = url_text(url_resolve(base, u))
    end
    # la maqueta y el pintor no saben la dirección de la página: el estilo se queda con la completa
    n.estilo["background-image"] = "url(" + completa + ")"
    return completa
end

func _imagenes_pedir_fondo(im: Imagenes, n: Nodo, base: Url)
    src = imagenes_fondo(n, base)
    if src == "" or im.por_src.has(src)
        return
    end
    u = url_parse(src)
    if u.esquema == "http" or u.esquema == "https" or url_es_data(src)
        im.por_src[src] = 0
        fichero = "T:dashweb_img" + im.ficheros.length
        im.ficheros.push(fichero)
        var sin: Carga = nil
        pedida = Pedida(src, src, fichero, sin)
        pedida.de_fondo = true
        if url_es_data(src) and not _imagenes_data(im, pedida)
            return
        end
        # con cover o contain el tamaño de la imagen solo cuenta por su proporción: se puede reducir
        if n.tipo == DOM_ELEMENTO and n.estilo != nil and n.estilo.has("background-size")
            bs = n.estilo["background-size"]
            pedida.con_medidas = bs == "cover" or bs == "contain"
        end
        im.cola.push(pedida)
    else
        im.por_src[src] = _imagen_traer(im, base, src)
    end
end

# El cartel de un vídeo (dom_video_poster), como dirección completa en su atributo poster (el pintor lo
# busca ahí); "" si no tiene
func imagenes_cartel(n: Nodo, base: Url) -> String
    if not dom_es_video(n)
        return ""
    end
    p = dom_video_poster(n)
    if p == ""
        return ""
    end
    completa = p
    if not url_es_data(p)
        completa = url_text(url_resolve(base, p))
    end
    _poner_atributo(n, "poster", completa)
    return completa
end

func _imagenes_pedir_cartel(im: Imagenes, n: Nodo, base: Url)
    src = imagenes_cartel(n, base)
    if src == "" or im.por_src.has(src)
        return
    end
    u = url_parse(src)
    if u.esquema == "http" or u.esquema == "https" or url_es_data(src)
        im.por_src[src] = 0
        fichero = "T:dashweb_img" + im.ficheros.length
        im.ficheros.push(fichero)
        var sin: Carga = nil
        pedida = Pedida(src, src, fichero, sin)
        if url_es_data(src) and not _imagenes_data(im, pedida)
            return
        end
        im.cola.push(pedida)
    else
        im.por_src[src] = _imagen_traer(im, base, src)
    end
end

func _imagenes_pedir_en(im: Imagenes, n: Nodo, base: Url)
    _imagenes_pedir_fondo(im, n, base)
    _imagenes_pedir_cartel(im, n, base)
    if n.tipo == DOM_ELEMENTO and n.nombre == "svg"
        _imagenes_svg(im, n)
        return
    end
    if dom_es_imagen(n)
        src = dom_img_src(n)
        if src != "" and im.por_src.has(src)
            if im.por_src[src] != 0
                _imagen_tamano(n, im.por_src[src])
            end
        elif src != ""
            u = url_resolve(base, src)
            data = url_es_data(src)
            if u.esquema == "http" or u.esquema == "https" or data
                im.por_src[src] = 0
                fichero = "T:dashweb_img" + im.ficheros.length
                im.ficheros.push(fichero)
                var sin: Carga = nil
                direccion = src
                if not data
                    direccion = url_text(u)
                end
                pedida = Pedida(src, direccion, fichero, sin)
                if data and not _imagenes_data(im, pedida)
                    return
                end
                pedida.perezosa = str_lower(dom_atributo(n, "loading")) == "lazy"
                w = Int(dom_atributo(n, "width"))
                h = Int(dom_atributo(n, "height"))
                if w > 0 and h > 0
                    pedida.con_medidas = true
                    if w < IMAGEN_MAX_ANCHO and h < IMAGEN_MAX_ALTO
                        pedida.maxw = w
                        pedida.maxh = h
                    end
                end
                im.cola.push(pedida)
            else
                im.por_src[src] = _imagen_traer(im, base, src)
                _imagen_tamano(n, im.por_src[src])
            end
        end
        return
    end
    for h in n.hijos
        _imagenes_pedir_en(im, h, base)
    end
end

# Avanza las descargas y las decodificaciones sin esperar; cuántas imágenes llegaron ahora (su tamaño ya
# está en los <img>). Cada imagen: se baja a su fichero (hasta IMAGENES_A_LA_VEZ a la vez) y se decodifica en
# otro proceso (hasta IMAGENES_DECODIFICANDO a la vez): la ventana no se para mientras.
func imagenes_avanzar(im: Imagenes, doc: Nodo) -> Int
    llegadas = 0
    activas = 0
    fuentes = 0
    decodificando = 0
    i = 0
    while i < im.cola.length
        p = im.cola[i]
        if p.dec != nil
            if imagen_lista(p.dec)
                img = imagen_acabar(p.dec)
                if img == 0
                    img = image_load(p.fichero)      # otro formato: los datatypes
                end
                if traza_activa
                    traza("decodificada " + p.src)
                end
                if _imagen_llegada(im, doc, p, img)
                    llegadas = llegadas + 1
                end
                im.cola.remove(i)
                continue
            end
            decodificando = decodificando + 1
        elif p.llegada and p.fuente != ""
            # una fuente: se apunta y hay que volver a maquetar (las letras cambian de ancho)
            fuente_web_registrar(p.fuente, p.fichero)
            im.cambiados = im.cambiados + 1
            llegadas = llegadas + 1
            im.cola.remove(i)
            continue
        elif p.llegada
            if decodificando < IMAGENES_DECODIFICANDO
                _imagen_tamano_final(im, p)
                p.dec = imagen_empezar(p.fichero, p.maxw, p.maxh)
                if p.dec == nil
                    # sin otro proceso: aquí mismo
                    if _imagen_llegada(im, doc, p, imagen_cargar_a(p.fichero, p.maxw, p.maxh))
                        llegadas = llegadas + 1
                    end
                    im.cola.remove(i)
                    continue
                end
                decodificando = decodificando + 1
            end
        elif p.carga == nil and _imagen_aparcada(im, p)
            i = i + 1
            continue
        else
            es_fuente = p.fuente != ""
            if p.carga == nil and ((not es_fuente and activas < IMAGENES_A_LA_VEZ) or (es_fuente and fuentes < FUENTES_A_LA_VEZ))
                p.carga = http_empezar_a_fichero(p.direccion, p.fichero, 15000)
            end
            if p.carga != nil
                if http_avanzar(p.carga)
                    r = p.carga.respuesta
                    var sin: Carga = nil
                    p.carga = sin
                    if r.error == "" and r.estado >= 200 and r.estado < 300
                        p.llegada = true
                        continue                     # (a decodificarse, en esta misma vuelta si le toca)
                    end
                    im.por_src[p.src] = 0
                    im.cola.remove(i)
                    continue
                end
                if es_fuente
                    fuentes = fuentes + 1
                else
                    activas = activas + 1
                end
            end
        end
        i = i + 1
    end
    return llegadas
end

# Hasta dónde decodificarla: al tamaño al que se ve si el HTML lo fija (una foto de 820x480 en una casilla
# de 225x220)
func _imagen_tamano_final(im: Imagenes, p: Pedida)
    if p.con_medidas and im.vistas != nil and im.vistas.has(p.src)
        v = im.vistas[p.src]
        if v / 65536 >= 16 and v % 65536 >= 16 and v / 65536 < p.maxw and v % 65536 < p.maxh
            p.maxw = v / 65536
            p.maxh = v % 65536
        end
    end
end

# Una imagen mayor que donde se ve (imagenes_vista de la última maqueta) se reduce a lo justo para cubrirlo con su
# proporción y se suelta la grande: el pintor ya pintaba una copia a ese tamaño y guardaba las dos (freemem.space:
# cinco de 820x480 que se ven a 412x241, una de 1376x768 a 453x442; tarea 40h). Sin vista sabida, tal cual.
func _imagen_a_su_vista(im: Imagenes, src: String, img: Int) -> Int
    if img == 0 or im.vistas == nil or not im.vistas.has(src)
        return img
    end
    v = im.vistas[src]
    vw = v / 65536
    vh = v % 65536
    iw = image_width(img)
    ih = image_height(img)
    if vw < 8 or vh < 8 or iw <= vw or ih <= vh
        return img
    end
    # (el factor que cubre los dos lados, en milésimas)
    f = vw * 1000 / iw
    if vh * 1000 / ih > f
        f = vh * 1000 / ih
    end
    nw = (iw * f + 999) / 1000
    nh = (ih * f + 999) / 1000
    if nw >= iw or nh >= ih
        return img
    end
    nueva = image_scale(img, nw, nh)
    if nueva == 0
        return img
    end
    image_free(img)
    return nueva
end

# La imagen ya decodificada, a su sitio; true si hay imagen (hay que volver a pintar: también un fondo)
func _imagen_llegada(im: Imagenes, doc: Nodo, p: Pedida, img: Int) -> Bool
    img = _imagen_a_su_vista(im, p.src, img)
    im.por_src[p.src] = img
    if img == 0
        return false
    end
    if im.recien == nil
        var r: {String: Int} = {}
        im.recien = r
    end
    im.recien[p.src] = 1
    _imagenes_tamano_de(im, doc, p.src, img)
    return true
end

# El tamaño al que se ve una imagen en la página (el mayor, si sale varias veces)
func imagenes_vista(im: Imagenes, src: String, ancho: Int, alto: Int)
    if im.vistas == nil
        var nuevas: {String: Int} = {}
        im.vistas = nuevas
    end
    w = ancho
    h = alto
    if im.vistas.has(src)
        v = im.vistas[src]
        if v / 65536 > w
            w = v / 65536
        end
        if v % 65536 > h
            h = v % 65536
        end
    end
    if w > 0 and h > 0 and w < 65536 and h < 65536
        im.vistas[src] = w * 65536 + h
    end
end

# Las fuentes de los @font-face (las que se saben leer: TTF, OTF y WOFF), a la cola como las imágenes; hasta 8
func imagenes_pedir_fuentes(im: Imagenes, caras: [CaraFuente])
    n = 0
    for c in caras
        src = css_fuente_src(c.src)
        if src == "" or im.por_src.has(src) or n >= 8 or imagenes_fuente_de_iconos(c.familia)
            continue
        end
        u = url_parse(src)
        if u.esquema != "http" and u.esquema != "https" and not url_es_data(src)
            continue
        end
        im.por_src[src] = 0
        fichero = "T:dashweb_fuente" + im.ficheros.length
        im.ficheros.push(fichero)
        var sin: Carga = nil
        pedida = Pedida(src, src, fichero, sin)
        pedida.fuente = c.familia + "|" + c.peso + "|" + c.estilo
        if url_es_data(src) and not _imagenes_data(im, pedida)
            continue
        end
        im.cola.push(pedida)
        n = n + 1
    end
end

# Las fuentes de iconos no se bajan: sus letras están fuera de Latin-1 (lib/fuente_web.dash solo lee de la 32 a la
# 255) y dashweb dibuja él los iconos más comunes (lib/pintor.dash, D_ICONO). Font Awesome son 700 KB.
func imagenes_fuente_de_iconos(familia: String) -> Bool
    f = str_lower(familia)
    for nombre in ["awesome", "icon", "dashicons", "genericons", "glyph", "fontello", "icomoon", "material symbols", "remixicon", "themify", "feather", "eicons"]
        if str_find(f, nombre) >= 0
            return true
        end
    end
    return false
end

# Las que faltan (sin contar las aparcadas: lejos de lo que se ve, o fondos que nada pinta)
func imagenes_pendientes(im: Imagenes) -> Int
    n = 0
    for p in im.cola
        if p.carga != nil or p.llegada or p.dec != nil or not _imagen_aparcada(im, p)
            n = n + 1
        end
    end
    return n
end

# ¿Espera a que la pidan? (perezosa lejos de lo que se ve, o un fondo que ninguna maqueta ha pintado)
func _imagen_aparcada(im: Imagenes, p: Pedida) -> Bool
    if p.de_fondo
        return im.vistas == nil or not im.vistas.has(p.src)
    end
    if p.perezosa
        if im.hasta < 0 or im.posiciones == nil or not im.posiciones.has(p.src)
            return true
        end
        return im.posiciones[p.src] > im.hasta
    end
    return false
end

# Hasta dónde de la página se bajan las imágenes perezosas (lo que se ve y dos pantallas más, como Chrome)
func imagenes_hasta(im: Imagenes, desde: Int, alto: Int)
    im.hasta = desde + alto * 3
end

# Dónde se dibuja cada imagen en la maqueta nueva (empezar: antes de la primera)
func imagenes_posicion(im: Imagenes, src: String, y: Int, empezar: Bool)
    if empezar or im.posiciones == nil
        var nuevas: {String: Int} = {}
        im.posiciones = nuevas
    end
    if src != "" and (not im.posiciones.has(src) or y < im.posiciones[src])
        im.posiciones[src] = y
    end
end

# width/height de todos los <img src> con esa imagen (los que no lo tenían: cuentan en im.cambiados)
func _imagenes_tamano_de(im: Imagenes, n: Nodo, src: String, img: Int)
    if n == nil
        return
    end
    if dom_es_imagen(n) and dom_img_src(n) == src
        if _imagen_tamano(n, img)
            im.cambiados = im.cambiados + 1
        end
    end
    for h in n.hijos
        _imagenes_tamano_de(im, h, src, img)
    end
end

func imagenes_cargar(im: Imagenes, doc: Nodo, base: String)
    _imagenes_recorrer(im, doc, url_parse(base))
end

func _imagenes_recorrer(im: Imagenes, n: Nodo, base: Url)
    if n.tipo == DOM_ELEMENTO and n.nombre == "svg"
        _imagenes_svg(im, n)
        return
    end
    fondo = imagenes_fondo(n, base)
    if fondo != "" and not im.por_src.has(fondo)
        im.por_src[fondo] = _imagen_traer(im, base, fondo)
    end
    cartel = imagenes_cartel(n, base)
    if cartel != "" and not im.por_src.has(cartel)
        im.por_src[cartel] = _imagen_traer(im, base, cartel)
    end
    if dom_es_imagen(n)
        src = dom_img_src(n)
        if src != ""
            if not im.por_src.has(src)
                im.por_src[src] = _imagen_traer(im, base, src)
            end
            _imagen_tamano(n, im.por_src[src])
        end
        return
    end
    for h in n.hijos
        _imagenes_recorrer(im, h, base)
    end
end

# La imagen de src (relativa a la página), o 0
func _imagen_traer(im: Imagenes, base: Url, src: String) -> Int
    u = url_resolve(base, src)
    direccion = url_text(u)
    if u.esquema == "http" or u.esquema == "https"
        fichero = "T:dashweb_img" + im.ficheros.length
        r = http_a_fichero(direccion, fichero, 15000)
        if r.bytes > 0 or r.estado != 0
            im.ficheros.push(fichero)
        end
        if r.error != "" or r.estado < 200 or r.estado >= 300
            return 0
        end
        return imagen_cargar(fichero)
    end
    if url_es_data(src)
        fichero = "T:dashweb_img" + im.ficheros.length
        im.ficheros.push(fichero)
        if not imagen_data_a_fichero(src, fichero)
            return 0
        end
        return imagen_cargar(fichero)
    end
    ruta = url_fichero(direccion)
    return imagen_cargar(ruta)
end

# Lo que lleva una dirección data: (imágenes y fuentes dentro de la página o del CSS: data:image/png;base64,... o
# data:image/svg+xml,%3Csvg...) escrito en fichero; false si no se puede (D68: base64_to_file)
func imagen_data_a_fichero(direccion: String, fichero: String) -> Bool
    if not url_es_data(direccion)
        return false
    end
    coma = str_find(direccion, ",")
    if coma < 0
        return false
    end
    cabecera = str_lower(direccion[5:coma])
    datos = url_deshacer(direccion[coma + 1:])
    if str_ends(cabecera, ";base64")
        return base64_to_file(datos, fichero) >= 0
    end
    return file_write_text(fichero, datos)
end

# Una pedida de una dirección data: ya está en su fichero (solo le falta decodificarse); false si no se pudo
func _imagenes_data(im: Imagenes, p: Pedida) -> Bool
    p.llegada = imagen_data_a_fichero(p.direccion, p.fichero)
    if not p.llegada
        im.por_src[p.src] = 0
    end
    return p.llegada
end

# width/height que faltan, con el tamaño real de la imagen; true si les faltaba
func _imagen_tamano(n: Nodo, img: Int) -> Bool
    if img == 0
        return false
    end
    w = Int(dom_atributo(n, "width"))
    h = Int(dom_atributo(n, "height"))
    if w > 0 and h > 0
        return false
    end
    rw = image_width(img)
    rh = image_height(img)
    if w <= 0 and h <= 0
        w = rw
        h = rh
    elif w <= 0
        w = rw * h / rh
    else
        h = rh * w / rw
    end
    _poner_atributo(n, "width", "" + w)
    _poner_atributo(n, "height", "" + h)
    return true
end

func _poner_atributo(n: Nodo, nombre: String, valor: String)
    dom_tocar(n)       # (lo medido en la maqueta anterior ya no vale; tarea 37e6)
    for a in n.atributos
        if a.nombre == nombre
            a.valor = valor
            return
        end
    end
    n.atributos.push(Atributo(nombre, valor))
end

# KB que ocupan las imágenes decodificadas (a 4 bytes por punto): las cargadas y las copias escaladas (traza)
func imagenes_kb(im: Imagenes) -> String
    a = 0
    for k in im.por_src.keys()
        i = im.por_src[k]
        if i != 0
            a = a + image_width(i) * image_height(i) * 4 / 1024
        end
    end
    b = 0
    for k in im.escaladas.keys()
        i = im.escaladas[k]
        if i != 0
            b = b + image_width(i) * image_height(i) * 4 / 1024
        end
    end
    return "imágenes " + a + " KB y copias " + b + " KB"
end

# La imagen de src a ancho x alto (la cargada o una copia escalada, que se guarda); 0 si no hay
func imagenes_a_tamano(im: Imagenes, src: String, ancho: Int, alto: Int) -> Int
    if not im.por_src.has(src)
        return 0
    end
    img = im.por_src[src]
    if img == 0 or (image_width(img) == ancho and image_height(img) == alto)
        return img
    end
    clave = src + " " + ancho + " " + alto
    if not im.escaladas.has(clave)
        im.escaladas[clave] = image_scale(img, ancho, alto)
    end
    return im.escaladas[clave]
end

func imagenes_liberar(im: Imagenes)
    for p in im.cola
        if p.carga != nil
            http_cancelar(p.carga)
        end
        if p.dec != nil
            image_free(imagen_acabar(p.dec))      # (espera a que acabe su proceso)
        end
    end
    im.cola.clear()
    for clave in im.escaladas.keys()
        image_free(im.escaladas[clave])
    end
    im.escaladas.clear()
    for src in im.por_src.keys()
        image_free(im.por_src[src])
    end
    im.por_src.clear()
    for f in im.ficheros
        file_delete(f)
    end
    im.ficheros.clear()
end

# La imagen ya cargada de src a su tamaño natural (0 si no está); para los fondos
func imagenes_cargada(im: Imagenes, src: String) -> Int
    if not im.por_src.has(src)
        return 0
    end
    return im.por_src[src]
end

# === SVG dentro de la página (tarea 31i) ===
# Cada <svg> se vuelve a escribir como un fichero SVG (T:dashweb_svgN.svg) que decodifica nanosvg: con los nombres
# en su caja (el HTML los pasa a minúsculas: viewBox, linearGradient...), currentColor con su color, el fill y el
# stroke que le da el CSS de la página a cada elemento, y <use href="#icono"> cambiado por lo que nombra (un
# <symbol> de un sprite, con su viewBox). Su dirección queda en el atributo data-dashweb-svg (la maqueta lo pone
# como una imagen).

func _imagenes_svg(im: Imagenes, n: Nodo)
    if dom_tiene_atributo(n, "data-dashweb-svg") or _oculto_svg(n)
        return
    end
    raiz = n
    while raiz.padre != nil
        raiz = raiz.padre
    end
    color = "#000000"
    if n.estilo.has("color") and css_color(n.estilo["color"]) >= 0
        color = _hex6(css_color(n.estilo["color"]))
    end
    w = svg_ancho(n)
    h = svg_alto(n)
    texto = _svg_elemento(n, raiz, true, w, h)
    texto = str_replace(str_replace(str_replace(texto, "currentColor", color), "currentcolor", color), "CurrentColor", color)
    fichero = "T:dashweb_svg" + im.ficheros.length + ".svg"
    if not file_write_text(fichero, texto)
        return
    end
    im.ficheros.push(fichero)
    _poner_atributo(n, "data-dashweb-svg", fichero)
    if not im.por_src.has(fichero)
        im.por_src[fichero] = imagen_cargar_a(fichero, IMAGEN_MAX_ANCHO, IMAGEN_MAX_ALTO)
    end
end

# Vuelve a escribir y rasterizar un <svg> ya puesto (un fotograma de las animaciones de lo de dentro, con sus
# svg_sobre: tarea 37d4) y cambia su imagen por la nueva; false si no se pudo (se queda la que había)
func imagenes_svg_rehacer(im: Imagenes, n: Nodo) -> Bool
    fichero = dom_atributo(n, "data-dashweb-svg")
    if fichero == "" or not im.por_src.has(fichero)
        return false
    end
    raiz = n
    while raiz.padre != nil
        raiz = raiz.padre
    end
    color = "#000000"
    if n.estilo.has("color") and css_color(n.estilo["color"]) >= 0
        color = _hex6(css_color(n.estilo["color"]))
    end
    # (al tamaño al que se ve en la última maqueta, si lo hay: un width en % no se sabe hasta maquetar)
    w = svg_ancho(n)
    h = svg_alto(n)
    if n.caja_pase == raiz.caja_pase and n.caja_w > 0 and n.caja_h > 0
        w = n.caja_w
        h = n.caja_h
    end
    texto = _svg_elemento(n, raiz, true, w, h)
    texto = str_replace(str_replace(str_replace(texto, "currentColor", color), "currentcolor", color), "CurrentColor", color)
    temporal = fichero + ".f"
    if not file_write_text(temporal, texto)
        return false
    end
    nueva = imagen_cargar_a(temporal, IMAGEN_MAX_ANCHO, IMAGEN_MAX_ALTO)
    file_delete(temporal)
    if nueva == 0
        return false
    end
    # las copias a otro tamaño de la vieja ya no valen
    var fuera: [String] = []
    for clave in im.escaladas.keys()
        if str_starts(clave, fichero + " ")
            fuera.push(clave)
        end
    end
    for clave in fuera
        image_free(im.escaladas[clave])
        im.escaladas.remove(clave)
    end
    image_free(im.por_src[fichero])
    im.por_src[fichero] = nueva
    return true
end

# Un <svg> rasterizado a otro tamaño que el que tiene en la página (width en %): otra vez, a ese (tarea 37h)
func imagenes_svg_a_tamano(im: Imagenes, n: Nodo) -> Bool
    fichero = dom_atributo(n, "data-dashweb-svg")
    if fichero == "" or not im.por_src.has(fichero) or im.por_src[fichero] == 0
        return false
    end
    raiz = n
    while raiz.padre != nil
        raiz = raiz.padre
    end
    if n.caja_pase != raiz.caja_pase or n.caja_w <= 0
        return false
    end
    dif = image_width(im.por_src[fichero]) - n.caja_w
    if dif > 4 or dif < -4
        return imagenes_svg_rehacer(im, n)
    end
    return false
end

# Un color de fill o stroke como lo lee nanosvg (#rrggbb); none, url(...) y lo que no sea un color, tal cual
func _svg_color(v: String) -> String
    t = str_lower(str_trim(v))
    # (lo que nanosvg ya lee, tal cual: #rgb, #rrggbb, rgb() y los nombres)
    if not (str_starts(t, "rgba(") or str_starts(t, "hsl") or (str_starts(t, "#") and (t.length == 5 or t.length == 9)))
        return v
    end
    c = css_color_opaco(v)
    if c < 0
        return v
    end
    return _hex6(c)
end

# La opacidad de un color con alfa (rgba, hsla, #rrggbbaa) como "0.35"; "" si es opaco o no es un color
func _svg_opacidad(v: String) -> String
    t = str_lower(str_trim(v))
    if t == "none" or t == "" or str_starts(t, "url(") or t == "currentcolor" or css_color_opaco(v) < 0
        return ""
    end
    a = css_alfa(v)
    if a >= 255
        return ""
    end
    mil = a * 1000 / 255
    r = "" + mil
    while r.length < 3
        r = "0" + r
    end
    return "0." + r
end

func _oculto_svg(n: Nodo) -> Bool
    return n.estilo.has("display") and n.estilo["display"] == "none"
end

func _hex6(rgb: Int) -> String
    cifras = "0123456789abcdef"
    r = "#"
    k = 20
    while k >= 0
        r = r + cifras[(rgb / _potencia2(k)) % 16]
        k = k - 4
    end
    return r
end

func _potencia2(k: Int) -> Int
    r = 1
    for i in (1..k)
        r = r * 2
    end
    return r
end

# Los nombres de SVG con mayúsculas (el HTML los deja en minúsculas)
func _svg_nombre(x: String) -> String
    if x == "lineargradient"
        return "linearGradient"
    elif x == "radialgradient"
        return "radialGradient"
    elif x == "clippath"
        return "clipPath"
    elif x == "textpath"
        return "textPath"
    elif x == "foreignobject"
        return "foreignObject"
    elif x == "viewbox"
        return "viewBox"
    elif x == "preserveaspectratio"
        return "preserveAspectRatio"
    elif x == "gradientunits"
        return "gradientUnits"
    elif x == "gradienttransform"
        return "gradientTransform"
    elif x == "spreadmethod"
        return "spreadMethod"
    elif x == "clippathunits"
        return "clipPathUnits"
    elif x == "patternunits"
        return "patternUnits"
    elif x == "pathlength"
        return "pathLength"
    end
    return x
end

func _svg_escapar(v: String) -> String
    return str_replace(str_replace(str_replace(v, "&", "&amp;"), "\"", "&quot;"), "<", "&lt;")
end

# Un elemento de SVG como texto (raiz: el documento, para los <use>)
func _svg_elemento(n: Nodo, raiz: Nodo, es_raiz: Bool, w: Int, h: Int) -> String
    if n.tipo == DOM_TEXTO
        if n.padre != nil and (n.padre.nombre == "style")
            return n.texto
        end
        return ""
    end
    if n.tipo != DOM_ELEMENTO or _oculto_svg(n)
        return ""
    end
    if n.nombre == "use"
        return _svg_use(n, raiz)
    end
    if n.nombre == "title" or n.nombre == "desc" or n.nombre == "script"
        return ""
    end
    nombre = _svg_nombre(n.nombre)
    r = "<" + nombre
    if es_raiz
        r = r + " xmlns=\"http://www.w3.org/2000/svg\" width=\"" + w + "\" height=\"" + h + "\""
        if svg_viewbox(n) == ""
            vb = _svg_viewbox_de_use(n, raiz)
            if vb != ""
                r = r + " viewBox=\"" + _svg_escapar(vb) + "\""
            end
        end
    end
    estilo = ""
    opacidad_attr = ""
    for a in n.atributos
        if es_raiz and (a.nombre == "width" or a.nombre == "height" or a.nombre == "data-dashweb-svg")
            continue
        end
        if a.nombre == "style"
            estilo = a.valor
            continue
        end
        if str_starts(a.nombre, "on")
            continue
        end
        v = a.valor
        if n.svg_sobre != nil and n.svg_sobre.has("@" + a.nombre)
            v = n.svg_sobre["@" + a.nombre]
        end
        v = estilo_resolver_var(v, n)
        if a.nombre == "fill" or a.nombre == "stroke"
            # (nanosvg no sabe rgba() ni hsl(): el color en #rrggbb y su opacidad aparte)
            opacidad = _svg_opacidad(v)
            if opacidad != ""
                opacidad_attr = opacidad_attr + ";" + a.nombre + "-opacity:" + opacidad
            end
            v = _svg_color(v)
        end
        r = r + " " + _svg_nombre(a.nombre) + "=\"" + _svg_escapar(v) + "\""
    end
    if opacidad_attr != ""
        estilo = opacidad_attr + ";" + estilo
    end
    # lo que le da el CSS de la página (con los guiones: la curva de trainalong.fit se dibuja con ellos)
    for p in ["fill", "stroke", "stroke-width", "fill-opacity", "stroke-opacity", "opacity", "fill-rule", "stroke-linecap", "stroke-linejoin", "stroke-dasharray", "stroke-dashoffset"]
        if n.estilo.has(p)
            v = n.estilo[p]
            if p == "fill" or p == "stroke"
                opacidad = _svg_opacidad(v)
                if opacidad != ""
                    estilo = estilo + ";" + p + "-opacity:" + opacidad
                end
                v = _svg_color(v)
            end
            estilo = estilo + ";" + p + ":" + v
        end
    end
    # y lo de este fotograma de su animación (tarea 37d4)
    if n.svg_sobre != nil
        for k in n.svg_sobre.keys()
            if not str_starts(k, "@")
                estilo = estilo + ";" + k + ":" + n.svg_sobre[k]
            end
        end
    end
    if estilo != ""
        r = r + " style=\"" + _svg_escapar(estilo) + "\""
    end
    r = r + ">"
    for h2 in n.hijos
        r = r + _svg_elemento(h2, raiz, false, 0, 0)
    end
    return r + "</" + nombre + ">"
end

# <use href="#id" x y width height>: lo que nombra, en su sitio (un <symbol>: sus hijos, a escala de su viewBox)
func _svg_use(n: Nodo, raiz: Nodo) -> String
    ref = dom_atributo(n, "href")
    if ref == ""
        ref = dom_atributo(n, "xlink:href")
    end
    if not str_starts(ref, "#")
        return ""
    end
    t = dom_por_id(raiz, ref[1:])
    if t == nil
        return ""
    end
    x = dom_atributo(n, "x")
    y = dom_atributo(n, "y")
    if x == ""
        x = "0"
    end
    if y == ""
        y = "0"
    end
    r = "<g transform=\"translate(" + _svg_escapar(x) + " " + _svg_escapar(y) + ")\">"
    if t.nombre == "symbol"
        for h in t.hijos
            r = r + _svg_elemento(h, raiz, false, 0, 0)
        end
    else
        r = r + _svg_elemento(t, raiz, false, 0, 0)
    end
    return r + "</g>"
end

# Un <svg> sin viewBox que usa un <symbol> con viewBox (los sprites de iconos): ese viewBox
func _svg_viewbox_de_use(n: Nodo, raiz: Nodo) -> String
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO and h.nombre == "use"
            ref = dom_atributo(h, "href")
            if ref == ""
                ref = dom_atributo(h, "xlink:href")
            end
            if str_starts(ref, "#")
                t = dom_por_id(raiz, ref[1:])
                if t != nil and t.nombre == "symbol"
                    return dom_atributo(t, "viewbox")
                end
            end
        end
    end
    return ""
end
