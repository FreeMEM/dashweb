# Imágenes de una página: las <img> y las imágenes de fondo se traen (HTTP/HTTPS a un fichero de T:, o
# de disco), se decodifican (lib/imagen_dec.dash; si no, los datatypes del sistema) y se pintan.
#
#   im = imagenes_nuevas()
#   imagenes_cargar(im, doc, "http://ejemplo.org/")   # con la ventana ya abierta (colores)
#   pagina = maquetar(doc, ancho)                     # width/height que faltaban ya están puestos
#   pintar(pagina, im, desde, x, y, ancho, alto)      # lib/pintor.dash
#   imagenes_liberar(im)
#
# Sin esperar (navegador): imagenes_pedir(im, doc, base) empieza las descargas (4 a la vez) y vuelve;
# imagenes_avanzar(im, doc) en cada vuelta del bucle dice cuántas llegaron (ya con su tamaño puesto:
# hay que volver a maquetar); imagenes_pendientes(im) cuántas faltan.
#
# Sin width ni height en el HTML, la imagen toma su tamaño real; con uno solo, el otro guarda la
# proporción. Una imagen que no se puede traer o leer se queda como hueco (16x16 si no dice más).

import "http.dash"
import "dom.dash"
import "css.dash"
import "imagen_dec.dash"
import "estilo.dash"
import "colores.dash"

# Una imagen de un fichero: decodificada aquí (lib/imagen_dec.dash, reducida a lo que cabe en una
# pantalla grande) y, si no se puede (otro formato, AmigaOS 3.1), con los datatypes
func imagen_cargar(fichero: String) -> Int
    return imagen_cargar_a(fichero, IMAGEN_MAX_ANCHO, IMAGEN_MAX_ALTO)
end

# Lo mismo sin decodificar más de lo que cabe en maxw x maxh
func imagen_cargar_a(fichero: String, maxw: Int, maxh: Int) -> Int
    img = imagen_decodificar(fichero, maxw, maxh)
    if img == 0
        img = image_load(fichero)
    end
    return img
end

struct Imagenes
    por_src: {String: Int}      # src del HTML -> imagen cargada (0: no se pudo, o aún no ha llegado)
    escaladas: {String: Int}    # "src ancho alto" -> copia a ese tamaño
    ficheros: [String]          # los de T: que se descargaron
    cola: [Pedida]              # las que esperan su turno o están llegando (imagenes_pedir)
    # src -> el tamaño mayor al que se ve en la última maqueta (ancho * 65536 + alto; imagenes_vista):
    # una <img> con width y height se decodifica a ese tamaño y no al de sus atributos
    vistas: {String: Int} = nil
    cambiados: Int = 0          # <img> a los que una imagen llegada les ha puesto tamaño (cambia la maqueta)
end

struct Pedida
    src: String
    direccion: String
    fichero: String
    carga: Carga                # nil hasta que le toca
    maxw: Int = 1280            # se decodifica reducida hasta lo que quepa en maxw x maxh (sin bajar de ahí)
    maxh: Int = 1024
    con_medidas: Bool = false   # una <img> con width y height (su tamaño en la página no depende de la imagen)
    llegada: Bool = false       # ya está en su fichero: espera su turno para decodificarse
    dec: Decodificando = nil    # decodificándose en otro proceso (lib/imagen_dec.dash)
end

# Una imagen grande no se decodifica entera si el HTML ya dice a qué tamaño se ve (width y height)
const IMAGEN_MAX_ANCHO = 1280
const IMAGEN_MAX_ALTO = 1024

const IMAGENES_A_LA_VEZ = 4
# Decodificando a la vez, cada una en su proceso (con una sola, freemem.space tardaba unos 5 s más)
const IMAGENES_DECODIFICANDO = 4

func imagenes_nuevas() -> Imagenes
    var por_src: {String: Int} = {}
    var escaladas: {String: Int} = {}
    var ficheros: [String] = []
    var cola: [Pedida] = []
    return Imagenes(por_src, escaladas, ficheros, cola)
end

# Empieza a traer las imágenes que falten (las de disco se cargan ya) y vuelve
func imagenes_pedir(im: Imagenes, doc: Nodo, base: String)
    _imagenes_pedir_en(im, doc, url_parse(base))
    imagenes_avanzar(im, doc)
end

# La imagen de fondo de un elemento (background-image: url(...)), como dirección completa; "" si no
func imagenes_fondo(n: Nodo, base: Url) -> String
    if n.tipo != DOM_ELEMENTO or not n.estilo.has("background-image")
        return ""
    end
    u = css_url(n.estilo["background-image"])
    if u == ""
        return ""
    end
    completa = url_text(url_resolve(base, u))
    # la maqueta y el pintor no saben la dirección de la página: el estilo se queda con la completa
    n.estilo["background-image"] = "url(" + completa + ")"
    return completa
end

func _imagenes_pedir_fondo(im: Imagenes, n: Nodo, base: Url)
    src = imagenes_fondo(n, base)
    if src == "" or im.por_src.has(src)
        return
    end
    u = url_parse(src)
    if u.esquema == "http" or u.esquema == "https"
        im.por_src[src] = 0
        fichero = "T:dashweb_img" + im.ficheros.length
        im.ficheros.push(fichero)
        var sin: Carga = nil
        pedida = Pedida(src, src, fichero, sin)
        # con cover o contain el tamaño de la imagen solo cuenta por su proporción: se puede reducir
        if n.tipo == DOM_ELEMENTO and n.estilo != nil and n.estilo.has("background-size")
            bs = n.estilo["background-size"]
            pedida.con_medidas = bs == "cover" or bs == "contain"
        end
        im.cola.push(pedida)
    else
        im.por_src[src] = _imagen_traer(im, base, src)
    end
end

# El cartel de un vídeo (dom_video_poster), como dirección completa en su atributo poster (el pintor lo
# busca ahí); "" si no tiene
func imagenes_cartel(n: Nodo, base: Url) -> String
    if not dom_es_video(n)
        return ""
    end
    p = dom_video_poster(n)
    if p == ""
        return ""
    end
    completa = url_text(url_resolve(base, p))
    _poner_atributo(n, "poster", completa)
    return completa
end

func _imagenes_pedir_cartel(im: Imagenes, n: Nodo, base: Url)
    src = imagenes_cartel(n, base)
    if src == "" or im.por_src.has(src)
        return
    end
    u = url_parse(src)
    if u.esquema == "http" or u.esquema == "https"
        im.por_src[src] = 0
        fichero = "T:dashweb_img" + im.ficheros.length
        im.ficheros.push(fichero)
        var sin: Carga = nil
        im.cola.push(Pedida(src, src, fichero, sin))
    else
        im.por_src[src] = _imagen_traer(im, base, src)
    end
end

func _imagenes_pedir_en(im: Imagenes, n: Nodo, base: Url)
    _imagenes_pedir_fondo(im, n, base)
    _imagenes_pedir_cartel(im, n, base)
    if n.tipo == DOM_ELEMENTO and n.nombre == "svg"
        _imagenes_svg(im, n)
        return
    end
    if n.tipo == DOM_ELEMENTO and n.nombre == "img"
        src = dom_img_src(n)
        if src != "" and im.por_src.has(src)
            if im.por_src[src] != 0
                _imagen_tamano(n, im.por_src[src])
            end
        elif src != ""
            u = url_resolve(base, src)
            if u.esquema == "http" or u.esquema == "https"
                im.por_src[src] = 0
                fichero = "T:dashweb_img" + im.ficheros.length
                im.ficheros.push(fichero)
                var sin: Carga = nil
                pedida = Pedida(src, url_text(u), fichero, sin)
                w = Int(dom_atributo(n, "width"))
                h = Int(dom_atributo(n, "height"))
                if w > 0 and h > 0
                    pedida.con_medidas = true
                    if w < IMAGEN_MAX_ANCHO and h < IMAGEN_MAX_ALTO
                        pedida.maxw = w
                        pedida.maxh = h
                    end
                end
                im.cola.push(pedida)
            else
                im.por_src[src] = _imagen_traer(im, base, src)
                _imagen_tamano(n, im.por_src[src])
            end
        end
        return
    end
    for h in n.hijos
        _imagenes_pedir_en(im, h, base)
    end
end

# Avanza las descargas y las decodificaciones sin esperar; cuántas imágenes llegaron ahora (su tamaño ya
# está en los <img>). Cada imagen: se baja a su fichero (hasta IMAGENES_A_LA_VEZ a la vez) y se decodifica en
# otro proceso (hasta IMAGENES_DECODIFICANDO a la vez): la ventana no se para mientras.
func imagenes_avanzar(im: Imagenes, doc: Nodo) -> Int
    llegadas = 0
    activas = 0
    decodificando = 0
    i = 0
    while i < im.cola.length
        p = im.cola[i]
        if p.dec != nil
            if imagen_lista(p.dec)
                img = imagen_acabar(p.dec)
                if img == 0
                    img = image_load(p.fichero)      # otro formato: los datatypes
                end
                if _imagen_llegada(im, doc, p, img)
                    llegadas = llegadas + 1
                end
                im.cola.remove(i)
                continue
            end
            decodificando = decodificando + 1
        elif p.llegada
            if decodificando < IMAGENES_DECODIFICANDO
                _imagen_tamano_final(im, p)
                p.dec = imagen_empezar(p.fichero, p.maxw, p.maxh)
                if p.dec == nil
                    # sin otro proceso: aquí mismo
                    if _imagen_llegada(im, doc, p, imagen_cargar_a(p.fichero, p.maxw, p.maxh))
                        llegadas = llegadas + 1
                    end
                    im.cola.remove(i)
                    continue
                end
                decodificando = decodificando + 1
            end
        else
            if p.carga == nil and activas < IMAGENES_A_LA_VEZ
                p.carga = http_empezar_a_fichero(p.direccion, p.fichero, 15000)
            end
            if p.carga != nil
                if http_avanzar(p.carga)
                    r = p.carga.respuesta
                    var sin: Carga = nil
                    p.carga = sin
                    if r.error == "" and r.estado >= 200 and r.estado < 300
                        p.llegada = true
                        continue                     # (a decodificarse, en esta misma vuelta si le toca)
                    end
                    im.por_src[p.src] = 0
                    im.cola.remove(i)
                    continue
                end
                activas = activas + 1
            end
        end
        i = i + 1
    end
    return llegadas
end

# Hasta dónde decodificarla: al tamaño al que se ve si el HTML lo fija (una foto de 820x480 en una casilla
# de 225x220)
func _imagen_tamano_final(im: Imagenes, p: Pedida)
    if p.con_medidas and im.vistas != nil and im.vistas.has(p.src)
        v = im.vistas[p.src]
        if v / 65536 >= 16 and v % 65536 >= 16 and v / 65536 < p.maxw and v % 65536 < p.maxh
            p.maxw = v / 65536
            p.maxh = v % 65536
        end
    end
end

# La imagen ya decodificada, a su sitio; true si hay imagen (hay que volver a pintar: también un fondo)
func _imagen_llegada(im: Imagenes, doc: Nodo, p: Pedida, img: Int) -> Bool
    im.por_src[p.src] = img
    if img == 0
        return false
    end
    _imagenes_tamano_de(im, doc, p.src, img)
    return true
end

# El tamaño al que se ve una imagen en la página (el mayor, si sale varias veces)
func imagenes_vista(im: Imagenes, src: String, ancho: Int, alto: Int)
    if im.vistas == nil
        var nuevas: {String: Int} = {}
        im.vistas = nuevas
    end
    w = ancho
    h = alto
    if im.vistas.has(src)
        v = im.vistas[src]
        if v / 65536 > w
            w = v / 65536
        end
        if v % 65536 > h
            h = v % 65536
        end
    end
    if w > 0 and h > 0 and w < 65536 and h < 65536
        im.vistas[src] = w * 65536 + h
    end
end

func imagenes_pendientes(im: Imagenes) -> Int
    return im.cola.length
end

# width/height de todos los <img src> con esa imagen (los que no lo tenían: cuentan en im.cambiados)
func _imagenes_tamano_de(im: Imagenes, n: Nodo, src: String, img: Int)
    if n == nil
        return
    end
    if n.tipo == DOM_ELEMENTO and n.nombre == "img" and dom_img_src(n) == src
        if _imagen_tamano(n, img)
            im.cambiados = im.cambiados + 1
        end
    end
    for h in n.hijos
        _imagenes_tamano_de(im, h, src, img)
    end
end

func imagenes_cargar(im: Imagenes, doc: Nodo, base: String)
    _imagenes_recorrer(im, doc, url_parse(base))
end

func _imagenes_recorrer(im: Imagenes, n: Nodo, base: Url)
    if n.tipo == DOM_ELEMENTO and n.nombre == "svg"
        _imagenes_svg(im, n)
        return
    end
    fondo = imagenes_fondo(n, base)
    if fondo != "" and not im.por_src.has(fondo)
        im.por_src[fondo] = _imagen_traer(im, base, fondo)
    end
    cartel = imagenes_cartel(n, base)
    if cartel != "" and not im.por_src.has(cartel)
        im.por_src[cartel] = _imagen_traer(im, base, cartel)
    end
    if n.tipo == DOM_ELEMENTO and n.nombre == "img"
        src = dom_img_src(n)
        if src != ""
            if not im.por_src.has(src)
                im.por_src[src] = _imagen_traer(im, base, src)
            end
            _imagen_tamano(n, im.por_src[src])
        end
        return
    end
    for h in n.hijos
        _imagenes_recorrer(im, h, base)
    end
end

# La imagen de src (relativa a la página), o 0
func _imagen_traer(im: Imagenes, base: Url, src: String) -> Int
    u = url_resolve(base, src)
    direccion = url_text(u)
    if u.esquema == "http" or u.esquema == "https"
        fichero = "T:dashweb_img" + im.ficheros.length
        r = http_a_fichero(direccion, fichero, 15000)
        if r.bytes > 0 or r.estado != 0
            im.ficheros.push(fichero)
        end
        if r.error != "" or r.estado < 200 or r.estado >= 300
            return 0
        end
        return imagen_cargar(fichero)
    end
    ruta = direccion
    if u.esquema == "file"
        ruta = u.ruta
        if str_starts(ruta, "/")
            ruta = ruta[1:]
        end
    end
    return imagen_cargar(ruta)
end

# width/height que faltan, con el tamaño real de la imagen; true si les faltaba
func _imagen_tamano(n: Nodo, img: Int) -> Bool
    if img == 0
        return false
    end
    w = Int(dom_atributo(n, "width"))
    h = Int(dom_atributo(n, "height"))
    if w > 0 and h > 0
        return false
    end
    rw = image_width(img)
    rh = image_height(img)
    if w <= 0 and h <= 0
        w = rw
        h = rh
    elif w <= 0
        w = rw * h / rh
    else
        h = rh * w / rw
    end
    _poner_atributo(n, "width", "" + w)
    _poner_atributo(n, "height", "" + h)
    return true
end

func _poner_atributo(n: Nodo, nombre: String, valor: String)
    for a in n.atributos
        if a.nombre == nombre
            a.valor = valor
            return
        end
    end
    n.atributos.push(Atributo(nombre, valor))
end

# La imagen de src a ancho x alto (la cargada o una copia escalada, que se guarda); 0 si no hay
func imagenes_a_tamano(im: Imagenes, src: String, ancho: Int, alto: Int) -> Int
    if not im.por_src.has(src)
        return 0
    end
    img = im.por_src[src]
    if img == 0 or (image_width(img) == ancho and image_height(img) == alto)
        return img
    end
    clave = src + " " + ancho + " " + alto
    if not im.escaladas.has(clave)
        im.escaladas[clave] = image_scale(img, ancho, alto)
    end
    return im.escaladas[clave]
end

func imagenes_liberar(im: Imagenes)
    for p in im.cola
        if p.carga != nil
            http_cancelar(p.carga)
        end
        if p.dec != nil
            image_free(imagen_acabar(p.dec))      # (espera a que acabe su proceso)
        end
    end
    im.cola.clear()
    for clave in im.escaladas.keys()
        image_free(im.escaladas[clave])
    end
    im.escaladas.clear()
    for src in im.por_src.keys()
        image_free(im.por_src[src])
    end
    im.por_src.clear()
    for f in im.ficheros
        file_delete(f)
    end
    im.ficheros.clear()
end

# La imagen ya cargada de src a su tamaño natural (0 si no está); para los fondos
func imagenes_cargada(im: Imagenes, src: String) -> Int
    if not im.por_src.has(src)
        return 0
    end
    return im.por_src[src]
end

# === SVG dentro de la página (tarea 31i) ===
# Cada <svg> se vuelve a escribir como un fichero SVG (T:dashweb_svgN.svg) que decodifica nanosvg: con los nombres
# en su caja (el HTML los pasa a minúsculas: viewBox, linearGradient...), currentColor con su color, el fill y el
# stroke que le da el CSS de la página a cada elemento, y <use href="#icono"> cambiado por lo que nombra (un
# <symbol> de un sprite, con su viewBox). Su dirección queda en el atributo data-dashweb-svg (la maqueta lo pone
# como una imagen).

func _imagenes_svg(im: Imagenes, n: Nodo)
    if dom_tiene_atributo(n, "data-dashweb-svg") or _oculto_svg(n)
        return
    end
    raiz = n
    while raiz.padre != nil
        raiz = raiz.padre
    end
    color = "#000000"
    if n.estilo.has("color") and css_color(n.estilo["color"]) >= 0
        color = _hex6(css_color(n.estilo["color"]))
    end
    w = svg_ancho(n)
    h = svg_alto(n)
    texto = _svg_elemento(n, raiz, true, w, h)
    texto = str_replace(str_replace(str_replace(texto, "currentColor", color), "currentcolor", color), "CurrentColor", color)
    fichero = "T:dashweb_svg" + im.ficheros.length + ".svg"
    if not file_write_text(fichero, texto)
        return
    end
    im.ficheros.push(fichero)
    _poner_atributo(n, "data-dashweb-svg", fichero)
    if not im.por_src.has(fichero)
        im.por_src[fichero] = imagen_cargar_a(fichero, IMAGEN_MAX_ANCHO, IMAGEN_MAX_ALTO)
    end
end

func _oculto_svg(n: Nodo) -> Bool
    return n.estilo.has("display") and n.estilo["display"] == "none"
end

func _hex6(rgb: Int) -> String
    cifras = "0123456789abcdef"
    r = "#"
    k = 20
    while k >= 0
        r = r + cifras[(rgb / _potencia2(k)) % 16]
        k = k - 4
    end
    return r
end

func _potencia2(k: Int) -> Int
    r = 1
    for i in (1..k)
        r = r * 2
    end
    return r
end

# Los nombres de SVG con mayúsculas (el HTML los deja en minúsculas)
func _svg_nombre(x: String) -> String
    if x == "lineargradient"
        return "linearGradient"
    elif x == "radialgradient"
        return "radialGradient"
    elif x == "clippath"
        return "clipPath"
    elif x == "textpath"
        return "textPath"
    elif x == "foreignobject"
        return "foreignObject"
    elif x == "viewbox"
        return "viewBox"
    elif x == "preserveaspectratio"
        return "preserveAspectRatio"
    elif x == "gradientunits"
        return "gradientUnits"
    elif x == "gradienttransform"
        return "gradientTransform"
    elif x == "spreadmethod"
        return "spreadMethod"
    elif x == "clippathunits"
        return "clipPathUnits"
    elif x == "patternunits"
        return "patternUnits"
    end
    return x
end

func _svg_escapar(v: String) -> String
    return str_replace(str_replace(str_replace(v, "&", "&amp;"), "\"", "&quot;"), "<", "&lt;")
end

# Un elemento de SVG como texto (raiz: el documento, para los <use>)
func _svg_elemento(n: Nodo, raiz: Nodo, es_raiz: Bool, w: Int, h: Int) -> String
    if n.tipo == DOM_TEXTO
        if n.padre != nil and (n.padre.nombre == "style")
            return n.texto
        end
        return ""
    end
    if n.tipo != DOM_ELEMENTO or _oculto_svg(n)
        return ""
    end
    if n.nombre == "use"
        return _svg_use(n, raiz)
    end
    if n.nombre == "title" or n.nombre == "desc" or n.nombre == "script"
        return ""
    end
    nombre = _svg_nombre(n.nombre)
    r = "<" + nombre
    if es_raiz
        r = r + " xmlns=\"http://www.w3.org/2000/svg\" width=\"" + w + "\" height=\"" + h + "\""
        if svg_viewbox(n) == ""
            vb = _svg_viewbox_de_use(n, raiz)
            if vb != ""
                r = r + " viewBox=\"" + _svg_escapar(vb) + "\""
            end
        end
    end
    estilo = ""
    for a in n.atributos
        if es_raiz and (a.nombre == "width" or a.nombre == "height" or a.nombre == "data-dashweb-svg")
            continue
        end
        if a.nombre == "style"
            estilo = a.valor
            continue
        end
        if str_starts(a.nombre, "on")
            continue
        end
        r = r + " " + _svg_nombre(a.nombre) + "=\"" + _svg_escapar(a.valor) + "\""
    end
    # lo que le da el CSS de la página
    for p in ["fill", "stroke", "stroke-width", "fill-opacity", "stroke-opacity", "opacity", "fill-rule", "stroke-linecap", "stroke-linejoin"]
        if n.estilo.has(p)
            estilo = estilo + ";" + p + ":" + n.estilo[p]
        end
    end
    if estilo != ""
        r = r + " style=\"" + _svg_escapar(estilo) + "\""
    end
    r = r + ">"
    for h2 in n.hijos
        r = r + _svg_elemento(h2, raiz, false, 0, 0)
    end
    return r + "</" + nombre + ">"
end

# <use href="#id" x y width height>: lo que nombra, en su sitio (un <symbol>: sus hijos, a escala de su viewBox)
func _svg_use(n: Nodo, raiz: Nodo) -> String
    ref = dom_atributo(n, "href")
    if ref == ""
        ref = dom_atributo(n, "xlink:href")
    end
    if not str_starts(ref, "#")
        return ""
    end
    t = dom_por_id(raiz, ref[1:])
    if t == nil
        return ""
    end
    x = dom_atributo(n, "x")
    y = dom_atributo(n, "y")
    if x == ""
        x = "0"
    end
    if y == ""
        y = "0"
    end
    r = "<g transform=\"translate(" + _svg_escapar(x) + " " + _svg_escapar(y) + ")\">"
    if t.nombre == "symbol"
        for h in t.hijos
            r = r + _svg_elemento(h, raiz, false, 0, 0)
        end
    else
        r = r + _svg_elemento(t, raiz, false, 0, 0)
    end
    return r + "</g>"
end

# Un <svg> sin viewBox que usa un <symbol> con viewBox (los sprites de iconos): ese viewBox
func _svg_viewbox_de_use(n: Nodo, raiz: Nodo) -> String
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO and h.nombre == "use"
            ref = dom_atributo(h, "href")
            if ref == ""
                ref = dom_atributo(h, "xlink:href")
            end
            if str_starts(ref, "#")
                t = dom_por_id(raiz, ref[1:])
                if t != nil and t.nombre == "symbol"
                    return dom_atributo(t, "viewbox")
                end
            end
        end
    end
    return ""
end
