# Imágenes decodificadas por dashweb (tarea 29), sin los datatypes: JPEG con TJpgDec (third_party/tjpgd),
# que decodifica ya reducido a 1/2, 1/4 o 1/8; WebP (con y sin pérdida, con alfa; no animado) con el
# decodificador de libwebp (third_party/libwebp), que también reduce al decodificar; JPEG progresivo, PNG,
# GIF y BMP con stb_image (third_party/stb), reducidos después. El resultado pasa a la pantalla con image_from_rgb de Dash
# (picture.datatype V43: AmigaOS 3.5+).
#
#   img = imagen_decodificar("T:foto.jpg", 1280, 1024)   # 0 si no se puede: entonces image_load
#
# Una imagen más grande que ancho x alto se reduce hasta caber (para no gastar memoria ni tiempo en
# píxeles que no se van a ver); la proporción se guarda. tools/build_img.sh hace la librería.

@link "../build/img-lib/libimg.a"
@header "#include <tjpgd.h>"
@header "#include <webp_inc/webp/decode.h>"

@c
"""
/* lib/imagen_dec.dash: a decoded picture (malloc) until image_from_rgb takes it */
typedef struct {
    LONG w, h, alfa;      /* alfa: 4 bytes per pixel (RGBA), else 3 (RGB) */
    UBYTE *px;
} _ImgDec;

extern unsigned char *stbi_load_from_memory(const unsigned char *buffer, int len, int *x, int *y,
                                            int *comp, int req_comp);
extern int stbi_info_from_memory(const unsigned char *buffer, int len, int *x, int *y, int *comp);
extern void stbi_image_free(void *p);

/* The whole file in memory (AllocVec); NULL if it cannot be read */
static UBYTE *_imgdec_fichero(STRPTR nombre, LONG *largo) {
    BPTR f = Open(nombre, MODE_OLDFILE);
    UBYTE *d = NULL;
    LONG n;
    if (!f) return NULL;
    Seek(f, 0, OFFSET_END);
    n = Seek(f, 0, OFFSET_BEGINNING);
    if (n > 0 && n < 64 * 1024 * 1024 && (d = (UBYTE *)AllocVec(n, MEMF_ANY))) {
        if (Read(f, d, n) != n) { FreeVec(d); d = NULL; }
    }
    Close(f);
    *largo = n;
    return d;
}

/* TJpgDec reads from memory and writes the decoded blocks into the picture */
typedef struct {
    UBYTE *datos;
    LONG largo, pos;
    _ImgDec *img;
} _ImgDecJpeg;

static size_t _imgdec_jpeg_leer(JDEC *jd, uint8_t *buf, size_t n) {
    _ImgDecJpeg *j = (_ImgDecJpeg *)jd->device;
    if (n > (size_t)(j->largo - j->pos)) n = j->largo - j->pos;
    if (buf) memcpy(buf, j->datos + j->pos, n);
    j->pos += n;
    return n;
}

static int _imgdec_jpeg_poner(JDEC *jd, void *bitmap, JRECT *r) {
    _ImgDecJpeg *j = (_ImgDecJpeg *)jd->device;
    _ImgDec *img = j->img;
    UBYTE *src = (UBYTE *)bitmap;
    LONG ancho = r->right - r->left + 1, y, x0 = r->left, x1 = r->right;
    if (x1 >= img->w) x1 = img->w - 1;
    for (y = r->top; y <= r->bottom; y++, src += ancho * 3)
        if (y < img->h && x0 <= x1) memcpy(img->px + (y * img->w + x0) * 3, src, (x1 - x0 + 1) * 3);
    return 1;
}

/* A baseline JPEG, reduced by 2^s so that it is not much bigger than maxw x maxh; NULL if TJpgDec
   cannot (progressive JPEG...) */
static _ImgDec *_imgdec_jpeg(UBYTE *datos, LONG largo, LONG maxw, LONG maxh) {
    JDEC jd;
    _ImgDecJpeg j;
    void *trabajo = AllocVec(32768, MEMF_ANY);
    _ImgDec *img = NULL;
    int s = 0;
    if (!trabajo) return NULL;
    j.datos = datos;
    j.largo = largo;
    j.pos = 0;
    if (jd_prepare(&jd, _imgdec_jpeg_leer, trabajo, 32768, &j) == JDR_OK) {
        while (s < 3 && (jd.width >> (s + 1)) >= maxw && (jd.height >> (s + 1)) >= maxh) s++;
        img = (_ImgDec *)AllocVec(sizeof(_ImgDec), MEMF_CLEAR);
        if (img) {
            img->w = (jd.width + (1 << s) - 1) >> s;
            img->h = (jd.height + (1 << s) - 1) >> s;
            img->px = (UBYTE *)AllocVec(img->w * img->h * 3, MEMF_CLEAR);
            j.img = img;
            if (!img->px || jd_decomp(&jd, _imgdec_jpeg_poner, s) != JDR_OK) {
                if (img->px) FreeVec(img->px);
                FreeVec(img);
                img = NULL;
            }
        }
    }
    FreeVec(trabajo);
    return img;
}

/* Smaller by k in each direction (the average of each k x k square) */
static void _imgdec_reducir(_ImgDec *img, LONG k) {
    LONG c = img->alfa ? 4 : 3, w = img->w / k, h = img->h / k, x, y, i, j, n, sum[4];
    UBYTE *nuevo, *d;
    if (k < 2 || w < 1 || h < 1) return;
    nuevo = (UBYTE *)AllocVec(w * h * c, MEMF_ANY);
    if (!nuevo) return;
    for (y = 0, d = nuevo; y < h; y++)
        for (x = 0; x < w; x++) {
            sum[0] = sum[1] = sum[2] = sum[3] = 0;
            for (j = 0; j < k; j++) {
                UBYTE *s = img->px + ((y * k + j) * img->w + x * k) * c;
                for (i = 0; i < k; i++, s += c)
                    for (n = 0; n < c; n++) sum[n] += s[n];
            }
            for (n = 0; n < c; n++) *d++ = sum[n] / (k * k);
        }
    FreeVec(img->px);
    img->px = nuevo;
    img->w = w;
    img->h = h;
}

/* A WebP (lossy or lossless, with alpha; not animated), decoded already scaled so that it is not much
   bigger than maxw x maxh (the aspect ratio is kept); NULL if libwebp cannot */
static _ImgDec *_imgdec_webp(UBYTE *datos, LONG largo, LONG maxw, LONG maxh) {
    WebPDecoderConfig cfg;
    _ImgDec *img;
    LONG w, h, tw, th, c;
    if (!WebPInitDecoderConfig(&cfg)) return NULL;
    if (WebPGetFeatures(datos, largo, &cfg.input) != VP8_STATUS_OK || cfg.input.has_animation) return NULL;
    w = cfg.input.width;
    h = cfg.input.height;
    tw = w;
    th = h;
    if (w > maxw && h > maxh) {
        /* the smallest size that still covers maxw x maxh */
        if (maxw * h > maxh * w) { tw = maxw; th = (h * maxw + w - 1) / w; }
        else { th = maxh; tw = (w * maxh + h - 1) / h; }
        cfg.options.use_scaling = 1;
        cfg.options.scaled_width = tw;
        cfg.options.scaled_height = th;
    }
    c = cfg.input.has_alpha ? 4 : 3;
    img = (_ImgDec *)AllocVec(sizeof(_ImgDec), MEMF_CLEAR);
    if (!img) return NULL;
    img->px = (UBYTE *)AllocVec(tw * th * c, MEMF_ANY);
    if (!img->px) { FreeVec(img); return NULL; }
    cfg.output.colorspace = c == 4 ? MODE_RGBA : MODE_RGB;
    cfg.output.is_external_memory = 1;
    cfg.output.u.RGBA.rgba = img->px;
    cfg.output.u.RGBA.stride = tw * c;
    cfg.output.u.RGBA.size = tw * th * c;
    if (WebPDecode(datos, largo, &cfg) != VP8_STATUS_OK) {
        WebPFreeDecBuffer(&cfg.output);
        FreeVec(img->px);
        FreeVec(img);
        return NULL;
    }
    WebPFreeDecBuffer(&cfg.output);
    img->w = tw;
    img->h = th;
    img->alfa = c == 4;
    return img;
}

/* PNG, GIF, BMP or a JPEG TJpgDec does not take, with stb_image; NULL if it cannot */
static _ImgDec *_imgdec_stb(UBYTE *datos, LONG largo, LONG maxw, LONG maxh) {
    int w, h, comp, pedir;
    unsigned char *px;
    _ImgDec *img;
    LONG k = 1, n;
    if (!stbi_info_from_memory(datos, largo, &w, &h, &comp)) return NULL;
    pedir = comp == 2 || comp == 4 ? 4 : 3;
    px = stbi_load_from_memory(datos, largo, &w, &h, &comp, pedir);
    if (!px) return NULL;
    img = (_ImgDec *)AllocVec(sizeof(_ImgDec), MEMF_CLEAR);
    n = (LONG)w * h * pedir;
    if (img) img->px = (UBYTE *)AllocVec(n, MEMF_ANY);
    if (!img || !img->px) { if (img) FreeVec(img); stbi_image_free(px); return NULL; }
    CopyMem(px, img->px, n);
    stbi_image_free(px);
    img->w = w;
    img->h = h;
    img->alfa = pedir == 4;
    while (img->w / (k + 1) >= maxw && img->h / (k + 1) >= maxh) k++;
    _imgdec_reducir(img, k);
    return img;
}
"""
end

@native(borrow) func _imgdec(fichero: String, maxw: Int, maxh: Int) -> Int
"""
    LONG largo = 0;
    UBYTE *datos = _imgdec_fichero(fichero, &largo);
    _ImgDec *img = NULL;
    if (!datos) return 0;
    if (largo > 2 && datos[0] == 0xFF && datos[1] == 0xD8) img = _imgdec_jpeg(datos, largo, maxw, maxh);
    else if (largo > 12 && !memcmp(datos, "RIFF", 4) && !memcmp(datos + 8, "WEBP", 4)) img = _imgdec_webp(datos, largo, maxw, maxh);
    if (!img) img = _imgdec_stb(datos, largo, maxw, maxh);
    FreeVec(datos);
    return (LONG)img;
"""
end

@native func _imgdec_ancho(d: Int) -> Int
"""
    return ((_ImgDec *)d)->w;
"""
end

@native func _imgdec_alto(d: Int) -> Int
"""
    return ((_ImgDec *)d)->h;
"""
end

@native func _imgdec_alfa(d: Int) -> Bool
"""
    return ((_ImgDec *)d)->alfa != 0;
"""
end

@native func _imgdec_pixeles(d: Int) -> Int
"""
    return (LONG)((_ImgDec *)d)->px;
"""
end

@native func _imgdec_liberar(d: Int)
"""
    _ImgDec *img = (_ImgDec *)d;
    if (!img) return;
    if (img->px) FreeVec(img->px);
    FreeVec(img);
"""
end

# La imagen del fichero decodificada aquí (cabe en maxw x maxh, reducida si es más grande); 0 si el
# formato no es de estos o picture.datatype es anterior a V43
func imagen_decodificar(fichero: String, maxw: Int, maxh: Int) -> Int
    d = _imgdec(fichero, maxw, maxh)
    if d == 0
        return 0
    end
    img = image_from_rgb(_imgdec_pixeles(d), _imgdec_ancho(d), _imgdec_alto(d), _imgdec_alfa(d))
    _imgdec_liberar(d)
    return img
end

# Para las pruebas: "ancho x alto alfa=0/1 r,g,b" del píxel (x, y) de lo decodificado (sin pasarlo a la
# pantalla); "no" si no se puede
func imagen_probar(fichero: String, maxw: Int, maxh: Int, x: Int, y: Int) -> String
    d = _imgdec(fichero, maxw, maxh)
    if d == 0
        return "no"
    end
    w = _imgdec_ancho(d)
    k = 3
    if _imgdec_alfa(d)
        k = 4
    end
    p = _imgdec_pixeles(d) + (y * w + x) * k
    r = "" + w + "x" + _imgdec_alto(d) + " alfa=" + _imgdec_alfa(d) + " " + buffer_get_byte(p, 0) + "," + buffer_get_byte(p, 1) + "," + buffer_get_byte(p, 2)
    if k == 4
        r = r + "," + buffer_get_byte(p, 3)
    end
    _imgdec_liberar(d)
    return r
end
