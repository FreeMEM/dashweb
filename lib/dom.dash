# Árbol DOM a partir del HTML (lib/html.dash), con las reglas tolerantes de los navegadores:
# html, head y body implícitos, cierres implícitos (p, li, dt/dd, option, filas y celdas de
# tablas), elementos vacíos (br, img, input...) y etiquetas de cierre sueltas que se ignoran.
#
#   doc = dom_desde_html(texto)        # el nodo documento; doc.hijos[0] es <html>
#   cuerpo = dom_buscar(doc, "body")
#   Print dom_texto(cuerpo)
#
# Los hijos van en una lista; el padre es un campo weak (el árbol se libera entero cuando
# nadie retiene el documento). estilo: las propiedades CSS calculadas (lib/estilo.dash).

import "html.dash"

const DOM_ELEMENTO = 1
const DOM_TEXTO = 3
const DOM_COMENTARIO = 8
const DOM_DOCUMENTO = 9
const DOM_FRAGMENTO = 11       # document.createDocumentFragment(): al añadirlo pasan sus hijos

# lib/maqueta.dash: lo que dio maquetar un elemento al medir (_bloque_de con _midiendo): con la misma clave en la
# misma maqueta no se maqueta otra vez, se ponen dos dibujos que lo resumen (_medida_poner)
struct Medida
    ancho: Int       # la clave: anchos, alto definido, cómo estaba el maquetador y el tamaño forzado por flex (-2: no)
    contenedor: Int
    alto_def: Int
    linea: Int
    blanco0: Int
    fz_w: Int
    fz_h: Int
    alto: Int
    x1: Int          # lo que abarca todo lo dibujado (desde x, y)
    y1: Int
    x2: Int
    y2: Int
    izq: Int         # lo que cuenta para un ancho (_ancho_flotante_medir); izq >= der si nada
    der: Int
    fuente: Int      # el último texto (su línea base, para un inline-block); 0 si no hay
    fy: Int
    fh: Int
    blanco: Int      # cómo deja el maquetador
    ancho_linea: Int
end

struct Nodo
    tipo: Int
    nombre: String
    texto: String
    atributos: [Atributo]
    hijos: [Nodo]
    weak padre: Nodo
    estilo: {String: String}
    # ::before y ::after (lib/estilo.dash): nodos aparte (el JavaScript no los ve) con su estilo y lo que dice
    # su content (un texto, o un nodo "::icono" con el código de un icono de Font Awesome); nil si no hay
    pseudo_antes: Nodo = nil
    pseudo_despues: Nodo = nil
    clases_cache: [String] = nil   # dom_clases y dom_id: el atributo class partido y el id, la primera vez que
    id_cache: String = nil         # se piden (dom_olvidar_atributos al cambiar un atributo)
    vars: {String: String} = nil   # las propiedades --x que le llegan a sus hijos (lib/estilo.dash)
    toques: [Toque] = nil          # en el documento: lo que ha cambiado el JavaScript (lib/jsdom.dash)
    # lib/maqueta.dash: los anchos medidos en la maqueta af_pase (de tres en tres: ancho, alto definido, resultado)
    af_pase: Int = 0
    af_lista: [Int] = nil
    medidas: [Medida] = nil   # (de la maqueta med_pase)
    cl: [Int] = nil           # márgenes, bordes y rellenos en px con el contenedor cl_cont en la maqueta cl_pase
    cl_pase: Int = 0
    cl_cont: Int = 0
    med_pase: Int = 0
    # la caja (borde incluido) en la última maqueta del documento, en coordenadas de la página (lib/maqueta.dash;
    # la leen getBoundingClientRect y offset* del JavaScript): vale si caja_pase es el caja_pase del documento
    caja_pase: Int = 0
    caja_bloque: Int = 0     # = caja_pase si la puso la maqueta de su bloque (si no, la unión de sus dibujos)
    caja_x: Int = 0
    caja_y: Int = 0
    caja_w: Int = 0
    caja_h: Int = 0
    # lib/documento.dash, al aplicar cambios del JavaScript sin maqueta: marca (el número de la vuelta), lo que se
    # desplaza y si puede haber cambiado su visibilidad
    lig_marca: Int = 0
    lig_dx: Int = 0
    lig_dy: Int = 0
    lig_vis: Bool = false
    # lib/imagenes.dash, al volver a escribir un <svg> en un fotograma de sus animaciones: lo que cambia en este
    # elemento ("@r": un atributo; lo demás, propiedades de su style); nil si nada
    svg_sobre: {String: String} = nil
end

# Un cambio del JavaScript, apuntado en el documento para rehacer después solo el estilo al que afecta
# (estilo_aplicar_partes)
const TOQUE_TODO = 0           # demasiados: todo
const TOQUE_ATRIBUTO = 1       # nodo: el elemento; nombre, antes y despues: el atributo y sus valores
const TOQUE_CONTENIDO = 2      # nodo: el elemento al que le han cambiado todos los hijos (textContent, innerHTML)
const TOQUE_ENTRA = 3          # nodo: el que acaba de entrar en el árbol
const TOQUE_SALE = 4           # nodo: el padre del que ha salido
const TOQUE_VECINO = 5         # nodo: un hermano del que ha entrado o salido
const DOM_TOQUES_MAX = 1000

struct Toque
    tipo: Int
    nodo: Nodo
    nombre: String
    antes: String
    despues: String
end

# Apunta un cambio en el documento de n (si n está en uno)
func dom_apuntar(n: Nodo, tipo: Int, nombre: String, antes: String, despues: String)
    if n == nil
        return
    end
    doc = n
    while doc.padre != nil
        doc = doc.padre
    end
    if doc.tipo != DOM_DOCUMENTO
        return
    end
    if doc.toques == nil
        var l: [Toque] = []
        doc.toques = l
    end
    if doc.toques.length < DOM_TOQUES_MAX
        doc.toques.push(Toque(tipo, n, nombre, antes, despues))
    elif doc.toques.length == DOM_TOQUES_MAX
        doc.toques.push(Toque(TOQUE_TODO, n, "", "", ""))
    end
end

# El elemento hermano de al lado (antes o después); nil si no hay
func dom_hermano_elemento(n: Nodo, despues: Bool) -> Nodo
    var nadie: Nodo = nil
    if n.padre == nil
        return nadie
    end
    hs = n.padre.hijos
    i = 0
    while i < hs.length and hs[i] != n
        i = i + 1
    end
    paso = -1
    if despues
        paso = 1
    end
    i = i + paso
    while i >= 0 and i < hs.length
        if hs[i].tipo == DOM_ELEMENTO
            return hs[i]
        end
        i = i + paso
    end
    return nadie
end


# Las clases del elemento (class="a  b\tc" -> a, b, c), partidas una vez
func dom_clases(n: Nodo) -> [String]
    if n.clases_cache == nil
        var r: [String] = []
        t = dom_atributo(n, "class")
        i = 0
        while i < t.length
            while i < t.length and str_code(t, i) <= 32
                i = i + 1
            end
            inicio = i
            while i < t.length and str_code(t, i) > 32
                i = i + 1
            end
            if i > inicio
                r.push(t[inicio:i])
            end
        end
        n.clases_cache = r
    end
    return n.clases_cache
end

func dom_id(n: Nodo) -> String
    if n.id_cache == nil
        n.id_cache = dom_atributo(n, "id")
    end
    return n.id_cache
end

# Tras cambiar un atributo: class e id se vuelven a leer
func dom_olvidar_atributos(n: Nodo)
    var sin_clases: [String] = nil
    var sin_id: String = nil
    n.clases_cache = sin_clases
    n.id_cache = sin_id
end

func dom_nodo(tipo: Int, nombre: String, texto: String) -> Nodo
    var atributos: [Atributo] = []
    var hijos: [Nodo] = []
    var nadie: Nodo = nil
    var estilo: {String: String} = {}
    return Nodo(tipo, nombre, texto, atributos, hijos, nadie, estilo)
end

func dom_agregar(padre: Nodo, hijo: Nodo)
    hijo.padre = padre
    padre.hijos.push(hijo)
end

# Valor de un atributo, o "" si no lo tiene
func dom_atributo(n: Nodo, nombre: String) -> String
    for a in n.atributos
        if a.nombre == nombre
            return a.valor
        end
    end
    return ""
end

func dom_tiene_atributo(n: Nodo, nombre: String) -> Bool
    for a in n.atributos
        if a.nombre == nombre
            return true
        end
    end
    return false
end

# Elementos sin contenido ni cierre
func dom_es_vacio(nombre: String) -> Bool
    return nombre == "br" or nombre == "img" or nombre == "input" or nombre == "hr" or nombre == "meta" or nombre == "link" or nombre == "area" or nombre == "base" or nombre == "col" or nombre == "embed" or nombre == "param" or nombre == "source" or nombre == "track" or nombre == "wbr"
end

# Lo que va en head mientras no ha empezado el cuerpo
func _de_head(nombre: String) -> Bool
    return nombre == "title" or nombre == "meta" or nombre == "link" or nombre == "style" or nombre == "script" or nombre == "base" or nombre == "noscript"
end

# Elementos de bloque que cierran un <p> abierto
func _cierra_p(nombre: String) -> Bool
    return nombre == "p" or nombre == "div" or nombre == "ul" or nombre == "ol" or nombre == "dl" or nombre == "li" or nombre == "table" or nombre == "pre" or nombre == "blockquote" or nombre == "form" or nombre == "hr" or nombre == "h1" or nombre == "h2" or nombre == "h3" or nombre == "h4" or nombre == "h5" or nombre == "h6" or nombre == "section" or nombre == "article" or nombre == "aside" or nombre == "header" or nombre == "footer" or nombre == "nav" or nombre == "address" or nombre == "fieldset" or nombre == "figure" or nombre == "main" or nombre == "menu" or nombre == "details" or nombre == "dd" or nombre == "dt"
end

# Solo espacios, tabuladores y saltos de línea
func _solo_blancos(s: String) -> Bool
    for i in (0..s.length - 1)
        c = str_code(s, i)
        if c != 32 and c != 9 and c != 10 and c != 13 and c != 12
            return false
        end
    end
    return true
end

struct Constructor
    doc: Nodo
    html: Nodo
    head: Nodo
    body: Nodo
    abiertos: [Nodo]
end

func _actual(c: Constructor) -> Nodo
    return c.abiertos[c.abiertos.length - 1]
end

# El elemento abierto más interior con ese nombre (su posición en la pila), o -1. Se para
# en los límites de tabla y lista cuando hace falta (para no cerrar lo de fuera).
func _abierto(c: Constructor, nombre: String, limites: [String]) -> Int
    i = c.abiertos.length - 1
    while i >= 0
        n = c.abiertos[i]
        if n.nombre == nombre
            return i
        end
        for l in limites
            if n.nombre == l
                return -1
            end
        end
        i = i - 1
    end
    return -1
end

# Cierra todo hasta el elemento de la posición i (incluido)
func _cerrar_hasta(c: Constructor, i: Int)
    while c.abiertos.length > i and c.abiertos.length > 3
        c.abiertos.pop()
    end
end

func _cerrar(c: Constructor, nombre: String, limites: [String])
    i = _abierto(c, nombre, limites)
    if i >= 3
        _cerrar_hasta(c, i)
    end
end

# Hace que haya body (al llegar contenido)
func _empezar_body(c: Constructor)
    if c.body == nil
        c.body = dom_nodo(DOM_ELEMENTO, "body", "")
        dom_agregar(c.html, c.body)
    end
    if c.abiertos.length < 3 or c.abiertos[2] != c.body
        while c.abiertos.length > 2
            c.abiertos.pop()
        end
        c.abiertos.push(c.body)
    end
end

func _texto(c: Constructor, texto: String)
    padre = _actual(c)
    ultimo = padre.hijos.length - 1
    if ultimo >= 0 and padre.hijos[ultimo].tipo == DOM_TEXTO
        t = padre.hijos[ultimo]
        t.texto = t.texto + texto
    else
        dom_agregar(padre, dom_nodo(DOM_TEXTO, "", texto))
    end
end

func _inicio(c: Constructor, tok: HtmlToken)
    nombre = tok.nombre
    if nombre == "html"
        for a in tok.atributos
            if not dom_tiene_atributo(c.html, a.nombre)
                c.html.atributos.push(a)
            end
        end
        return
    end
    if nombre == "head"
        return
    end
    if nombre == "body"
        _empezar_body(c)
        for a in tok.atributos
            if not dom_tiene_atributo(c.body, a.nombre)
                c.body.atributos.push(a)
            end
        end
        return
    end
    destino = c.head
    if c.body == nil and _de_head(nombre)
        destino = c.head
    else
        _empezar_body(c)
        # cierres implícitos
        if _cierra_p(nombre)
            _cerrar(c, "p", ["button", "table", "td", "th"])
        end
        if nombre == "li"
            _cerrar(c, "li", ["ul", "ol"])
        elif nombre == "dt" or nombre == "dd"
            _cerrar(c, "dt", ["dl"])
            _cerrar(c, "dd", ["dl"])
        elif nombre == "option"
            _cerrar(c, "option", ["select"])
        elif nombre == "tr"
            _cerrar(c, "tr", ["table"])
        elif nombre == "td" or nombre == "th"
            _cerrar(c, "td", ["tr", "table"])
            _cerrar(c, "th", ["tr", "table"])
        elif nombre == "thead" or nombre == "tbody" or nombre == "tfoot"
            _cerrar(c, "thead", ["table"])
            _cerrar(c, "tbody", ["table"])
            _cerrar(c, "tfoot", ["table"])
        end
        destino = _actual(c)
    end
    n = dom_nodo(DOM_ELEMENTO, nombre, "")
    for a in tok.atributos
        n.atributos.push(a)
    end
    dom_agregar(destino, n)
    if not dom_es_vacio(nombre) and not tok.autocierre
        if destino == c.head
            # el contenido de title, style y script llega como texto crudo justo después
            c.abiertos.push(c.head)
        end
        c.abiertos.push(n)
    end
end

func _fin(c: Constructor, nombre: String)
    if nombre == "html" or nombre == "body"
        return
    end
    if nombre == "head"
        return
    end
    if nombre == "br"
        _empezar_body(c)
        dom_agregar(_actual(c), dom_nodo(DOM_ELEMENTO, "br", ""))
        return
    end
    i = c.abiertos.length - 1
    while i >= 2
        if c.abiertos[i].nombre == nombre
            while c.abiertos.length > i
                c.abiertos.pop()
            end
            # lo de head vuelve al nivel de html
            if c.abiertos.length > 0 and _actual(c) == c.head and c.body == nil
                c.abiertos.pop()
            end
            return
        end
        i = i - 1
    end
end

# El árbol de un texto HTML (ya en Latin-1)
func dom_desde_html(texto: String) -> Nodo
    doc = dom_nodo(DOM_DOCUMENTO, "#document", "")
    html = dom_nodo(DOM_ELEMENTO, "html", "")
    head = dom_nodo(DOM_ELEMENTO, "head", "")
    dom_agregar(doc, html)
    dom_agregar(html, head)
    var nadie: Nodo = nil
    c = Constructor(doc, html, head, nadie, [doc, html])
    t = html_tokenizador(texto)
    tok = html_siguiente(t)
    while tok != nil
        if tok.tipo == HT_TEXTO
            if c.body == nil and _solo_blancos(tok.texto)
                if _actual(c) != c.html
                    _texto(c, tok.texto)
                end
            else
                if c.body == nil and _actual(c) == c.html
                    _empezar_body(c)
                end
                _texto(c, tok.texto)
            end
        elif tok.tipo == HT_INICIO
            _inicio(c, tok)
        elif tok.tipo == HT_FIN
            _fin(c, tok.nombre)
        elif tok.tipo == HT_COMENTARIO
            dom_agregar(_actual(c), dom_nodo(DOM_COMENTARIO, "", tok.texto))
        elif tok.tipo == HT_DOCTYPE
            doc.texto = tok.texto
        end
        tok = html_siguiente(t)
    end
    if c.body == nil
        _empezar_body(c)
    end
    return doc
end

# El primer elemento con ese nombre (en orden de documento), o nil
func dom_buscar(n: Nodo, nombre: String) -> Nodo
    if n.tipo == DOM_ELEMENTO and n.nombre == nombre
        return n
    end
    for h in n.hijos
        r = dom_buscar(h, nombre)
        if r != nil
            return r
        end
    end
    var nada: Nodo = nil
    return nada
end

# El elemento con ese id, o nil
func dom_por_id(n: Nodo, id: String) -> Nodo
    if n.tipo == DOM_ELEMENTO and dom_atributo(n, "id") == id
        return n
    end
    for h in n.hijos
        r = dom_por_id(h, id)
        if r != nil
            return r
        end
    end
    var nada: Nodo = nil
    return nada
end

# Todo el texto de dentro, seguido
func dom_texto(n: Nodo) -> String
    if n.tipo == DOM_TEXTO
        return n.texto
    end
    r = ""
    for h in n.hijos
        if h.tipo == DOM_TEXTO
            r = r + h.texto
        elif h.tipo == DOM_ELEMENTO
            r = r + dom_texto(h)
        end
    end
    return r
end

# Esquema del árbol en una línea, para pruebas: html(head(title("x")),body(p("a"),br))
func dom_esquema(n: Nodo) -> String
    if n.tipo == DOM_TEXTO
        return "\"" + str_replace(n.texto, "\n", "\\n") + "\""
    elif n.tipo == DOM_COMENTARIO
        return "<!--" + n.texto + "-->"
    end
    r = n.nombre
    if n.tipo == DOM_DOCUMENTO
        r = "#doc"
    end
    id = dom_atributo(n, "id")
    if id != ""
        r = r + "#" + id
    end
    if n.hijos.length == 0
        return r
    end
    r = r + "("
    primero = true
    for h in n.hijos
        if not primero
            r = r + ","
        end
        r = r + dom_esquema(h)
        primero = false
    end
    return r + ")"
end

# === Imágenes con srcset ===

# El ancho al que se supone que se ve una imagen sin width: fijo, para que la elección no cambie al cambiar
# el ancho de la ventana (la imagen ya pedida es la que se pinta)
const DOM_IMG_ANCHO = 1024

# La dirección que se usa de un <img>: de su srcset (o del de un <source> de su <picture> con un tipo que
# se sabe leer), la más pequeña que no se quede corta para el ancho al que se va a ver (su width o
# DOM_IMG_ANCHO); con descriptores x, la de 1x. Si no hay srcset, su src.
func dom_img_src(n: Nodo) -> String
    objetivo = Int(dom_atributo(n, "width"))
    if objetivo <= 0
        objetivo = DOM_IMG_ANCHO
    end
    p = n.padre
    if p != nil and p.tipo == DOM_ELEMENTO and p.nombre == "picture"
        for s in p.hijos
            if s == n
                break
            end
            if s.tipo == DOM_ELEMENTO and s.nombre == "source" and dom_tiene_atributo(s, "srcset") and not dom_tiene_atributo(s, "media")
                tipo = str_lower(dom_atributo(s, "type"))
                if tipo == "" or tipo == "image/jpeg" or tipo == "image/png" or tipo == "image/gif" or tipo == "image/bmp" or tipo == "image/webp"
                    elegida = _srcset_elegir(dom_atributo(s, "srcset"), objetivo)
                    if elegida != ""
                        return elegida
                    end
                end
            end
        end
    end
    if dom_tiene_atributo(n, "srcset")
        elegida = _srcset_elegir(dom_atributo(n, "srcset"), objetivo)
        if elegida != ""
            return elegida
        end
    end
    return dom_atributo(n, "src")
end

func _srcset_elegir(srcset: String, objetivo: Int) -> String
    mejor = ""
    mejor_w = 0
    mayor = ""
    mayor_w = 0
    una_x = ""
    primera = ""
    for candidato in _srcset_partir(srcset)
        c = str_trim(candidato)
        if c == ""
            continue
        end
        b = str_find(c, " ")
        dir = c
        desc = ""
        if b > 0
            dir = c[:b]
            desc = str_lower(str_trim(c[b + 1:]))
        end
        if _formato_raro(dir)
            continue
        end
        if primera == ""
            primera = dir
        end
        if str_ends(desc, "w")
            w = Int(desc[:desc.length - 1])
            if w >= objetivo and (mejor == "" or w < mejor_w)
                mejor = dir
                mejor_w = w
            end
            if w > mayor_w
                mayor = dir
                mayor_w = w
            end
        elif desc == "" or desc == "1x" or desc == "1.0x"
            una_x = dir
        end
    end
    if mejor != ""
        return mejor
    end
    if mayor != ""
        return mayor
    end
    if una_x != ""
        return una_x
    end
    return primera
end

# Las candidatas de un srcset: una coma separa si va seguida de blanco o si ya pasó la dirección (tras un
# blanco: "a.jpg 300w,b.jpg 600w"); dentro de la dirección puede haber comas
func _srcset_partir(s: String) -> [String]
    var r: [String] = []
    desde = 0
    i = 0
    en_dir = false
    tras_dir = false
    while i < s.length
        c = str_code(s, i)
        if c == 32 or c == 10 or c == 9
            if en_dir
                en_dir = false
                tras_dir = true
            end
        elif c == 44 and (tras_dir or i + 1 >= s.length or str_code(s, i + 1) == 32 or str_code(s, i + 1) == 10 or str_code(s, i + 1) == 9)
            r.push(s[desde:i])
            desde = i + 1
            tras_dir = false
        elif not tras_dir
            en_dir = true
        end
        i = i + 1
    end
    r.push(s[desde:])
    return r
end

# Formatos que dashweb aún no sabe leer (AVIF, JPEG XL)
func _formato_raro(dir: String) -> Bool
    d = str_lower(dir)
    q = str_find(d, "?")
    if q >= 0
        d = d[:q]
    end
    return str_ends(d, ".avif") or str_ends(d, ".jxl")
end

# ¿Es la dirección de un vídeo de YouTube? (watch, embed, shorts, youtu.be, youtube-nocookie)
func dom_es_youtube(d: String) -> Bool
    l = str_lower(d)
    return str_find(l, "youtube.com/embed/") >= 0 or str_find(l, "youtube-nocookie.com/embed/") >= 0 or str_find(l, "youtube.com/watch") >= 0 or str_find(l, "youtube.com/shorts/") >= 0 or str_find(l, "youtu.be/") >= 0
end

# El identificador de un vídeo de YouTube en su dirección (embed, watch?v=, youtu.be, shorts); "" si no
func dom_youtube_id(d: String) -> String
    for marca in ["/embed/", "/shorts/", "youtu.be/", "?v=", "&v="]
        p = str_find(d, marca)
        if p >= 0
            i = p + marca.length
            f = i
            while f < d.length
                c = str_code(d, f)
                if not ((c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 95)
                    break
                end
                f = f + 1
            end
            if f > i
                return d[i:f]
            end
        end
    end
    return ""
end

# La imagen que se ve antes de reproducir: el poster de un <video> o la miniatura de un YouTube
# (hqdefault: 480x360, la que se ve sin JavaScript); "" si no tiene
func dom_video_poster(n: Nodo) -> String
    if dom_atributo(n, "poster") != ""
        return dom_atributo(n, "poster")
    end
    if n.nombre == "iframe"
        id = dom_youtube_id(dom_atributo(n, "src"))
        if id != ""
            return "https://i.ytimg.com/vi/" + id + "/hqdefault.jpg"
        end
    end
    return ""
end

# ¿Se maqueta n como un vídeo? (<video>, o un <iframe> de YouTube)
func dom_es_video(n: Nodo) -> Bool
    return n.tipo == DOM_ELEMENTO and (n.nombre == "video" or (n.nombre == "iframe" and dom_es_youtube(dom_atributo(n, "src"))))
end

# La dirección de un <video>: su src o la del primer <source> con un tipo que se sabe reproducir (MP4, MOV,
# AVI, MKV, MPEG-TS, MPEG-1) o sin tipo
func video_src(n: Nodo) -> String
    if n.nombre == "iframe"
        return dom_atributo(n, "src")
    end
    if dom_atributo(n, "src") != ""
        return dom_atributo(n, "src")
    end
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO and h.nombre == "source" and dom_atributo(h, "src") != ""
            tipo = str_lower(dom_atributo(h, "type"))
            if tipo == "" or str_starts(tipo, "video/mp4") or tipo == "video/quicktime" or tipo == "video/x-msvideo" or tipo == "video/x-matroska" or tipo == "video/mp2t" or tipo == "video/mpeg"
                return dom_atributo(h, "src")
            end
        end
    end
    return ""
end
