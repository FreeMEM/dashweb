# Lectura de CSS: reglas, selectores (con su especificidad) y declaraciones.
#
#   hoja = css_leer(texto, 0)              # 0: número de orden de la primera regla
#   for r in hoja.reglas
#       for s in r.selectores
#           Print css_selector_texto(s)    # para pruebas
#       end
#   end
#   decl = css_declaraciones("color: red; margin: 0 !important")   # atributo style
#
# Selectores: tipo, *, #id, .clase, [atr], [atr=v] (y ~= |= ^= $= *=), :pseudo, ::pseudo y
# los combinadores descendiente, >, + y ~. @media se mira al aplicar el estilo, con el ancho de la página
# (css_vista);
# @import se guarda en hoja.importes; el resto de reglas @ se salta.

const CSS_DESCENDIENTE = 1
const CSS_HIJO = 2
const CSS_ADYACENTE = 3
const CSS_HERMANO = 4

struct SelAtributo
    nombre: String
    op: String
    valor: String
end

# Un selector simple compuesto: div#a.b[c]:hover
struct SelSimple
    etiqueta: String
    id: String
    clases: [String]
    atributos: [SelAtributo]
    pseudo: [String]
    pseudo_elemento: String
end

# Una parte de un selector y cómo se une a la anterior (0 en la primera)
struct SelParte
    simple: SelSimple
    combinador: Int
end

struct Selector
    partes: [SelParte]
    especificidad: Int
end

struct Declaracion
    propiedad: String
    valor: String
    importante: Bool
end

struct Regla
    selectores: [Selector]
    declaraciones: [Declaracion]
    orden: Int
    medios: [String] = nil      # las condiciones de los @media que la rodean (nil: vale siempre)
    expandidas: [Declaracion] = nil   # las declaraciones con los atajos (margin, border...) ya partidos (lib/estilo.dash)
    con_content: Int = -1       # 1 si declara content (lib/estilo.dash: los ::before/::after sin él no se miran)
    capa: Int = 1000            # @layer: el puesto de su capa (1000: fuera de capas, gana a todas)
end

struct HojaCSS
    reglas: [Regla]
    importes: [String]
    # @keyframes: el nombre -> las declaraciones de su último fotograma (to o 100 %); "nombre 0", las del primero
    fotogramas: {String: [Declaracion]} = nil
end

# Sin comentarios /* ... */
func css_sin_comentarios(s: String) -> String
    p = str_find(s, "/*")
    if p < 0
        return s
    end
    r = ""
    desde = 0
    while p >= 0
        r = r + s[desde:p]
        fin = str_find_from(s, "*/", p + 2)
        if fin < 0
            return r
        end
        desde = fin + 2
        p = str_find_from(s, "/*", desde)
    end
    return r + s[desde:]
end

# Posición del carácter c (código) en s desde i, fuera de comillas, paréntesis y corchetes; -1 si no está
func _css_buscar(s: String, c: Int, desde: Int) -> Int
    n = s.length
    i = desde
    nivel = 0
    comilla = 0
    while i < n
        x = str_code(s, i)
        if comilla != 0
            if x == 92
                i = i + 1
            elif x == comilla
                comilla = 0
            end
        elif x == 34 or x == 39
            comilla = x
        elif x == c and nivel == 0
            return i
        elif x == 40 or x == 91
            nivel = nivel + 1
        elif x == 41 or x == 93
            if nivel > 0
                nivel = nivel - 1
            end
        end
        i = i + 1
    end
    return -1
end

# La "}" que cierra la "{" de la posición i (bloques anidados); el final si no hay
func _css_cierre(s: String, i: Int) -> Int
    n = s.length
    nivel = 0
    comilla = 0
    j = i
    while j < n
        x = str_code(s, j)
        if comilla != 0
            if x == 92
                j = j + 1
            elif x == comilla
                comilla = 0
            end
        elif x == 34 or x == 39
            comilla = x
        elif x == 123
            nivel = nivel + 1
        elif x == 125
            nivel = nivel - 1
            if nivel == 0
                return j
            end
        end
        j = j + 1
    end
    return n
end

# Trozos de s separados por el carácter c fuera de comillas y paréntesis
func css_partir(s: String, c: Int) -> [String]
    var r: [String] = []
    desde = 0
    p = _css_buscar(s, c, 0)
    while p >= 0
        r.push(s[desde:p])
        desde = p + 1
        p = _css_buscar(s, c, desde)
    end
    r.push(s[desde:])
    return r
end

# Las declaraciones de un bloque (o del atributo style)
func css_declaraciones(texto: String) -> [Declaracion]
    var r: [Declaracion] = []
    for trozo in css_partir(texto, 59)
        p = str_find(trozo, ":")
        if p > 0
            propiedad = str_lower(str_trim(trozo[:p]))
            valor = str_trim(trozo[p + 1:])
            importante = false
            q = str_find(str_lower(valor), "!important")
            if q >= 0
                importante = true
                valor = str_trim(valor[:q])
            end
            if propiedad != "" and valor != ""
                r.push(Declaracion(propiedad, valor, importante))
            end
        end
    end
    return r
end

func _sel_simple_vacio() -> SelSimple
    var clases: [String] = []
    var atributos: [SelAtributo] = []
    var pseudo: [String] = []
    return SelSimple("", "", clases, atributos, pseudo, "")
end

# Letras, cifras, "-", "_" y bytes Latin-1 altos: lo que forma un nombre
func _css_nombre(c: Int) -> Bool
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 45 or c == 95 or c >= 160 or c == 92
end

# Un selector completo (sin comas); nil si no se entiende
func css_selector(texto: String) -> Selector
    s = str_trim(texto)
    n = s.length
    var partes: [SelParte] = []
    actual = _sel_simple_vacio()
    vacio = true
    combinador = 0
    pendiente = 0
    ids = 0
    clases = 0
    tipos = 0
    i = 0
    while i < n
        c = str_code(s, i)
        if c == 32 or c == 9 or c == 10 or c == 13 or c == 62 or c == 43 or c == 126
            # fin de una parte: espacios y quizá un combinador
            if not vacio
                partes.push(SelParte(actual, combinador))
                actual = _sel_simple_vacio()
                vacio = true
                pendiente = CSS_DESCENDIENTE
            end
            if c == 62
                pendiente = CSS_HIJO
            elif c == 43
                pendiente = CSS_ADYACENTE
            elif c == 126
                pendiente = CSS_HERMANO
            end
            combinador = pendiente
            i = i + 1
        elif c == 42
            vacio = false
            i = i + 1
        elif c == 35 or c == 46
            j = i + 1
            while j < n and _css_nombre(str_code(s, j))
                j = j + 1
            end
            nombre = s[i + 1:j]
            if c == 35
                actual.id = nombre
                ids = ids + 1
            else
                actual.clases.push(nombre)
                clases = clases + 1
            end
            vacio = false
            i = j
        elif c == 91
            fin = _css_buscar(s, 93, i + 1)
            if fin < 0
                var nada: Selector = nil
                return nada
            end
            actual.atributos.push(_css_sel_atributo(s[i + 1:fin]))
            clases = clases + 1
            vacio = false
            i = fin + 1
        elif c == 58
            j = i + 1
            doble = j < n and str_code(s, j) == 58
            if doble
                j = j + 1
            end
            inicio = j
            while j < n and _css_nombre(str_code(s, j))
                j = j + 1
            end
            nombre = str_lower(s[inicio:j])
            if j < n and str_code(s, j) == 40
                fin = _css_buscar(s, 41, j + 1)
                if fin < 0
                    fin = n - 1
                end
                nombre = nombre + s[j:fin + 1]
                j = fin + 1
            end
            # los pseudo-elementos de CSS2 se escriben también con un solo ":"
            if doble or nombre == "before" or nombre == "after" or nombre == "first-line" or nombre == "first-letter"
                actual.pseudo_elemento = nombre
                tipos = tipos + 1
            else
                actual.pseudo.push(nombre)
                # :where() no cuenta; :is(), :not(), :has() cuentan lo de su argumento más específico (Selectors 4)
                if str_starts(nombre, "where(")
                    clases = clases
                elif str_starts(nombre, "is(") or str_starts(nombre, "not(") or str_starts(nombre, "has(") or str_starts(nombre, "matches(") or str_starts(nombre, "-webkit-any(")
                    mayor = 0
                    q = str_find(nombre, "(")
                    for arg in css_partir(nombre[q + 1:nombre.length - 1], 44)
                        a = str_trim(arg)
                        while a != "" and (str_starts(a, ">") or str_starts(a, "+") or str_starts(a, "~"))
                            a = str_trim(a[1:])
                        end
                        sa = css_selector(a)
                        if sa != nil and sa.especificidad > mayor
                            mayor = sa.especificidad
                        end
                    end
                    ids = ids + mayor / 10000
                    clases = clases + (mayor / 100) % 100
                    tipos = tipos + mayor % 100
                else
                    clases = clases + 1
                end
            end
            vacio = false
            i = j
        elif _css_nombre(c)
            j = i
            while j < n and _css_nombre(str_code(s, j))
                j = j + 1
            end
            actual.etiqueta = str_lower(s[i:j])
            tipos = tipos + 1
            vacio = false
            i = j
        else
            var nada: Selector = nil
            return nada
        end
    end
    if not vacio
        partes.push(SelParte(actual, combinador))
    end
    if partes.length == 0
        var nada2: Selector = nil
        return nada2
    end
    return Selector(partes, ids * 10000 + clases * 100 + tipos)
end

# [nombre], [nombre=valor], [nombre~=valor]...
func _css_sel_atributo(t: String) -> SelAtributo
    p = 0
    n = t.length
    while p < n and _css_nombre(str_code(t, p))
        p = p + 1
    end
    nombre = str_lower(str_trim(t[:p]))
    resto = str_trim(t[p:])
    if resto == ""
        return SelAtributo(nombre, "", "")
    end
    op = "="
    valor = ""
    if str_starts(resto, "=")
        valor = resto[1:]
    else
        op = resto[:2]
        valor = resto[2:]
    end
    valor = str_trim(valor)
    if valor.length >= 2 and (str_starts(valor, "\"") or str_starts(valor, "'"))
        valor = valor[1:valor.length - 1]
    end
    return SelAtributo(nombre, op, valor)
end

# Cascade Layers (CSS Cascade 5): cada capa con nombre tiene su puesto, por orden de aparición en las hojas del
# documento (css_capas_reiniciar al empezar uno); las reglas de fuera de capas van en el 1000 (ganan a todas)
var _css_capas: {String: Int} = nil
var _css_capa: Int = 1000
var _css_capa_nombre: String = ""
var _css_capas_anonimas: Int = 0

func css_capas_reiniciar()
    var capas: {String: Int} = {}
    _css_capas = capas
    _css_capa = 1000
    _css_capa_nombre = ""
    _css_capas_anonimas = 0
end

func _css_capa_completa(nombre: String) -> String
    if _css_capa_nombre == ""
        return nombre
    end
    return _css_capa_nombre + "." + nombre
end

func _css_capa_puesto(nombre: String) -> Int
    if _css_capas == nil
        css_capas_reiniciar()
    end
    if not _css_capas.has(nombre)
        puesto = _css_capas.length
        if puesto > 998
            puesto = 998
        end
        _css_capas[nombre] = puesto
    end
    return _css_capas[nombre]
end

# @supports: (propiedad: valor), not, and, or, paréntesis y selector(); una propiedad vale si dashweb la pinta
func _css_soporta(condicion: String) -> Bool
    c = str_trim(condicion)
    if str_starts(c, "not ") or str_starts(c, "not(")
        return not _css_soporta(c[3:])
    end
    resultado = false
    op = ""
    primero = true
    for t in css_partir(c, 32)
        u = str_trim(t)
        if u == ""
            continue
        elif u == "and" or u == "or"
            op = u
            continue
        end
        v = _css_soporta_uno(u)
        if primero
            resultado = v
        elif op == "and"
            resultado = resultado and v
        else
            resultado = resultado or v
        end
        primero = false
    end
    return resultado
end

func _css_soporta_uno(t: String) -> Bool
    if str_starts(t, "selector(") and str_ends(t, ")")
        return css_selector(t[9:t.length - 1]) != nil
    end
    if not (str_starts(t, "(") and str_ends(t, ")"))
        return false
    end
    dentro = str_trim(t[1:t.length - 1])
    if str_starts(dentro, "(") or str_starts(dentro, "not ") or str_starts(dentro, "not(") or str_starts(dentro, "selector(")
        return _css_soporta(dentro)
    end
    p = str_find(dentro, ":")
    if p < 0
        return false
    end
    propiedad = str_trim(dentro[:p])
    valor = str_trim(dentro[p + 1:])
    if propiedad == "display"
        return valor != "contents" and valor != "ruby" and valor != "math" and not str_starts(valor, "-")
    end
    if _css_conocidas == nil
        var d: {String: Int} = {}
        for q in css_partir(CSS_CONOCIDAS, 32)
            if q != ""
                d[q] = 1
            end
        end
        _css_conocidas = d
    end
    return _css_conocidas.has(propiedad) or str_starts(propiedad, "--")
end

var _css_conocidas: {String: Int} = nil
const CSS_CONOCIDAS = "color background background-color background-image background-size background-position background-repeat border border-top border-right border-bottom border-left border-width border-style border-color border-radius border-collapse border-spacing box-shadow box-sizing margin margin-top margin-right margin-bottom margin-left padding padding-top padding-right padding-bottom padding-left width height min-width min-height max-width max-height position top right bottom left inset z-index overflow overflow-x overflow-y float clear visibility opacity flex flex-direction flex-wrap flex-flow flex-grow flex-shrink flex-basis order justify-content align-items align-self align-content place-items place-content gap row-gap column-gap grid grid-template grid-template-columns grid-template-rows grid-template-areas grid-area grid-column grid-row grid-auto-flow grid-auto-rows grid-auto-columns aspect-ratio object-fit transform transform-origin translate rotate scale animation animation-name transition font font-family font-size font-weight font-style line-height letter-spacing word-spacing text-align text-decoration text-transform text-indent text-shadow text-overflow white-space overflow-wrap word-wrap word-break vertical-align list-style list-style-type content table-layout caption-side"

# Hoja de estilo de un texto CSS; orden: número de la primera regla (para la cascada)
func css_leer(texto: String, orden: Int) -> HojaCSS
    var reglas: [Regla] = []
    var importes: [String] = []
    hoja = HojaCSS(reglas, importes)
    var ninguno: [String] = nil
    _css_bloque(hoja, css_sin_comentarios(texto), orden, ninguno)
    return hoja
end

# medios: las condiciones de los @media de fuera (se miran al aplicar el estilo, con el ancho de la
# página de entonces: css_vista)
func _css_bloque(hoja: HojaCSS, s: String, orden: Int, medios: [String]) -> Int
    n = s.length
    i = 0
    while i < n
        while i < n and (str_code(s, i) == 32 or str_code(s, i) == 9 or str_code(s, i) == 10 or str_code(s, i) == 13 or str_code(s, i) == 59)
            i = i + 1
        end
        if i >= n
            break
        end
        llave = _css_buscar(s, 123, i)
        if str_code(s, i) == 64
            # regla @: con bloque o hasta ";"
            punto_coma = _css_buscar(s, 59, i)
            if llave < 0 or (punto_coma >= 0 and punto_coma < llave)
                if punto_coma < 0
                    punto_coma = n
                end
                cabeza = str_trim(s[i:punto_coma])
                if str_starts(str_lower(cabeza), "@import")
                    hoja.importes.push(_css_url(str_trim(cabeza[7:])))
                elif str_starts(str_lower(cabeza), "@layer")
                    # @layer a, b;: el orden de las capas
                    for nombre in css_partir(cabeza[6:], 44)
                        _css_capa_puesto(_css_capa_completa(str_trim(nombre)))
                    end
                end
                i = punto_coma + 1
            else
                cierre = _css_cierre(s, llave)
                cabeza = str_lower(str_trim(s[i:llave]))
                if str_find(cabeza, "keyframes") >= 0 and str_find(cabeza, "keyframes") < 16
                    _css_fotogramas(hoja, str_trim(s[i:llave]), s[llave + 1:cierre])
                end
                if str_starts(cabeza, "@supports")
                    if _css_soporta(cabeza[9:])
                        orden = _css_bloque(hoja, s[llave + 1:cierre], orden, medios)
                    end
                elif str_starts(cabeza, "@layer")
                    nombre = str_trim(s[i + 6:llave])
                    if nombre == ""
                        _css_capas_anonimas = _css_capas_anonimas + 1
                        nombre = "#" + _css_capas_anonimas
                    end
                    antes_capa = _css_capa
                    antes_nombre = _css_capa_nombre
                    _css_capa_nombre = _css_capa_completa(nombre)
                    _css_capa = _css_capa_puesto(_css_capa_nombre)
                    orden = _css_bloque(hoja, s[llave + 1:cierre], orden, medios)
                    _css_capa = antes_capa
                    _css_capa_nombre = antes_nombre
                end
                if str_starts(cabeza, "@media") and _css_media_posible(cabeza[6:])
                    var dentro: [String] = []
                    if medios != nil
                        for m in medios
                            dentro.push(m)
                        end
                    end
                    dentro.push(cabeza[6:])
                    orden = _css_bloque(hoja, s[llave + 1:cierre], orden, dentro)
                end
                i = cierre + 1
            end
        else
            if llave < 0
                break
            end
            cierre = _css_cierre(s, llave)
            var selectores: [Selector] = []
            for parte in css_partir(s[i:llave], 44)
                sel = css_selector(parte)
                if sel != nil
                    selectores.push(sel)
                end
            end
            if selectores.length > 0
                r = Regla(selectores, css_declaraciones(s[llave + 1:cierre]), orden)
                r.medios = medios
                r.capa = _css_capa
                hoja.reglas.push(r)
                orden = orden + 1
            end
            i = cierre + 1
        end
    end
    return orden
end

# Un @keyframes (o @-webkit-keyframes...): se guardan su primer y su último fotograma (lib/estilo.dash pinta el
# estado en que se queda la animación)
func _css_fotogramas(hoja: HojaCSS, cabeza: String, cuerpo: String)
    p = _css_buscar(cabeza, 32, 0)
    if p < 0
        return
    end
    nombre = str_trim(cabeza[p + 1:])
    if nombre.length >= 2 and (str_starts(nombre, "\"") or str_starts(nombre, "'"))
        nombre = nombre[1:nombre.length - 1]
    end
    var ultimo: [Declaracion] = []
    var primero: [Declaracion] = []
    i = 0
    while i < cuerpo.length
        llave = _css_buscar(cuerpo, 123, i)
        if llave < 0
            break
        end
        cierre = _css_cierre(cuerpo, llave)
        var decl: [Declaracion] = css_declaraciones(cuerpo[llave + 1:cierre])
        for sel in css_partir(cuerpo[i:llave], 44)
            t = str_lower(str_trim(sel))
            if t == "to" or t == "100%"
                for d in decl
                    ultimo.push(d)
                end
            elif t == "from" or t == "0%"
                for d in decl
                    primero.push(d)
                end
            end
        end
        i = cierre + 1
    end
    if hoja.fotogramas == nil
        var f: {String: [Declaracion]} = {}
        hoja.fotogramas = f
    end
    hoja.fotogramas[nombre] = ultimo
    hoja.fotogramas[nombre + " 0"] = primero
end

# ¿Vale esta lista de medios para la pantalla? Se mira como la página de ahora (css_vista: ancho y alto
# en px, de la zona de dibujo; 640x480 si nadie lo dice) en color, apaisada y sin preferencias:
# screen/all, min-/max-width y -height, orientation, prefers-color-scheme: light; print, lo negado
# con "not" y lo que no se conoce, no.
var css_ancho: Int = 640
var css_alto: Int = 480

func css_vista(ancho: Int, alto: Int)
    css_ancho = ancho
    css_alto = alto
end

func css_vista_ancho() -> Int
    return css_ancho
end

func css_alto_vista() -> Int
    return css_alto
end

# ¿Vale la regla con el ancho de ahora? (todos sus @media)
func css_regla_vale(r: Regla) -> Bool
    if r.medios == nil
        return true
    end
    for m in r.medios
        if not _css_media_pantalla(m)
            return false
        end
    end
    return true
end

# Lo mismo con otro ancho (para saber si cambiar el ancho cambia el estilo)
func css_regla_vale_con(r: Regla, ancho: Int) -> Bool
    antes = css_ancho
    css_ancho = ancho
    v = css_regla_vale(r)
    css_ancho = antes
    return v
end

# ¿Puede valer con algún ancho? (print, no: esas reglas ni se guardan)
func _css_media_posible(medios: String) -> Bool
    # se prueba con unos anchos típicos y con los que nombra la consulta (y el de al lado): un rango como
    # (min-width: 768px) and (max-width: 1023px) no contiene ninguno de los típicos
    var anchos: [Int] = [320, 640, 1024, 1920]
    i = 0
    while i < medios.length
        c = str_code(medios, i)
        if c >= 48 and c <= 57
            j = i
            while j < medios.length and str_code(medios, j) >= 48 and str_code(medios, j) <= 57
                j = j + 1
            end
            v = Int(medios[i:j])
            if j + 1 < medios.length and str_code(medios, j) == 101 and str_code(medios, j + 1) == 109
                v = v * 16
            end
            anchos.push(v)
            anchos.push(v + 1)
            if v > 0
                anchos.push(v - 1)
            end
            i = j
        else
            i = i + 1
        end
    end
    antes = css_ancho
    for ancho in anchos
        css_ancho = ancho
        if _css_media_pantalla(medios)
            css_ancho = antes
            return true
        end
    end
    css_ancho = antes
    return false
end

# Lo mismo para quien lo use desde fuera (matchMedia de lib/jsdom.dash)
func css_media_vale(medios: String) -> Bool
    return _css_media_pantalla(medios)
end

func _css_media_pantalla(medios: String) -> Bool
    m = str_lower(str_trim(medios))
    if m == ""
        return true
    end
    for parte in css_partir(m, 44)
        if _css_media_una(str_trim(parte))
            return true
        end
    end
    return false
end

func _css_media_una(q: String) -> Bool
    negada = false
    if str_starts(q, "not ")
        negada = true
        q = str_trim(q[4:])
    elif str_starts(q, "only ")
        q = str_trim(q[5:])
    end
    vale = true
    for trozo in _css_partir_and(q)
        c = str_trim(trozo)
        if str_starts(c, "(")
            if not _css_media_rasgo(c)
                vale = false
            end
        elif c != "screen" and c != "all"
            vale = false
        end
    end
    return vale != negada
end

# "screen and (min-width: 600px)" -> ["screen", "(min-width: 600px)"]
func _css_partir_and(q: String) -> [String]
    var r: [String] = []
    i = 0
    inicio = 0
    while i < q.length
        if i + 5 <= q.length and q[i:i + 5] == " and "
            r.push(q[inicio:i])
            i = i + 5
            inicio = i
        else
            i = i + 1
        end
    end
    r.push(q[inicio:])
    return r
end

# (rasgo: valor)
func _css_media_rasgo(c: String) -> Bool
    fin = str_find(c, ")")
    if fin < 0
        fin = c.length
    end
    dentro = c[1:fin]
    dos = str_find(dentro, ":")
    if dos < 0
        return dentro == "color"
    end
    rasgo = str_trim(dentro[:dos])
    valor = str_trim(dentro[dos + 1:])
    if rasgo == "min-width" or rasgo == "min-device-width"
        return css_ancho >= _css_media_px(valor)
    elif rasgo == "max-width" or rasgo == "max-device-width"
        return css_ancho <= _css_media_px(valor)
    elif rasgo == "min-height" or rasgo == "min-device-height"
        return css_alto >= _css_media_px(valor)
    elif rasgo == "max-height" or rasgo == "max-device-height"
        return css_alto <= _css_media_px(valor)
    elif rasgo == "orientation"
        return (valor == "landscape") == (css_ancho >= css_alto)
    elif rasgo == "prefers-color-scheme"
        return valor == "light"
    elif rasgo == "prefers-reduced-motion"
        return valor == "no-preference"
    end
    return false
end

# 600px, 37.5em, 30rem -> px (16 px por em)
func _css_media_px(v: String) -> Int
    if str_ends(v, "px")
        return Int(str_trim(v[:v.length - 2]))
    elif str_ends(v, "rem")
        return _css_decimal_por(str_trim(v[:v.length - 3]), 16)
    elif str_ends(v, "em")
        return _css_decimal_por(str_trim(v[:v.length - 2]), 16)
    end
    return Int(v)
end

# "37.5" * 16 sin coma flotante
func _css_decimal_por(v: String, k: Int) -> Int
    punto = str_find(v, ".")
    if punto < 0
        return Int(v) * k
    end
    decimales = v[punto + 1:]
    if decimales.length > 3
        decimales = decimales[:3]
    end
    escala = 1
    i = 0
    while i < decimales.length
        escala = escala * 10
        i = i + 1
    end
    return Int(v[:punto]) * k + Int(decimales) * k / escala
end

# Los @import de una hoja sin leerla entera: solo valen al principio (tras @charset y comentarios)
func css_importes(texto: String) -> [String]
    var r: [String] = []
    i = 0
    n = texto.length
    while i < n
        c = str_code(texto, i)
        if c == 32 or c == 9 or c == 10 or c == 13 or c == 59
            i = i + 1
        elif c == 47 and i + 1 < n and str_code(texto, i + 1) == 42
            fin = str_find_from(texto, "*/", i + 2)
            if fin < 0
                return r
            end
            i = fin + 2
        elif c == 64
            fin = _css_buscar(texto, 59, i)
            if fin < 0
                fin = n
            end
            cabeza = str_trim(texto[i:fin])
            if str_starts(str_lower(cabeza), "@import")
                r.push(_css_url(str_trim(cabeza[7:])))
            elif not str_starts(str_lower(cabeza), "@charset")
                return r
            end
            i = fin + 1
        else
            return r
        end
    end
    return r
end

# La dirección de un valor con url(...) ("" si no lleva)
func css_url(valor: String) -> String
    p = str_find(str_lower(valor), "url(")
    if p < 0
        return ""
    end
    return _css_url(valor[p:])
end

# url("x"), url(x), "x" -> x
func _css_url(t: String) -> String
    v = str_trim(t)
    if str_starts(str_lower(v), "url(")
        fin = str_find(v, ")")
        if fin < 0
            fin = v.length
        end
        v = str_trim(v[4:fin])
    else
        sp = _css_buscar(v, 32, 0)
        if sp > 0
            v = v[:sp]
        end
    end
    if v.length >= 2 and (str_starts(v, "\"") or str_starts(v, "'"))
        v = v[1:v.length - 1]
    end
    return v
end

# El selector como texto, para pruebas: "div#a.b > p:hover"
func css_selector_texto(sel: Selector) -> String
    r = ""
    for p in sel.partes
        if p.combinador == CSS_DESCENDIENTE
            r = r + " "
        elif p.combinador == CSS_HIJO
            r = r + " > "
        elif p.combinador == CSS_ADYACENTE
            r = r + " + "
        elif p.combinador == CSS_HERMANO
            r = r + " ~ "
        end
        s = p.simple
        t = s.etiqueta
        if t == "" and s.id == "" and s.clases.length == 0 and s.atributos.length == 0 and s.pseudo.length == 0
            t = "*"
        end
        r = r + t
        if s.id != ""
            r = r + "#" + s.id
        end
        for c in s.clases
            r = r + "." + c
        end
        for a in s.atributos
            r = r + "[" + a.nombre + a.op + a.valor + "]"
        end
        for ps in s.pseudo
            r = r + ":" + ps
        end
        if s.pseudo_elemento != ""
            r = r + "::" + s.pseudo_elemento
        end
    end
    return r
end
