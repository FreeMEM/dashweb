# Una página abierta: su texto, el árbol, las hojas de estilo, las imágenes, el JavaScript y la
# maqueta. Lo que comparten el visor y el navegador.
#
#   d = documento_abrir("http://ejemplo.org/")   # carga, árbol, <script>, estilo e imágenes
#   documento_maquetar(d, ancho)                  # d.pagina: la lista de dibujos (lib/maqueta.dash)
#   pintar(d.pagina, d.im, desde, x, y, ancho, alto)
#   if documento_al_dia(d) ...                    # tras un clic o un temporizador: si el JS lo cambió,
#                                                 # vuelve a dar estilo y a maquetar (true si lo hizo)
#   if documento_imagenes(d) ...                  # las imágenes llegan sin esperar: true si llegó alguna
#                                                 # (y se volvió a maquetar); imagenes_pendientes(d.im)
#   documento_liberar(d)
#
# Con imágenes, abrir después de que la ventana esté en su pantalla (colores).

import "pintor.dash"
import "jsdom.dash"
import "recursos.dash"
import "html5.dash"
import "animacion.dash"

struct Documento
    direccion: String
    titulo: String
    bytes: Int
    doc: Nodo
    hojas: Hojas
    im: Imagenes
    js: Int              # el motor de JavaScript, 0 si la página no tiene <script>
    cambios: Int         # jsdom_cambios la última vez que se maquetó
    pagina: Pagina       # nil hasta documento_maquetar
    ancho: Int
    error: String
    ms: Int              # lo que tardó en abrirse y maquetarse
    recursos: Recursos = nil   # documento_empezar: las hojas y scripts que están llegando
    hojas_firma: String = ""   # estilo_firma de cuando se hicieron las hojas: si cambia, el JS metió o tocó un <style>
    vh: Int = 0                # el alto de la vista con que se maquetó (vh, position: fixed con top y bottom)
    videos: Videos = nil       # los reproductores de sus <video> (lib/videos.dash)
    sin_maquetar: Int = 0      # imágenes llegadas que cambian la maqueta (su <img> no tenía tamaño)
    sin_pintar: Int = 0        # imágenes llegadas que aún no se han pintado
    pintada: Int = 0           # time_ms del último repintado por imágenes
    remaquetada: Bool = false  # documento_imagenes volvió a maquetar (hay que repintar sí o sí)
    anims: [Animacion] = nil   # las animaciones de CSS de la última maqueta (lib/animacion.dash; tarea 37d2)
    anim_t0: Int = 0           # time_ms de su principio (la primera maqueta): su reloj
    svgs: [SvgAnimado] = nil   # los <svg> con animaciones dentro (se rasterizan otra vez en cada fotograma; 37d4)
    raton: Nodo = nil          # el elemento bajo el ratón (documento_raton; tarea 37f3)
    raton_toques: Bool = false # el :hover cambió: documento_al_dia rehace el estilo aunque el JavaScript no tocara nada
    # el último documento_al_dia que dio true solo cambió lo de zx0..zx1, zy0..zy1 (coordenadas de la vista con la
    # página desplazada desde, sin incluir los dos últimos): basta repintar eso (tarea 37e7). false: toda la vista
    desde: Int = 0             # lo pone quien llama a documento_al_dia: el desplazamiento de la vista y su alto
    alto_vista: Int = 0        # (lo de fuera de la vista no entra en la zona)
    zona: Bool = false
    zona_entera: Bool = false
    zx0: Int = 0
    zy0: Int = 0
    zx1: Int = 0
    zy1: Int = 0
    # lo que costó la última maqueta entera por el JavaScript y cuándo acabó: si pasa de DOCUMENTO_CARO ms, la
    # siguiente espera a que haya pasado el doble (aplazada: cuándo toca; -1, ninguna). Un panel que cambia su texto
    # cada segundo (trasfondo.freemem.space) se llevaba así el 90 % del tiempo y no se decodificaban sus imágenes
    maqueta_ms: Int = 0
    maqueta_fin: Int = 0
    aplazada: Int = -1
end

const DOCUMENTO_CARO = 150
# (lo pone el navegador; las pruebas quieren cada cambio al momento)
var documento_aplazar: Bool = false

# Un <svg> de la página con animaciones de CSS en sus elementos (la curva de trainalong.fit: stroke-dashoffset)
struct SvgAnimado
    svg: Nodo
    anims: [Animacion]
    acabado: Bool = false
end

# Las imágenes que llegan se pintan juntas: mientras siguen llegando, como mucho cada tanto (pintar
# freemem.space entera cuesta ~0,7 s en la máquina RTG y se ve redibujarse: eran 15 repintados seguidos, uno
# por imagen); la última, enseguida. Solo se vuelve a maquetar si alguna cambió el tamaño de su <img>
# (maquetar esa página cuesta ~1,4 s).
const DOCUMENTO_REPINTAR = 2500

# El texto de la página (Latin-1): http(s) o un fichero; si falla, una página que lo dice
func documento_texto(direccion: String, d: Documento) -> String
    if str_starts(direccion, "http://") or str_starts(direccion, "https://")
        r = http_get(direccion, 20000)
        if r.error != ""
            d.error = r.error
            return "<title>Error</title><h1>No se pudo cargar</h1><p>" + r.error + "</p>"
        end
        d.direccion = r.url
        return http_texto(r)
    end
    t = file_read_text(url_fichero(direccion))
    if t == nil
        d.error = "no se puede leer " + direccion
        return "<title>Error</title><h1>No se pudo abrir</h1><p>" + direccion + "</p>"
    end
    return utf8_a_latin1(t)
end

func documento_abrir(direccion: String) -> Documento
    t0 = time_ms()
    var nadie: Nodo = nil
    var sin_hojas: Hojas = nil
    var sin_pagina: Pagina = nil
    d = Documento(direccion, "", 0, nadie, sin_hojas, imagenes_nuevas(), 0, 0, sin_pagina, 0, "", 0)
    return documento_desde_html(d, documento_texto(direccion, d), t0)
end

# Con la respuesta ya recibida (lib/http.dash, sin esperar: http_empezar/http_avanzar)
func documento_desde_respuesta(direccion: String, r: Respuesta) -> Documento
    t0 = time_ms()
    var nadie: Nodo = nil
    var sin_hojas: Hojas = nil
    var sin_pagina: Pagina = nil
    d = Documento(direccion, "", 0, nadie, sin_hojas, imagenes_nuevas(), 0, 0, sin_pagina, 0, "", 0)
    if r.error != ""
        d.error = r.error
        return documento_desde_html(d, "<title>Error</title><h1>No se pudo cargar</h1><p>" + r.error + "</p>", t0)
    end
    d.direccion = r.url
    return documento_desde_html(d, _documento_de_tipo(r), t0)
end

# Sin esperar: el árbol de la respuesta y los recursos (CSS, <script src>) pedidos; documento_avanzar en
# cada vuelta hasta que dé true (entonces scripts, estilo e imágenes, y listo para maquetar)
func documento_empezar(direccion: String, r: Respuesta) -> Documento
    t0 = time_ms()
    var nadie: Nodo = nil
    var sin_hojas: Hojas = nil
    var sin_pagina: Pagina = nil
    d = Documento(direccion, "", 0, nadie, sin_hojas, imagenes_nuevas(), 0, 0, sin_pagina, 0, "", 0)
    texto = ""
    if r.error != ""
        d.error = r.error
        texto = "<title>Error</title><h1>No se pudo cargar</h1><p>" + r.error + "</p>"
    else
        d.direccion = r.url
        texto = _documento_de_tipo(r)
    end
    d.bytes = texto.length
    if r.error == "" and _documento_html_utf8(r)
        # a Hubbub, los bytes UTF-8 tal cual: los scripts en línea conservan sus caracteres (tarea 37a4)
        d.doc = dom_desde_html5_utf8(r.cuerpo)
    else
        d.doc = dom_desde_html5(texto)
    end
    d.recursos = recursos_nuevos()
    recursos_del_documento(d.recursos, d.doc, d.direccion)
    d.ms = time_ms() - t0
    return d
end

# ¿Es una página HTML en UTF-8 (o sin juego dicho), lo que _documento_de_tipo da tal cual?
func _documento_html_utf8(r: Respuesta) -> Bool
    tipo = str_lower(r.tipo)
    if str_starts(tipo, "image/") or str_starts(tipo, "video/") or tipo == "text/plain"
        return false
    end
    if tipo == ""
        e = str_lower(r.url)
        q = str_find(e, "?")
        if q >= 0
            e = e[:q]
        end
        if str_ends(e, ".jpg") or str_ends(e, ".jpeg") or str_ends(e, ".png") or str_ends(e, ".gif") or str_ends(e, ".webp") or str_ends(e, ".bmp") or str_ends(e, ".svg")
            return false
        end
    end
    j = str_lower(str_trim(r.juego))
    return not (j == "iso-8859-1" or j == "latin1" or j == "iso8859-1" or j == "us-ascii" or j == "ascii" or j == "windows-1252" or j == "cp1252")
end

# El HTML de lo que llegó: una imagen o un vídeo abiertos solos van en una página que los muestra (como Chrome:
# centrada sobre fondo oscuro), el texto plano en un <pre>; lo demás es HTML
func _documento_de_tipo(r: Respuesta) -> String
    tipo = str_lower(r.tipo)
    if tipo == ""
        # sin Content-Type: por la extensión
        e = str_lower(r.url)
        q = str_find(e, "?")
        if q >= 0
            e = e[:q]
        end
        if str_ends(e, ".jpg") or str_ends(e, ".jpeg") or str_ends(e, ".png") or str_ends(e, ".gif") or str_ends(e, ".webp") or str_ends(e, ".bmp") or str_ends(e, ".svg")
            tipo = "image/"
        end
    end
    nombre = r.url
    barra = nombre.length - 1
    while barra >= 0 and str_code(nombre, barra) != 47
        barra = barra - 1
    end
    if barra >= 0
        nombre = nombre[barra + 1:]
    end
    src = str_replace(str_replace(r.url, "\"", "%22"), "<", "%3C")
    if str_starts(tipo, "image/")
        h = "<html><head><title>" + nombre + "</title></head>"
        h = h + "<body style='margin:0;background:#0e0e0e;display:flex;align-items:center;justify-content:center;min-height:100vh'>"
        return h + "<img src=\"" + src + "\" style='max-width:100%'></body></html>"
    elif str_starts(tipo, "video/")
        h = "<html><head><title>" + nombre + "</title></head>"
        h = h + "<body style='margin:0;background:#0e0e0e;display:flex;align-items:center;justify-content:center;min-height:100vh'>"
        return h + "<video src=\"" + src + "\" controls style='max-width:100%'></video></body></html>"
    elif tipo == "text/plain"
        t = str_replace(str_replace(str_replace(http_texto(r), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
        return "<html><head><title>" + nombre + "</title></head><body><pre style='white-space:pre-wrap'>" + t + "</pre></body></html>"
    end
    return http_texto(r)
end

# ¿Es algo para guardar y no para ver? Lo que no es texto, imagen ni vídeo (un .lha, un .zip, un PDF...), o lo
# que el servidor manda como adjunto (Content-Disposition: attachment)
func documento_es_descarga(r: Respuesta) -> Bool
    if r.estado < 200 or r.estado >= 300
        return false
    end
    if r.cabeceras.has("content-disposition") and str_find(str_lower(r.cabeceras["content-disposition"]), "attachment") >= 0
        return true
    end
    t = str_lower(r.tipo)
    if t == ""
        n = str_lower(documento_nombre_descarga(r))
        for e in [".lha", ".lzh", ".lzx", ".zip", ".adf", ".dms", ".gz", ".tgz", ".tar", ".7z", ".exe", ".pdf", ".mod", ".mp3", ".iso", ".hdf"]
            if str_ends(n, e)
                return true
            end
        end
        return false
    end
    if str_starts(t, "text/") or str_starts(t, "image/") or str_starts(t, "video/")
        return false
    end
    for v in ["application/xhtml+xml", "application/xml", "application/javascript", "application/json", "application/rss+xml", "application/atom+xml"]
        if t == v
            return false
        end
    end
    return true
end

# El nombre con que guardarlo: el filename de Content-Disposition, o lo último de la dirección (sin ?...)
func documento_nombre_descarga(r: Respuesta) -> String
    if r.cabeceras.has("content-disposition")
        cd = r.cabeceras["content-disposition"]
        p = str_find(str_lower(cd), "filename=")
        if p >= 0
            n = str_trim(cd[p + 9:])
            fin = str_find(n, ";")
            if fin >= 0
                n = n[:fin]
            end
            n = str_trim(str_replace(n, "\"", ""))
            if n != ""
                return url_fichero_nombre(n)
            end
        end
    end
    u = r.url
    q = str_find(u, "?")
    if q >= 0
        u = u[:q]
    end
    i = u.length - 1
    while i >= 0 and str_code(u, i) != 47
        i = i - 1
    end
    n = u[i + 1:]
    if n == ""
        return "descarga"
    end
    return url_fichero_nombre(n)
end

func documento_avanzar(d: Documento) -> Bool
    if d.recursos == nil
        return true
    end
    recursos_avanzar(d.recursos)
    if recursos_pendientes(d.recursos) > 0
        return false
    end
    t0 = time_ms()
    traza("recursos listos: scripts")
    traidos = d.recursos.traidos
    if dom_buscar(d.doc, "script") != nil
        d.js = js_nuevo()
        jsdom_preparar(d.js, d.doc)
        jsdom_ejecutar_scripts_con(d.js, d.doc, d.direccion, traidos)
        d.cambios = jsdom_cambios(d.js)
    end
    _documento_olvidar_tocados(d)
    traza("scripts hechos en " + (time_ms() - t0) + " ms: estilo")
    d.titulo = jsdom_titulo(d.doc)
    if d.titulo == ""
        d.titulo = d.direccion
    end
    d.hojas = estilo_hojas_con(d.doc, d.direccion, traidos)
    d.hojas_firma = estilo_firma(d.doc)
    estilo_aplicar(d.doc, d.hojas)
    traza("estilo hecho")
    imagenes_pedir_fuentes(d.im, estilo_caras(d.hojas))
    imagenes_pedir(d.im, d.doc, d.direccion)
    var nada: Recursos = nil
    d.recursos = nada
    d.ms = d.ms + time_ms() - t0
    return true
end

# Algún cambio puede tocar las hojas: un <style> o <link> que entra, sale o cambia (o demasiados cambios para saberlo)
func _documento_toques_hojas(toques: [Toque]) -> Bool
    for t in toques
        n = t.nodo
        if t.tipo == TOQUE_TODO or n == nil
            return true
        end
        if n.nombre == "style" or n.nombre == "link" or (n.padre != nil and n.padre.nombre == "style")
            return true
        end
        if t.tipo == TOQUE_ENTRA and _documento_con_hoja(n)
            return true
        end
        if t.tipo == TOQUE_SALE and t.quitado != nil and _documento_con_hoja(t.quitado)
            return true
        end
    end
    return false
end

func _documento_con_hoja(n: Nodo) -> Bool
    if n.tipo == DOM_ELEMENTO and (n.nombre == "style" or n.nombre == "link")
        return true
    end
    for h in n.hijos
        if _documento_con_hoja(h)
            return true
        end
    end
    return false
end

# Lo mismo con el HTML ya en la mano (una página de inicio, una de error)
func documento_html(direccion: String, html: String) -> Documento
    var nadie: Nodo = nil
    var sin_hojas: Hojas = nil
    var sin_pagina: Pagina = nil
    d = Documento(direccion, "", 0, nadie, sin_hojas, imagenes_nuevas(), 0, 0, sin_pagina, 0, "", 0)
    return documento_desde_html(d, html, time_ms())
end

func documento_desde_html(d: Documento, texto: String, t0: Int) -> Documento
    d.bytes = texto.length
    d.doc = dom_desde_html5(texto)
    if dom_buscar(d.doc, "script") != nil
        d.js = js_nuevo()
        jsdom_preparar(d.js, d.doc)
        jsdom_ejecutar_scripts(d.js, d.doc, d.direccion)
        d.cambios = jsdom_cambios(d.js)
    end
    _documento_olvidar_tocados(d)
    d.titulo = jsdom_titulo(d.doc)
    if d.titulo == ""
        d.titulo = d.direccion
    end
    d.hojas = estilo_hojas(d.doc, d.direccion)
    d.hojas_firma = estilo_firma(d.doc)
    estilo_aplicar(d.doc, d.hojas)
    imagenes_pedir_fuentes(d.im, estilo_caras(d.hojas))
    imagenes_pedir(d.im, d.doc, d.direccion)
    d.ms = time_ms() - t0
    return d
end

# La barra de desplazamiento, que en un navegador cuenta en el ancho de los @media
const DOC_BARRA = 16

func documento_maquetar(d: Documento, ancho: Int)
    t0 = time_ms()
    # los @media miran el ancho de la página: si alguno cambia de lado, el estilo otra vez
    if d.hojas != nil and css_vista_ancho() != ancho + DOC_BARRA
        cambia = estilo_cambia_con(d.hojas, ancho + DOC_BARRA)
        css_vista(ancho + DOC_BARRA, css_alto_vista())
        if cambia
            estilo_aplicar(d.doc, d.hojas)
        end
    end
    d.pagina = maquetar(d.doc, ancho)
    d.ancho = ancho
    _documento_vistas(d)
    d.ms = d.ms + time_ms() - t0
    traza("maquetada en " + (time_ms() - t0) + " ms")
end

# A qué tamaño se ve cada imagen (las que aún no han llegado se decodificarán a ese tamaño)
# Los <svg> de la página que se ven a otro tamaño que su imagen: rasterizados otra vez a ese
func _documento_svg_tamanos(d: Documento, n: Nodo)
    if n.tipo != DOM_ELEMENTO and n.tipo != DOM_DOCUMENTO
        return
    end
    if n.tipo == DOM_ELEMENTO and n.nombre == "svg"
        imagenes_svg_a_tamano(d.im, n)
        return
    end
    for h in n.hijos
        _documento_svg_tamanos(d, h)
    end
end

func _documento_vistas(d: Documento)
    _documento_svg_tamanos(d, d.doc)
    # las animaciones de CSS de esta maqueta (sus dibujos son otros: se recogen otra vez; el reloj sigue)
    if d.anim_t0 == 0
        d.anim_t0 = time_ms()
    end
    if d.hojas != nil
        d.anims = animaciones_pagina(d.pagina, d.hojas)
        var svgs: [SvgAnimado] = []
        _documento_svgs(d, d.doc, svgs)
        d.svgs = svgs
        # su primer fotograma ya, antes de pintar (si no, se veía un momento su estado final: la curva entera)
        if svgs.length > 0
            _documento_animar_svgs(d)
        end
    end
    imagenes_posicion(d.im, "", 0, true)
    for dib in d.pagina.dibujos
        if dib.tipo == D_IMAGEN or dib.tipo == D_FONDO
            imagenes_vista(d.im, dib.texto, dib.ancho, dib.alto)
            imagenes_posicion(d.im, dib.texto, dib.y, false)
        end
    end
end

# Un fotograma de las animaciones de CSS (tarea 37d2): mueve y vela lo dibujado de cada elemento animado según
# el tiempo desde que se maquetó la página por primera vez; true si alguna sigue viva (hará falta otro)
func documento_animar(d: Documento) -> Bool
    if d.pagina == nil
        return false
    end
    # (lo que cambia: los dibujos animados y los <svg> animados, antes y después; tarea 37e7)
    _documento_zona_vacia(d)
    _documento_zona_animada(d)
    viva = false
    if d.anims != nil and d.anims.length > 0
        viva = animar(d.pagina, d.anims, time_ms() - d.anim_t0)
    end
    if d.svgs != nil and d.svgs.length > 0 and _documento_animar_svgs(d)
        viva = true
    end
    _documento_zona_animada(d)
    d.zona = not d.zona_entera
    return viva
end

func _documento_zona_animada(d: Documento)
    for dib in d.pagina.dibujos
        if dib.anim != nil
            _documento_zona(d, dib)
        elif d.svgs != nil and dib.tipo == D_IMAGEN and dib.nodo != nil and dib.nodo.nombre == "svg"
            for s in d.svgs
                if s.svg == dib.nodo
                    _documento_zona(d, dib)
                end
            end
        end
    end
end

# ¿Tiene animaciones de CSS?
func documento_animado(d: Documento) -> Bool
    return d.pagina != nil and ((d.anims != nil and d.anims.length > 0) or (d.svgs != nil and d.svgs.length > 0))
end

# Los <svg> ya puestos como imagen con animaciones en lo de dentro
func _documento_svgs(d: Documento, n: Nodo, r: [SvgAnimado])
    if n.tipo != DOM_ELEMENTO and n.tipo != DOM_DOCUMENTO
        return
    end
    if n.tipo == DOM_ELEMENTO and n.nombre == "svg"
        if dom_atributo(n, "data-dashweb-svg") != ""
            var anims: [Animacion] = []
            _documento_svg_anims(d, n, anims)
            if anims.length > 0
                r.push(SvgAnimado(n, anims))
            end
        end
        return
    end
    for h in n.hijos
        _documento_svgs(d, h, r)
    end
end

func _documento_svg_anims(d: Documento, n: Nodo, r: [Animacion])
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO
            for a in animaciones_de(h, d.hojas)
                r.push(a)
            end
            _documento_svg_anims(d, h, r)
        end
    end
end

# Un fotograma de cada <svg> animado: los valores de este instante en svg_sobre de sus elementos (stroke-dashoffset,
# opacity, fill, stroke...; scale de un <circle>, en su r) y otra vez rasterizado. Acabadas sus animaciones, se
# deja en su estado final y ya no se toca. true si alguno sigue vivo.
func _documento_animar_svgs(d: Documento) -> Bool
    viva = false
    t = time_ms() - d.anim_t0
    for g in d.svgs
        if g.acabado
            continue
        end
        alguna = false
        for a in g.anims
            if a.vueltas < 0 or t < a.retardo + a.vueltas / 100 * a.duracion / 10
                alguna = true
            end
            prog = animacion_progreso(a, t)
            var sobre: {String: String} = {}
            if prog >= 0
                for p in ["stroke-dashoffset", "stroke-dasharray", "opacity", "fill-opacity", "stroke-opacity", "fill", "stroke", "stroke-width"]
                    v = animacion_valor(a, p, prog)
                    if v != ""
                        sobre[p] = v
                    end
                end
                tr = animacion_valor(a, "transform", prog)
                if tr != "" and a.nodo.nombre == "circle" and dom_atributo(a.nodo, "r") != ""
                    s = maqueta_escala(tr)
                    sobre["@r"] = animacion_mezcla("0", dom_atributo(a.nodo, "r"), s[0])
                end
            else
                # antes de empezar (su retardo), como estaba debajo de la animación
                for p in ["stroke-dashoffset", "opacity", "transform"]
                    if a.nodo.estilo.has("~" + p) and animacion_valor(a, p, 0) != ""
                        sobre[p] = a.nodo.estilo["~" + p]
                    end
                end
                if sobre.has("transform")
                    if a.nodo.nombre == "circle" and dom_atributo(a.nodo, "r") != ""
                        s = maqueta_escala(sobre["transform"])
                        sobre["@r"] = animacion_mezcla("0", dom_atributo(a.nodo, "r"), s[0])
                    end
                    sobre.remove("transform")
                end
            end
            a.nodo.svg_sobre = sobre
        end
        imagenes_svg_rehacer(d.im, g.svg)
        for a in g.anims
            var nada: {String: String} = nil
            a.nodo.svg_sobre = nada
        end
        if not alguna
            g.acabado = true
        else
            viva = true
        end
    end
    return viva
end

# El ratón está en x, y de la página (y_vista: la y en la vista, para el JavaScript; x < 0: fuera de la página). Pone
# :hover en el elemento de debajo y los de fuera (y lo quita de los que deja) y lanza los sucesos del ratón al
# JavaScript. true si el :hover cambió algo que el CSS mira: entonces documento_al_dia rehace el estilo.
func documento_raton(d: Documento, x: Int, y: Int, y_vista: Int) -> Bool
    if d.pagina == nil
        return false
    end
    var n: Nodo = nil
    if x >= 0
        n = maqueta_nodo_en_vista(d.pagina, x, y_vista, y - y_vista)
    end
    while n != nil and (n.tipo != DOM_ELEMENTO or str_starts(n.nombre, "::"))
        n = n.padre
    end
    viejo = d.raton
    cambia = false
    if n != viejo
        usa_hover = d.hojas != nil and d.hojas.con_hover
        # (se marcan los de la cadena nueva; los de la vieja que no estén, se desmarcan)
        _lig_vuelta = _lig_vuelta + 1
        marca = _lig_vuelta
        p = n
        while p != nil and p.tipo == DOM_ELEMENTO
            p.lig_fuera = 0 - marca
            p = p.padre
        end
        p = viejo
        while p != nil and p.tipo == DOM_ELEMENTO
            if p.lig_fuera != 0 - marca and p.raton
                p.raton = false
                if usa_hover
                    dom_apuntar(p, TOQUE_ATRIBUTO, ":hover", "", "")
                    cambia = true
                end
            end
            p = p.padre
        end
        p = n
        while p != nil and p.tipo == DOM_ELEMENTO
            if not p.raton
                p.raton = true
                if usa_hover
                    dom_apuntar(p, TOQUE_ATRIBUTO, ":hover", "", "")
                    cambia = true
                end
            end
            p = p.padre
        end
        d.raton = n
    end
    if d.js != 0 and (n != nil or viejo != nil)
        jsdom_raton(d.js, n, viejo, x, y_vista)
    end
    if cambia
        d.raton_toques = true
    end
    return cambia
end

# Si el JavaScript cambió el documento desde la última maqueta: estilo, imágenes y maqueta otra vez
func documento_al_dia(d: Documento) -> Bool
    if not d.raton_toques and (d.js == 0 or jsdom_cambios(d.js) == d.cambios)
        return false
    end
    # (lo del ratón, ya; lo del JavaScript, cuando le toque si la última maqueta fue cara: los cambios se juntan)
    t0 = time_ms()
    if documento_aplazar and not d.raton_toques and d.maqueta_ms > DOCUMENTO_CARO and t0 < d.maqueta_fin + 2 * d.maqueta_ms
        d.aplazada = d.maqueta_fin + 2 * d.maqueta_ms
        return false
    end
    d.aplazada = -1
    d.raton_toques = false
    if d.js != 0
        d.cambios = jsdom_cambios(d.js)
    end
    d.titulo = jsdom_titulo(d.doc)
    toques = d.doc.toques
    _documento_olvidar_tocados(d)
    d.zona = false
    # cambios del JS sin nada apuntado: fuera del documento (lo que React monta antes de meterlo) o sin efecto (un
    # atributo con el valor que ya tenía): ni estilo ni maqueta (tarea 37e6; antes, estilo entero y maqueta, 7 s)
    if toques == nil or toques.length == 0
        return false
    end
    # el JavaScript metió, quitó o cambió un <style> o un <link> de hoja (el CSS de Didomi en xataka.com, que llega
    # tras la carga): las hojas otra vez (las de fuera ya traídas no se piden) y el estilo entero
    hojas_nuevas = false
    if d.hojas != nil and _documento_toques_hojas(toques)
        firma = estilo_firma(d.doc)
        if firma != d.hojas_firma
            traidas = d.hojas.traidas
            if traidas == nil
                var vacias: {String: String} = {}
                traidas = vacias
            end
            d.hojas = estilo_hojas_con(d.doc, d.direccion, traidas)
            d.hojas_firma = firma
            imagenes_pedir_fuentes(d.im, estilo_caras(d.hojas))
            hojas_nuevas = true
            traza("hojas otra vez: el JavaScript cambió un <style> o <link>")
        end
    end
    # lo que cambia en el estilo, por si no mueve nada (tarea 37d)
    ligero = not hojas_nuevas and _documento_puede_ligero(d, toques)
    # todo lo tocado dentro de una caja que se puede maquetar sola (tarea 48h): se apunta qué estilos cambian, para
    # saber que ninguno es de fuera
    limite = _documento_limite(d, toques)
    if hojas_nuevas
        var ninguna: Nodo = nil
        limite = ninguna
    end
    if ligero or limite != nil
        var cambios: [EstiloCambio] = []
        estilo_cambios = cambios
        estilo_apuntar = true
    end
    # lo medido en la maqueta anterior se guarda salvo en lo tocado (tarea 37e6)
    if toques != nil
        for t in toques
            dom_tocar(t.nodo)
        end
    end
    estilo_marcar = true
    parte = toques != nil and not hojas_nuevas and estilo_aplicar_partes(d.doc, d.hojas, toques)
    estilo_marcar = false
    estilo_apuntar = false
    if not parte
        estilo_aplicar(d.doc, d.hojas)
    end
    svgs = _documento_svgs_tocados(d, toques)
    _documento_zona_vacia(d)
    if ligero and parte and _documento_sin_maqueta(d, toques, estilo_cambios)
        for dib in d.pagina.dibujos
            for s in svgs
                if dib.nodo == s
                    _documento_zona(d, dib)
                end
            end
        end
        d.zona = not d.zona_entera
        if traza_activa
            traza("el JavaScript hizo " + toques.length + " cambios que no mueven nada (" + estilo_cambios.length + " estilos): aplicados sin maqueta en " + (time_ms() - t0) + " ms")
        end
        return true
    end
    t1 = time_ms()
    imagenes_pedir(d.im, d.doc, d.direccion)
    if traza_activa
        traza("estilo en " + (t1 - t0) + " ms; buscar imágenes en " + (time_ms() - t1) + " ms")
    end
    if traza_activa and limite == nil and toques != nil
        for t in toques
            if t.nodo != nil and _dentro_de_nodo(t.nodo, d.doc) and maqueta_limite_de(d.pagina, t.nodo) == nil
                traza("sin caja que maquetar sola: " + t.nodo.nombre + "." + dom_atributo(t.nodo, "class") + " (toque " + t.tipo + ")")
                break
            end
        end
    end
    if traza_activa and limite != nil and not (parte and _documento_cambios_dentro(estilo_cambios, limite))
        traza("la caja no se maqueta sola: estilo entero o un estilo de fuera cambia")
    end
    if limite != nil and parte and d.ancho > 0 and _documento_cambios_dentro(estilo_cambios, limite)
        viejos = maqueta_dibujos_de(d.pagina, limite)
        nuevos = maqueta_rehacer(d.pagina, d.doc, limite)
        if traza_activa and nuevos == nil
            traza("la caja no se maqueta sola: maqueta_rehacer no puede")
        end
        if nuevos != nil
            for dib in viejos
                _documento_zona(d, dib)
            end
            for dib in nuevos
                _documento_zona(d, dib)
            end
            d.zona = not d.zona_entera
            _documento_vistas(d)
            d.maqueta_fin = time_ms()
            d.maqueta_ms = d.maqueta_fin - t0
            if traza_activa
                traza("el JavaScript hizo " + toques.length + " cambios dentro de " + limite.nombre + "." + str_replace(str_trim(dom_atributo(limite, "class")), " ", ".") + ": maquetada sola en " + (time_ms() - t0) + " ms (" + maqueta_bloques + " bloques)")
            end
            return true
        end
    end
    if d.ancho > 0
        maqueta_conservar = parte
        d.pagina = maquetar(d.doc, d.ancho)
        _documento_vistas(d)
    end
    d.maqueta_fin = time_ms()
    d.maqueta_ms = d.maqueta_fin - t0
    if traza_activa
        cuantos = 0
        if toques != nil
            cuantos = toques.length
        end
        de = "entero"
        if parte
            de = "de lo cambiado"
        end
        traza("el JavaScript hizo " + cuantos + " cambios: estilo (" + de + ") y maqueta otra vez en " + (time_ms() - t0) + " ms (" + maqueta_bloques + " bloques, " + maqueta_medidas + " medidas y " + maqueta_guardadas + " guardadas)")
    end
    return true
end

# === Cambios del JavaScript sin rehacer la maqueta (tarea 37d) ===
# GSAP, Lenis y compañía cambian a cada fotograma el atributo style de unos elementos, casi siempre solo un
# desplazamiento (transform: translate..., translate) y la opacidad. Si solo cambió eso, se mueven y se enseñan o
# esconden sus dibujos ya colocados; si no, la maqueta entera, como siempre.

var _lig_vuelta: Int = 0

# ¿Pueden ser cambios sin maqueta? Solo atributos que actúan por el estilo (class, style, id, data-*, aria-*...) y
# textos cambiados (TOQUE_CONTENIDO, que _documento_texto_igual mira después)
# ¿Un atributo que cambia lo que se maqueta o se pinta? (los demás, como name o lang, sin maqueta si el CSS no los
# nombra; tarea 37h2)
func _documento_atributo_mueve(k: String) -> Bool
    return k == "src" or k == "srcset" or k == "width" or k == "height" or k == "value" or k == "type" or k == "colspan" or k == "rowspan" or k == "size" or k == "rows" or k == "cols" or k == "hidden" or k == "open" or k == "checked" or k == "selected" or k == "alt" or k == "dir" or k == "align" or k == "valign" or k == "bgcolor" or k == "color" or k == "face" or k == "border" or k == "cellpadding" or k == "cellspacing" or k == "nowrap" or k == "poster" or k == "data" or k == "placeholder" or k == "start" or k == "reversed" or k == "multiple" or k == "disabled" or k == "viewbox" or k == "d" or k == "points" or k == "href"
end

# ¿Está dentro de un <svg> (no el <svg> mismo)? Lo de dentro no se maqueta: es parte de su imagen
func _documento_en_svg(n: Nodo) -> Bool
    p = n.padre
    while p != nil and p.tipo == DOM_ELEMENTO
        if p.nombre == "svg"
            return true
        end
        p = p.padre
    end
    return false
end

# Los <svg> con algo de dentro tocado: su imagen otra vez (un transform de un <g>, un fill...)
func _documento_svgs_tocados(d: Documento, toques: [Toque]) -> [Nodo]
    var hechos: [Nodo] = []
    if toques == nil
        return hechos
    end
    for t in toques
        p = t.nodo
        while p != nil and p.tipo == DOM_ELEMENTO and p.nombre != "svg"
            p = p.padre
        end
        if p != nil and p.tipo == DOM_ELEMENTO and p.nombre == "svg" and dom_tiene_atributo(p, "data-dashweb-svg")
            ya = false
            for h in hechos
                if h == p
                    ya = true
                end
            end
            if not ya
                hechos.push(p)
                imagenes_svg_rehacer(d.im, p)
            end
        end
    end
    return hechos
end

# La zona que cambia en la ruta ligera (tarea 37e7): la unión de los rectángulos de los dibujos tocados, antes y
# después de tocarlos (con su sombra difuminada y 2 px de margen), donde se ven con la página desplazada d.desde
# (lo fijo, en la ventana; lo de un sticky, más abajo lo que lo empuja).
func _documento_zona_vacia(d: Documento)
    d.zona_entera = false
    d.zx0 = 1000000000
    d.zy0 = 1000000000
    d.zx1 = -1000000000
    d.zy1 = -1000000000
end

func _documento_zona(d: Documento, dib: Dibujo)
    dd = d.desde
    if dib.fijo
        dd = 0
    elif dib.pega != nil
        dd = d.desde - maqueta_pega_dy(dib.pega, d.desde)
    end
    m = 2 + dib.difuso
    y = dib.y - dd
    if y + dib.alto + m <= 0 or y - m >= d.alto_vista
        return
    end
    if dib.x - m < d.zx0
        d.zx0 = dib.x - m
    end
    if y - m < d.zy0
        d.zy0 = y - m
    end
    if dib.x + dib.ancho + m > d.zx1
        d.zx1 = dib.x + dib.ancho + m
    end
    if y + dib.alto + m > d.zy1
        d.zy1 = y + dib.alto + m
    end
end

func _documento_puede_ligero(d: Documento, toques: [Toque]) -> Bool
    if toques == nil or d.pagina == nil or d.ancho <= 0 or toques.length == 0
        return false
    end
    for t in toques
        if t.nodo == nil or t.nodo.tipo != DOM_ELEMENTO
            return _lig_no("un toque sin elemento", t.nodo)
        end
        if _documento_en_svg(t.nodo)
            # (dentro de un <svg>: solo cambia su imagen, que se rasteriza otra vez: _documento_svgs_tocados)
            continue
        end
        if t.tipo == TOQUE_ATRIBUTO
            k = t.nombre
            if not (k == "class" or k == "style" or k == "id" or k == ":hover" or str_starts(k, "data-") or str_starts(k, "aria-") or not (_documento_atributo_mueve(k) or (d.hojas != nil and d.hojas.atributos_usados.has(k))))
                return _lig_no("el atributo " + k, t.nodo)
            end
        elif t.tipo != TOQUE_CONTENIDO and t.tipo != TOQUE_ENTRA and t.tipo != TOQUE_VECINO and t.tipo != TOQUE_SALE
            # (lo que entra se mira con su estilo, en _documento_sin_maqueta: si no se ve, no mueve nada)
            return _lig_no("un toque de tipo " + t.tipo, t.nodo)
        end
    end
    return true
end

# (con TRAZA: por qué los cambios del JavaScript necesitan la maqueta entera)
func _lig_no(por: String, n: Nodo) -> Bool
    if traza_activa
        quien = "?"
        if n != nil
            quien = n.nombre + "." + str_replace(str_trim(dom_atributo(n, "class")), " ", ".")
            if quien.length > 70
                quien = quien[:70]
            end
        end
        traza("maqueta entera por " + por + " en " + quien)
    end
    return false
end

# ¿Solo cambió lo que no mueve nada? Entonces se aplica sobre los dibujos (una pasada: cada dibujo suma los
# desplazamientos de los suyos que cambiaron) y da true
func _documento_sin_maqueta(d: Documento, toques: [Toque], cambios: [EstiloCambio]) -> Bool
    # primero, comprobarlo todo (sin tocar nada)
    var fuera: [Nodo] = []
    for t in toques
        if _documento_en_svg(t.nodo)
            continue
        end
        if t.tipo == TOQUE_CONTENIDO and not _documento_texto_igual(d, t.nodo, false)
            return _lig_no("un texto que cambia de forma", t.nodo)
        end
        if t.tipo == TOQUE_ENTRA and not _documento_sin_caja(t.nodo)
            return _lig_no("un elemento que entra", t.nodo)
        end
        if t.tipo == TOQUE_SALE and not _documento_sin_caja(t.nodo)
            # lo que sale sin ocupar sitio (display: none, position: absolute o fixed): se quitan sus dibujos
            q = t.quitado
            if q == nil or (q.tipo == DOM_ELEMENTO and not _documento_fuera_del_flujo(q.estilo))
                return _lig_no("un elemento que sale", t.nodo)
            end
            fuera.push(q)
        end
    end
    var dxs: [Int] = []
    var dys: [Int] = []
    for c in cambios
        n = c.nodo
        if _documento_en_svg(n)
            dxs.push(0)
            dys.push(0)
            continue
        end
        if not c.pseudo and c.viejo != nil and _val_estilo(n.estilo, "display", "") == "none" and _val_estilo(c.viejo, "display", "none") != "none" and _documento_fuera_del_flujo(c.viejo)
            # (uno absoluto o fijo que se esconde: se quitan sus dibujos)
            fuera.push(n)
            dxs.push(0)
            dys.push(0)
            continue
        end
        if not c.pseudo and _documento_sin_caja(n) and (c.viejo == nil or not c.viejo.has("display") or c.viejo["display"] == "none")
            # (uno que acaba de entrar y no se ve, como un <script>, o que ya no se veía)
            dxs.push(0)
            dys.push(0)
            continue
        end
        if c.pseudo or c.viejo == nil
            return _lig_no("un estilo nuevo o de ::before/::after", n)
        end
        for k in n.estilo.keys()
            if not _documento_ligera(k) and (not c.viejo.has(k) or c.viejo[k] != n.estilo[k])
                viejo = "(nada)"
                if c.viejo.has(k)
                    viejo = c.viejo[k]
                end
                return _lig_no(k + ": " + viejo + " -> " + n.estilo[k], n)
            end
        end
        for k in c.viejo.keys()
            if not _documento_ligera(k) and not n.estilo.has(k)
                return _lig_no(k + ": " + c.viejo[k] + " -> (nada)", n)
            end
        end
        a = _documento_traslacion(c.viejo, n)
        b = _documento_traslacion(n.estilo, n)
        if a == nil or b == nil
            return _lig_no("un transform que no es traslación", n)
        end
        dxs.push(b[0] - a[0])
        dys.push(b[1] - a[1])
    end
    # y aplicarlo
    for t in toques
        if t.tipo == TOQUE_CONTENIDO
            for dib in d.pagina.dibujos
                if dib.nodo == t.nodo
                    _documento_zona(d, dib)
                end
            end
            _documento_texto_igual(d, t.nodo, true)
            for dib in d.pagina.dibujos
                if dib.nodo == t.nodo
                    _documento_zona(d, dib)
                end
            end
        end
    end
    if fuera.length > 0
        _documento_quitar_dibujos(d, fuera)
    end
    if cambios.length == 0
        return true
    end
    _lig_vuelta = _lig_vuelta + 1
    marca = _lig_vuelta
    i = 0
    for c in cambios
        n = c.nodo
        if dxs[i] == 0 and dys[i] == 0 and (_documento_sin_caja(n) or _documento_en_svg(n))
            i = i + 1
            continue
        end
        n.lig_marca = marca
        n.lig_dx = dxs[i]
        n.lig_dy = dys[i]
        n.lig_vis = _val_estilo(c.viejo, "opacity", "1") != _val_estilo(n.estilo, "opacity", "1") or _val_estilo(c.viejo, "visibility", "visible") != _val_estilo(n.estilo, "visibility", "visible")
        if dxs[i] != 0 or dys[i] != 0
            _documento_mover_cajas(d.doc, n, dxs[i], dys[i])
        end
        i = i + 1
    end
    for dib in d.pagina.dibujos
        dx = 0
        dy = 0
        vis = false
        p = dib.nodo
        while p != nil
            if p.lig_marca == marca
                dx = dx + p.lig_dx
                dy = dy + p.lig_dy
                if p.lig_vis
                    vis = true
                end
            end
            p = p.padre
        end
        if dx != 0 or dy != 0 or vis
            _documento_zona(d, dib)
        end
        if dx != 0 or dy != 0
            maqueta_mover(dib, dx, dy)
            if dib.base
                # (un dibujo animado: su sitio de antes de animarse va con él)
                dib.bx = dib.bx + dx
                dib.by = dib.by + dy
                dib.bcx = dib.bcx + dx
                dib.bcy = dib.bcy + dy
            end
        end
        if vis
            dib.velado = maqueta_escondido(dib.nodo)
        end
        if dx != 0 or dy != 0
            _documento_zona(d, dib)
        end
    end
    return true
end

# ¿Un estilo que no ocupa sitio en el flujo (display: none, position: absolute o fixed)?
func _documento_fuera_del_flujo(e: {String: String}) -> Bool
    if e == nil
        return true
    end
    if _val_estilo(e, "display", "inline") == "none"
        return true
    end
    p = _val_estilo(e, "position", "static")
    return p == "absolute" or p == "fixed"
end

# Quita de la página los dibujos de esos nodos y de lo de dentro
func _documento_quitar_dibujos(d: Documento, nodos: [Nodo])
    # (lo que sale deja su sitio por repintar)
    _lig_vuelta = _lig_vuelta + 1
    marca = _lig_vuelta
    for n in nodos
        n.lig_fuera = marca
    end
    var quedan: [Dibujo] = []
    for dib in d.pagina.dibujos
        p = dib.nodo
        sale = false
        while p != nil
            if p.lig_fuera == marca
                sale = true
                break
            end
            p = p.padre
        end
        if not sale
            quedan.push(dib)
        else
            _documento_zona(d, dib)
        end
    end
    d.pagina.dibujos = quedan
end

# Propiedades que no mueven la maqueta (lo que se aplica sobre los dibujos, y lo que ni se ve)
# ¿No tiene caja (display: none él o uno de fuera)? Entonces entrar o cambiar no mueve nada
func _documento_sin_caja(n: Nodo) -> Bool
    p = n
    while p != nil and p.tipo == DOM_ELEMENTO
        if p.estilo != nil and p.estilo.has("display") and p.estilo["display"] == "none"
            return true
        end
        p = p.padre
    end
    return false
end

func _documento_ligera(k: String) -> Bool
    return k == "view-transition-name" or k == "view-transition-class" or k == "transform" or k == "translate" or k == "opacity" or k == "visibility" or k == "will-change" or str_starts(k, "transition") or k == "pointer-events" or k == "cursor"
end

func _documento_con_hijos(n: Nodo) -> Bool
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO or (h.tipo == DOM_TEXTO and str_trim(h.texto) != "")
            return true
        end
    end
    return false
end

# El desplazamiento de transform y translate en px, [x, y]; nil si hay algo más que desplazar (giro, escala...)
func _documento_traslacion(e: {String: String}, n: Nodo) -> [Int]
    var nada: [Int] = nil
    x = 0
    y = 0
    w = n.caja_w
    h = n.caja_h
    em = estilo_px(_val_estilo(e, "font-size", "16px"), 0, 0)
    t = str_trim(_val_estilo(e, "transform", "none"))
    if t != "none" and t != ""
        i = 0
        while i < t.length
            while i < t.length and str_code(t, i) == 32
                i = i + 1
            end
            if i >= t.length
                break
            end
            p = str_find_from(t, "(", i)
            q = str_find_from(t, ")", i)
            if p < 0 or q < p
                return nada
            end
            f = str_lower(str_trim(t[i:p]))
            var args: [String] = []
            for a in css_partir(str_replace(t[p + 1:q], " ", ","), 44)
                if str_trim(a) != ""
                    args.push(str_trim(a))
                end
            end
            if f == "translate" or f == "translate3d"
                if args.length >= 1
                    x = x + estilo_px(args[0], em, w)
                end
                if args.length >= 2
                    y = y + estilo_px(args[1], em, h)
                end
            elif f == "translatex"
                x = x + estilo_px(args[0], em, w)
            elif f == "translatey"
                y = y + estilo_px(args[0], em, h)
            elif f == "translatez"
                x = x
            elif f == "matrix" and args.length == 6
                # (con giro, en algo con hijos: el giro no se pinta, solo cuenta lo que desplaza)
                if not (_casi_uno(args[0]) and _casi_uno(args[3])) or ((args[1] != "0" or args[2] != "0") and not _documento_con_hijos(n))
                    return nada
                end
                x = x + estilo_px(args[4], em, w)
                y = y + estilo_px(args[5], em, h)
            elif (f == "rotate" or f == "rotatez" or f == "skew" or f == "skewx" or f == "skewy") and args.length >= 1 and (args[0] == "0" or args[0] == "0deg" or args[0] == "0rad" or args[0] == "0turn" or _documento_con_hijos(n))
                # (dashweb solo gira una barra suelta, sin nada dentro: lo demás no cambia al girar)
                x = x
            elif (f == "scale" or f == "scalex" or f == "scaley" or f == "scale3d") and args.length >= 1 and _casi_uno(args[0]) and (args.length < 2 or _casi_uno(args[1]))
                # (una escala entre 0,9 y 1,1 no se aplica: GSAP las pone a cada fotograma y rehacer la maqueta por
                # eso cuesta más de un segundo; se pierde ese poco de zoom)
                x = x
            else
                return nada
            end
            i = q + 1
        end
    end
    tr = str_trim(_val_estilo(e, "translate", "none"))
    if tr != "none" and tr != ""
        partes = css_partir(str_replace(tr, " ", ","), 44)
        var vals: [String] = []
        for a in partes
            if str_trim(a) != ""
                vals.push(str_trim(a))
            end
        end
        if vals.length >= 1
            x = x + estilo_px(vals[0], em, w)
        end
        if vals.length >= 2
            y = y + estilo_px(vals[1], em, h)
        end
    end
    # rotate y scale sueltos: solo si no giran ni escalan
    ro = str_trim(_val_estilo(e, "rotate", "none"))
    sc = str_trim(_val_estilo(e, "scale", "none"))
    if (ro != "none" and ro != "0deg" and ro != "0") or (sc != "none" and not _casi_uno(str_trim(css_partir(str_replace(sc, " ", ","), 44)[0])))
        return nada
    end
    return [x, y]
end

# ¿Un número entre 0,9 y 1,1? ("1", "0.95", "1.04")
func _casi_uno(v: String) -> Bool
    return v == "1" or str_starts(v, "0.9") or str_starts(v, "1.0") or v == "1.1" or str_starts(v, "1.10")
end

# Un texto que cambió sin cambiar de forma (un reloj: "08:02:13" -> "08:02:14"): si n solo tiene texto dentro, y
# sus palabras nuevas son tantas como sus dibujos de texto, y cada una mide lo mismo que la vieja, se cambian en
# los dibujos (con aplicar) y da true. Si el ancho guardado no coincide con el medido (una letra que no se sabe
# medir aquí), false.
func _documento_texto_igual(d: Documento, n: Nodo, aplicar: Bool) -> Bool
    for h in n.hijos
        if h.tipo != DOM_TEXTO
            return false
        end
    end
    var dibs: [Dibujo] = []
    # (sus otros dibujos, fondo o borde, no cambian si el texto no cambia de forma)
    for dib in d.pagina.dibujos
        if dib.nodo == n and dib.tipo == D_TEXTO
            dibs.push(dib)
        end
    end
    var palabras: [String] = []
    for t in str_split(str_replace(str_replace(dom_texto(n), "\n", " "), "\t", " "), " ")
        if t != ""
            palabras.push(_documento_mayusculas(n, t))
        end
    end
    # todo en un dibujo (white-space: nowrap o pre: la "huella" que la página va barajando)
    if dibs.length == 1 and palabras.length > 1
        junto = ""
        for t in palabras
            if junto != ""
                junto = junto + " "
            end
            junto = junto + t
        end
        var una: [String] = [junto]
        palabras = una
    end
    if dibs.length == 0 or palabras.length != dibs.length
        return false
    end
    i = 0
    while i < dibs.length
        dib = dibs[i]
        viejo = str_trim(dib.texto)
        resto = dib.texto[viejo.length:]
        if viejo.length != palabras[i].length or dib.fuente == 0
            return false
        end
        font_use(dib.fuente)
        font_style(dib.estilo)
        if font_text_width(dib.texto) + dib.espaciado * dib.texto.length != dib.ancho
            return false
        end
        nuevo = palabras[i] + resto
        ancho = font_text_width(nuevo) + dib.espaciado * nuevo.length
        if ancho != dib.ancho
            # algo más ancho o más estrecho (letras de ancho distinto: la "huella" en hexadecimal): solo en un bloque
            # con ese único texto (su caja no depende de él) y hasta 8 px; se recoloca según text-align
            dif = ancho - dib.ancho
            if dibs.length != 1 or dif > 8 or dif < -8 or _val_estilo(n.estilo, "display", "inline") != "block"
                return false
            end
            if aplicar
                alin = _val_estilo(n.estilo, "text-align", "left")
                if alin == "right" or alin == "end"
                    dib.x = dib.x - dif
                elif alin == "center"
                    dib.x = dib.x - dif / 2
                end
                dib.ancho = ancho
            end
        end
        if aplicar
            dib.texto = nuevo
        end
        i = i + 1
    end
    return true
end

func _documento_mayusculas(n: Nodo, t: String) -> String
    tt = _val_estilo(n.estilo, "text-transform", "none")
    if tt == "uppercase"
        return str_upper(t)
    elif tt == "lowercase"
        return str_lower(t)
    end
    return t
end

func _val_estilo(e: {String: String}, k: String, defecto: String) -> String
    if e.get(k, "") == ""
        return defecto
    end
    return e.get(k, defecto)
end

# Las cajas (para el JavaScript) de n y lo de dentro, movidas
func _documento_mover_cajas(doc: Nodo, n: Nodo, dx: Int, dy: Int)
    if n.caja_pase == doc.caja_pase
        n.caja_x = n.caja_x + dx
        n.caja_y = n.caja_y + dy
    end
    for h in n.hijos
        _documento_mover_cajas(doc, h, dx, dy)
    end
end

# Lo que cambió el JavaScript antes del estilo entero ya no hace falta apuntarlo
func _documento_olvidar_tocados(d: Documento)
    var nada: [Toque] = nil
    d.doc.toques = nada
end

# Las imágenes que siguen llegando (sin esperar); true si llegó alguna y se volvió a maquetar
func documento_imagenes(d: Documento) -> Bool
    if imagenes_pendientes(d.im) > 0
        d.sin_pintar = d.sin_pintar + imagenes_avanzar(d.im, d.doc)
    end
    d.sin_maquetar = d.sin_maquetar + d.im.cambiados
    d.im.cambiados = 0
    if d.sin_pintar == 0
        return false
    end
    # (la última que faltaba: ya)
    if imagenes_pendientes(d.im) > 0 and time_ms() - d.pintada < DOCUMENTO_REPINTAR
        return false
    end
    if d.sin_maquetar > 0 and d.ancho > 0
        t0 = time_ms()
        d.pagina = maquetar(d.doc, d.ancho)
        _documento_vistas(d)
        d.remaquetada = true
        if traza_activa
            traza("maquetada otra vez por " + d.sin_maquetar + " imágenes o fuentes en " + (time_ms() - t0) + " ms")
        end
    end
    d.sin_maquetar = 0
    d.sin_pintar = 0
    d.pintada = time_ms()
    return true
end

# Tras documento_imagenes: ¿hay que repintar lo que se ve (la página desde "desde", alto px)? Sí si se volvió a
# maquetar, si ya no falta ninguna o si alguna de las llegadas se dibuja ahí; las de más abajo se verán al
# desplazar (en freemem.space la página entera se repintaba 22 veces mientras llegaban)
func documento_imagenes_visibles(d: Documento, desde: Int, alto: Int) -> Bool
    r = d.remaquetada or imagenes_pendientes(d.im) == 0 or d.pagina == nil or d.im.recien == nil
    if not r
        hasta = desde + alto
        for dib in d.pagina.dibujos
            if (dib.tipo == D_IMAGEN or dib.tipo == D_FONDO) and dib.y < hasta and dib.y + dib.alto > desde and d.im.recien.has(dib.texto)
                r = true
                break
            end
        end
    end
    d.remaquetada = false
    var nada: {String: Int} = nil
    d.im.recien = nada
    return r
end

func documento_liberar(d: Documento)
    if d.recursos != nil
        recursos_cancelar(d.recursos)
    end
    imagenes_liberar(d.im)
    if d.videos != nil
        videos_liberar(d.videos)
    end
    if d.js != 0
        jsdom_peticiones_cancelar(d.js)
        js_liberar(d.js)
        d.js = 0
    end
end

# La dirección (absoluta) del enlace <a href> que contiene a n, o ""
func documento_enlace(d: Documento, n: Nodo) -> String
    p = n
    while p != nil
        if p.tipo == DOM_ELEMENTO and p.nombre == "a" and dom_tiene_atributo(p, "href")
            href = str_trim(dom_atributo(p, "href"))
            if str_starts(str_lower(href), "javascript:")
                return ""
            end
            return url_text(url_resolve(url_parse(d.direccion), href))
        end
        p = p.padre
    end
    return ""
end

# Dónde empieza en la página maquetada el elemento con ese id (o <a name>): lo más alto que pintó él o
# algo de dentro; -1 si no está o no se ve
func documento_y_de(d: Documento, id: String) -> Int
    if d.pagina == nil or id == ""
        return -1
    end
    objetivo = dom_por_id(d.doc, id)
    if objetivo == nil
        objetivo = _documento_por_nombre(d.doc, id)
    end
    if objetivo == nil
        return -1
    end
    # el borde de arriba de su caja, con su relleno (Acid2: #top lleva padding-top 2em; tarea 41a); sin caja, su
    # primer dibujo
    if d.doc.caja_pase != 0 and objetivo.caja_pase == d.doc.caja_pase and not objetivo.caja_fija
        return objetivo.caja_y
    end
    y = -1
    for dib in d.pagina.dibujos
        if dib.nodo != nil and (y < 0 or dib.y < y) and _documento_dentro(dib.nodo, objetivo)
            y = dib.y
        end
    end
    return y
end

func _documento_dentro(n: Nodo, contenedor: Nodo) -> Bool
    p = n
    while p != nil
        if p == contenedor
            return true
        end
        p = p.padre
    end
    return false
end

func _documento_por_nombre(n: Nodo, nombre: String) -> Nodo
    if n.tipo == DOM_ELEMENTO and n.nombre == "a" and dom_atributo(n, "name") == nombre
        return n
    end
    for h in n.hijos
        r = _documento_por_nombre(h, nombre)
        if r != nil
            return r
        end
    end
    var nada: Nodo = nil
    return nada
end

# "http://x/a.html#b" -> "http://x/a.html" y "b"
func documento_sin_fragmento(direccion: String) -> String
    p = str_find(direccion, "#")
    if p < 0
        return direccion
    end
    return direccion[:p]
end

func documento_fragmento(direccion: String) -> String
    p = str_find(direccion, "#")
    if p < 0
        return ""
    end
    return direccion[p + 1:]
end

# Los vídeos de la página (se crean al primer clic en uno)
func documento_videos(d: Documento) -> Videos
    if d.videos == nil
        d.videos = videos_nuevos()
    end
    return d.videos
end

# El <video> que contiene a n (o n mismo); nil si no está en uno
func documento_video_de(n: Nodo) -> Nodo
    m = n
    while m != nil
        if dom_es_video(m)
            return m
        end
        m = m.padre
    end
    var nada: Nodo = nil
    return nada
end

# El dibujo del vídeo de ese nodo en la página (para saber dónde cayó un clic); nil si no está
func documento_video_dibujo(d: Documento, n: Nodo) -> Dibujo
    if d.pagina != nil
        for dib in d.pagina.dibujos
            if dib.tipo == D_VIDEO and dib.nodo == n
                return dib
            end
        end
    end
    var nada: Dibujo = nil
    return nada
end

# La caja que se puede maquetar sola con todo lo tocado dentro (tarea 48h: maqueta_rehacer); nil si no hay. Lo
# tocado en sus atributos no puede ser ella misma (su class o su style la cambian a ella): entonces, la de fuera
func _documento_limite(d: Documento, toques: [Toque]) -> Nodo
    var nada: Nodo = nil
    if d.pagina == nil or toques == nil or toques.length == 0
        return nada
    end
    var b: Nodo = nil
    for t in toques
        if t.nodo == nil
            return nada
        end
        # (lo que ya no está en el documento, como una fila que React tocó y luego quitó, no cuenta)
        if not _dentro_de_nodo(t.nodo, d.doc)
            continue
        end
        if b == nil
            b = maqueta_limite_de(d.pagina, t.nodo)
        end
        while b != nil and not (_dentro_de_nodo(t.nodo, b) and not (t.tipo == TOQUE_ATRIBUTO and t.nodo == b))
            b = maqueta_limite_de(d.pagina, b.padre)
        end
        if b == nil
            return nada
        end
    end
    return b
end

func _dentro_de_nodo(x: Nodo, anc: Nodo) -> Bool
    while x != nil
        if x == anc
            return true
        end
        x = x.padre
    end
    return false
end

# ¿Los estilos que cambiaron son de lo de dentro de b (no de b ni de fuera)?
func _documento_cambios_dentro(cambios: [EstiloCambio], b: Nodo) -> Bool
    if cambios == nil
        return false
    end
    for c in cambios
        if c.nodo == b or not _dentro_de_nodo(c.nodo, b)
            return false
        end
    end
    return true
end
