# Cliente HTTP/1.1 y HTTPS (AmiSSL): GET con redirecciones, Content-Length, chunked y hasta el cierre.
#
#   r = http_get("http://ejemplo.org/", 15000)
#   if r.error != ""
#       Print r.error
#   end
#   Print r.estado                  # 200
#   Print r.cabeceras["content-type"]
#   html = http_texto(r)            # el cuerpo en Latin-1, según su juego de caracteres
#   r = http_a_fichero("http://ejemplo.org/logo.png", "T:logo.png", 15000)
#   Print r.bytes                   # el cuerpo va tal cual al fichero (con estado 2xx; si no, a r.cuerpo)
#
# Sin esperar (para una interfaz que no se congela): ni la consulta DNS, ni la conexión, ni la
# negociación TLS, ni recibir.
#   c = http_empezar("http://ejemplo.org/", 15000)
#   while not http_avanzar(c)                  # sigue la carga; true al acabar
#       ... la interfaz; http_fase(c), http_recibidos(c), http_total(c) para el progreso; http_cancelar(c)
#   end
#   r = c.respuesta
#
# Las cabeceras se guardan con el nombre en minúsculas. En http_get el cuerpo es texto: los
# bytes 0 pasan a espacios.

import "url.dash"
import "red.dash"
import "texto.dash"

const HTTP_MAX_REDIRECCIONES = 5
const HTTP_AGENTE = "dashweb/0.1 (AmigaOS)"

struct Respuesta
    estado: Int
    razon: String
    cabeceras: {String: String}
    cuerpo: String
    url: String
    tipo: String
    juego: String
    error: String
    bytes: Int        # bytes escritos en el fichero (http_a_fichero)
end

func _respuesta_vacia(url: String) -> Respuesta
    var c: {String: String} = {}
    return Respuesta(0, "", c, "", url, "", "", "", 0)
end

# GET de una URL, siguiendo hasta 5 redirecciones
func http_get(direccion: String, espera_ms: Int) -> Respuesta
    return _http_get(direccion, espera_ms, "")
end

# Lo mismo, con el cuerpo de una respuesta 2xx escrito tal cual en el fichero (imágenes)
func http_a_fichero(direccion: String, fichero: String, espera_ms: Int) -> Respuesta
    return _http_get(direccion, espera_ms, fichero)
end

func _http_get(direccion: String, espera_ms: Int, fichero: String) -> Respuesta
    actual = url_parse(direccion)
    for vuelta in (0..HTTP_MAX_REDIRECCIONES)
        r = _http_una(actual, espera_ms, fichero)
        if r.error != ""
            return r
        end
        es_redireccion = r.estado == 301 or r.estado == 302 or r.estado == 303 or r.estado == 307 or r.estado == 308
        if not es_redireccion or not r.cabeceras.has("location")
            return r
        end
        actual = url_resolve(actual, r.cabeceras["location"])
    end
    r = _respuesta_vacia(url_text(actual))
    r.error = "demasiadas redirecciones"
    return r
end

func _http_una(u: Url, espera_ms: Int, fichero: String) -> Respuesta
    r = _respuesta_vacia(url_text(u))
    c = _http_conectar(u, espera_ms, r)
    if c == nil
        return r
    end
    _http_leer(c, r, fichero)
    return r
end

# Conecta y manda la petición; nil (con r.error) si no se pudo
func _http_conectar(u: Url, espera_ms: Int, r: Respuesta) -> Conexion
    return _http_conectar_con(u, espera_ms, r, "GET", "", "")
end

# Con método y cuerpo (POST: el cuerpo y su Content-Type)
func _http_conectar_con(u: Url, espera_ms: Int, r: Respuesta, metodo: String, cuerpo: String, tipo: String) -> Conexion
    var c: Conexion = nil
    if u.esquema != "http" and u.esquema != "https"
        r.error = "esquema no admitido: " + u.esquema
        return c
    end
    if u.esquema == "https"
        c = red_abrir_tls(u.host, url_port(u), espera_ms)
    else
        c = red_abrir(u.host, url_port(u), espera_ms)
    end
    if c.error != ""
        r.error = c.error
        var nada: Conexion = nil
        return nada
    end
    if not red_enviar(c, _http_peticion(u, metodo, cuerpo, tipo, ""))
        r.error = c.error
        red_cerrar(c)
        var nada: Conexion = nil
        return nada
    end
    return c
end

# agente: el User-Agent ("" el de dashweb; YouTube contesta según el cliente que dice ser)
func _http_peticion(u: Url, metodo: String, cuerpo: String, tipo: String, agente: String) -> String
    ruta = u.ruta
    if ruta == ""
        ruta = "/"
    end
    if u.tiene_consulta
        ruta = ruta + "?" + u.consulta
    end
    host = u.host
    if u.puerto >= 0
        host = host + ":" + u.puerto
    end
    ua = HTTP_AGENTE
    if agente != ""
        ua = agente
    end
    peticion = metodo + " " + ruta + " HTTP/1.1\r\nHost: " + host + "\r\nUser-Agent: " + ua
    peticion = peticion + "\r\nAccept: */*\r\nAccept-Encoding: identity\r\nConnection: close"
    if metodo == "POST"
        peticion = peticion + "\r\nContent-Type: " + tipo + "\r\nContent-Length: " + cuerpo.length
    end
    return peticion + "\r\n\r\n" + cuerpo
end

# Lee la respuesta (estado, cabeceras y cuerpo, a r.cuerpo o al fichero) y cierra la conexión
func _http_leer(c: Conexion, r: Respuesta, fichero: String)
    _leer_estado(c, r)
    if r.error == ""
        _leer_cabeceras(c, r)
    end
    if r.error == ""
        f = 0
        if fichero != "" and r.estado >= 200 and r.estado < 300
            f = file_open(fichero, 1006)
            if f == 0
                r.error = "no se puede escribir " + fichero
            end
        end
        if r.error == ""
            _leer_cuerpo(c, r, f)
        end
        if f != 0
            file_close(f)
        end
    end
    red_cerrar(c)
end

# "HTTP/1.1 200 OK"
func _leer_estado(c: Conexion, r: Respuesta)
    linea = red_leer_linea(c)
    if linea == nil
        r.error = "el servidor cerró sin responder"
        if c.error != ""
            r.error = c.error
        end
        return
    end
    if not str_starts(linea, "HTTP/")
        r.error = "respuesta que no es HTTP"
        return
    end
    p = str_find(linea, " ")
    if p < 0
        r.error = "línea de estado rota"
        return
    end
    resto = linea[p + 1:]
    r.estado = Int(resto)
    q = str_find(resto, " ")
    if q >= 0
        r.razon = resto[q + 1:]
    end
end

# "Nombre: valor" hasta una línea vacía; nombres en minúsculas
func _leer_cabeceras(c: Conexion, r: Respuesta)
    linea = red_leer_linea(c)
    while linea != nil and linea != ""
        p = str_find(linea, ":")
        if p > 0
            nombre = str_lower(str_trim(linea[:p]))
            valor = str_trim(linea[p + 1:])
            if r.cabeceras.has(nombre)
                r.cabeceras[nombre] = r.cabeceras[nombre] + ", " + valor
            else
                r.cabeceras[nombre] = valor
            end
        end
        linea = red_leer_linea(c)
    end
    if linea == nil
        r.error = "cabeceras cortadas"
        return
    end
    if r.cabeceras.has("content-type")
        _tipo_y_juego(r, r.cabeceras["content-type"])
    end
end

# "text/html; charset=UTF-8" -> tipo "text/html", juego "utf-8"
func _tipo_y_juego(r: Respuesta, valor: String)
    v = str_lower(valor)
    p = str_find(v, ";")
    if p < 0
        r.tipo = str_trim(v)
        return
    end
    r.tipo = str_trim(v[:p])
    q = str_find(v, "charset=")
    if q >= 0
        j = str_trim(v[q + 8:])
        fin = str_find(j, ";")
        if fin >= 0
            j = j[:fin]
        end
        r.juego = str_replace(str_trim(j), "\"", "")
    end
end

# El cuerpo como texto en r.cuerpo, o tal cual al fichero f si no es 0
func _leer_cuerpo(c: Conexion, r: Respuesta, f: Int)
    if r.estado == 204 or r.estado == 304 or (r.estado >= 100 and r.estado < 200)
        return
    end
    codificacion = ""
    if r.cabeceras.has("transfer-encoding")
        codificacion = str_lower(r.cabeceras["transfer-encoding"])
    end
    if str_find(codificacion, "chunked") >= 0
        _leer_chunked(c, r, f)
    elif r.cabeceras.has("content-length")
        n = Int(r.cabeceras["content-length"])
        if f != 0
            r.bytes = red_copiar(c, f, n)
            if r.bytes < n
                r.error = "cuerpo cortado"
            end
        else
            r.cuerpo = red_leer(c, n)
            if r.cuerpo.length < n
                r.error = "cuerpo cortado"
            end
        end
    elif f != 0
        r.bytes = red_copiar(c, f, -1)
    else
        r.cuerpo = red_leer_todo(c)
    end
end

# Trozos: tamaño en hexadecimal, datos, salto; un trozo de tamaño 0 termina
func _leer_chunked(c: Conexion, r: Respuesta, f: Int)
    cuerpo = ""
    linea = red_leer_linea(c)
    while linea != nil
        n = str_to_int(str_trim(linea), 16)
        if n <= 0
            # cabeceras finales, hasta una línea vacía
            fin = red_leer_linea(c)
            while fin != nil and fin != ""
                fin = red_leer_linea(c)
            end
            r.cuerpo = cuerpo
            return
        end
        llegados = 0
        if f != 0
            llegados = red_copiar(c, f, n)
            r.bytes = r.bytes + llegados
        else
            trozo = red_leer(c, n)
            cuerpo = cuerpo + trozo
            llegados = trozo.length
        end
        if llegados < n
            r.cuerpo = cuerpo
            r.error = "cuerpo cortado"
            return
        end
        red_leer_linea(c)
        linea = red_leer_linea(c)
    end
    r.cuerpo = cuerpo
    r.error = "cuerpo cortado"
end

# El cuerpo en Latin-1, según su juego de caracteres (sin él: UTF-8)
func http_texto(r: Respuesta) -> String
    return texto_decodificar(r.cuerpo, r.juego)
end

# === Sin esperar ===

struct Carga
    actual: Url
    conexion: Conexion
    espera: Int            # ms sin recibir nada antes de darla por perdida
    redirecciones: Int
    hecha: Bool
    respuesta: Respuesta
    total: Int             # bytes de la respuesta entera si se sabe (Content-Length), -1 si aún no, -2 si no
    ultimo: Int            # time_ms del último dato
    fichero: String = ""   # el cuerpo de una respuesta 2xx va a este fichero (http_empezar_a_fichero)
    metodo: String = "GET"
    cuerpo: String = ""    # lo que se manda con POST
    tipo: String = ""      # su Content-Type
    agente: String = ""    # el User-Agent, si no es el de dashweb (http_con_agente)
    cabecera: Int = -1     # bytes de la línea de estado y las cabeceras, cuando ya llegaron (http_parcial)
end

func http_empezar(direccion: String, espera_ms: Int) -> Carga
    var sin: Conexion = nil
    c = Carga(url_parse(direccion), sin, espera_ms, 0, false, _respuesta_vacia(direccion), -1, time_ms())
    _carga_conectar(c)
    return c
end

# Lo mismo que http_a_fichero, sin esperar
func http_empezar_a_fichero(direccion: String, fichero: String, espera_ms: Int) -> Carga
    var sin: Conexion = nil
    c = Carga(url_parse(direccion), sin, espera_ms, 0, false, _respuesta_vacia(direccion), -1, time_ms())
    c.fichero = fichero
    _carga_conectar(c)
    return c
end

# POST sin esperar: el cuerpo (application/x-www-form-urlencoded si tipo es "")
func http_empezar_post(direccion: String, cuerpo: String, tipo: String, espera_ms: Int) -> Carga
    var sin: Conexion = nil
    c = Carga(url_parse(direccion), sin, espera_ms, 0, false, _respuesta_vacia(direccion), -1, time_ms())
    c.metodo = "POST"
    c.cuerpo = cuerpo
    c.tipo = tipo
    if tipo == ""
        c.tipo = "application/x-www-form-urlencoded"
    end
    _carga_conectar(c)
    return c
end

# La misma carga con otro User-Agent (antes de su primer http_avanzar: la petición aún no se ha mandado)
func http_con_agente(c: Carga, agente: String) -> Carga
    c.agente = agente
    return c
end

# Empieza a abrir la conexión sin esperar (http_avanzar manda la petición cuando está abierta)
func _carga_conectar(c: Carga)
    c.respuesta = _respuesta_vacia(url_text(c.actual))
    c.total = -1
    c.cabecera = -1
    c.ultimo = time_ms()
    u = c.actual
    if u.esquema != "http" and u.esquema != "https"
        c.respuesta.error = "esquema no admitido: " + u.esquema
        var nada: Conexion = nil
        c.conexion = nada
        c.hecha = true
        return
    end
    c.conexion = red_abrir_empezar(u.host, url_port(u), u.esquema == "https", c.espera)
    if c.conexion.cerrada
        c.respuesta.error = c.conexion.error
        c.hecha = true
    end
end

# Lo que hace la carga ahora: "buscando" (el nombre del servidor), "conectando", "negociando" (TLS),
# "recibiendo"; "" si acabó
func http_fase(c: Carga) -> String
    if c.hecha
        return ""
    end
    f = red_fase(c.conexion)
    if f == ""
        return "recibiendo"
    end
    return f
end

# Lee lo que haya llegado sin esperar; true cuando la respuesta está entera (o hubo error) en c.respuesta
func http_avanzar(c: Carga) -> Bool
    if c.hecha
        return true
    end
    if c.conexion.fase != 0
        abierta = red_abrir_avanzar(c.conexion)
        if abierta == 0
            return false
        end
        if abierta < 0 or not red_enviar(c.conexion, _http_peticion(c.actual, c.metodo, c.cuerpo, c.tipo, c.agente))
            c.respuesta.error = c.conexion.error
            red_cerrar(c.conexion)
            c.hecha = true
            return true
        end
        c.ultimo = time_ms()
    end
    n = red_recibir_ya(c.conexion)
    while n > 0
        c.ultimo = time_ms()
        n = red_recibir_ya(c.conexion)
    end
    if c.total == -1
        c.total = _carga_total(c.conexion)
    end
    entera = n < 0 or (c.total > 0 and red_pendientes(c.conexion) >= c.total)
    if not entera
        if time_ms() - c.ultimo > c.espera
            red_cerrar(c.conexion)
            c.respuesta.error = "tiempo agotado"
            c.hecha = true
            return true
        end
        return false
    end
    _http_leer(c.conexion, c.respuesta, c.fichero)
    r = c.respuesta
    redireccion = r.estado == 301 or r.estado == 302 or r.estado == 303 or r.estado == 307 or r.estado == 308
    if r.error == "" and redireccion and r.cabeceras.has("location")
        if c.redirecciones >= HTTP_MAX_REDIRECCIONES
            r.error = "demasiadas redirecciones"
        else
            c.redirecciones = c.redirecciones + 1
            c.actual = url_resolve(c.actual, r.cabeceras["location"])
            if r.estado != 307 and r.estado != 308
                # tras un POST, la redirección se sigue con GET (como los navegadores)
                c.metodo = "GET"
                c.cuerpo = ""
            end
            _carga_conectar(c)
            return c.hecha
        end
    end
    c.hecha = true
    return true
end

# Bytes de la respuesta ya recibidos y lo que medirá entera (-1 si no se sabe), para el progreso
func http_recibidos(c: Carga) -> Int
    if c.conexion == nil or c.conexion.fase != 0
        return 0
    end
    return red_pendientes(c.conexion)
end

func http_total(c: Carga) -> Int
    if c.total < 0
        return -1
    end
    return c.total
end

func http_cancelar(c: Carga)
    if not c.hecha
        red_cerrar(c.conexion)     # también si aún se estaba abriendo
        c.respuesta.error = "cancelada"
        c.hecha = true
    end
end

# Lo que ya ha llegado del cuerpo de una respuesta 2xx con Content-Length, para usarlo antes de que acabe
# (un vídeo que empieza mientras se baja): su dirección en el búfer de la conexión, o 0 si aún no se sabe o no
# vale (redirección, chunked). El búfer se mueve al crecer: pedirla otra vez tras cada http_avanzar. Al acabar la
# carga el búfer se libera (el cuerpo ya está en su fichero).
func http_parcial(c: Carga) -> Int
    if c.hecha or c.conexion == nil or c.conexion.fase != 0 or c.total <= 0
        return 0
    end
    if c.cabecera < 0
        c.cabecera = _carga_cabecera(c.conexion)
    end
    # "HTTP/1.1 2xx": el estado empieza en el byte 9
    if c.cabecera <= 12 or buffer_get_byte(c.conexion.buf, c.conexion.ini + 9) != 50
        return 0
    end
    return c.conexion.buf + c.conexion.ini + c.cabecera
end

# Bytes del cuerpo que ya han llegado (con http_parcial) y los que tendrá entero
func http_parcial_listos(c: Carga) -> Int
    if http_parcial(c) == 0
        return 0
    end
    return red_pendientes(c.conexion) - c.cabecera
end

func http_parcial_total(c: Carga) -> Int
    if http_parcial(c) == 0
        return 0
    end
    return c.total - c.cabecera
end

# Bytes de la línea de estado y las cabeceras (con la línea vacía), o -1 si aún no han llegado
func _carga_cabecera(c: Conexion) -> Int
    n = red_pendientes(c)
    i = 0
    while i + 3 < n
        if buffer_get_byte(c.buf, c.ini + i) == 13 and buffer_get_byte(c.buf, c.ini + i + 1) == 10 and buffer_get_byte(c.buf, c.ini + i + 2) == 13 and buffer_get_byte(c.buf, c.ini + i + 3) == 10
            return i + 4
        end
        i = i + 1
    end
    return -1
end

# Cabeceras + Content-Length cuando ya llegaron las cabeceras: el tamaño de la respuesta entera;
# -1 si aún no han llegado, -2 si no lo dicen (chunked, hasta el cierre)
func _carga_total(c: Conexion) -> Int
    n = red_pendientes(c)
    i = 0
    while i + 3 < n
        if buffer_get_byte(c.buf, c.ini + i) == 13 and buffer_get_byte(c.buf, c.ini + i + 1) == 10 and buffer_get_byte(c.buf, c.ini + i + 2) == 13 and buffer_get_byte(c.buf, c.ini + i + 3) == 10
            cabeceras = str_lower(str_from_buffer(c.buf, c.ini, i))
            p = str_find(cabeceras, "\ncontent-length:")
            if p < 0 or str_find(cabeceras, "chunked") >= 0
                return -2
            end
            fin = str_find_from(cabeceras, "\r", p + 1)
            if fin < 0
                fin = cabeceras.length
            end
            return i + 4 + Int(str_trim(cabeceras[p + 16:fin]))
        end
        i = i + 1
    end
    return -1
end

