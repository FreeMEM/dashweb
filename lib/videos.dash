# Los vídeos de una página (tarea 30): cada <video> tiene un reproductor. Un clic lo trae (por HTTP/HTTPS, a
# un fichero de T:) y lo reproduce; otro lo para. Cada vuelta del bucle, videos_avanzar decodifica hasta la
# imagen que toca según el reloj (si va con retraso, salta imágenes) y dice si hay que repintar; el pintor
# llama a videos_pintar con el recuadro del vídeo. Sin sonido todavía.
#
#   vs = videos_nuevos()
#   videos_alternar(vs, nodo_video, "https://ejemplo.org/")   # al hacer clic
#   if videos_avanzar(vs)                                   # en cada tic
#       ... repintar
#   videos_liberar(vs)

import "video.dash"
import "youtube.dash"
import "http.dash"
import "url.dash"
import "dom.dash"

const V_PARADO = 0       # aún no se ha pulsado
const V_TRAYENDO = 1
const V_SONANDO = 2
const V_PAUSA = 3
const V_FIN = 4
const V_ERROR = 5
const V_RESOLVIENDO = 6  # YouTube: buscando el MP4 del vídeo (lib/youtube.dash)

# Una imagen se puede enseñar hasta este adelanto sobre su hora: el temporizador del sistema despierta tarde
# (en la máquina RTG emulada, unos 27 ms de media) y esperar a la hora exacta la retrasa siempre
const VIDEO_ADELANTO = 30

struct Reproductor
    nodo: Nodo
    direccion: String
    fichero: String
    estado: Int = 0
    carga: Carga = nil
    yt: YouTube = nil
    v: Int = 0
    inicio: Int = 0          # time_ms() del instante 0 del vídeo (mientras suena)
    pos: Int = 0             # ms del vídeo donde se paró
    hay_imagen: Bool = false
    error: String = ""
    decodificadas: Int = 0   # desde que empezó a sonar
    mostradas: Int = 0       # las que llegaron a pintarse (las demás se saltaron por ir tarde)
    t_decodificar: Int = 0   # ms decodificando
    modo: Int = 2            # el modo de H.264 (video_rapido): 2 rápido, 3 turbo, 4 turbo+
    tics: Int = 0            # vueltas de videos_avanzar mientras suena (medida)
    fuera: Int = 0           # ms entre el final de una vuelta y el principio de la siguiente (medida)
    fin_vuelta: Int = 0
    lista: Bool = false      # una imagen decodificada que aún no ha llegado su hora
    probar_en: Int = 0       # bytes bajados con los que probar a abrirlo antes de tenerlo entero
    esperando: Bool = false  # suena mientras se baja y la imagen siguiente aún no ha llegado
    t_espera: Int = 0        # time_ms() de cuando empezó a esperar
    bajada_rota: Bool = false  # la descarga falló a medias: lo que falte ya no llegará
end

# Mientras se baja, se prueba a abrir el vídeo cada tanto (un MP4 "fast start" tiene su índice al principio:
# empieza a sonar enseguida; si lo tiene al final, cuando llegue entero)
const VIDEO_PROBAR = 262144

struct Videos
    lista: [Reproductor]
    n: Int = 0               # para los nombres de los ficheros
end

func videos_nuevos() -> Videos
    var lista: [Reproductor] = []
    return Videos(lista)
end

# El reproductor de ese <video> (nil si aún no tiene)
func videos_de(vs: Videos, n: Nodo) -> Reproductor
    for r in vs.lista
        if r.nodo == n
            return r
        end
    end
    var nadie: Reproductor = nil
    return nadie
end

# Un clic en el vídeo: traerlo y reproducirlo, pararlo o seguir
func videos_alternar(vs: Videos, n: Nodo, base: String)
    r = videos_de(vs, n)
    if r == nil
        src = video_src(n)
        if src == ""
            return
        end
        vs.n = vs.n + 1
        r = Reproductor(n, url_text(url_resolve(url_parse(base), src)), "T:dashweb_video" + vs.n)
        vs.lista.push(r)
    end
    if r.estado == V_PARADO or r.estado == V_ERROR
        r.error = ""
        if youtube_es(r.direccion)
            r.yt = youtube_empezar(r.direccion)
            r.estado = V_RESOLVIENDO
        elif str_starts(r.direccion, "http://") or str_starts(r.direccion, "https://")
            r.carga = http_empezar_a_fichero(r.direccion, r.fichero, 60000)
            r.estado = V_TRAYENDO
        else
            r.fichero = r.direccion
            _video_empezar(r)
        end
    elif r.estado == V_SONANDO
        r.pos = time_ms() - r.inicio
        video_pausa(r.v, true)
        r.estado = V_PAUSA
    elif r.estado == V_PAUSA
        r.inicio = time_ms() - r.pos
        video_pausa(r.v, false)
        r.estado = V_SONANDO
    elif r.estado == V_FIN and r.carga == nil
        video_cerrar(r.v)
        r.v = 0
        r.hay_imagen = false
        _video_empezar(r)
    end
end

func _video_empezar(r: Reproductor)
    r.v = video_abrir(r.fichero)
    if r.v == 0
        r.estado = V_ERROR
        r.error = "no se puede reproducir"
        return
    end
    _video_arrancar(r)
end

# Con el vídeo ya abierto (entero o mientras se baja): a sonar
func _video_arrancar(r: Reproductor)
    # H.264: el modo rápido (sin filtros caros); en la máquina objetivo, ~12 imágenes/s a 640x360
    video_rapido(r.v, 2)
    r.modo = 2
    r.inicio = time_ms()
    r.pos = 0
    r.decodificadas = 0
    r.mostradas = 0
    r.lista = false
    r.t_decodificar = 0
    r.estado = V_SONANDO
end

# El instante del vídeo que suena: el reloj del sonido si tiene (manda: la imagen se ajusta a él), si no el
# tiempo desde que empezó
func _ahora(r: Reproductor) -> Int
    reloj = video_reloj(r.v)
    if reloj >= 0
        return reloj
    end
    return time_ms() - r.inicio
end

# Avanza descargas y reproducción; true si algún vídeo cambió de imagen o de estado (hay que repintar).
# La imagen siguiente se decodifica por adelantado (videos_adelantar, después de pintar) y aquí solo se
# muestra cuando llega su hora; si no hay ninguna lista, se decodifica ya.
func videos_avanzar(vs: Videos) -> Bool
    cambio = false
    for r in vs.lista
        if r.estado == V_RESOLVIENDO
            if youtube_avanzar(r.yt)
                if r.yt.media != ""
                    r.carga = http_con_agente(http_empezar_a_fichero(r.yt.media, r.fichero, 60000), r.yt.agente)
                    r.estado = V_TRAYENDO
                else
                    r.estado = V_ERROR
                    r.error = r.yt.error
                end
                cambio = true
            end
        elif r.estado == V_TRAYENDO
            if http_avanzar(r.carga)
                resp = r.carga.respuesta
                r.carga = nil
                if resp.error == "" and resp.estado >= 200 and resp.estado < 300
                    _video_empezar(r)
                else
                    r.estado = V_ERROR
                    r.error = "no se pudo traer"
                end
                cambio = true
            elif _video_probar(r)
                cambio = true
            end
        elif r.estado == V_SONANDO
            if r.carga != nil
                _video_bajar(r)
            end
            if r.fin_vuelta > 0
                r.fuera = r.fuera + time_ms() - r.fin_vuelta
            end
            r.tics = r.tics + 1
            video_servicio(r.v)
            if not r.lista
                _video_decodificar(r)
            end
            if r.estado == V_SONANDO and r.lista and video_ms(r.v) <= _ahora(r) + VIDEO_ADELANTO
                r.lista = false
                r.hay_imagen = true
                r.mostradas = r.mostradas + 1
                cambio = true
            elif r.estado == V_FIN
                cambio = true
            end
            r.fin_vuelta = time_ms()
        end
    end
    return cambio
end

# Mientras se baja: ¿se puede abrir ya con lo que ha llegado? (empieza a sonar)
func _video_probar(r: Reproductor) -> Bool
    listos = http_parcial_listos(r.carga)
    if listos <= 0 or listos < r.probar_en
        return false
    end
    r.probar_en = listos + VIDEO_PROBAR
    v = video_abrir_bajando(http_parcial(r.carga), listos, http_parcial_total(r.carga))
    if v == 0
        return false
    end
    r.v = v
    _video_arrancar(r)
    return true
end

# Suena mientras se baja: lo que llega, al vídeo; al acabar, que lea del fichero (la memoria de la carga se
# libera)
func _video_bajar(r: Reproductor)
    if http_avanzar(r.carga)
        resp = r.carga.respuesta
        r.carga = nil
        if resp.error == "" and resp.estado >= 200 and resp.estado < 300
            video_bajado_fichero(r.v, r.fichero)
        else
            r.bajada_rota = true
        end
    else
        video_bajado(r.v, http_parcial(r.carga), http_parcial_listos(r.carga))
    end
end

# Después de pintar: la imagen siguiente de cada vídeo que suena, decodificada mientras se espera su hora;
# true si alguno se acabó (hay que repintarlo: el botón de volver a empezar)
func videos_adelantar(vs: Videos) -> Bool
    acabado = false
    for r in vs.lista
        if r.estado == V_SONANDO and not r.lista
            _video_decodificar(r)
            r.fin_vuelta = time_ms()
            if r.estado == V_FIN
                acabado = true
            end
        end
    end
    return acabado
end

# La siguiente imagen, decodificada; se enseña aunque llegue tarde (mejor pocas imágenes que una cada mucho).
# Si el retraso pasa de 200 ms, H.264 en turbo (no decodifica las imágenes que no sirven de referencia)
# hasta alcanzar el reloj; al alcanzarlo, otra vez el modo rápido. Turbo+ (solo las imágenes clave) no: con una
# imagen clave cada 10 s (lo normal en x264) se salta el vídeo entero.
func _video_decodificar(r: Reproductor)
    t0 = time_ms()
    s = video_siguiente(r.v)
    r.t_decodificar = r.t_decodificar + time_ms() - t0
    if s == 2 and not r.bajada_rota and r.carga != nil
        # aún no ha llegado: el vídeo se para (también su sonido) hasta que llegue
        if not r.esperando
            r.esperando = true
            r.t_espera = time_ms()
            video_pausa(r.v, true)
        end
        return
    end
    if r.esperando
        r.esperando = false
        r.inicio = r.inicio + time_ms() - r.t_espera
        video_pausa(r.v, false)
    end
    if s == 2
        r.estado = V_ERROR
        r.error = "la descarga se cortó"
        return
    end
    if s != 1
        r.estado = V_FIN
        Print "video: " + r.mostradas + " imagenes mostradas, " + r.decodificadas + " decodificadas en " + (time_ms() - r.inicio) + " ms (" + r.t_decodificar + " ms decodificando), " + video_ancho(r.v) + "x" + video_alto(r.v) + ", sonido " + video_con_sonido(r.v) + " (reloj " + video_reloj(r.v) + " ms)"
        return
    end
    r.decodificadas = r.decodificadas + 1
    r.lista = true
    retraso = _ahora(r) - video_ms(r.v)
    modo = r.modo
    if retraso > 200 and modo < 3
        modo = 3
    elif retraso <= 0
        modo = 2
    end
    if modo != r.modo and video_rapido(r.v, modo)
        r.modo = modo
    end
end

func _fps(v: Int) -> Int
    f = video_fps_mil(v)
    if f <= 0
        return 25000
    end
    return f
end

# Una línea para la barra de estado: el vídeo que suena, su segundo y las imágenes por segundo que se ven
func videos_estado(vs: Videos) -> String
    for r in vs.lista
        if r.estado == V_RESOLVIENDO
            return "Vídeo: preguntando a YouTube..."
        elif r.estado == V_TRAYENDO
            t = http_recibidos(r.carga) / 1024
            if http_total(r.carga) > 0
                return "Vídeo: trayéndolo, " + (http_recibidos(r.carga) * 100 / http_total(r.carga)) + " % de " + (http_total(r.carga) / 1024) + " KB"
            end
            return "Vídeo: trayéndolo, " + t + " KB"
        elif r.estado == V_SONANDO
            bajando = ""
            if r.carga != nil and http_parcial_total(r.carga) > 0
                bajando = " (trayéndolo, " + (http_parcial_listos(r.carga) / (http_parcial_total(r.carga) / 100 + 1)) + " %)"
            end
            if r.esperando
                return "Vídeo: esperando a que llegue" + bajando
            end
            t = time_ms() - r.inicio
            ips = 0
            if t > 0
                ips = r.mostradas * 10000 / t
            end
            return "Vídeo: " + (t / 1000) + " s, " + (ips / 10) + "," + (ips % 10) + " imágenes/s" + bajando
        end
    end
    return ""
end

# Milisegundos hasta que toca la siguiente imagen de algún vídeo que suena (1 si ya toca); -1 si no suena
# ninguno (50 mientras alguno llega)
func videos_espera(vs: Videos) -> Int
    espera = -1
    for r in vs.lista
        e = -1
        if r.estado == V_TRAYENDO or r.estado == V_RESOLVIENDO
            e = 50
        elif r.estado == V_SONANDO and r.esperando
            e = 50
        elif r.estado == V_SONANDO
            e = 1
            if r.lista
                e = video_ms(r.v) - _ahora(r) - VIDEO_ADELANTO
                if video_con_sonido(r.v) and e > 20
                    e = 20       # Paula pide búferes nuevos a menudo
                end
                if r.carga != nil and e > 50
                    e = 50       # la descarga sigue
                end
                if e < 1
                    e = 1
                end
            end
        end
        if e > 0 and (espera < 0 or e < espera)
            espera = e
        end
    end
    return espera
end

# ¿Algún vídeo suena o llega? (el bucle tiene que seguir dando tics)
func videos_activos(vs: Videos) -> Bool
    for r in vs.lista
        if r.estado == V_TRAYENDO or r.estado == V_SONANDO or r.estado == V_RESOLVIENDO
            return true
        end
    end
    return false
end

# Pinta el vídeo de ese nodo en el recuadro x, y, ancho x alto: su imagen escalada o, si aún no tiene, un
# recuadro negro con el triángulo de reproducir (y "..." mientras llega)
func videos_pintar(vs: Videos, n: Nodo, x: Int, y: Int, ancho: Int, alto: Int)
    var r: Reproductor = nil
    if vs != nil
        r = videos_de(vs, n)
    end
    videos_pintar_r(r, x, y, ancho, alto)
    if r != nil and r.hay_imagen
        _icono_completa(x + ancho - VIDEO_ESQUINA, y + alto - VIDEO_ESQUINA)
    end
end

# Lo mismo para un reproductor (la pantalla completa); r nil: el recuadro negro con el botón de reproducir
func videos_pintar_r(r: Reproductor, x: Int, y: Int, ancho: Int, alto: Int)
    if r != nil and r.hay_imagen and r.v != 0
        # con su proporción (un vídeo 4:3 en un recuadro 16:9: franjas negras a los lados), como los navegadores
        vw = video_ancho(r.v)
        vh = video_alto(r.v)
        dw = ancho
        dh = alto
        if vw > 0 and vh > 0
            if vw * alto > vh * ancho
                dh = vh * ancho / vw
            else
                dw = vw * alto / vh
            end
        end
        dx = x + (ancho - dw) / 2
        dy = y + (alto - dh) / 2
        if dw < ancho or dh < alto
            gfx_pen(color_pen(0, 0, 0))
            if dx > x
                gfx_rect(x, y, dx - 1, y + alto - 1)
                gfx_rect(dx + dw, y, x + ancho - 1, y + alto - 1)
            end
            if dy > y
                gfx_rect(x, y, x + ancho - 1, dy - 1)
                gfx_rect(x, dy + dh, x + ancho - 1, y + alto - 1)
            end
        end
        gfx_rgb_draw_scaled(video_rgb(r.v), vw, vh, dx, dy, dw, dh)
        if r.estado == V_PAUSA or r.estado == V_FIN
            _triangulo(x, y, ancho, alto)
        end
        return
    end
    gfx_pen(color_pen(0, 0, 0))
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    if r != nil and (r.estado == V_TRAYENDO or r.estado == V_RESOLVIENDO)
        gfx_pen(color_pen(255, 255, 255))
        gfx_text_at(x + ancho / 2 - 12, y + alto / 2, "...")
        return
    end
    _triangulo(x, y, ancho, alto)
    if r != nil and r.estado == V_ERROR
        gfx_pen(color_pen(255, 120, 120))
        gfx_text_at(x + 8, y + alto - 8, r.error)
    end
end

# ¿Se ve aún el cartel del vídeo? (no se ha pulsado, o falló)
func videos_sin_empezar(vs: Videos, n: Nodo) -> Bool
    if vs == nil
        return true
    end
    r = videos_de(vs, n)
    return r == nil or r.estado == V_PARADO or r.estado == V_ERROR
end

# El botón de reproducir (y el error, si lo hubo) encima del cartel
func videos_boton(vs: Videos, n: Nodo, x: Int, y: Int, ancho: Int, alto: Int)
    _triangulo(x, y, ancho, alto)
    if vs != nil
        r = videos_de(vs, n)
        if r != nil and r.estado == V_ERROR
            gfx_pen(color_pen(255, 120, 120))
            gfx_text_at(x + 8, y + alto - 8, r.error)
        end
    end
end

# El botón de pantalla completa, abajo a la derecha del vídeo: cuatro esquinas blancas
const VIDEO_ESQUINA = 24

func _icono_completa(x: Int, y: Int)
    gfx_pen(color_pen(255, 255, 255))
    a = x + 5
    b = y + 6
    c = x + VIDEO_ESQUINA - 6
    d = y + VIDEO_ESQUINA - 6
    gfx_rect(a, b, a + 4, b + 1)
    gfx_rect(a, b, a + 1, b + 4)
    gfx_rect(c - 4, b, c, b + 1)
    gfx_rect(c - 1, b, c, b + 4)
    gfx_rect(a, d - 1, a + 4, d)
    gfx_rect(a, d - 4, a + 1, d)
    gfx_rect(c - 4, d - 1, c, d)
    gfx_rect(c - 1, d - 4, c, d)
end

# ¿Cae el punto (dx, dy), relativo al recuadro del vídeo, en su botón de pantalla completa?
func videos_en_completa(vs: Videos, n: Nodo, dx: Int, dy: Int, ancho: Int, alto: Int) -> Bool
    r = videos_de(vs, n)
    return r != nil and r.hay_imagen and dx >= ancho - VIDEO_ESQUINA and dy >= alto - VIDEO_ESQUINA
end

# El botón de reproducir: un rectángulo oscuro con un triángulo blanco en el centro
func _triangulo(x: Int, y: Int, ancho: Int, alto: Int)
    r = alto / 6
    if ancho / 6 < r
        r = ancho / 6
    end
    if r < 8
        r = 8
    end
    cx = x + ancho / 2
    cy = y + alto / 2
    gfx_pen(color_pen(40, 40, 40))
    gfx_rect(cx - r, cy - r * 2 / 3, cx + r, cy + r * 2 / 3)
    # el triángulo, línea a línea (el relleno de polígonos necesita memoria de área que una zona de dibujo
    # de MUI no tiene)
    gfx_pen(color_pen(255, 255, 255))
    alto_t = r / 2
    for k in (0 - alto_t..alto_t)
        d = k
        if d < 0
            d = 0 - d
        end
        largo = (r * 5 / 6) * (alto_t - d) / alto_t
        gfx_line(cx - r / 3, cy + k, cx - r / 3 + largo, cy + k)
    end
end

func videos_liberar(vs: Videos)
    for r in vs.lista
        if r.v != 0
            video_cerrar(r.v)
            r.v = 0
        end
        if r.carga != nil
            http_cancelar(r.carga)       # (después de cerrar el vídeo: podía leer de su memoria)
        end
        if str_starts(r.fichero, "T:dashweb_video")
            file_delete(r.fichero)
        end
    end
    vs.lista.clear()
end
