# Conexiones TCP con lectura por líneas y por trozos. Toda la red va en una tarea aparte (task_start, D69 de Dash):
# allí se buscan los nombres, se conecta, se negocia TLS (AmiSSL), se envía y se recibe aunque el programa esté
# ocupado (el JavaScript de una página o una maqueta de varios segundos: antes la red se paraba entonces; tarea 42e).
# El programa no llama a ninguna función net_/tls_ (la red es de la tarea): pide y lee por una tabla en C detrás de
# un semáforo. La tarea empieza con la primera conexión y acaba sola tras red_ociosa_ms sin tráfico (cierra las
# conexiones guardadas para reusar), o con red_terminar() (el programa espera a sus tareas al acabar: llamarla antes
# si red_ociosa_ms es largo).
#
#   c = red_abrir("ejemplo.org", 80, 10000)     # tiempo límite en ms para cada espera
#   c = red_abrir_tls("ejemplo.org", 443, 10000) # lo mismo con TLS (AmiSSL), certificado comprobado
#   if c.error != ""
#       Print c.error
#   end
#   red_enviar(c, "GET / HTTP/1.0\r\n\r\n")
#   linea = red_leer_linea(c)                   # sin el salto de línea; nil al cerrarse
#   cuerpo = red_leer_todo(c)
#   red_copiar(c, fichero, n)                   # n bytes tal cual a un fichero abierto (-1: hasta el cierre)
#   n = red_recibir_ya(c)                       # lo que haya llegado, sin esperar (-1: cerrada)
#   red_cerrar(c)
#
# Abrir sin esperar:
#   c = red_abrir_empezar("ejemplo.org", 443, true, 10000)
#   while red_abrir_avanzar(c) == 0     # 1 abierta, -1 error (c.error)
#       ... la interfaz; red_fase(c) dice en qué está: "buscando", "conectando", "negociando"
#   end
#
# Lo recibido se guarda en bytes (un buffer): las líneas y los textos se sacan de ahí (los bytes 0 pasan a
# espacios) y red_copiar lleva los bytes sin tocar a un fichero (imágenes).

@header "#include <exec/semaphores.h>"
@header "#include <dos/dos.h>"

const RED_TROZO = 4096

struct Conexion
    sock: Int         # el sitio de la conexión en la tabla de la tarea (-1: ninguno)
    tls: Int          # (sin uso: la TLS es de la tarea; se deja por los que lo miran)
    espera: Int
    buf: Int          # lo recibido sin leer son los bytes [ini, fin) de buf (de cap bytes)
    cap: Int
    ini: Int
    fin: Int
    cerrada: Bool
    error: String
    fase: Int = 0     # abriéndose: 1 nombre y conexión, 2 negociación TLS; 0 abierta
    host: String = ""
    con_tls: Bool = false
    puerto: Int = 0
    empezada: Int = 0      # time_ms de cuando se pidió la conexión
    reintentos: Int = 0
end

# Sin ninguna conexión, la tarea de la red acaba tras esto (ms); dashweb lo sube y llama a red_terminar al salir
var red_ociosa_ms: Int = 2000

# === La tarea y su tabla (C) ===

@header "#define _RT_MAX 48"
@header "#define _RT_LIBRE 0"
@header "#define _RT_PEDIDA 1"
@header "#define _RT_CONECTANDO 2"
@header "#define _RT_NEGOCIANDO 3"
@header "#define _RT_ABIERTA 4"
@header "#define _RT_CERRADA 5"
@header "#define _RT_ERROR 6"
@header "typedef struct { volatile LONG estado; char host[256]; LONG puerto, con_tls, espera, sock, tls, empezada, reintentos, etapa, enviado; UBYTE *sal; LONG sal_len, sal_cap; UBYTE *ent; LONG ent_len, ent_cap; volatile LONG soltar; char error[160]; } _RtSitio;"
@header "static _RtSitio _rt[_RT_MAX]; static struct SignalSemaphore _rt_sem; static volatile LONG _rt_salir = 0, _rt_viva = 0, _rt_ociosa = 2000; static LONG _rt_sem_lista = 0; static struct Task * volatile _rt_tarea = NULL;"
@header "static void _rt_liberar(_RtSitio *s) { if (s->sal) FreeVec(s->sal); if (s->ent) FreeVec(s->ent); s->sal = s->ent = NULL; s->sal_len = s->sal_cap = s->ent_len = s->ent_cap = 0; s->soltar = 0; s->estado = _RT_LIBRE; }"

# (un servidor deja de contestar a una conexión TCP callada muchos segundos antes de la negociación TLS: se abre
# otra, como mucho dos veces)
@header "#define _RT_CALLADA_MS 5000"

@native func _rt_preparar()
"""
    if (!_rt_sem_lista) {
        InitSemaphore(&_rt_sem);
        _rt_sem_lista = 1;
    }
"""
end

# La función de la tarea: avanza todas las conexiones hasta _rt_salir o red_ociosa_ms sin ninguna
@native func _rt_bucle(arg: Int) -> Int
"""
    LONG i, ociosa = 0, hecho, activas, r, n, t;
    struct DateStamp ds;
    _rt_tarea = FindTask(NULL);
    while (!_rt_salir) {
        hecho = 0;
        activas = 0;
        DateStamp(&ds);
        t = ((LONG)ds.ds_Minute * 60 + ds.ds_Tick / 50) * 1000 + (ds.ds_Tick % 50) * 20;
        for (i = 0; i < _RT_MAX; i++) {
            _RtSitio *s = &_rt[i];
            LONG e = s->estado;
            if (e == _RT_LIBRE) continue;
            /* (las abiertas sin nada que mandar, las cerradas y las de error no la tienen viva: así acaba aunque
               el programa guarde conexiones para reusarlas, y el programa, que espera a sus tareas, también) */
            if (e < _RT_ABIERTA || (e == _RT_ABIERTA && s->sal_len > 0) || s->soltar) activas++;
            if (s->soltar) {
                if (s->tls >= 0) { _dash_tls_close(s->tls); s->tls = -1; }
                if (s->sock >= 0) { _dash_net_close(s->sock); s->sock = -1; }
                ObtainSemaphore(&_rt_sem);
                _rt_liberar(s);
                ReleaseSemaphore(&_rt_sem);
                continue;
            }
            if (e == _RT_PEDIDA) {
                /* (Dash abre como mucho _DASH_NET_PENDING a la vez: las demás esperan su turno) */
                if (_dash_net_npend >= _DASH_NET_PENDING) continue;
                s->sock = _dash_net_connect_start((STRPTR)s->host, s->puerto, s->espera);
                s->empezada = t;
                if (s->sock < 0) {
                    strncpy(s->error, (const char *)_dash_net_error(), sizeof(s->error) - 1);
                    s->estado = _RT_ERROR;
                } else s->estado = _RT_CONECTANDO;
                hecho = 1;
            } else if (e == _RT_CONECTANDO) {
                s->etapa = _dash_net_connect_stage(s->sock);
                r = _dash_net_connect_poll(s->sock);
                if (r < 0) {
                    strncpy(s->error, (const char *)_dash_net_error(), sizeof(s->error) - 1);
                    s->sock = -1;
                    s->estado = _RT_ERROR;
                    hecho = 1;
                } else if (r > 0) {
                    if (!s->con_tls) s->estado = _RT_ABIERTA;
                    else if (t - s->empezada > _RT_CALLADA_MS && s->reintentos < 2) {
                        _dash_net_close(s->sock);
                        s->reintentos++;
                        s->estado = _RT_PEDIDA;
                    } else {
                        s->tls = _dash_tls_connect_start(s->sock, (STRPTR)s->host, s->espera);
                        if (s->tls < 0) {
                            strncpy(s->error, (const char *)_dash_net_error(), sizeof(s->error) - 1);
                            _dash_net_close(s->sock);
                            s->sock = -1;
                            s->estado = _RT_ERROR;
                        } else s->estado = _RT_NEGOCIANDO;
                    }
                    hecho = 1;
                }
            } else if (e == _RT_NEGOCIANDO) {
                r = _dash_tls_connect_poll(s->tls);
                if (r < 0) {
                    strncpy(s->error, (const char *)_dash_net_error(), sizeof(s->error) - 1);
                    s->tls = -1;
                    _dash_net_close(s->sock);
                    s->sock = -1;
                    if (!strncmp(s->error, "tiempo agotado", 14) && s->reintentos < 2) {
                        s->reintentos++;
                        s->error[0] = 0;
                        s->estado = _RT_PEDIDA;
                    } else s->estado = _RT_ERROR;
                    hecho = 1;
                } else if (r > 0) {
                    s->estado = _RT_ABIERTA;
                    hecho = 1;
                }
            } else if (e == _RT_ABIERTA) {
                /* lo que haya por enviar (send espera a que salga todo) */
                if (s->sal_len > 0) {
                    UBYTE *b;
                    LONG len;
                    ObtainSemaphore(&_rt_sem);
                    b = s->sal; len = s->sal_len;
                    s->sal = NULL; s->sal_len = s->sal_cap = 0;
                    ReleaseSemaphore(&_rt_sem);
                    n = s->tls >= 0 ? _dash_tls_send_buffer(s->tls, b, len) : _dash_net_send_buffer(s->sock, b, len);
                    FreeVec(b);
                    s->enviado = 1;
                    if (n < 0) {
                        strncpy(s->error, (const char *)_dash_net_error(), sizeof(s->error) - 1);
                        s->estado = _RT_CERRADA;
                    }
                    hecho = 1;
                }
                /* lo que haya llegado, a su búfer (que crece) */
                if (s->estado == _RT_ABIERTA) {
                    ObtainSemaphore(&_rt_sem);
                    if (s->ent_cap - s->ent_len < 4096) {
                        LONG cap = s->ent_cap ? s->ent_cap * 2 : 16384;
                        UBYTE *nb = (UBYTE *)AllocVec(cap, MEMF_PUBLIC);
                        if (nb) {
                            if (s->ent) { memcpy(nb, s->ent, s->ent_len); FreeVec(s->ent); }
                            s->ent = nb;
                            s->ent_cap = cap;
                        }
                    }
                    ReleaseSemaphore(&_rt_sem);
                    if (s->ent && s->ent_cap > s->ent_len) {
                        /* (fuera del semáforo: el programa solo quita de delante y mueve lo demás con él cogido) */
                        UBYTE tmp[4096];
                        if (s->tls < 0)
                            n = _dash_net_recv_buffer(s->sock, tmp, sizeof(tmp), 0);
                        else {
                            /* sin bloqueo mientras lee: SSL_read con el socket listo puede quedarse esperando (tras el
                               saludo llegan los billetes de sesión de TLS 1.3 y luego espera la respuesta, que no
                               vendrá si la petición aún no salió) y para las demás conexiones */
                            SSL *ssl = _dash_tls_get(s->tls);
                            LONG fd, si = 1, no = 0, e = 0;
                            n = -1;
                            if (ssl) {
                                fd = SSL_get_fd(ssl);
                                n = SSL_pending(ssl) ? 1 : _dash_net_select(fd, FALSE, 0);
                                if (n > 0) {
                                    IoctlSocket(fd, FIONBIO, (char *)&si);
                                    n = SSL_read(ssl, tmp, sizeof(tmp));
                                    if (n <= 0) e = SSL_get_error(ssl, n);
                                    IoctlSocket(fd, FIONBIO, (char *)&no);
                                    if (n > 0) {
                                        if (!_dash_tls_saved[s->tls]) _dash_tls_sess_keep(s->tls);
                                    } else
                                        n = (e == SSL_ERROR_WANT_READ || e == SSL_ERROR_WANT_WRITE) ? 0 : -1;
                                }
                            }
                        }
                        if (n > 0) {
                            ObtainSemaphore(&_rt_sem);
                            if (s->ent_cap - s->ent_len >= n) {
                                memcpy(s->ent + s->ent_len, tmp, n);
                                s->ent_len += n;
                            }
                            ReleaseSemaphore(&_rt_sem);
                            hecho = 1;
                        } else if (n < 0 && !s->enviado && s->reintentos < 4) {
                            /* el servidor cerró la conexión antes de que el programa mandara nada (abierta pronto y
                               el programa ocupado: se cansó de esperar): otra */
                            if (s->tls >= 0) { _dash_tls_close(s->tls); s->tls = -1; }
                            _dash_net_close(s->sock);
                            s->sock = -1;
                            s->reintentos++;
                            s->estado = _RT_PEDIDA;
                        } else if (n < 0) {
                            s->estado = _RT_CERRADA;
                            hecho = 1;
                        }
                    }
                }
            }
        }
        if (hecho) {
            _dash_task_wake();
            ociosa = 0;
            continue;
        }
        if (activas == 0) {
            ociosa += 20;
            if (ociosa >= _rt_ociosa) break;
        } else ociosa = 0;
        Delay(1);
    }
    /* al acabar: todo cerrado en su proceso (la red se suelta con la tarea) */
    for (i = 0; i < _RT_MAX; i++) {
        _RtSitio *s = &_rt[i];
        /* (una pedida mientras acababa sigue pedida: red_abrir_avanzar arranca otra tarea) */
        if (s->estado == _RT_LIBRE || (s->estado == _RT_PEDIDA && !s->soltar)) continue;
        if (s->tls >= 0) { _dash_tls_close(s->tls); s->tls = -1; }
        if (s->sock >= 0) { _dash_net_close(s->sock); s->sock = -1; }
        ObtainSemaphore(&_rt_sem);
        if (s->estado != _RT_ERROR) { s->estado = _RT_CERRADA; if (!s->error[0]) strcpy(s->error, "red cerrada"); }
        ReleaseSemaphore(&_rt_sem);
    }
    /* las soltadas, libres (desde aquí _rt_soltar las libera él mismo) */
    ObtainSemaphore(&_rt_sem);
    _rt_viva = 0;
    for (i = 0; i < _RT_MAX; i++)
        if (_rt[i].estado != _RT_LIBRE && _rt[i].soltar) _rt_liberar(&_rt[i]);
    ReleaseSemaphore(&_rt_sem);
    _rt_tarea = NULL;
    return 0;
"""
end

@native func _rt_ociosa_poner(ms: Int)
"""
    _rt_ociosa = ms;
"""
end

@native func _rt_salir_poner(s: Bool)
"""
    _rt_salir = s ? 1 : 0;
"""
end

@native func _rt_viva_poner()
"""
    _rt_viva = 1;
"""
end

@native func _rt_esta_viva() -> Bool
"""
    return _rt_viva != 0;
"""
end

# Un sitio libre para una conexión a host:puerto; -1 si no hay
@native(borrow) func _rt_pedir(host: String, puerto: Int, con_tls: Bool, espera: Int) -> Int
"""
    LONG i;
    ObtainSemaphore(&_rt_sem);
    for (i = 0; i < _RT_MAX; i++) {
        _RtSitio *s = &_rt[i];
        if (s->estado != _RT_LIBRE) continue;
        memset(s, 0, sizeof(*s));
        strncpy(s->host, (const char *)host, sizeof(s->host) - 1);
        s->puerto = puerto;
        s->con_tls = con_tls ? 1 : 0;
        s->espera = espera;
        s->sock = -1;
        s->tls = -1;
        s->estado = _RT_PEDIDA;
        ReleaseSemaphore(&_rt_sem);
        return i;
    }
    ReleaseSemaphore(&_rt_sem);
    return -1;
"""
end

@native func _rt_estado(i: Int) -> Int
"""
    return (i >= 0 && i < _RT_MAX) ? _rt[i].estado : _RT_ERROR;
"""
end

@native func _rt_etapa(i: Int) -> Int
"""
    return (i >= 0 && i < _RT_MAX) ? _rt[i].etapa : 0;
"""
end

@native func _rt_error(i: Int) -> String
"""
    char b[160];
    b[0] = 0;
    if (i >= 0 && i < _RT_MAX) {
        ObtainSemaphore(&_rt_sem);
        strcpy(b, _rt[i].error);
        ReleaseSemaphore(&_rt_sem);
    }
    return _dash_str_dup((STRPTR)b, TRUE);
"""
end

# Pone el texto para enviar; false si no hay memoria
@native(borrow) func _rt_enviar(i: Int, texto: String) -> Bool
"""
    _RtSitio *s;
    LONG n = _dash_str_len(texto);
    if (i < 0 || i >= _RT_MAX) return FALSE;
    s = &_rt[i];
    ObtainSemaphore(&_rt_sem);
    if (s->sal_cap - s->sal_len < n) {
        LONG cap = (s->sal_len + n) * 2 + 256;
        UBYTE *nb = (UBYTE *)AllocVec(cap, MEMF_PUBLIC);
        if (!nb) { ReleaseSemaphore(&_rt_sem); return FALSE; }
        if (s->sal) { memcpy(nb, s->sal, s->sal_len); FreeVec(s->sal); }
        s->sal = nb;
        s->sal_cap = cap;
    }
    memcpy(s->sal + s->sal_len, (APTR)texto, n);
    s->sal_len += n;
    ReleaseSemaphore(&_rt_sem);
    if (_rt_tarea) Signal((struct Task *)_rt_tarea, SIGBREAKF_CTRL_F);
    return TRUE;
"""
end

# ¿Tiene un error apuntado? (para no crear un texto vacío en cada cierre)
@native func _rt_con_error(i: Int) -> Bool
"""
    return i >= 0 && i < _RT_MAX && _rt[i].error[0] != 0;
"""
end

# Hasta max bytes de lo recibido a destino: cuántos; -1 si la conexión se cerró y no queda nada
@native func _rt_recibir(i: Int, destino: Int, max: Int) -> Int
"""
    _RtSitio *s;
    LONG n;
    if (i < 0 || i >= _RT_MAX) return -1;
    s = &_rt[i];
    ObtainSemaphore(&_rt_sem);
    n = s->ent_len < max ? s->ent_len : max;
    if (n > 0) {
        memcpy((APTR)destino, s->ent, n);
        memmove(s->ent, s->ent + n, s->ent_len - n);
        s->ent_len -= n;
    } else if (s->estado == _RT_CERRADA || s->estado == _RT_ERROR) n = -1;
    ReleaseSemaphore(&_rt_sem);
    return n;
"""
end

# La tarea la cierra y deja el sitio libre
@native func _rt_soltar(i: Int)
"""
    if (i < 0 || i >= _RT_MAX) return;
    ObtainSemaphore(&_rt_sem);
    if (_rt[i].estado != _RT_LIBRE) {
        if (_rt_viva) _rt[i].soltar = 1;
        else _rt_liberar(&_rt[i]);       /* sin tarea (ya cerrada): aquí */
    }
    ReleaseSemaphore(&_rt_sem);
"""
end

var _rt_t: Int = 0

# La tarea en marcha (la empieza si no lo está)
func _rt_asegurar()
    _rt_preparar()
    if _rt_t != 0 and task_done(_rt_t)
        task_free(_rt_t)
        _rt_t = 0
    end
    if _rt_t == 0
        _rt_ociosa_poner(red_ociosa_ms)
        _rt_salir_poner(false)
        _rt_viva_poner()
        _rt_t = task_start(_rt_bucle, 0)
    end
end

# Para la tarea de la red (cierra lo que quede); el programa espera a sus tareas al acabar: llamarla antes de salir
func red_terminar()
    if _rt_t != 0
        _rt_salir_poner(true)
        task_free(_rt_t)
        _rt_t = 0
    end
end

# (nunca se llama: que el programa lleve las funciones de red de Dash, que usa el C de la tarea)
func _red_con_funciones()
    net_close(-1)
    tls_close(-1)
end

# === Conexiones ===

func red_abrir(host: String, puerto: Int, espera_ms: Int) -> Conexion
    c = red_abrir_empezar(host, puerto, false, espera_ms)
    _red_esperar_abierta(c)
    return c
end

func red_abrir_tls(host: String, puerto: Int, espera_ms: Int) -> Conexion
    c = red_abrir_empezar(host, puerto, true, espera_ms)
    _red_esperar_abierta(c)
    return c
end

func _red_esperar_abierta(c: Conexion)
    desde = time_ms()
    while red_abrir_avanzar(c) == 0
        if c.espera > 0 and time_ms() - desde > c.espera * 3
            c.error = "tiempo agotado"
            red_cerrar(c)
            return
        end
        time_delay(1)
    end
end

# Empieza a abrir la conexión y vuelve en seguida (red_abrir_avanzar la sigue)
func red_abrir_empezar(host: String, puerto: Int, con_tls: Bool, espera_ms: Int) -> Conexion
    c = Conexion(-1, -1, espera_ms, buffer_alloc(RED_TROZO * 4), RED_TROZO * 4, 0, 0, false, "")
    c.host = host
    c.con_tls = con_tls
    c.puerto = puerto
    c.empezada = time_ms()
    _rt_asegurar()
    c.sock = _rt_pedir(host, puerto, con_tls, espera_ms)
    if c.sock < 0
        c.error = "demasiadas conexiones"
        red_cerrar(c)
        return c
    end
    c.fase = 1
    return c
end

# Sigue abriendo sin esperar: 1 abierta, 0 todavía no, -1 error (c.error, y la conexión queda cerrada)
func red_abrir_avanzar(c: Conexion) -> Int
    if c.cerrada
        return -1
    end
    if c.fase == 0
        return 1
    end
    e = _rt_estado(c.sock)
    if e == 1
        _rt_asegurar()
    end
    if e == 6 or e == 5
        if _rt_con_error(c.sock)
            c.error = _rt_error(c.sock)
        else
            c.error = "conexión cerrada"
        end
        red_cerrar(c)
        return -1
    end
    if e == 4
        c.fase = 0
        return 1
    end
    if e == 3
        c.fase = 2
    end
    return 0
end

# En qué está una conexión que se abre: "buscando" (el nombre), "conectando", "negociando" (TLS); "" abierta
func red_fase(c: Conexion) -> String
    if c.cerrada or c.fase == 0
        return ""
    end
    e = _rt_estado(c.sock)
    if e == 3
        return "negociando"
    elif e == 2 and _rt_etapa(c.sock) != 0
        return "conectando"
    end
    return "buscando"
end

func red_enviar(c: Conexion, texto: String) -> Bool
    if c.cerrada
        return false
    end
    if texto.length == 0
        return true
    end
    ok = _rt_enviar(c.sock, texto)
    if not ok
        c.error = "sin memoria"
    end
    return ok
end

# Sitio para un trozo más al final del buffer: lo no leído pasa al principio (sin solaparse)
# o a un buffer más grande
func _red_sitio(c: Conexion)
    sin_leer = c.fin - c.ini
    if c.cap - c.fin >= RED_TROZO
        return
    end
    if c.ini >= sin_leer and c.cap - sin_leer >= RED_TROZO
        buffer_copy(c.buf, 0, c.buf, c.ini, sin_leer)
    else
        cap = c.cap
        while cap - sin_leer < RED_TROZO
            cap = cap * 2
        end
        nuevo = buffer_alloc(cap)
        buffer_copy(nuevo, 0, c.buf, c.ini, sin_leer)
        buffer_free(c.buf)
        c.buf = nuevo
        c.cap = cap
    end
    c.ini = 0
    c.fin = sin_leer
end

# Trae otro trozo (espera hasta c.espera); false si la conexión se cerró o no llegó nada a tiempo
func _red_traer(c: Conexion) -> Bool
    if c.cerrada
        return false
    end
    desde = time_ms()
    while true
        n = red_recibir_ya(c)
        if n > 0
            return true
        end
        if n < 0
            return false
        end
        if c.espera >= 0 and time_ms() - desde > c.espera
            c.error = "tiempo agotado"
            c.cerrada = true
            return false
        end
        time_delay(1)
    end
    return false
end

# Lo que haya llegado, sin esperar: los bytes nuevos (0 si no hay), -1 si la conexión se cerró
func red_recibir_ya(c: Conexion) -> Int
    if c.cerrada
        return -1
    end
    if c.fase != 0 and red_abrir_avanzar(c) != 1
        return 0
    end
    _red_sitio(c)
    n = _rt_recibir(c.sock, c.buf + c.fin, c.cap - c.fin)
    if n < 0
        c.cerrada = true
        if c.error == "" and _rt_con_error(c.sock)
            c.error = _rt_error(c.sock)
        end
        return -1
    end
    c.fin = c.fin + n
    return n
end

# Bytes recibidos y sin leer
func red_pendientes(c: Conexion) -> Int
    return c.fin - c.ini
end

# Los n primeros bytes sin leer como texto, y los da por leídos
func _red_sacar(c: Conexion, n: Int) -> String
    t = str_from_buffer(c.buf, c.ini, n)
    c.ini = c.ini + n
    return t
end

# Una línea sin "\r\n" ni "\n"; nil si la conexión se cerró sin dar más
func red_leer_linea(c: Conexion) -> String
    i = c.ini
    while true
        while i < c.fin
            if buffer_get_byte(c.buf, i) == 10
                fin = i
                if fin > c.ini and buffer_get_byte(c.buf, fin - 1) == 13
                    fin = fin - 1
                end
                linea = _red_sacar(c, fin - c.ini)
                c.ini = i + 1
                return linea
            end
            i = i + 1
        end
        visto = i - c.ini
        if not _red_traer(c)
            if c.fin > c.ini
                return _red_sacar(c, c.fin - c.ini)
            end
            var nada: String = nil
            return nada
        end
        i = c.ini + visto
    end
    var nunca: String = nil
    return nunca
end

# n bytes como texto (menos si la conexión se cierra antes); n < 0: hasta el cierre
func red_leer(c: Conexion, n: Int) -> String
    r = ""
    falta = n
    while falta != 0
        if c.fin == c.ini and not _red_traer(c)
            break
        end
        toma = c.fin - c.ini
        if falta > 0 and toma > falta
            toma = falta
        end
        r = r + _red_sacar(c, toma)
        if falta > 0
            falta = falta - toma
        end
    end
    return r
end

# Todo lo que llegue hasta que la conexión se cierre
func red_leer_todo(c: Conexion) -> String
    return red_leer(c, -1)
end

# n bytes tal cual al fichero abierto f (n < 0: hasta el cierre); cuántos se escribieron
func red_copiar(c: Conexion, f: Int, n: Int) -> Int
    hechos = 0
    while n < 0 or hechos < n
        if c.fin == c.ini and not _red_traer(c)
            break
        end
        toma = c.fin - c.ini
        if n >= 0 and toma > n - hechos
            toma = n - hechos
        end
        if file_write(f, c.buf + c.ini, toma) != toma
            c.error = "no se puede escribir"
            break
        end
        c.ini = c.ini + toma
        hechos = hechos + toma
    end
    return hechos
end

# Bytes sueltos que crecen (un cuerpo comprimido, que no puede pasar por un texto: tiene bytes 0)
struct Bytes
    buf: Int = 0
    n: Int = 0
    cap: Int = 0
end

func bytes_meter(b: Bytes, origen: Int, n: Int) -> Bool
    if b.n + n > b.cap
        cap = (b.n + n) * 2 + 4096
        nuevo = buffer_alloc(cap)
        if nuevo == 0
            return false
        end
        if b.buf != 0
            buffer_copy(nuevo, 0, b.buf, 0, b.n)
            buffer_free(b.buf)
        end
        b.buf = nuevo
        b.cap = cap
    end
    buffer_copy(b.buf, b.n, origen, 0, n)
    b.n = b.n + n
    return true
end

func bytes_liberar(b: Bytes)
    if b.buf != 0
        buffer_free(b.buf)
    end
    b.buf = 0
    b.n = 0
    b.cap = 0
end

# Como red_copiar, pero al final de b
func red_juntar(c: Conexion, b: Bytes, n: Int) -> Int
    hechos = 0
    while n < 0 or hechos < n
        if c.fin == c.ini and not _red_traer(c)
            break
        end
        toma = c.fin - c.ini
        if n >= 0 and toma > n - hechos
            toma = n - hechos
        end
        if not bytes_meter(b, c.buf + c.ini, toma)
            c.error = "sin memoria"
            break
        end
        c.ini = c.ini + toma
        hechos = hechos + toma
    end
    return hechos
end

func red_cerrar(c: Conexion)
    if c.buf != 0
        buffer_free(c.buf)
        c.buf = 0
    end
    if c.sock >= 0
        _rt_soltar(c.sock)
        c.sock = -1
    end
    c.cerrada = true
end
