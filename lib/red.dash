# Conexiones TCP con lectura por líneas y por trozos, sobre los builtins net_ de Dash.
#
#   c = red_abrir("ejemplo.org", 80, 10000)     # tiempo límite en ms para cada espera
#   c = red_abrir_tls("ejemplo.org", 443, 10000) # lo mismo con TLS (AmiSSL), certificado comprobado
#   if c.error != ""
#       Print c.error
#   end
#   red_enviar(c, "GET / HTTP/1.0\r\n\r\n")
#   linea = red_leer_linea(c)                   # sin el salto de línea; nil al cerrarse
#   cuerpo = red_leer_todo(c)
#   red_copiar(c, fichero, n)                   # n bytes tal cual a un fichero abierto (-1: hasta el cierre)
#   n = red_recibir_ya(c)                       # lo que haya llegado, sin esperar (-1: cerrada)
#   red_cerrar(c)
#
# Abrir sin esperar (la consulta DNS, la conexión y la negociación TLS no paran el programa):
#   c = red_abrir_empezar("ejemplo.org", 443, true, 10000)
#   while red_abrir_avanzar(c) == 0     # 1 abierta, -1 error (c.error)
#       ... la interfaz; red_fase(c) dice en qué está: "buscando", "conectando", "negociando"
#   end
#
# Lo recibido se guarda en bytes (un buffer): las líneas y los textos se sacan de ahí (los bytes 0
# pasan a espacios) y red_copiar lleva los bytes sin tocar a un fichero (imágenes).

const RED_TROZO = 4096

struct Conexion
    sock: Int
    tls: Int
    espera: Int
    buf: Int          # lo recibido sin leer son los bytes [ini, fin) de buf (de cap bytes)
    cap: Int
    ini: Int
    fin: Int
    cerrada: Bool
    error: String
    fase: Int = 0     # abriéndose sin esperar: 1 nombre y conexión, 2 negociación TLS; 0 abierta
    host: String = ""
    con_tls: Bool = false
end

func red_abrir(host: String, puerto: Int, espera_ms: Int) -> Conexion
    c = Conexion(-1, -1, espera_ms, buffer_alloc(RED_TROZO * 4), RED_TROZO * 4, 0, 0, false, "")
    c.sock = net_connect(host, puerto, espera_ms)
    if c.sock < 0
        c.error = net_error()
        red_cerrar(c)
    end
    return c
end

func red_abrir_tls(host: String, puerto: Int, espera_ms: Int) -> Conexion
    c = red_abrir(host, puerto, espera_ms)
    if c.cerrada
        return c
    end
    c.tls = tls_connect(c.sock, host)
    if c.tls < 0
        c.error = net_error()
        red_cerrar(c)
    end
    return c
end

# Empieza a abrir la conexión y vuelve en seguida (red_abrir_avanzar la sigue)
func red_abrir_empezar(host: String, puerto: Int, con_tls: Bool, espera_ms: Int) -> Conexion
    c = Conexion(-1, -1, espera_ms, buffer_alloc(RED_TROZO * 4), RED_TROZO * 4, 0, 0, false, "")
    c.host = host
    c.con_tls = con_tls
    c.sock = net_connect_start(host, puerto, espera_ms)
    if c.sock < 0
        c.error = net_error()
        red_cerrar(c)
        return c
    end
    c.fase = 1
    return c
end

# Sigue abriendo sin esperar: 1 abierta, 0 todavía no, -1 error (c.error, y la conexión queda cerrada)
func red_abrir_avanzar(c: Conexion) -> Int
    if c.cerrada
        return -1
    end
    if c.fase == 1
        r = net_connect_poll(c.sock)
        if r == 0
            return 0
        end
        if r < 0
            c.error = net_error()
            c.sock = -1          # net_connect_poll ya lo cerró
            red_cerrar(c)
            return -1
        end
        if not c.con_tls
            c.fase = 0
            return 1
        end
        c.tls = tls_connect_start(c.sock, c.host, c.espera)
        if c.tls < 0
            c.error = net_error()
            red_cerrar(c)
            return -1
        end
        c.fase = 2
    end
    if c.fase == 2
        r = tls_connect_poll(c.tls)
        if r == 0
            return 0
        end
        if r < 0
            c.error = net_error()
            c.tls = -1
            red_cerrar(c)
            return -1
        end
        c.fase = 0
    end
    return 1
end

# En qué está una conexión que se abre: "buscando" (el nombre), "conectando", "negociando" (TLS); "" abierta
func red_fase(c: Conexion) -> String
    if c.fase == 1 and net_connect_stage(c.sock) == 0
        return "buscando"
    elif c.fase == 1
        return "conectando"
    elif c.fase == 2
        return "negociando"
    end
    return ""
end

func red_enviar(c: Conexion, texto: String) -> Bool
    if c.cerrada
        return false
    end
    enviados = 0
    if c.tls >= 0
        enviados = tls_send(c.tls, texto)
    else
        enviados = net_send(c.sock, texto)
    end
    if enviados < 0
        c.error = net_error()
        return false
    end
    return true
end

# Sitio para un trozo más al final del buffer: lo no leído pasa al principio (sin solaparse)
# o a un buffer más grande
func _red_sitio(c: Conexion)
    sin_leer = c.fin - c.ini
    if c.cap - c.fin >= RED_TROZO
        return
    end
    if c.ini >= sin_leer and c.cap - sin_leer >= RED_TROZO
        buffer_copy(c.buf, 0, c.buf, c.ini, sin_leer)
    else
        cap = c.cap
        while cap - sin_leer < RED_TROZO
            cap = cap * 2
        end
        nuevo = buffer_alloc(cap)
        buffer_copy(nuevo, 0, c.buf, c.ini, sin_leer)
        buffer_free(c.buf)
        c.buf = nuevo
        c.cap = cap
    end
    c.ini = 0
    c.fin = sin_leer
end

# Trae otro trozo; false si la conexión se cerró o no llegó nada a tiempo
func _red_traer(c: Conexion) -> Bool
    if c.cerrada
        return false
    end
    _red_sitio(c)
    n = 0
    if c.tls >= 0
        n = tls_recv_buffer(c.tls, c.buf + c.fin, c.cap - c.fin, c.espera)
    else
        n = net_recv_buffer(c.sock, c.buf + c.fin, c.cap - c.fin, c.espera)
    end
    if n < 0
        c.cerrada = true
        return false
    end
    if n == 0
        c.error = "tiempo agotado"
        c.cerrada = true
        return false
    end
    c.fin = c.fin + n
    return true
end

# Lo que haya llegado, sin esperar: los bytes nuevos (0 si no hay), -1 si la conexión se cerró
func red_recibir_ya(c: Conexion) -> Int
    if c.cerrada
        return -1
    end
    _red_sitio(c)
    n = 0
    if c.tls >= 0
        n = tls_recv_buffer(c.tls, c.buf + c.fin, c.cap - c.fin, 0)
    else
        n = net_recv_buffer(c.sock, c.buf + c.fin, c.cap - c.fin, 0)
    end
    if n < 0
        c.cerrada = true
        return -1
    end
    c.fin = c.fin + n
    return n
end

# Bytes recibidos y sin leer
func red_pendientes(c: Conexion) -> Int
    return c.fin - c.ini
end

# Los n primeros bytes sin leer como texto, y los da por leídos
func _red_sacar(c: Conexion, n: Int) -> String
    t = str_from_buffer(c.buf, c.ini, n)
    c.ini = c.ini + n
    return t
end

# Una línea sin "\r\n" ni "\n"; nil si la conexión se cerró sin dar más
func red_leer_linea(c: Conexion) -> String
    i = c.ini
    while true
        while i < c.fin
            if buffer_get_byte(c.buf, i) == 10
                fin = i
                if fin > c.ini and buffer_get_byte(c.buf, fin - 1) == 13
                    fin = fin - 1
                end
                linea = _red_sacar(c, fin - c.ini)
                c.ini = i + 1
                return linea
            end
            i = i + 1
        end
        visto = i - c.ini
        if not _red_traer(c)
            if c.fin > c.ini
                return _red_sacar(c, c.fin - c.ini)
            end
            var nada: String = nil
            return nada
        end
        i = c.ini + visto
    end
    var nunca: String = nil
    return nunca
end

# n bytes como texto (menos si la conexión se cierra antes); n < 0: hasta el cierre
func red_leer(c: Conexion, n: Int) -> String
    r = ""
    falta = n
    while falta != 0
        if c.fin == c.ini and not _red_traer(c)
            break
        end
        toma = c.fin - c.ini
        if falta > 0 and toma > falta
            toma = falta
        end
        r = r + _red_sacar(c, toma)
        if falta > 0
            falta = falta - toma
        end
    end
    return r
end

# Todo lo que llegue hasta que la conexión se cierre
func red_leer_todo(c: Conexion) -> String
    return red_leer(c, -1)
end

# n bytes tal cual al fichero abierto f (n < 0: hasta el cierre); cuántos se escribieron
func red_copiar(c: Conexion, f: Int, n: Int) -> Int
    hechos = 0
    while n < 0 or hechos < n
        if c.fin == c.ini and not _red_traer(c)
            break
        end
        toma = c.fin - c.ini
        if n >= 0 and toma > n - hechos
            toma = n - hechos
        end
        if file_write(f, c.buf + c.ini, toma) != toma
            c.error = "no se puede escribir"
            break
        end
        c.ini = c.ini + toma
        hechos = hechos + toma
    end
    return hechos
end

func red_cerrar(c: Conexion)
    if c.buf != 0
        buffer_free(c.buf)
        c.buf = 0
    end
    if c.tls >= 0
        tls_close(c.tls)
        c.tls = -1
    end
    if c.sock >= 0
        net_close(c.sock)
        c.sock = -1
    end
    c.cerrada = true
end
