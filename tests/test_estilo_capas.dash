# Test: @layer y @supports (tarea 31p). Capas: la que se declara después gana aunque su selector sea más débil;
# lo de fuera de capas gana a todas; el atributo style, a todo. @supports: (propiedad: valor) con lo que dashweb
# pinta, not, and, or, paréntesis y selector().
# memcheck
# expect-out: a red b green c red d black e red f red g red h red i red j red
# expect-out: fondo url("http://ejemplo.com/a/img/f.png") url(data:image/png;base64,AAA)
# expect-out: rango none
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/estilo.dash"

Main
    c = "@layer base, utilidades; "
    c = c + "@layer utilidades { .rojo { color: red } } "
    c = c + "@layer base { #a { color: blue } #b { color: blue } } "
    c = c + "p { color: green } #c, #d, #e, #f, #g, #h, #i { color: black } "
    c = c + "@layer base { #a { color: blue } } "
    c = c + "@supports (display: grid) { #c { color: red } } "
    c = c + "@supports not (display: grid) { #d { color: red } } "
    c = c + "@supports (backdrop-filter: blur(2px)) or (color: red) { #e { color: red } } "
    c = c + "@supports (display: flex) and (not (-webkit-box-reflect: below)) { #f { color: red } } "
    c = c + "@supports selector(:has(a)) { #g { color: red } } "
    # las máscaras ya se pintan (Wikipedia pone el buen icono en @supports (mask-image: none); 42g)
    c = c + "#j { color: black } @supports (-webkit-mask-image:none) or (mask-image:none) { #j { color: red } } "
    c = c + "@layer { #h { color: blue } } #h { color: red } #i { color: blue }"
    c = c + " @media (min-width:768px) and (max-width:1023px) { #r { display: none } }"
    c = c + " #f1 { background-image: url(img/f.png) } #f2 { background-image: url(data:image/png;base64,AAA) }"
    h = "<html><head><style>" + c + "</style></head><body>"
    h = h + "<div id=a class=rojo>x</div><p id=b>x</p><p id=c>x</p><p id=d>x</p><p id=e>x</p><p id=f>x</p><p id=g>x</p><p id=j>x</p>"
    h = h + "<p id=h>x</p><p id=i style='color:red'>x</p><p id=r>x</p><p id=f1>x</p><p id=f2>x</p></body></html>"
    doc = dom_desde_html(h)
    css_vista(940, 600)
    estilo_aplicar(doc, estilo_hojas(doc, "http://ejemplo.com/a/b.html"))
    r = ""
    for id in ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"]
        r = r + " " + id + " " + dom_por_id(doc, id).estilo["color"]
    end
    Print str_trim(r)
    # las url() relativas, completas respecto a la hoja (aquí, la página); data: tal cual
    Print "fondo " + dom_por_id(doc, "f1").estilo["background-image"] + " " + dom_por_id(doc, "f2").estilo["background-image"]
    # un @media con un rango (768-1023) que no contiene ninguno de los anchos típicos: se guarda y vale a 940
    Print "rango " + dom_por_id(doc, "r").estilo["display"]
end
