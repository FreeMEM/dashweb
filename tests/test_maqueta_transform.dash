# Test: transform completo (tarea 31l). translate con % de la propia caja y con calc(), scale alrededor del centro
# y de transform-origin, scale(0) que oculta, scale(-1) que da la vuelta, matrix() sin giro, las propiedades
# sueltas translate y rotate (en turn: una barra girada 45 grados es un trazo).
# memcheck
# expect-out: a 50 10 100 20
# expect-out: b 10 30 20 20
# expect-out: c 0 60 80 80
# expect-out: e 10 115 40 10
# expect-out: f 30 120 40 10
# expect-out: g trazo
# expect-out: h -15 132 40 10
# expect-out: i 0 142 40 10
# expect-out: capa 0 157 280 30
# expect-out: img 50 50
# expect-out: img 140 70
# expect-out: img 280 140
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/maqueta.dash"

Main
    h = "<html><body style='margin:0'>"
    h = h + "<div id=a style='margin-left:100px;width:100px;height:20px;background:red;transform:translate(-50%, 10px)'></div>"
    h = h + "<div id=b style='width:40px;height:40px;background:red;transform:scale(.5)'></div>"
    h = h + "<div id=c style='width:40px;height:40px;background:red;transform-origin:left top;transform:scale(2)'></div>"
    h = h + "<div id=d style='height:10px;background:red;transform:scale(0)'></div>"
    h = h + "<div id=e style='width:40px;height:10px;background:red;translate:10px 5px'></div>"
    h = h + "<div id=f style='width:40px;height:10px;background:red;transform:matrix(1, 0, 0, 1, 30, 0)'></div>"
    h = h + "<div id=g style='width:20px;height:2px;background:red;rotate:0.125turn'></div>"
    h = h + "<div id=h style='width:40px;height:10px;background:red;transform:translateX(calc(-50% + 5px))'></div>"
    h = h + "<div id=i style='width:40px;height:10px;background:red;transform:scale(-1)'></div>"
    # (y una capa con position absolute, top y bottom y sin height: el hueco entre los dos)
    h = h + "<div style='position:relative;height:40px'><div id=capa style='position:absolute;top:5px;bottom:5px;left:0;right:0;background:navy'></div></div>"
    # (y el width/height del CSS en una <img>: el otro sale de la proporción; max-width)
    h = h + "<div><img src=a.png width=3000 height=3000 style='height:50px;width:auto'></div>"
    h = h + "<div><img src=b.png width=200 height=100 style='width:50%'></div>"
    h = h + "<div><img src=c.png width=400 height=200 style='max-width:100%;height:auto'></div>"
    h = h + "</body></html>"
    doc = dom_desde_html(h)
    estilo_aplicar(doc, estilo_hojas(doc, "prueba.html"))
    p = maquetar(doc, 280)
    for d in p.dibujos
        if d.tipo == D_IMAGEN
            Print "img " + d.ancho + " " + d.alto
        elif d.nodo != nil and dom_atributo(d.nodo, "id") != ""
            if d.tipo == D_RECT
                Print dom_atributo(d.nodo, "id") + " " + d.x + " " + d.y + " " + d.ancho + " " + d.alto
            elif d.tipo == D_TRAZO
                Print dom_atributo(d.nodo, "id") + " trazo"
            end
        end
    end
end
