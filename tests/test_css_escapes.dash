# Test: escapes de CSS en los selectores (tarea 37a1, CSS Syntax 3): "\" y un carácter (".md\:grid-cols-12",
# ".h-\[1\.35em\]", ".w-1\/2") y "\" con cifras hex (".\31 0" es la clase "10"), como los pone Tailwind; dentro de
# @layer y @media, con la especificidad de una clase, y desde querySelector.
# memcheck
# expect-out: md:grid-cols-12 | h-[1.35em] | w-1/2 | 10 | a{b} | hover:bg-x
# expect-out: a 12 b 1.35em c 50% d 10px e azul f red
# expect-out: especificidad 200
# expect-out: js: 1 1
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/jsdom.dash"

Main
    r = ""
    for s in [".md\\:grid-cols-12", ".h-\\[1\\.35em\\]", ".w-1\\/2", ".\\31 0", ".a\\{b\\}", ".hover\\:bg-x:hover"]
        sel = css_selector(s)
        if r != ""
            r = r + " | "
        end
        r = r + sel.partes[0].simple.clases[0]
    end
    Print r
    c = "@layer utilities { @media (min-width:48rem) { .md\\:grid-cols-12 { z-index: 12 } } "
    c = c + ".h-\\[1\\.35em\\] { height: 1.35em } .w-1\\/2 { width: 50% } } "
    c = c + ".\\31 0 { margin-top: 10px } .a\\{b\\} { color: azul } "
    c = c + ".x\\:y, #f { color: red }"
    h = "<html><head><style>" + c + "</style></head><body>"
    h = h + "<div id=a class='marco md:grid-cols-12'>x</div><p id=b class='h-[1.35em]'>x</p><p id=c class='w-1/2'>x</p>"
    h = h + "<p id=d class=10>x</p><p id=e class='a{b}'>x</p><p id=f>x</p></body></html>"
    doc = dom_desde_html(h)
    css_vista(940, 600)
    estilo_aplicar(doc, estilo_hojas(doc, "http://ejemplo.com/"))
    Print "a " + dom_por_id(doc, "a").estilo["z-index"] + " b " + dom_por_id(doc, "b").estilo["height"] + " c " + dom_por_id(doc, "c").estilo["width"] + " d " + dom_por_id(doc, "d").estilo["margin-top"] + " e " + dom_por_id(doc, "e").estilo["color"] + " f " + dom_por_id(doc, "f").estilo["color"]
    Print "especificidad " + css_selector(".md\\:a.h-\\[1\\.5em\\]").especificidad
    js = js_nuevo()
    jsdom_preparar(js, doc)
    Print "js: " + js_evaluar(js, "document.querySelectorAll('.md\\\\:grid-cols-12').length + ' ' + document.querySelectorAll('.h-\\\\[1\\\\.35em\\\\]').length", "t.js")
    js_liberar(js)
end
