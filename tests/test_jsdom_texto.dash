# Test: TextEncoder y TextDecoder del preludio de jsdom (tarea 28i; los pide el webpack de Next.js). UTF-8 de
# ida y vuelta con un carácter de 4 bytes, encodeInto sin partir un carácter, un trozo partido con stream,
# bytes malos (U+FFFD y fatal), el BOM, un ArrayBuffer, UTF-16LE y Latin-1. Comprobado antes contra el
# TextDecoder de Node (también con 3000 secuencias de bytes al azar). La ReadableStream del preludio (aún sin
# poner como ReadableStream: tarea 28j): enqueue y close desde start, lecturas con promesas, pull y for await.
# memcheck
# expect-out: 97,195,169,226,130,172,240,159,152,128
# expect-out: 104,111,108,97,32,241,32,8364
# expect-out: 128512
# expect-out: 2,4,97,226,130,172
# expect-out: 0,8364
# expect-out: 65533,65 TypeError
# expect-out: 65 OK utf-8 utf-8
# expect-out: 65,233 233
# expect-out: afalse bfalse undefinedtrue
# expect-out: 1,2,3,fin
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/jsdom.dash"

func cods(js: Int, expr: String) -> String
    return js_evaluar(js, "Array.prototype.map.call(" + expr + ", function (c) { return c.charCodeAt(0); }).join(',')", "t.js")
end

Main
    js = js_nuevo()
    jsdom_preparar(js, dom_desde_html("<p>x</p>"))
    Print js_evaluar(js, "Array.from(new TextEncoder().encode('a\\u00e9\\u20ac\\ud83d\\ude00')).join(',')", "t.js")
    Print cods(js, "new TextDecoder().decode(new Uint8Array([104,111,108,97,32,195,177,32,226,130,172]))")
    Print js_evaluar(js, "new TextDecoder().decode(new TextEncoder().encode('\\ud83d\\ude00')).codePointAt(0)", "t.js")
    Print js_evaluar(js, "var u = new Uint8Array(4), r = new TextEncoder().encodeInto('a\\u20acb', u); r.read + ',' + r.written + ',' + Array.from(u).join(',')", "t.js")
    Print js_evaluar(js, "var d = new TextDecoder(), a = d.decode(new Uint8Array([226,130]), {stream: true}); a.length + ',' + d.decode(new Uint8Array([172])).charCodeAt(0)", "t.js")
    Print cods(js, "new TextDecoder().decode(new Uint8Array([255,65]))") + " " + js_evaluar(js, "try { new TextDecoder('utf-8', {fatal: true}).decode(new Uint8Array([255])); 'no' } catch (e) { e.name }", "t.js")
    Print cods(js, "new TextDecoder().decode(new Uint8Array([239,187,191,65]))") + " " + js_evaluar(js, "new TextDecoder().decode(new Uint8Array([79,75]).buffer) + ' ' + new TextDecoder('UTF8').encoding + ' ' + new TextEncoder().encoding", "t.js")
    Print cods(js, "new TextDecoder('utf-16le').decode(new Uint8Array([0xFF,0xFE,65,0,233,0]))") + " " + cods(js, "new TextDecoder('latin1').decode(new Uint8Array([233]))")
    js_evaluar(js, "var R = [], o, s = new __dashweb_ReadableStream({start: function (c) { c.enqueue('a'); o = c; }}), rd = s.getReader(); rd.read().then(function (x) { R.push(x.value + x.done); return rd.read(); }).then(function (x) { R.push(x.value + x.done); return rd.read(); }).then(function (x) { R.push(String(x.value) + x.done); });", "t.js")
    js_evaluar(js, "o.enqueue('b'); o.close();", "t.js")
    Print js_evaluar(js, "R.join(' ')", "t.js")
    js_evaluar(js, "var n = 0, T = []; (async function () { for await (var v of new __dashweb_ReadableStream({pull: function (c) { n++; if (n <= 3) c.enqueue(n); else c.close(); }})) T.push(v); T.push('fin'); })();", "t.js")
    Print js_evaluar(js, "T.join(',')", "t.js")
    js_liberar(js)
end
