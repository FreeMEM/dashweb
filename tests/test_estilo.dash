# Test: lib/estilo.dash: hoja del navegador, <style>, atributo style, especificidad, orden,
# !important, herencia, inherit, atajos (margin, border, font, background), font-size en px,
# selectores con combinadores y pseudo-clases, estilo_px; el índice de selectores (clase, id, etiqueta,
# universal; ::before y :hover fuera), @media por ancho, el texto solo para lectores y css_importes. Las
# propiedades lógicas (padding-inline, margin-block, inset-inline-start...), también con var() (tarea 37f).
# memcheck
# expect-out: h1: block bold 26px rojo
# expect-out: p.nota: block 10px green italic
# expect-out: span: inline 10px green
# expect-out: em: 15px blue italic
# expect-out: li1: list-item 20px 5px 20px 5px | 1px solid red
# expect-out: li2: 0 | 2px dotted #00f
# expect-out: a: #0000ee underline
# expect-out: div#caja: 2px 4px 2px 4px fondo=#eee familia=Courier,monospace 9px
# expect-out: head: none
# expect-out: indice: b a-1 c
# expect-out: media: 600 640 no-print no-ancho
# expect-out: media 1000: true 0 640 true
# expect-out: oculto: none inline
# expect-out: importes: a.css b.css
# expect-out: lógicas: 4px 4px 2px 6px | 8px 8px | 1px 3px | 5px
# expect-out: px: 16 24 50 4 -3 10 0
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/estilo.dash"

Main
    h = "<style>h1 { color: rojo } p.nota { color: green; font-size: smaller; font-style: italic }"
    h = h + "p { color: gray !important } p.nota { color: green !important }"
    h = h + "em { font-size: 15px; color: blue } li { margin: 20px 5px; border: 1px solid red }"
    h = h + "ul > li:first-child + li { margin: 0; border: dotted 2px #00f }"
    h = h + "#caja { padding: 2px 4px; background: #eee url(x.png) no-repeat; font: 9px/12px Courier, monospace }</style>"
    h = h + "<h1>T</h1><p class=nota>a <span>b <em>c</em></span></p><ul><li>x<li>y</ul><a href=x>l</a>"
    h = h + "<div id=caja style='margin: 1px'>d</div>"
    doc = dom_desde_html(h)
    estilo_aplicar(doc, estilo_hojas(doc, "http://x/"))
    n = dom_buscar(doc, "h1")
    Print "h1: " + n.estilo["display"] + " " + n.estilo["font-weight"] + " " + n.estilo["font-size"] + " " + n.estilo["color"]
    n = dom_buscar(doc, "p")
    Print "p.nota: " + n.estilo["display"] + " " + n.estilo["font-size"] + " " + n.estilo["color"] + " " + n.estilo["font-style"]
    n = dom_buscar(doc, "span")
    Print "span: " + n.estilo["display"] + " " + n.estilo["font-size"] + " " + n.estilo["color"]
    n = dom_buscar(doc, "em")
    Print "em: " + n.estilo["font-size"] + " " + n.estilo["color"] + " " + n.estilo["font-style"]
    ul = dom_buscar(doc, "ul")
    l1 = ul.hijos[0]
    Print "li1: " + l1.estilo["display"] + " " + l1.estilo["margin-top"] + " " + l1.estilo["margin-right"] + " " + l1.estilo["margin-bottom"] + " " + l1.estilo["margin-left"] + " | " + l1.estilo["border-top-width"] + " " + l1.estilo["border-top-style"] + " " + l1.estilo["border-top-color"]
    l2 = ul.hijos[1]
    Print "li2: " + l2.estilo["margin-top"] + " | " + l2.estilo["border-left-width"] + " " + l2.estilo["border-left-style"] + " " + l2.estilo["border-left-color"]
    n = dom_buscar(doc, "a")
    Print "a: " + n.estilo["color"] + " " + n.estilo["text-decoration"]
    n = dom_por_id(doc, "caja")
    Print "div#caja: " + n.estilo["padding-top"] + " " + n.estilo["padding-right"] + " " + n.estilo["padding-bottom"] + " " + n.estilo["padding-left"] + " fondo=" + n.estilo["background-color"] + " familia=" + str_replace(n.estilo["font-family"], " ", "") + " " + n.estilo["font-size"]
    Print "head: " + dom_buscar(doc, "head").estilo["display"]
    # el índice: varias clases, id, universal, la mejor especificidad; ::before y :hover no cuentan
    h = "<style>* { margin-left: 3px } .x { color: a } .y.x { color: b } #i { margin-left: 1px } p.z { color: c }"
    h = h + " .x::before { color: no } .x:hover { color: no } div .z { margin-left: 2px }</style>"
    h = h + "<div class='x  y' id=i>a</div><div><p class=z>b</p></div>"
    doc = dom_desde_html(h)
    estilo_aplicar(doc, estilo_hojas(doc, "http://x/"))
    a = dom_por_id(doc, "i")
    b = dom_buscar(doc, "p")
    Print "indice: " + a.estilo["color"] + " a-" + a.estilo["margin-left"][:1] + " " + b.estilo["color"]
    # @media como una pantalla de 640 px
    h = "<style>p { margin-left: 0 } @media (max-width: 767px) { p { margin-left: 600px } }"
    h = h + " @media screen and (min-width: 37.5em) { p { margin-right: 640px } } @media print { p { color: x } }"
    h = h + " @media (min-width: 1024px) { p { color: ancho } }</style><p>m</p>"
    doc = dom_desde_html(h)
    estilo_aplicar(doc, estilo_hojas(doc, "http://x/"))
    p = dom_buscar(doc, "p")
    color = "no-print no-ancho"
    if p.estilo.has("color") and p.estilo["color"] != "black"
        color = p.estilo["color"]
    end
    Print "media: " + p.estilo["margin-left"][:3] + " " + p.estilo["margin-right"][:3] + " " + color
    # con la página a 1000 px: max-width 767 deja de valer (el estilo cambia) y min-width 1024 sigue sin valer
    hojas = estilo_hojas(doc, "http://x/")
    cambia = estilo_cambia_con(hojas, 1000)
    css_vista(1000, 700)
    estilo_aplicar(doc, hojas)
    p = dom_buscar(doc, "p")
    Print "media 1000: " + cambia + " " + p.estilo["margin-left"][:1] + " " + p.estilo["margin-right"][:3] + " " + estilo_cambia_con(hojas, 1100)
    css_vista(640, 480)
    h = "<style>.sr { position: absolute; clip: rect(1px, 1px, 1px, 1px); width: 1px } .ab { position: absolute; width: auto; height: auto }</style>"
    h = h + "<a class=sr href=#c>Saltar</a><span class=ab>v</span>"
    doc = dom_desde_html(h)
    estilo_aplicar(doc, estilo_hojas(doc, "http://x/"))
    Print "oculto: " + dom_buscar(doc, "a").estilo["display"] + " " + dom_buscar(doc, "span").estilo["display"]
    importes = css_importes("@charset \"utf-8\"; /* x */ @import url(a.css); @import \"b.css\" screen; p { } @import url(c.css);")
    r = ""
    for i in importes
        r = r + " " + i
    end
    Print "importes:" + r
    h = "<style>:root { --s: 4px } .l { padding-inline: var(--s); padding-block: 2px 6px; margin-inline: auto; margin-block: 8px }"
    h = h + " .m { position: absolute; inset-inline: 1px 3px; inset-block-start: 5px }</style><div class=l id=l>a</div><div class=m id=m>b</div>"
    doc = dom_desde_html(h)
    estilo_aplicar(doc, estilo_hojas(doc, "http://x/"))
    l = dom_por_id(doc, "l")
    m = dom_por_id(doc, "m")
    Print "lógicas: " + l.estilo["padding-left"] + " " + l.estilo["padding-right"] + " " + l.estilo["padding-top"] + " " + l.estilo["padding-bottom"] + " | " + l.estilo["margin-top"] + " " + l.estilo["margin-bottom"] + " | " + m.estilo["left"] + " " + m.estilo["right"] + " | " + m.estilo["top"]
    Print "px: " + estilo_px("1em", 16, 0) + " " + estilo_px("1.5em", 16, 0) + " " + estilo_px("50%", 0, 100) + " " + estilo_px("3pt", 0, 0) + " " + estilo_px("-3px", 0, 0) + " " + estilo_px("10", 0, 0) + " " + estilo_px("auto", 0, 0)
end
