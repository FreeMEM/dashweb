# expect-out: 404 0 bytes [no]

import "../lib/http.dash"

# Cuántos bytes tiene el fichero, su suma y cuántos son 0
func resumen(fichero: String) -> String
    f = file_open(fichero, 1005)
    if f == 0
        return "sin fichero"
    end
    n = 0
    suma = 0
    ceros = 0
    b = file_read_byte(f)
    while b >= 0
        n = n + 1
        suma = suma + b
        if b == 0
            ceros = ceros + 1
        end
        b = file_read_byte(f)
    end
    file_close(f)
    return "" + n + " " + suma + " " + ceros
end

Main
    base = "http://127.0.0.1:40851"
    r = http_get(base + "/hola", 5000)
    Print "" + r.estado + " " + r.razon + " " + r.tipo + " [" + r.cuerpo + "]"
    r = http_get(base + "/chunked", 5000)
    Print "" + r.estado + " " + r.tipo + " " + r.juego + " [" + r.cuerpo + "]"
    r = http_get(base + "/utf8", 5000)
    Print http_texto(r)
    r = http_get(base + "/redir", 5000)
    Print "" + r.estado + " [" + r.cuerpo + "] " + r.url
    r = http_get(base + "/redir2", 5000)
    Print "" + r.estado + " [" + r.cuerpo + "]"
    r = http_get(base + "/bucle", 5000)
    Print r.error
    r = http_get(base + "/no", 5000)
    Print "" + r.estado + " " + r.cabeceras["set-cookie"]
    r = http_get(base + "/cerrar", 5000)
    Print "" + r.estado + " " + r.cuerpo.length + " " + r.cuerpo[4999]
    r = http_get(base + "/eco?x=1#frag", 5000)
    Print "[" + str_trim(r.cuerpo) + "]"
    r = http_get("ftp://127.0.0.1/", 5000)
    Print r.error
    r = http_get("http://127.0.0.1:1/", 3000)
    Print r.error
    # el cuerpo tal cual a un fichero (bytes 0 incluidos), con longitud y por trozos
    r = http_a_fichero(base + "/binario", "T:binario", 5000)
    Print "binario " + r.estado + " " + r.bytes + " bytes: " + resumen("T:binario")
    r = http_a_fichero(base + "/binario_chunked", "T:binario2", 5000)
    Print "binario " + r.estado + " " + r.bytes + " bytes: " + resumen("T:binario2")
    r = http_a_fichero(base + "/no", "T:nada", 5000)
    Print "" + r.estado + " " + r.bytes + " bytes [" + r.cuerpo + "]"
end
