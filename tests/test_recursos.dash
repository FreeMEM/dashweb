# Test: lib/recursos.dash. Las hojas CSS (y sus @import, que se descubren al llegar) y los <script src>
# de una página se traen a la vez y sin esperar; después el estilo y los scripts usan esos textos sin
# volver a pedirlos. Un recurso que no existe queda como "".
# emu-server: http.py 40857
# memcheck
# expect-out: faltan al empezar: 3
# expect-out: traídos: 4
# expect-out: estilo.css: 37 bytes, imp.css: 20 bytes, js_simple.js: 33 bytes, no.css: []
# expect-out: p: teal em: olive
# expect-out: script traído
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/recursos.dash"
import "../lib/jsdom.dash"

@native(borrow) func esperar(ticks: Int)
"""
    Delay(ticks);
"""
end

Main
    base = "http://127.0.0.1:40857/pages/x.html"
    doc = dom_desde_html("<head><link rel=stylesheet href=/estilo.css><link rel=stylesheet href=no.css><script src=js_simple.js></script></head><body><p>a <em>b</em></p></body>")
    r = recursos_nuevos()
    recursos_del_documento(r, doc, base)
    Print "faltan al empezar: " + recursos_pendientes(r)
    vueltas = 0
    while recursos_pendientes(r) > 0 and vueltas < 500
        recursos_avanzar(r)
        esperar(1)
        vueltas = vueltas + 1
    end
    Print "traídos: " + r.traidos.length
    t = r.traidos
    Print "estilo.css: " + t["http://127.0.0.1:40857/estilo.css"].length + " bytes, imp.css: " + t["http://127.0.0.1:40857/imp.css"].length + " bytes, js_simple.js: " + t["http://127.0.0.1:40857/pages/js_simple.js"].length + " bytes, no.css: [" + t["http://127.0.0.1:40857/pages/no.css"] + "]"
    estilo_aplicar(doc, estilo_hojas_con(doc, base, r.traidos))
    p = dom_buscar(doc, "p")
    em = dom_buscar(doc, "em")
    Print "p: " + p.estilo["color"] + " em: " + em.estilo["color"]
    js = js_nuevo()
    jsdom_preparar(js, doc)
    jsdom_ejecutar_scripts_con(js, doc, base, r.traidos)
    Print js_evaluar(js, "desde_src", "x")
    js_liberar(js)
    recursos_cancelar(r)
end
