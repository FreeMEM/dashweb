# Test: las tarjetas de xataka.com (tarea 42e): un <a> de alto 0 con padding-top (la proporción) y dentro un <picture>
# con su <img> absoluto al 100 % de ancho y alto: la imagen va arriba, encima del relleno y de su tamaño (antes iba
# en la línea, debajo de la caja). Un absoluto dentro de algo en línea no es una pieza de la línea. Con top y bottom y
# sin height, lo de en medio.
# memcheck
# expect-out: tarjeta: 0,0 344x258 | caja 258
# expect-out: dentro de un span: 10,5 20x30 | sin línea: true
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0
import "../lib/documento.dash"

func pagina(cuerpo: String) -> Pagina
    doc = dom_desde_html5("<!DOCTYPE html><html><body style='margin:0'>" + cuerpo + "</body></html>")
    estilo_aplicar(doc, estilo_hojas(doc, "http://x/"))
    return maquetar(doc, 800)
end

func imagen(p: Pagina) -> String
    for d in p.dibujos
        if d.tipo == D_IMAGEN
            return "" + d.x + "," + d.y + " " + d.ancho + "x" + d.alto
        end
    end
    return "?"
end

Main
    p = pagina("<div style='width:344px'><a href='x' style='display:block;position:relative;width:100%;height:0;padding:75% 0 0;overflow:hidden'><picture><source media='(min-width: 1360px)' srcset='g.jpeg'><img src='p.jpeg' width=375 height=142 style='position:absolute;display:block;width:100%;height:100%;object-fit:cover;left:0;right:0;top:0;bottom:0;margin:auto'></picture></a></div>")
    Print "tarjeta: " + imagen(p) + " | caja " + p.alto
    p2 = pagina("<div style='position:relative;width:100px;height:40px'><span>x<img src='q.png' style='position:absolute;left:10px;top:5px;bottom:5px;width:20px'></span></div>")
    texto = 0
    for d in p2.dibujos
        if d.tipo == D_TEXTO
            texto = texto + 1
        end
    end
    Print "dentro de un span: " + imagen(p2) + " | sin línea: " + (texto == 1 and p2.alto == 40)
end
