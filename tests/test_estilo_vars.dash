# Test: lib/estilo.dash más rápido (tarea 26): las propiedades --x van aparte y un hijo comparte las de su
# padre mientras no cambien (un *{--x} que repite el mismo valor no copia nada); una --x que ningún var()
# nombra no se guarda, salvo en el atributo style; var() con respaldo, anidado y en otra --x; los atajos
# partidos una vez por regla (margin, border) con el orden de las declaraciones, y con var() después de
# sustituirla (también en el atributo style); un ::before solo si su
# regla con content se cumple; estilo_px con unidades en mayúsculas y blancos. Un atajo con var() compite en la
# cascada con lo suelto: el padding: 0 de * no le gana al de una clase; dentro de la regla, lo de después gana (37f).
# Una --x con var() de otra del mismo elemento, en cualquier orden (37g). Una --x que se nombra a sí misma (Wikipedia:
# --font-size-medium: var(--font-size-medium, 1rem)) es un ciclo: no vale, font-size: var(--x) se queda en el heredado
# y un var(--x, 3px) toma el respaldo (41a3).
# memcheck
# expect-out: a: rgb(1,2,3) 4px
# expect-out: b: red 4px
# expect-out: c: blue 7px
# expect-out: d: green 2px 9px 1px dashed
# expect-out: borde: 3px dashed #123
# expect-out: before: 1 0
# expect-out: cascada: 4px | 1px 4px
# expect-out: en orden: ana, serif
# expect-out: px: 32 12 0 5
# expect-out: ciclo: 20px 3px
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/estilo.dash"

Main
    h = "<style>:root { --c: rgb(1,2,3); --m: 4px; --nadie: 9px } * { --t: 0 } .b { --c: red }"
    h = h + " .c { --c: var(--azul, blue); --m: 7px } p { color: var(--c); margin-left: var(--m) }"
    h = h + " .d { margin: 1px; margin-right: 2px; padding: var(--falta, 9px) 1px } .d p { color: var(--v) }"
    h = h + " .e { border: 1px solid; border-width: 3px; border-style: dashed; border-color: #123 }"
    h = h + " .x::before { content: 'x' } .y::before { color: red }</style>"
    h = h + "<p id=a>a</p><div class=b><p id=b>b</p></div><div class=c><p id=c>c</p></div>"
    h = h + "<div class=d style='--v: green; border: var(--b, 3px dashed #123)'><p id=d>d</p></div><div class=e>e</div>"
    h = h + "<span class=x>1</span><span class=y>2</span>"
    doc = dom_desde_html(h)
    estilo_aplicar(doc, estilo_hojas(doc, "http://x/"))
    for id in ["a", "b", "c"]
        n = dom_por_id(doc, id)
        Print id + ": " + n.estilo["color"] + " " + n.estilo["margin-left"]
    end
    d = dom_por_id(doc, "d")
    caja = d.padre
    Print "d: " + d.estilo["color"] + " " + caja.estilo["margin-right"] + " " + caja.estilo["padding-top"] + " " + caja.estilo["padding-left"] + " " + caja.estilo["border-top-style"]
    e = dom_buscar(doc, "div")
    for div in [dom_buscar(doc, "body")]
        for h2 in div.hijos
            if h2.tipo == DOM_ELEMENTO and dom_atributo(h2, "class") == "e"
                e = h2
            end
        end
    end
    Print "borde: " + e.estilo["border-top-width"] + " " + e.estilo["border-left-style"] + " " + e.estilo["border-bottom-color"]
    x = 0
    y = 0
    for s in dom_buscar(doc, "body").hijos
        if s.tipo == DOM_ELEMENTO and s.nombre == "span"
            if dom_atributo(s, "class") == "x" and s.pseudo_antes != nil
                x = 1
            end
            if dom_atributo(s, "class") == "y" and s.pseudo_antes != nil
                y = 1
            end
        end
    end
    Print "before: " + x + " " + y
    h = "<style>:root { --m: 4px } * { padding: 0 } .f { padding: var(--m) } .g { padding: var(--m); padding-left: 1px }</style>"
    h = h + "<div id=f class=f>f</div><div id=g class=g>g</div>"
    doc = dom_desde_html(h)
    estilo_aplicar(doc, estilo_hojas(doc, "http://x/"))
    g = dom_por_id(doc, "g")
    h = "<style>html { --b: var(--a), serif; --a: ana } p { font-family: var(--b) }</style><p id=p>x</p>"
    doc3 = dom_desde_html(h)
    estilo_aplicar(doc3, estilo_hojas(doc3, "http://x/"))
    orden = "en orden: " + dom_por_id(doc3, "p").estilo["font-family"]
    Print "cascada: " + dom_por_id(doc, "f").estilo["padding-left"] + " | " + g.estilo["padding-left"] + " " + g.estilo["padding-right"]
    Print orden
    Print "px: " + estilo_px(" 2EM ", 16, 0) + " " + estilo_px("12PX", 0, 0) + " " + estilo_px("3zz", 0, 0) + " " + estilo_px("50%", 0, 10)
    h = "<style>html { --c: var(--c, 1rem); --d: var(--e); --e: var(--d, 2px) } body { font-size: 20px } p { font-size: var(--c); padding-left: var(--d, 3px) }</style><p id=p>x</p>"
    doc4 = dom_desde_html(h)
    estilo_aplicar(doc4, estilo_hojas(doc4, "http://x/"))
    p4 = dom_por_id(doc4, "p")
    Print "ciclo: " + p4.estilo["font-size"] + " " + p4.estilo["padding-left"]
end
