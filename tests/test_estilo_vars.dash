# Test: lib/estilo.dash más rápido (tarea 26): las propiedades --x van aparte y un hijo comparte las de su
# padre mientras no cambien (un *{--x} que repite el mismo valor no copia nada); una --x que ningún var()
# nombra no se guarda, salvo en el atributo style; var() con respaldo, anidado y en otra --x; los atajos
# partidos una vez por regla (margin, border) con el orden de las declaraciones; un ::before solo si su
# regla con content se cumple; estilo_px con unidades en mayúsculas y blancos.
# memcheck
# expect-out: a: rgb(1,2,3) 4px
# expect-out: b: red 4px
# expect-out: c: blue 7px
# expect-out: d: green 2px 9px
# expect-out: borde: 3px dashed #123
# expect-out: before: 1 0
# expect-out: px: 32 12 0 5
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/estilo.dash"

Main
    h = "<style>:root { --c: rgb(1,2,3); --m: 4px; --nadie: 9px } * { --t: 0 } .b { --c: red }"
    h = h + " .c { --c: var(--azul, blue); --m: 7px } p { color: var(--c); margin-left: var(--m) }"
    h = h + " .d { margin: 1px; margin-right: 2px; padding-top: var(--falta, 9px) } .d p { color: var(--v) }"
    h = h + " .e { border: 1px solid; border-width: 3px; border-style: dashed; border-color: #123 }"
    h = h + " .x::before { content: 'x' } .y::before { color: red }</style>"
    h = h + "<p id=a>a</p><div class=b><p id=b>b</p></div><div class=c><p id=c>c</p></div>"
    h = h + "<div class=d style='--v: green'><p id=d>d</p></div><div class=e>e</div>"
    h = h + "<span class=x>1</span><span class=y>2</span>"
    doc = dom_desde_html(h)
    estilo_aplicar(doc, estilo_hojas(doc, "http://x/"))
    for id in ["a", "b", "c"]
        n = dom_por_id(doc, id)
        Print id + ": " + n.estilo["color"] + " " + n.estilo["margin-left"]
    end
    d = dom_por_id(doc, "d")
    caja = d.padre
    Print "d: " + d.estilo["color"] + " " + caja.estilo["margin-right"] + " " + caja.estilo["padding-top"]
    e = dom_buscar(doc, "div")
    for div in [dom_buscar(doc, "body")]
        for h2 in div.hijos
            if h2.tipo == DOM_ELEMENTO and dom_atributo(h2, "class") == "e"
                e = h2
            end
        end
    end
    Print "borde: " + e.estilo["border-top-width"] + " " + e.estilo["border-left-style"] + " " + e.estilo["border-bottom-color"]
    x = 0
    y = 0
    for s in dom_buscar(doc, "body").hijos
        if s.tipo == DOM_ELEMENTO and s.nombre == "span"
            if dom_atributo(s, "class") == "x" and s.pseudo_antes != nil
                x = 1
            end
            if dom_atributo(s, "class") == "y" and s.pseudo_antes != nil
                y = 1
            end
        end
    end
    Print "before: " + x + " " + y
    Print "px: " + estilo_px(" 2EM ", 16, 0) + " " + estilo_px("12PX", 0, 0) + " " + estilo_px("3zz", 0, 0) + " " + estilo_px("50%", 0, 10)
end
