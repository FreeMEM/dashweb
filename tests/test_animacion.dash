# Test: lib/animacion.dash (tarea 31q, paso 1): una animación con el atajo (1s linear, 0.5s de retardo, 2
# vueltas, alternate, forwards) y sus fotogramas: en qué punto va (nada antes del retardo, a la ida, a la vuelta,
# y acabada donde termina: alternate con 2 vueltas acaba al principio), los valores entre fotogramas (opacity
# con un fotograma en medio, translateX, un color), ease y steps. En la página (tarea 37d3): scale alrededor del
# centro, color del texto y box-shadow (un 0 sin unidad se mezcla con 10px), y acabadas, como estaban.
# memcheck
# expect-out: 1 x 1000 500 2000 alternate forwards linear
# expect-out: -1 250 750 0
# expect-out: 0.25 translateX(-15px) rgb(128, 0, 127)
# expect-out: ease true steps 500 linear 600
# expect-out: pagina 3 -22 true -2 false 8 false true false
# expect-out: anims 3 | s 25,3 50x5 | k 80007f | l -5,41 30x30 a153 false
# expect-out: fin | s 0,0 100x10 | l 20x20
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/animacion.dash"

Main
    c = "@keyframes x { 0% { opacity: 0; transform: translateX(-20px) } 50% { opacity: .5 } 100% { opacity: 1; transform: translateX(0px) } }"
    c = c + " @keyframes c { from { color: red } to { color: blue } }"
    c = c + " #a { animation: x 1s linear 0.5s 2 alternate forwards } #b { animation: c 2s }"
    c = c + " @keyframes m { from { transform: translateX(-40px); opacity: 0 } to { transform: translateX(0px); opacity: 1 } }"
    c = c + " #m { width: 100px; height: 10px; background: red; animation: m 1s linear }"
    doc = dom_desde_html("<html><head><style>" + c + "</style></head><body><p id=a>x</p><p id=b>y</p><div id=m></div></body></html>")
    hojas = estilo_hojas(doc, "prueba.html")
    estilo_aplicar(doc, hojas)
    lista = animaciones_de(dom_por_id(doc, "a"), hojas)
    a = lista[0]
    Print "" + lista.length + " " + a.nombre + " " + a.duracion + " " + a.retardo + " " + a.vueltas + " " + a.sentido + " " + a.relleno + " " + a.curva
    Print "" + animacion_progreso(a, 0) + " " + animacion_progreso(a, 750) + " " + animacion_progreso(a, 1750) + " " + animacion_progreso(a, 3000)
    b = animaciones_de(dom_por_id(doc, "b"), hojas)[0]
    b.curva = "linear"
    Print animacion_valor(a, "opacity", 250) + " " + animacion_valor(a, "transform", 250) + " " + animacion_valor(b, "color", 500)
    e = animacion_curva("ease", 500)
    Print "ease " + (e > 795 and e < 810) + " steps " + animacion_curva("steps(4)", 600) + " linear " + animacion_curva("linear", 600)
    # en la página (8 px de margen del body): lo dibujado de #m se mueve y se esconde con opacity < 0,5; acabada
    # (sin forwards), en su sitio. #a se dibuja velado (acaba en su primer fotograma: opacity 0; desde la 37d lo
    # invisible conserva sus dibujos) y cuenta: a los 2000 ms sigue viva (0,5 s + 2 vueltas de 1 s), a los 5000 no
    p = maquetar(doc, 280)
    anims = animaciones_pagina(p, hojas)
    var caja: Dibujo = nil
    for d in p.dibujos
        if d.tipo == D_RECT and d.nodo != nil and dom_atributo(d.nodo, "id") == "m"
            caja = d
        end
    end
    r = "pagina " + anims.length
    animar(p, anims, 250)
    r = r + " " + caja.x + " " + caja.velado
    animar(p, anims, 750)
    r = r + " " + caja.x + " " + caja.velado
    viva = animar(p, anims, 2000)
    r = r + " " + caja.x + " " + caja.velado + " " + viva + " " + animar(p, anims, 5000)
    Print r
    # scale, color y box-shadow (tarea 37d3): a la mitad, la caja de 100x10 a 50x5 en su centro, el texto morado y
    # la sombra 5 px más ancha por cada lado
    c2 = "@keyframes s { from { transform: scale(0) } to { transform: scale(1) } } @keyframes k { from { color: #ff0000 } to { color: #0000ff } }"
    c2 = c2 + " @keyframes l { from { box-shadow: 0 0 0 0 rgba(255,0,0,1) } to { box-shadow: 0 0 0 10px rgba(255,0,0,0.2) } }"
    c2 = c2 + " body { margin: 0 } #s { width: 100px; height: 10px; background: red; animation: s 1s linear } #k { animation: k 1s linear }"
    c2 = c2 + " #l { width: 20px; height: 20px; background: blue; box-shadow: 0 0 0 0 red; animation: l 1s linear }"
    doc2 = dom_desde_html("<html><head><style>" + c2 + "</style></head><body><div id=s></div><p id=k>x</p><div id=l></div></body></html>")
    hojas2 = estilo_hojas(doc2, "prueba.html")
    estilo_aplicar(doc2, hojas2)
    p2 = maquetar(doc2, 280)
    anims2 = animaciones_pagina(p2, hojas2)
    animar(p2, anims2, 500)
    r2 = "anims " + anims2.length
    for d in p2.dibujos
        if d.nodo != nil and dom_atributo(d.nodo, "id") == "s" and d.tipo == D_RECT
            r2 = r2 + " | s " + d.x + "," + d.y + " " + d.ancho + "x" + d.alto
        elif d.nodo != nil and dom_atributo(d.nodo, "id") == "k" and d.tipo == D_TEXTO
            r2 = r2 + " | k " + str_from_int(d.color, 16)
        elif d.sombra
            r2 = r2 + " | l " + d.x + "," + d.y + " " + d.ancho + "x" + d.alto + " a" + d.espaciado + " " + d.velado
        end
    end
    Print r2
    animar(p2, anims2, 2000)
    r3 = "fin"
    for d in p2.dibujos
        if d.nodo != nil and dom_atributo(d.nodo, "id") == "s" and d.tipo == D_RECT
            r3 = r3 + " | s " + d.x + "," + d.y + " " + d.ancho + "x" + d.alto
        elif d.sombra
            r3 = r3 + " | l " + d.ancho + "x" + d.alto
        end
    end
    Print r3
end
