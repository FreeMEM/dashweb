# Test: HTTP sin esperar (http_empezar, http_avanzar, http_cancelar de lib/http.dash). Entre vuelta
# y vuelta el programa podría atender la interfaz. Con longitud, chunked, una redirección, un 404,
# una respuesta lenta (se ve el progreso a medias: 1000 de 2000+cabeceras), una carga cancelada y
# un nombre que se busca sin esperar (http_fase).
# emu-server: http.py 40855
# memcheck
# expect-out: 200 [hola]
# expect-out: 200 [unodostres-cuatr]
# expect-out: 200 [hola] http://127.0.0.1:40855/hola
# expect-out: 404 [no]
# expect-out: lento: 200 2000 bytes, a medias: 1
# expect-out: cancelada: [cancelada]
# expect-out: rechazada: [conexión rechazada]
# expect-out: fase: buscando
# expect-out: 200 [hola] fase: []
# expect-out: cancelada buscando: [cancelada]
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/http.dash"

@native(borrow) func esperar(ticks: Int)
"""
    Delay(ticks);
"""
end

func traer(direccion: String) -> Respuesta
    c = http_empezar(direccion, 10000)
    while not http_avanzar(c)
        esperar(2)
    end
    return c.respuesta
end

Main
    base = "http://127.0.0.1:40855"
    r = traer(base + "/hola")
    Print "" + r.estado + " [" + r.cuerpo + "]"
    r = traer(base + "/chunked")
    Print "" + r.estado + " [" + r.cuerpo + "]"
    r = traer(base + "/redir")
    Print "" + r.estado + " [" + r.cuerpo + "] " + r.url
    r = traer(base + "/no")
    Print "" + r.estado + " [" + r.cuerpo + "]"
    c = http_empezar(base + "/lento", 10000)
    a_medias = false
    while not http_avanzar(c)
        if http_total(c) > 0 and http_recibidos(c) > 0 and http_recibidos(c) < http_total(c)
            a_medias = true
        end
        esperar(5)
    end
    Print "lento: " + c.respuesta.estado + " " + c.respuesta.cuerpo.length + " bytes, a medias: " + a_medias
    c = http_empezar(base + "/lento", 10000)
    http_cancelar(c)
    Print "cancelada: [" + c.respuesta.error + "]"
    c = http_empezar("http://127.0.0.1:1/", 3000)
    while not http_avanzar(c)
        esperar(2)
    end
    Print "rechazada: [" + c.respuesta.error + "]"
    # el nombre se busca en otro proceso: la carga empieza "buscando" y llega igual
    c = http_empezar("http://localhost:40855/hola", 10000)
    Print "fase: " + http_fase(c)
    while not http_avanzar(c)
        esperar(2)
    end
    Print "" + c.respuesta.estado + " [" + c.respuesta.cuerpo + "] fase: [" + http_fase(c) + "]"
    c = http_empezar("http://nadie.invalid/", 10000)
    http_cancelar(c)
    Print "cancelada buscando: [" + c.respuesta.error + "]"
end
