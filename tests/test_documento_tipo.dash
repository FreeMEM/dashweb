# Test: lib/documento.dash con algo que no es HTML. Una imagen abierta sola (Content-Type image/jpeg) da una página
# que la muestra (como Chrome: centrada sobre fondo oscuro), con su nombre de título; un HTML, el HTML.
# emu-server: http.py 40858
# memcheck
# expect-out: imagen: dec_base.jpg http://127.0.0.1:40858/pages/dec_base.jpg #0e0e0e
# expect-out: html: true
# expect-out: visibles: true false true
# expect-out: iconos: true true true false
# expect-out: descargas: true false false true true false | dashweb.lha guia_amiga.pdf a_b.zip descarga
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/documento.dash"

Main
    r = http_get("http://127.0.0.1:40858/pages/dec_base.jpg", 10000)
    d = documento_empezar("http://127.0.0.1:40858/pages/dec_base.jpg", r)
    while not documento_avanzar(d)
        time_delay(1)
    end
    img = dom_buscar(d.doc, "img")
    cuerpo = dom_buscar(d.doc, "body")
    Print "imagen: " + jsdom_titulo(d.doc) + " " + dom_atributo(img, "src") + " " + cuerpo.estilo["background-color"]
    r2 = http_get("http://127.0.0.1:40858/pages/prueba.html", 10000)
    d2 = documento_empezar("http://127.0.0.1:40858/pages/prueba.html", r2)
    Print "html: " + (dom_buscar(d2.doc, "img") == nil or dom_atributo(dom_buscar(d2.doc, "img"), "src") != "http://127.0.0.1:40858/pages/prueba.html")
    # repintar al llegar imágenes solo si alguna se ve (o se volvió a maquetar, o ya no falta ninguna)
    d3 = documento_html("http://x/", "<body style='margin:0'><img src=arriba.png width=10 height=10><div style='height:2000px'></div><img src=abajo.png width=10 height=10></body>")
    documento_maquetar(d3, 300)
    var sin: Carga = nil
    d3.im.cola.push(Pedida("otra.png", "otra.png", "T:x", sin))
    var v1: {String: Int} = {"arriba.png": 1}
    d3.im.recien = v1
    a = documento_imagenes_visibles(d3, 0, 400)
    var v2: {String: Int} = {"abajo.png": 1}
    d3.im.recien = v2
    b = documento_imagenes_visibles(d3, 0, 400)
    d3.im.recien = v2
    d3.remaquetada = true
    c = documento_imagenes_visibles(d3, 0, 400)
    Print "visibles: " + a + " " + b + " " + c
    Print "iconos: " + imagenes_fuente_de_iconos("Font Awesome 6 Free") + " " + imagenes_fuente_de_iconos("dashicons") + " " + imagenes_fuente_de_iconos("Material Icons") + " " + imagenes_fuente_de_iconos("Inter")
    var cab: {String: String} = {}
    z = Respuesta(200, "OK", cab, "", "http://x/files/dashweb.lha", "application/octet-stream", "", "", 0)
    h = Respuesta(200, "OK", cab, "", "http://x/", "text/html", "", "", 0)
    j = Respuesta(200, "OK", cab, "", "http://x/a.json", "application/json", "", "", 0)
    var cab2: {String: String} = {"content-disposition": "attachment; filename=\"guia_amiga.pdf\""}
    adj = Respuesta(200, "OK", cab2, "", "http://x/bajar?id=3", "text/html", "", "", 0)
    s2 = Respuesta(200, "OK", cab, "", "http://x/a%3Ab.zip", "", "", "", 0)
    n = Respuesta(404, "Not Found", cab, "", "http://x/no.lha", "application/octet-stream", "", "", 0)
    Print "descargas: " + documento_es_descarga(z) + " " + documento_es_descarga(h) + " " + documento_es_descarga(j) + " " + documento_es_descarga(adj) + " " + documento_es_descarga(s2) + " " + documento_es_descarga(n) + " | " + documento_nombre_descarga(z) + " " + documento_nombre_descarga(adj) + " " + documento_nombre_descarga(s2) + " " + documento_nombre_descarga(h)
end
