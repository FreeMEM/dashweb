# Test: un flex con position: absolute mide su ancho con el texto de su caja anónima (el "NUEVO" de xataka.com: el
# texto no contaba al medirlo y su icono quedaba encima; tarea 42g). Con right: 0 en 600, "Nuevo" (40) y un span de
# 16 con margin-left 8 caben en 64: x 536 y 584. Comprobado a mano.
# memcheck
# expect-out: abs derecha | 536 w40 Nuevo | 584 w16 XX
# expect-out: abs izquierda | 0 w40 Nuevo | 48 w16 XX
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0
import "../lib/documento.dash"

func prueba(nombre: String, css: String)
    d = dom_desde_html5("<!DOCTYPE html><html><head><style>" + css + "</style></head><body style='margin:0'><div style='position:relative;height:50px'><a href=#>Nuevo<span>XX</span></a></div></body></html>")
    estilo_aplicar(d, estilo_hojas(d, "http://x/"))
    p = maquetar(d, 600)
    r = nombre
    for x in p.dibujos
        if x.tipo == D_TEXTO
            r = r + " | " + x.x + " w" + x.ancho + " " + x.texto
        end
    end
    Print r
end

Main
    prueba("abs derecha", "a { display: flex; position: absolute; right: 0 } a span { display: block; margin-left: 8px }")
    prueba("abs izquierda", "a { display: flex; position: absolute; left: 0 } a span { display: block; margin-left: 8px }")
end
