# Test: flexbox (tarea 31b). Cada caso es un contenedor display: flex de 600 px (fondo gris) con cajas de colores;
# se escribe cada caja con su id: x,y relativos a su contenedor y ancho x alto. Comprobado a mano con la
# especificación (y con Chrome en la tarea 31b). Con order, se pintan en el orden cambiado (z2 antes que z1).
# memcheck
# expect-out: a 0,0 100x20
# expect-out: b 100,0 450x20
# expect-out: c 550,0 50x20
# expect-out: d 140,0 100x20
# expect-out: e 250,0 100x20
# expect-out: f 360,0 100x20
# expect-out: g 0,0 100x20
# expect-out: h 250,0 100x20
# expect-out: i 500,0 100x20
# expect-out: j 0,40 50x20
# expect-out: k 0,0 50x60
# expect-out: l 50,0 50x60
# expect-out: m 0,0 200x10
# expect-out: n 200,0 200x10
# expect-out: o 400,0 200x10
# expect-out: p 0,10 200x10
# expect-out: q 0,0 600x30
# expect-out: r 0,30 600x40
# expect-out: s 0,65 100x30
# expect-out: t 0,95 100x40
# expect-out: u 0,0 200x10
# expect-out: v 200,0 200x10
# expect-out: w 400,0 200x10
# expect-out: x 0,0 100x10
# expect-out: y 500,0 100x10
# expect-out: z2 0,0 100x10
# expect-out: z1 100,0 50x10
# expect-out: z3 500,0 100x10
# expect-out: z4 450,0 50x10
# expect-out: z5 0,0 100x10
# expect-out: z6 100,0 500x10
# expect-out: z7 40,0 48x20
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/maqueta.dash"

func caja(id: String, color: String, estilo: String) -> String
    return "<div id=" + id + " style='background:" + color + ";" + estilo + "'></div>"
end

func contenedor(estilo: String, dentro: String) -> String
    return "<div class=f style='display:flex;background:#eee;" + estilo + "'>" + dentro + "</div>"
end

Main
    h = "<html><body style='margin:0'>"
    h = h + contenedor("", caja("a", "red", "width:100px;height:20px") + caja("b", "blue", "flex:1;height:20px") + caja("c", "green", "width:50px;height:20px"))
    h = h + contenedor("justify-content:center;gap:10px", caja("d", "red", "width:100px;height:20px") + caja("e", "blue", "width:100px;height:20px") + caja("f", "green", "width:100px;height:20px"))
    h = h + contenedor("justify-content:space-between", caja("g", "red", "width:100px;height:20px") + caja("h", "blue", "width:100px;height:20px") + caja("i", "green", "width:100px;height:20px"))
    h = h + contenedor("align-items:center;height:100px", caja("j", "red", "width:50px;height:20px"))
    h = h + contenedor("", caja("k", "red", "width:50px;height:60px") + caja("l", "blue", "width:50px"))
    h = h + contenedor("flex-wrap:wrap", caja("m", "red", "width:200px;height:10px") + caja("n", "blue", "width:200px;height:10px") + caja("o", "green", "width:200px;height:10px") + caja("p", "black", "width:200px;height:10px"))
    h = h + contenedor("flex-direction:column", caja("q", "red", "height:30px") + caja("r", "blue", "height:40px"))
    h = h + contenedor("flex-direction:column;justify-content:center;align-items:flex-start;height:200px", caja("s", "red", "width:100px;height:30px") + caja("t", "blue", "width:100px;height:40px"))
    h = h + contenedor("", caja("u", "red", "flex-basis:300px;height:10px") + caja("v", "blue", "flex-basis:300px;height:10px") + caja("w", "green", "flex-basis:300px;height:10px"))
    h = h + contenedor("", caja("x", "red", "width:100px;height:10px") + caja("y", "blue", "width:100px;height:10px;margin-left:auto"))
    h = h + contenedor("", caja("z1", "red", "width:50px;height:10px;order:2") + caja("z2", "blue", "width:100px;height:10px;order:1"))
    h = h + contenedor("flex-direction:row-reverse", caja("z3", "red", "width:100px;height:10px") + caja("z4", "blue", "width:50px;height:10px"))
    h = h + contenedor("", caja("z5", "red", "flex:1;max-width:100px;height:10px") + caja("z6", "blue", "flex:1;height:10px"))
    # una imagen en un elemento flex va en una caja anónima: al medirla no cuentan los rellenos de fuera (las
    # pestañas de GitHub medían 96 px de más; tarea 42i): 8 + 16 + 16 ("ab") + 8
    h = h + contenedor("padding:0 40px", "<div id=z7 style='background:red;display:flex;padding:0 8px'><img width=16 height=16 src=x.png>ab</div>")
    h = h + "</body></html>"
    doc = dom_desde_html(h)
    estilo_aplicar(doc, estilo_hojas(doc, "prueba.html"))
    p = maquetar(doc, 600)
    # cada caja respecto a su contenedor (su padre; los fondos de los bloques se pintan antes que las cajas flex/grid)
    var conts: [Dibujo] = []
    for d in p.dibujos
        if d.tipo == D_RECT and d.nodo != nil and dom_atributo(d.nodo, "class") == "f"
            conts.push(d)
        end
    end
    for d in p.dibujos
        if d.tipo == D_RECT and d.nodo != nil and dom_atributo(d.nodo, "id") != ""
            cx = 0
            cy = 0
            for c in conts
                if c.nodo == d.nodo.padre
                    cx = c.x
                    cy = c.y
                end
            end
            Print dom_atributo(d.nodo, "id") + " " + (d.x - cx) + "," + (d.y - cy) + " " + d.ancho + "x" + d.alto
        end
    end
end
