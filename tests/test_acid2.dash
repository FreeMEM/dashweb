# Test: lo que Acid2 (acid2.acidtests.org, CSS 2.1) pide, pieza a pieza (tarea 41a). Una hoja en una dirección
# data: (<link rel="appendix stylesheet" href="data:text/css,...">) se aplica; un borde transparent no se pinta (ni
# con el color del texto), uno semitransparente se mezcla y uno con un color que no se entiende va con el del texto.
# Ir a #top lleva al borde de arriba de su caja, con su relleno (no a su texto). En modo estándar "width: 200" no
# vale (en quirks, sí: 200px) y un ";" suelto tras una regla deja fuera la siguiente.
# memcheck
# expect-out: hoja data: none
# expect-out: borde transparente: 0 dibujos
# expect-out: borde rgba: true 127
# expect-out: borde raro: 16711680
# expect-out: ancla: 100 true
# expect-out: parser: 2em 1em | quirks: 200
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/documento.dash"

func rects(estilo: String) -> [Dibujo]
    doc = dom_desde_html("<style>html { color: red } .p { height: 20px; " + estilo + " }</style><body><div class=p></div></body>")
    estilo_aplicar(doc, estilo_hojas(doc, "http://x/"))
    p = maquetar(doc, 300)
    var r: [Dibujo] = []
    for d in p.dibujos
        if d.tipo == D_RECT
            r.push(d)
        end
    end
    return r
end

Main
    doc = dom_desde_html("<head><style>.p { background: red }</style><link rel=\"appendix stylesheet\" href=\"data:text/css,.p%20%7B%20background%3A%20none%3B%20%7D\"></head><body><div class=p>x</div></body>")
    estilo_aplicar(doc, estilo_hojas(doc, "http://x/"))
    n = dom_buscar(dom_buscar(doc, "body"), "div")
    fondo = "?"
    if n.estilo.has("background-color")
        fondo = n.estilo["background-color"]
    end
    if n.estilo.has("background-image")
        fondo = n.estilo["background-image"]
    end
    Print "hoja data: " + fondo
    Print "borde transparente: " + rects("border: 1em solid transparent").length + " dibujos"
    a = rects("border: 2px solid rgba(0, 0, 255, 0.5)")
    Print "borde rgba: " + (a.length == 4 and a[0].color == 255) + " " + a[0].espaciado
    b = rects("border: 2px solid nocolor")
    Print "borde raro: " + b[0].color
    d = documento_html("http://x/", "<body style='margin:0'><div style='height:100px'></div><h2 id=top style='margin:0;padding-top:40px;font:24px/24px sans-serif'>Hola</h2></body>")
    documento_maquetar(d, 300)
    t = 0
    for dib in d.pagina.dibujos
        if dib.tipo == D_TEXTO and str_trim(dib.texto) == "Hola"
            t = dib.y
        end
    end
    Print "ancla: " + documento_y_de(d, "top") + " " + (t >= 140)
    documento_liberar(d)
    css = "<style>.parser { width: 2em; height: 1em } .parser { m\\argin: 2em; }; .parser { height: 3em; } .parser { width: 200; }</style>"
    e1 = dom_desde_html5("<!DOCTYPE html><html><head>" + css + "</head><body><div class=parser></div></body></html>")
    estilo_aplicar(e1, estilo_hojas(e1, "http://x/"))
    n1 = jsdom_selector(e1, ".parser", false)[0]
    e2 = dom_desde_html5("<html><head>" + css + "</head><body><div class=parser></div></body></html>")
    estilo_aplicar(e2, estilo_hojas(e2, "http://x/"))
    n2 = jsdom_selector(e2, ".parser", false)[0]
    Print "parser: " + n1.estilo["width"] + " " + n1.estilo["height"] + " | quirks: " + n2.estilo["width"]
end
