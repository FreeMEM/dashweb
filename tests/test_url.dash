# expect-out: google: 779 https://fonts.googleapis.com/css2?family=Inter&text=+%21%22%23%24%25%26%27%28%29%2A%2B%2C- igual

import "../lib/url.dash"

func partes(texto: String)
    u = url_parse(texto)
    f = "(sin)"
    if u.tiene_fragmento
        f = u.fragmento
    end
    Print u.esquema + "|" + u.usuario + "|" + u.host + "|" + u.puerto + "|" + u.ruta + "|" + u.consulta + "|" + f + "|" + url_port(u)
end

func prueba(base: Url, ref: String)
    Print url_text(url_resolve(base, ref))
end

Main
    partes("HTTP://User@Ejemplo.ORG:8080/a/B?x=1#Arriba")
    partes("https://ejemplo.org")
    partes("http://[::1]:81/x")
    partes("file:///DH0:pagina.html")
    partes("mailto:yo@ejemplo.org")
    partes("/solo/ruta?q")
    base = url_parse("http://a/b/c/d;p?q")
    prueba(base, "g:h")
    prueba(base, "g")
    prueba(base, "./g")
    prueba(base, "g/")
    prueba(base, "/g")
    prueba(base, "//g")
    prueba(base, "?y")
    prueba(base, "g?y")
    prueba(base, "#s")
    prueba(base, "g#s")
    prueba(base, "g?y#s")
    prueba(base, ";x")
    prueba(base, "g;x")
    prueba(base, "g;x?y#s")
    prueba(base, "")
    prueba(base, ".")
    prueba(base, "./")
    prueba(base, "..")
    prueba(base, "../")
    prueba(base, "../g")
    prueba(base, "../..")
    prueba(base, "../../")
    prueba(base, "../../g")
    prueba(base, "../../../g")
    prueba(base, "../../../../g")
    prueba(base, "/./g")
    prueba(base, "/../g")
    prueba(base, "g.")
    prueba(base, ".g")
    prueba(base, "g..")
    prueba(base, "..g")
    prueba(base, "./../g")
    prueba(base, "./g/.")
    prueba(base, "g/./h")
    prueba(base, "g/../h")
    prueba(base, "g;x=1/./y")
    prueba(base, "g;x=1/../y")
    prueba(base, "g?y/./x")
    prueba(base, "g?y/../x")
    prueba(base, "g#s/./x")
    prueba(base, "g#s/../x")
    prueba(base, "http:g")
    e = url_parse("http://Ejemplo.org")
    prueba(e, "/")
    prueba(url_parse("http://otro.net/x/"), "y.html")
    Print "ficheros: " + url_fichero("file:///Programs/Network/NetSurf/welcome.html") + "|" + url_fichero("file:///DH0:pagina.html") + "|" + url_fichero("file://localhost/Work/a%20b/%41.html") + "|" + url_fichero("FILE://work/x") + "|" + url_fichero("file:///a.html") + "|" + url_fichero("pages/x.html") + "|" + str_code(url_fichero("file:///W/%C3%A9"), 2)
    Print "rastreo: " + url_rastreador("https://www.googletagmanager.com/gtag/js?id=X") + " " + url_rastreador("https://stats.wp.com/e.js") + " " + url_rastreador("https://freemem.space/a.js") + " " + url_rastreador("https://notgoogletagmanager.com/x.js")
    g = url_fuentes_latin1("https://fonts.googleapis.com/css2?family=Inter")
    otra = "igual"
    if url_fuentes_latin1("https://ejemplo.org/a.css") != "https://ejemplo.org/a.css" or url_fuentes_latin1(g) != g
        otra = "distinta"
    end
    Print "google: " + g.length + " " + g[:90] + " " + otra
end
