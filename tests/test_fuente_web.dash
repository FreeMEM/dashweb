# Test: lib/fuente_web.dash (tarea 31h): Bitstream Vera Sans Mono (tests/pages/VeraMono.ttf, su licencia al lado)
# hecha TextFont del Amiga a 20 px de em: alto 24 (ascendente 19 + descendente 5), todas las letras del mismo
# ancho (12), "abc" tres veces una, y un fichero que no es una fuente da 0; en WOFF, igual; en WOFF2 (Brotli y glyf/loca
# transformadas, tests/pages/VeraMono.woff2 de woff2_compress; tarea 37g), igual y con las mismas letras. Y pintada: la
# W pone tinta. Con font-stretch: 150 % las letras son 1,5 veces más anchas y un letter-spacing negativo las junta (tarea 37h).
# Una fuente fina (Lato Light, tests/pages/LatoLight.woff2 y su licencia) a 15 px: el palo de la L sale entero en el
# plano de 1 bit (caía entre dos píxeles al 50 % y desaparecía: "_os" por "Los" en freemem.space).
# emu-server: http.py 40853
# memcheck
# expect-out: fuente 24 12 true true
# expect-out: nada 0
# expect-out: woff 24 12
# expect-out: woff2 24 12 true
# expect-out: tinta true
# expect-out: woff2 como ttf true
# expect-out: palo de la L entero: true
# expect-out: caras 3: mi fuente 700 italic http://ejemplo.com/f/mi.woff2 | otra 400 normal http://ejemplo.com/a/otra.ttf?v=2 | icons-min 400 normal http://ejemplo.com/i/icons.ttf?x
# expect-out: maqueta 36 sin 0
# expect-out: estirada 54 | apretada 30
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/fuente_web.dash"
import "../lib/http.dash"
import "../lib/maqueta.dash"

Window W
    title "Fuente"
    width 200
    height 80
end

Main
    http_a_fichero("http://127.0.0.1:40853/pages/VeraMono.ttf", "T:VeraMono.ttf", 10000)
    f = fuente_web("T:VeraMono.ttf", 20)
    font_use(f)
    Print "fuente " + font_height() + " " + font_text_width("W") + " " + (font_text_width("i") == font_text_width("W")) + " " + (font_text_width("abc") == 3 * font_text_width("a"))
    Print "nada " + fuente_web("T:nada", 20)
    # la misma en WOFF (el servidor la hace al vuelo con zlib)
    http_a_fichero("http://127.0.0.1:40853/woff/VeraMono.woff", "T:VeraMono.woff", 10000)
    g = fuente_web("T:VeraMono.woff", 20)
    font_use(g)
    Print "woff " + font_height() + " " + font_text_width("W")
    fuente_web_liberar(g)
    http_a_fichero("http://127.0.0.1:40853/pages/VeraMono.woff2", "T:VeraMono.woff2", 10000)
    g2 = fuente_web("T:VeraMono.woff2", 20)
    font_use(g2)
    Print "woff2 " + font_height() + " " + font_text_width("W") + " " + (font_text_width("abc") == 3 * font_text_width("a"))
    W.open
    font_use(f)
    x0 = W.inner_left
    y0 = W.inner_top
    gfx_pen(0)
    gfx_rect(x0, y0, x0 + 100, y0 + 40)
    gfx_pen(1)
    gfx_mode(0)
    gfx_text_at(x0 + 4, y0 + 4 + font_baseline(), "WWW")
    tinta = false
    for x in (0..40)
        for y in (0..30)
            if gfx_pixel_read(x0 + 4 + x, y0 + 4 + y) != gfx_pixel_read(x0 + 90, y0 + 35)
                tinta = true
            end
        end
    end
    Print "tinta " + tinta
    # la misma letra de la WOFF2 que de la TTF: los contornos rehechos de glyf transformada, pixel a pixel
    gfx_pen(0)
    gfx_rect(x0, y0, x0 + 180, y0 + 40)
    gfx_pen(1)
    gfx_text_at(x0 + 4, y0 + 4 + font_baseline(), "Wag&8")
    font_use(g2)
    gfx_text_at(x0 + 94, y0 + 4 + font_baseline(), "Wag&8")
    iguales = true
    for x in (0..80)
        for y in (0..30)
            if gfx_pixel_read(x0 + 4 + x, y0 + 4 + y) != gfx_pixel_read(x0 + 94 + x, y0 + 4 + y)
                iguales = false
            end
        end
    end
    Print "woff2 como ttf " + iguales
    fuente_web_liberar(g2)
    http_a_fichero("http://127.0.0.1:40853/pages/LatoLight.woff2", "T:LatoLight.woff2", 10000)
    g3 = fuente_web("T:LatoLight.woff2", 15)
    font_use(g3)
    gfx_pen(0)
    gfx_rect(x0, y0, x0 + 180, y0 + 40)
    gfx_pen(1)
    gfx_text_at(x0 + 4, y0 + 4 + font_baseline(), "L")
    arriba = -1
    abajo = -1
    for y in (0..30)
        for x in (0..5)
            if gfx_pixel_read(x0 + 4 + x, y0 + 4 + y) != gfx_pixel_read(x0 + 170, y0 + 35)
                if arriba < 0
                    arriba = y
                end
                abajo = y
            end
        end
    end
    entero = arriba >= 0 and abajo - arriba >= 8
    for y in (arriba..abajo)
        hay = false
        for x in (0..5)
            if gfx_pixel_read(x0 + 4 + x, y0 + 4 + y) != gfx_pixel_read(x0 + 170, y0 + 35)
                hay = true
            end
        end
        if not hay
            entero = false
        end
    end
    Print "palo de la L entero: " + entero
    fuente_web_liberar(g3)
    W.close
    fuente_web_liberar(f)
    # @font-face en una hoja: familia, peso, estilo y, del src, el primero que se sabe leer (no local)
    c = "@font-face { font-family: 'Mi Fuente'; src: local('X'), url(/f/mi.woff2) format('woff2'), url(/f/mi.woff) format('woff'); font-weight: bold; font-style: italic }"
    c = c + " @font-face { font-family: Otra; src: url(otra.ttf?v=2) }"
    # (el EOT de Internet Explorer primero, como los iconos de Xataka: no se sabe leer; el TrueType sí)
    c = c + " @font-face { font-family: icons-min; src: url('/i/icons.eot?x'); src: url('/i/icons.eot?x#iefix') format('embedded-opentype'), url('/i/icons.ttf?x') format('truetype') }"
    doc = dom_desde_html("<html><head><style>" + c + "</style></head><body>x</body></html>")
    hojas = estilo_hojas(doc, "http://ejemplo.com/a/b.html")
    caras = estilo_caras(hojas)
    r = "caras " + caras.length + ":"
    for cara in caras
        if cara != caras[0]
            r = r + " |"
        end
        r = r + " " + cara.familia + " " + cara.peso + " " + cara.estilo + " " + css_fuente_src(cara.src)
    end
    Print r
    # una fuente de la página registrada (como al llegar): la maqueta la usa si el font-family la nombra
    fuente_web_registrar("vera mono|400|normal", "T:VeraMono.ttf")
    doc2 = dom_desde_html("<html><body style='margin:0'><p style=\"font-family: 'Vera Mono', sans-serif; font-size: 20px\">WWW</p></body></html>")
    estilo_aplicar(doc2, estilo_hojas(doc2, "prueba.html"))
    p = maquetar(doc2, 280)
    ancho = 0
    for d in p.dibujos
        if d.tipo == D_TEXTO
            ancho = d.ancho
        end
    end
    Print "maqueta " + ancho + " sin " + fuente_web_para("otra, serif", 400, "normal", 20)
    # font-stretch: 150% (letras de 18 px en vez de 12) y letter-spacing negativo (-2 px por letra; tarea 37h)
    doc3 = dom_desde_html("<html><body style='margin:0'><p style=\"font-family: 'Vera Mono'; font-size: 20px; font-stretch: 150%\">WWW</p><p style=\"font-family: 'Vera Mono'; font-size: 20px; letter-spacing: -2px\">WWW</p></body></html>")
    estilo_aplicar(doc3, estilo_hojas(doc3, "prueba.html"))
    p3 = maquetar(doc3, 280)
    var anchos: [Int] = []
    for d in p3.dibujos
        if d.tipo == D_TEXTO
            anchos.push(d.ancho)
        end
    end
    Print "estirada " + anchos[0] + " | apretada " + anchos[1]
end
