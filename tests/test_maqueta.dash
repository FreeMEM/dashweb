import "../lib/maqueta.dash"

Window W
    title "Maqueta"
    width 300
    height 100
end

func muestra(d: Dibujo) -> String
    if d.tipo == D_TEXTO
        r = "T " + d.x + "," + d.y + " [" + d.texto + "] c=" + str_from_int(d.color, 16) + " e=" + d.estilo
        if d.enlace != ""
            r = r + " ->" + d.enlace
        end
        return r
    elif d.tipo == D_RECT
        return "R " + d.x + "," + d.y + " " + d.ancho + "x" + d.alto + " c=" + str_from_int(d.color, 16)
    elif d.tipo == D_IMAGEN
        return "I " + d.x + "," + d.y + " " + d.ancho + "x" + d.alto + " " + d.texto
    end
    return "L " + d.x + "," + d.y + " " + d.ancho
end

Main
    W.open
    h = "<style>body { margin: 4px } p { margin: 6px 0 } .c { text-align: center } .caja { background: #ff0; border: 1px solid blue; padding: 2px }</style>"
    h = h + "<p>uno dos tres cuatro cinco seis siete</p><p class=c>medio</p>"
    h = h + "<p>a <b>bb</b> <a href=x.html>enlace</a><br>fin</p>"
    h = h + "<ul><li>x<li>y</ul><ol><li>p</ol>"
    h = h + "<table><tr><td>c1<td>c2</table><div class=caja>k</div><pre>a  b\nc</pre><img src=f.png width=10 height=12>"
    # "dddd" y "." van pegados: si no caben los dos, pasan juntos a la línea siguiente
    h = h + "<p>aaaa bbbb cccc <a href=y.html>dddd</a>.</p>"
    doc = dom_desde_html(h)
    estilo_aplicar(doc, estilo_hojas(doc, "file:///"))
    p = maquetar(doc, 160)
    for d in p.dibujos
        Print muestra(d)
    end
    Print "alto " + p.alto + " fondo " + str_from_int(p.fondo, 16)
    W.close
end
