# dashweb: el navegador con MUI (fase B). La ventana está en navegador.dashui (editor visual de
# Dash); la página la abre lib/documento.dash y la pinta lib/pintor.dash en la zona de dibujo.
#
#   dashweb                       # página de inicio
#   dashweb http://ejemplo.org/   # esa página (con varias direcciones, una ventana para cada una)
#
# Barra de URL (Return para ir), atrás, adelante, recargar, historial (oculto hasta que se despliega
# con su botón), barra de estado y de progreso. La rueda, la barra y las teclas (arriba, abajo,
# espacio, retroceso) desplazan; un clic llega al JavaScript de la página y, si no lo para, sigue el
# enlace (#ancla: dentro de la página).
# Hasta 4 ventanas (menú Proyecto: Nueva ventana, Cerrar ventana), cada una con su página.
# Necesita MUI 3.8 o 5 y un 68020.

import "navegador.dashui"
import "../lib/documento.dash"
import "../lib/formularios.dash"
import "../lib/marcadores.dash"

# Los números de evento del .dashui (los mismos en todas las ventanas: la activa dice de cuál viene)
const ID_ATRAS = 1
const ID_ADELANTE = 2
const ID_RECARGAR = 3
const ID_IR = 4
const ID_SCROLL = 5
const ID_HISTORIAL = 6
const ID_ACERCA = 8
const ID_SALIR = 9
const ID_PAGINA = 10
const ID_PARAR = 13
const ID_MARCADORES = 14
const ID_ANADIR = 15
const ID_USAR_INICIO = 16
const ID_INICIO = 17
const ID_NUEVA = 18
const ID_CERRAR = 19
const ID_VER_HISTORIAL = 20
# y los del programa
const ID_TIC = 11         # el temporizador: las cargas en curso y los setTimeout/setInterval de las páginas
const ID_RANGO = 12       # la barra, después de maquetar en el dibujo (el ancho cambió)
const ID_CERRADA = 100    # + número de ventana: su botón de cerrar

const MAX_VENTANAS = 4
const FICHERO_MARCADORES = "PROGDIR:dashweb.marcadores"
const FICHERO_PREFERENCIAS = "PROGDIR:dashweb.prefs"

# Una ventana del navegador y lo que tiene
struct Ventana
    v: Navegador
    numero: Int
    abierta: Bool = true
    actual: Documento = nil
    desde: Int = 0
    visto: Int = -1          # la línea del historial que se ve
    carga: Carga = nil       # la página que está llegando (sin congelar la ventana)
    carga_dir: String = ""
    preparando: Documento = nil   # la página ya llegó; sus hojas y scripts están llegando
    js_cuando: Int = -1      # time_ms del siguiente temporizador del JavaScript, -1 si no hay
    foco: Nodo = nil         # el campo de formulario donde se escribe
    con_historial: Bool = false   # la lista del historial desplegada (empieza oculta)
    giro: Int = -1           # el indicador de actividad: el punto que va delante (0-7), -1 parado
    cargando: Bool = false   # la barra en modo carga: "parar" en vez de "recargar" y el progreso a la vista
    con_atras: Bool = false     # los iconos de atrás y adelante, encendidos o apagados
    con_adelante: Bool = false
end

# Los ocho puntos del indicador de actividad, alrededor de su centro
var giro_x: [Int] = [0, 4, 6, 4, 0, -4, -6, -4]
var giro_y: [Int] = [-6, -4, 0, 4, 6, 4, 0, -4]

var dw_ventanas: [Ventana] = []

func dw_inicio() -> String
    h = "<html><head><title>dashweb</title><style>body { font-family: sans-serif; margin: 12px }"
    h = h + " h1 { color: #036 } .nota { color: #555 }</style></head><body>"
    h = h + "<h1>dashweb</h1><p>Un navegador para <b>AmigaOS</b> escrito en <i>Dash</i>.</p>"
    h = h + "<p>Escribe una dirección arriba (http o https) y pulsa Return.</p>"
    h = h + "<ul><li>HTML y CSS<li>Imágenes por datatypes<li>JavaScript con QuickJS<li>HTTPS con AmiSSL</ul>"
    h = h + "<p class=nota>Fase B: ventanas con MUI 5.</p></body></html>"
    return h
end

# Mientras la página llega, el botón de recargar se cambia por el de parar y se ve el progreso
func modo_carga(w: Ventana, cargando: Bool)
    if cargando == w.cargando
        return
    end
    w.cargando = cargando
    mui_set_visible(w.v.recargar, not cargando)
    mui_set_visible(w.v.parar, cargando)
    mui_set_visible(w.v.progreso, cargando)
end

# La barra de estado: un texto largo ensancharía la ventana entera (MUI le da el ancho de su texto)
func dw_estado(w: Ventana, texto: String)
    t = texto
    if t.length > 48
        t = t[:45] + "..."
    end
    mui_set_text(w.v.estado, t)
end

# Al repintar por una imagen nueva de un vídeo: solo los vídeos, no la página entera
var dw_solo_videos: Bool = false

# La zona de dibujo de cada ventana (MUI llama a una función sin decir de qué zona: una por ventana)
func pinta0(x: Int, y: Int, ancho: Int, alto: Int)
    pinta_en(0, x, y, ancho, alto)
end

func pinta1(x: Int, y: Int, ancho: Int, alto: Int)
    pinta_en(1, x, y, ancho, alto)
end

func pinta2(x: Int, y: Int, ancho: Int, alto: Int)
    pinta_en(2, x, y, ancho, alto)
end

func pinta3(x: Int, y: Int, ancho: Int, alto: Int)
    pinta_en(3, x, y, ancho, alto)
end

# El indicador de actividad de cada ventana (como la página: una función por ventana)
func giro0(x: Int, y: Int, ancho: Int, alto: Int)
    giro_en(0, x, y, ancho, alto)
end

func giro1(x: Int, y: Int, ancho: Int, alto: Int)
    giro_en(1, x, y, ancho, alto)
end

func giro2(x: Int, y: Int, ancho: Int, alto: Int)
    giro_en(2, x, y, ancho, alto)
end

func giro3(x: Int, y: Int, ancho: Int, alto: Int)
    giro_en(3, x, y, ancho, alto)
end

# Mientras algo llega, ocho puntos que giran: el de delante negro, los dos que lo siguen azules y el
# resto blancos (los lápices 1, 3 y 2 de la pantalla: con 4 colores no hay grises)
func giro_en(k: Int, x: Int, y: Int, ancho: Int, alto: Int)
    gfx_pen(0)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    if k >= dw_ventanas.length or dw_ventanas[k].giro < 0
        return
    end
    cx = x + ancho / 2
    cy = y + alto / 2
    for i in (0..7)
        detras = (dw_ventanas[k].giro - i + 8) % 8
        if detras == 0
            gfx_pen(1)
        elif detras < 3
            gfx_pen(3)
        else
            gfx_pen(2)
        end
        gfx_rect(cx + giro_x[i] - 1, cy + giro_y[i] - 1, cx + giro_x[i] + 1, cy + giro_y[i] + 1)
    end
end

# Mueve el indicador si algo está llegando (página, hojas, scripts, imágenes); si no, lo para
func actualizar_giro(w: Ventana)
    nuevo = -1
    if w.carga != nil or w.preparando != nil or (w.actual != nil and imagenes_pendientes(w.actual.im) > 0)
        nuevo = (time_ms() / 100) % 8
    end
    if nuevo != w.giro
        w.giro = nuevo
        mui_canvas_redraw(w.v.actividad)
    end
end

# La página desde "desde"; si el ancho cambió, se maqueta otra vez
func pinta_en(k: Int, x: Int, y: Int, ancho: Int, alto: Int)
    if k >= dw_ventanas.length
        return
    end
    w = dw_ventanas[k]
    if w.actual == nil
        gfx_pen(color_pen(255, 255, 255))
        gfx_rect(x, y, x + ancho - 1, y + alto - 1)
        return
    end
    if w.actual.pagina == nil or w.actual.ancho != ancho
        documento_maquetar(w.actual, ancho)
        mui_timer(1, ID_RANGO)
    end
    pintor_foco = w.foco
    pintor_videos = w.actual.videos
    if dw_solo_videos
        pintar_videos(w.actual.pagina, w.desde, x, y, ancho, alto)
        return
    end
    pintar(w.actual.pagina, w.actual.im, w.desde, x, y, ancho, alto)
end

# Barra de desplazamiento: total de la página y lo que se ve
func ajustar_barra(w: Ventana)
    if w.actual == nil or w.actual.pagina == nil
        return
    end
    alto = mui_height(w.v.pagina)
    mui_set_range(w.v.barra, w.actual.pagina.alto, alto)
    if w.desde > w.actual.pagina.alto - alto
        w.desde = w.actual.pagina.alto - alto
    end
    if w.desde < 0
        w.desde = 0
    end
    mui_set_value(w.v.barra, w.desde)
end

# Los @media de CSS y matchMedia miran el tamaño de la zona de dibujo de la ventana (con la barra)
func vista(w: Ventana)
    ancho = mui_width(w.v.pagina)
    if ancho > 0
        css_vista(ancho + DOC_BARRA, mui_height(w.v.pagina))
    end
end

# Abre la dirección en la ventana (direccion "" = la página de inicio). Por http(s) empieza la carga y
# vuelve: la página llega en los tics (la ventana sigue respondiendo y se puede parar).
func abrir(w: Ventana, direccion: String)
    parar_carga(w)
    if str_starts(direccion, "http://") or str_starts(direccion, "https://")
        dw_estado(w, "Conectando con " + direccion + "...")
        mui_set_value(w.v.progreso, 5)
        w.carga = http_empezar(direccion, 20000)
        w.carga_dir = direccion
        modo_carga(w, true)
        actualizar_giro(w)
        programar()
        return
    end
    dw_estado(w, "Abriendo " + direccion + "...")
    vista(w)
    var d: Documento = nil
    if direccion == "" or direccion == "dashweb:inicio"
        d = documento_html("dashweb:inicio", dw_inicio())
    elif direccion == "dashweb:marcadores"
        d = documento_html("dashweb:marcadores", marcadores_html(FICHERO_MARCADORES))
    else
        d = documento_abrir(direccion)
    end
    mostrar(w, d, direccion)
end

# POST: como abrir, pero la carga manda el cuerpo
func abrir_post(w: Ventana, direccion: String, cuerpo: String)
    parar_carga(w)
    dw_estado(w, "Enviando a " + direccion + "...")
    mui_set_value(w.v.progreso, 5)
    mui_set_text(w.v.url, direccion)
    w.carga = http_empezar_post(direccion, cuerpo, "", 20000)
    w.carga_dir = direccion
    modo_carga(w, true)
    actualizar_giro(w)
    programar()
end

# La carga en curso: lo que haya llegado; al acabar, sus hojas y scripts; después la página
func avanzar_carga(w: Ventana)
    if w.carga != nil
        if not http_avanzar(w.carga)
            fase = http_fase(w.carga)
            if fase != "recibiendo"
                host = url_parse(w.carga_dir).host
                if fase == "buscando"
                    dw_estado(w, "Buscando " + host + "...")
                elif fase == "conectando"
                    dw_estado(w, "Conectando con " + host + "...")
                else
                    dw_estado(w, "Conexión segura con " + host + "...")
                end
                return
            end
            total = http_total(w.carga)
            if total > 0
                mui_set_value(w.v.progreso, 10 + http_recibidos(w.carga) * 80 / total)
            else
                mui_set_value(w.v.progreso, 10 + (http_recibidos(w.carga) / 1024) % 80)
            end
            dw_estado(w, "Recibiendo " + w.carga_dir + ": " + http_recibidos(w.carga) / 1024 + " KB")
            return
        end
        c = w.carga
        var nada: Carga = nil
        w.carga = nada
        mui_set_value(w.v.progreso, 90)
        dw_estado(w, "Trayendo hojas de estilo y scripts...")
        vista(w)
        w.preparando = documento_empezar(w.carga_dir, c.respuesta)
    end
    if w.preparando == nil
        return
    end
    if not documento_avanzar(w.preparando)
        dw_estado(w, "Trayendo hojas de estilo y scripts: faltan " + recursos_pendientes(w.preparando.recursos))
        return
    end
    d = w.preparando
    var ninguno: Documento = nil
    w.preparando = ninguno
    modo_carga(w, false)
    mostrar(w, d, w.carga_dir)
end

# Para lo que esté llegando (la página o sus recursos)
func parar_carga(w: Ventana)
    if w.carga != nil
        http_cancelar(w.carga)
        var nada: Carga = nil
        w.carga = nada
    end
    if w.preparando != nil
        documento_liberar(w.preparando)
        var ninguno: Documento = nil
        w.preparando = ninguno
    end
end

# Pone el documento nuevo en la ventana
func mostrar(w: Ventana, d: Documento, direccion: String)
    if w.actual != nil
        documento_liberar(w.actual)
    end
    w.actual = d
    if direccion != ""
        mui_set_text(w.v.url, w.actual.direccion)
    end
    w.js_cuando = -1
    w.desde = 0
    ancho = mui_width(w.v.pagina)
    if ancho > 0
        documento_maquetar(w.actual, ancho)
        y = documento_y_de(w.actual, documento_fragmento(direccion))
        if y > 0
            w.desde = y
        end
    end
    var nadie: Nodo = nil
    w.foco = nadie
    if w.actual.titulo != ""
        mui_set_text(w.v.window, w.actual.titulo + " - dashweb")
    else
        mui_set_text(w.v.window, "dashweb")
    end
    ajustar_barra(w)
    if w.actual.error != ""
        dw_estado(w, "Error: " + w.actual.error)
    else
        dw_estado(w, "Listo: " + w.actual.bytes + " bytes en " + w.actual.ms + " ms")
    end
    mui_set_value(w.v.progreso, 0)
    modo_carga(w, false)
    mui_canvas_redraw(w.v.pagina)
    temporizadores(w)
    actualizar_giro(w)
end

# El único mui_timer, para todas las ventanas: cada 50 ms mientras algo llega, si no al siguiente
# temporizador del JavaScript
func programar()
    espera = -1
    for w in dw_ventanas
        if w.abierta
            if w.js_cuando >= 0
                e = w.js_cuando - time_ms()
                if e < 1
                    e = 1
                end
                if espera < 0 or e < espera
                    espera = e
                end
            end
            trayendo = w.carga != nil or w.preparando != nil or (w.actual != nil and imagenes_pendientes(w.actual.im) > 0)
            if trayendo and (espera < 0 or espera > 50)
                espera = 50
            end
            # un vídeo sonando: un tic cada 20 ms (cada imagen a su hora)
            if w.actual != nil and w.actual.videos != nil and videos_activos(w.actual.videos) and (espera < 0 or espera > 20)
                espera = 20
            end
        end
    end
    if espera > 0
        mui_timer(espera, ID_TIC)
    end
end

# Los setTimeout/setInterval que tocan en esa ventana
func temporizadores(w: Ventana)
    if w.actual != nil and w.actual.js != 0 and w.carga == nil
        espera = jsdom_temporizadores(w.actual.js)
        if documento_al_dia(w.actual)
            ajustar_barra(w)
            mui_canvas_redraw(w.v.pagina)
        end
        w.js_cuando = -1
        if espera >= 0
            w.js_cuando = time_ms() + espera
        end
        envio_del_js(w)
    end
    programar()
end

# Un tic: cargas, imágenes y temporizadores de una ventana
func tic(w: Ventana)
    avanzar_carga(w)
    if w.actual != nil and documento_imagenes(w.actual)
        ajustar_barra(w)
        mui_canvas_redraw(w.v.pagina)
    end
    if w.actual != nil and w.carga == nil and imagenes_pendientes(w.actual.im) > 0
        dw_estado(w, "Imágenes: faltan " + imagenes_pendientes(w.actual.im))
    elif w.actual != nil and w.carga == nil and str_starts(mui_get_text(w.v.estado), "Imágenes")
        dw_estado(w, "Listo")
    end
    if w.js_cuando >= 0 and time_ms() >= w.js_cuando
        temporizadores(w)
    end
    if w.actual != nil and w.actual.videos != nil and videos_avanzar(w.actual.videos)
        dw_solo_videos = true
        mui_canvas_redraw(w.v.pagina)
        dw_solo_videos = false
    end
    actualizar_giro(w)
end

func clic(w: Ventana)
    if w.actual == nil or w.actual.pagina == nil
        return
    end
    n = maqueta_nodo_en(w.actual.pagina, mui_canvas_mouse_x(w.v.pagina), mui_canvas_mouse_y(w.v.pagina) + w.desde)
    if n == nil
        return
    end
    seguir = true
    if w.actual.js != 0
        seguir = jsdom_clic(w.actual.js, n)
        if documento_al_dia(w.actual)
            ajustar_barra(w)
            mui_canvas_redraw(w.v.pagina)
        end
        temporizadores(w)
        envio_del_js(w)
    end
    if not seguir
        return
    end
    # un <video>: reproducir o parar
    vid = documento_video_de(n)
    if vid != nil
        videos_alternar(documento_videos(w.actual), vid, w.actual.direccion)
        mui_canvas_redraw(w.v.pagina)
        programar()
        return
    end
    # el formulario: foco, marcar, elegir, enviar
    r = formulario_clic(n)
    var nadie: Nodo = nil
    foco = nadie
    if r == FORM_FOCO
        foco = n
    end
    if foco != w.foco
        w.foco = foco
        mui_canvas_redraw(w.v.pagina)
    end
    if r == FORM_CAMBIO
        mui_canvas_redraw(w.v.pagina)
    elif r == FORM_ENVIAR
        enviar(w, n)
    elif r == FORM_NADA
        destino = documento_enlace(w.actual, n)
        if destino != ""
            navegar(w, destino)
        end
    end
end

# Envía el formulario de desde (un botón, el campo donde se pulsó Return o el form de form.submit()):
# antes el evento submit (onsubmit puede pararlo), después GET o POST según su method
func enviar(w: Ventana, desde: Nodo)
    form = formulario_de(desde)
    if form == nil
        return
    end
    if w.actual.js != 0 and not jsdom_evento(w.actual.js, form, "submit")
        return
    end
    enviar_formulario(w, desde)
end

func enviar_formulario(w: Ventana, desde: Nodo)
    e = formulario_envio(desde, w.actual.direccion)
    if e.metodo == "POST"
        abrir_post(w, e.direccion, e.cuerpo)
        apuntar(w, e.direccion)
    elif e.direccion != ""
        navegar(w, e.direccion)
    end
end

# Si el JavaScript llamó a form.submit(), se envía
func envio_del_js(w: Ventana)
    if w.actual == nil or w.actual.js == 0
        return
    end
    f = jsdom_envio(w.actual.js)
    if f != nil
        enviar_formulario(w, f)
    end
end

# Ir a una dirección nueva: lo que había delante en el historial se descarta. Un enlace a otra parte
# de la misma página solo desplaza.
func navegar(w: Ventana, destino: String)
    if w.actual != nil and documento_sin_fragmento(destino) == documento_sin_fragmento(w.actual.direccion) and documento_fragmento(destino) != ""
        y = documento_y_de(w.actual, documento_fragmento(destino))
        if y >= 0
            w.desde = y
            ajustar_barra(w)
            mui_canvas_redraw(w.v.pagina)
        end
        return
    end
    mui_set_text(w.v.url, destino)
    abrir(w, destino)
    apuntar(w, destino)
end

# Una entrada nueva en el historial (lo que había delante se descarta)
func apuntar(w: Ventana, destino: String)
    while mui_list_count(w.v.historial) > w.visto + 1
        mui_list_remove(w.v.historial, mui_list_count(w.v.historial) - 1)
    end
    mui_list_add(w.v.historial, destino)      # la pedida: la página aún está llegando
    w.visto = mui_list_count(w.v.historial) - 1
    botones(w)
end

# Atrás y adelante: con su flecha azul si llevan a algún sitio y solo el contorno si no (un botón
# desactivado de MUI sale tapado por una trama); pulsar uno apagado no hace nada
func botones(w: Ventana)
    atras = w.visto > 0
    adelante = w.visto < mui_list_count(w.v.historial) - 1
    if atras != w.con_atras
        w.con_atras = atras
        mui_set_text(w.v.atras, icono("atras", atras))
    end
    if adelante != w.con_adelante
        w.con_adelante = adelante
        mui_set_text(w.v.adelante, icono("adelante", adelante))
    end
end

func icono(nombre: String, encendido: Bool) -> String
    if encendido
        return "PROGDIR:iconos/" + nombre + ".iff"
    end
    return "PROGDIR:iconos/" + nombre + "_apagado.iff"
end

# Desplaza la página n píxeles (la barra avisa con ID_SCROLL y se repinta)
func desplazar(w: Ventana, n: Int)
    mui_set_value(w.v.barra, mui_get_value(w.v.barra) + n)
end

# Corre la ventana (las del mismo .dashui salen en el mismo sitio)
@native func mover_ventana(win: Int, dx: Int, dy: Int)
"""
    struct Window *w = NULL;
    GetAttr(MUIA_Window_Window, (Object *)win, (ULONG *)&w);
    if (w) MoveWindow(w, dx, dy);
"""
end

# Una ventana nueva con esa dirección ("" = la página de inicio); nil si ya hay MAX_VENTANAS
func nueva_ventana(direccion: String) -> Ventana
    var nada: Ventana = nil
    k = dw_ventanas.length
    if k >= MAX_VENTANAS
        return nada
    end
    v = Navegador_create()
    w = Ventana(v, k)
    dw_ventanas.push(w)
    if k == 0
        mui_canvas_on_draw(v.pagina, pinta0)
        mui_canvas_on_draw(v.actividad, giro0)
    elif k == 1
        mui_canvas_on_draw(v.pagina, pinta1)
        mui_canvas_on_draw(v.actividad, giro1)
    elif k == 2
        mui_canvas_on_draw(v.pagina, pinta2)
        mui_canvas_on_draw(v.actividad, giro2)
    else
        mui_canvas_on_draw(v.pagina, pinta3)
        mui_canvas_on_draw(v.actividad, giro3)
    end
    mui_canvas_on_input(v.pagina, ID_PAGINA)
    mui_on_close(v.window, ID_CERRADA + k)
    mui_window_open(v.window)
    if k > 0
        mover_ventana(v.window, k * 24, k * 16)
    end
    if direccion != ""
        navegar(w, direccion)
    else
        abrir(w, "")
    end
    return w
end

func cerrar_ventana(w: Ventana)
    parar_carga(w)
    if w.actual != nil
        documento_liberar(w.actual)
        var ninguno: Documento = nil
        w.actual = ninguno
    end
    w.abierta = false
    mui_window_close(w.v.window)
end

func abiertas() -> Int
    n = 0
    for w in dw_ventanas
        if w.abierta
            n = n + 1
        end
    end
    return n
end

# La ventana que está usando el usuario (la activa); si no hay, la primera abierta
func activa() -> Ventana
    var primera: Ventana = nil
    for w in dw_ventanas
        if w.abierta
            if mui_window_active(w.v.window)
                return w
            end
            if primera == nil
                primera = w
            end
        end
    end
    return primera
end

func pagina_inicio() -> String
    inicio = preferencia(FICHERO_PREFERENCIAS, "inicio")
    if inicio == ""
        inicio = "dashweb:inicio"
    end
    return inicio
end

Main
    if mui_app_begin("dashweb", "DASHWEB") == 0
        Print "dashweb necesita MUI (3.8 o 5) y un 68020"
    else
        a = Acerca_create()
        # cada argumento en su ventana (hasta 4); sin argumentos, la página de inicio
        if arg_count() == 0
            nueva_ventana(preferencia(FICHERO_PREFERENCIAS, "inicio"))
        end
        for i in (0..arg_count() - 1)
            nueva_ventana(arg(i))
        end
        acerca_abierta = false
        while abiertas() > 0
            ev = mui_wait_event()
            if ev == -1 or ev == ID_SALIR
                break
            end
            if ev == ID_TIC or ev == ID_RANGO
                # mui_timer es uno solo: sirve a todas las ventanas
                for t in dw_ventanas
                    if t.abierta
                        if ev == ID_RANGO
                            ajustar_barra(t)
                        else
                            tic(t)
                        end
                    end
                end
                programar()
                continue
            end
            if ev >= ID_CERRADA and ev < ID_CERRADA + MAX_VENTANAS
                cerrar_ventana(dw_ventanas[ev - ID_CERRADA])
                continue
            end
            w = activa()
            if w == nil
                break
            end
            if ev == ID_IR
                direccion = str_trim(mui_get_text(w.v.url))
                if direccion != "" and not str_starts(direccion, "http") and str_find(direccion, ":") < 0
                    direccion = "http://" + direccion
                end
                if direccion == ""
                    abrir(w, "")
                else
                    navegar(w, direccion)
                end
            end
            if ev == ID_RECARGAR and w.actual != nil
                if w.visto >= 0
                    abrir(w, mui_list_get(w.v.historial, w.visto))
                else
                    abrir(w, "")
                end
            end
            if ev == ID_ATRAS or ev == ID_ADELANTE or ev == ID_HISTORIAL
                if ev == ID_ATRAS and w.visto > 0
                    w.visto = w.visto - 1
                end
                if ev == ID_ADELANTE and w.visto < mui_list_count(w.v.historial) - 1
                    w.visto = w.visto + 1
                end
                if ev == ID_HISTORIAL and mui_get_value(w.v.historial) >= 0
                    w.visto = mui_get_value(w.v.historial)
                end
                if w.visto >= 0
                    direccion = mui_list_get(w.v.historial, w.visto)
                    mui_set_text(w.v.url, direccion)
                    abrir(w, direccion)
                end
                botones(w)
            end
            if ev == ID_VER_HISTORIAL
                # desplegar o esconder la lista del historial (la página se maqueta al ancho nuevo)
                w.con_historial = not w.con_historial
                mui_set_visible(w.v.historial, w.con_historial)
                mui_set_visible(w.v.separador, w.con_historial)
            end
            if ev == ID_SCROLL
                w.desde = mui_get_value(w.v.barra)
                mui_canvas_redraw(w.v.pagina)
            end
            if ev == ID_PARAR and (w.carga != nil or w.preparando != nil)
                parar_carga(w)
                modo_carga(w, false)
                mui_set_value(w.v.progreso, 0)
                dw_estado(w, "Parado")
                actualizar_giro(w)
                programar()
            end
            if ev == ID_PAGINA
                rueda = mui_canvas_wheel(w.v.pagina)
                tecla = mui_canvas_key(w.v.pagina)
                if rueda != 0
                    desplazar(w, 0 - rueda * 30)
                elif tecla >= 0 and w.foco != nil
                    r = formulario_tecla(w.foco, mui_canvas_char(w.v.pagina), tecla)
                    if r == FORM_CAMBIO
                        mui_canvas_redraw(w.v.pagina)
                    elif r == FORM_ENVIAR
                        enviar(w, w.foco)
                    end
                elif tecla == 0x4D
                    desplazar(w, 20)
                elif tecla == 0x4C
                    desplazar(w, -20)
                elif tecla == 0x40
                    desplazar(w, mui_height(w.v.pagina) - 20)
                elif tecla == 0x41
                    desplazar(w, 20 - mui_height(w.v.pagina))
                elif mui_canvas_button(w.v.pagina) == 1
                    clic(w)
                end
            end
            if ev == ID_MARCADORES
                navegar(w, "dashweb:marcadores")
            end
            if ev == ID_ANADIR and w.actual != nil
                if marcadores_agregar(FICHERO_MARCADORES, w.actual.direccion, w.actual.titulo)
                    dw_estado(w, "Marcador: " + w.actual.titulo)
                else
                    dw_estado(w, "No se pudo guardar el marcador")
                end
            end
            if ev == ID_USAR_INICIO and w.actual != nil
                if preferencia_poner(FICHERO_PREFERENCIAS, "inicio", w.actual.direccion)
                    dw_estado(w, "Página de inicio: " + w.actual.direccion)
                end
            end
            if ev == ID_INICIO
                navegar(w, pagina_inicio())
            end
            if ev == ID_NUEVA
                if nueva_ventana(pagina_inicio()) == nil
                    dw_estado(w, "Como mucho " + MAX_VENTANAS + " ventanas")
                end
            end
            if ev == ID_CERRAR
                cerrar_ventana(w)
            end
            if ev == ID_ACERCA
                if acerca_abierta
                    mui_window_close(a.window)
                else
                    mui_window_open(a.window)
                end
                acerca_abierta = not acerca_abierta
            end
        end
        for w in dw_ventanas
            parar_carga(w)
            if w.actual != nil
                documento_liberar(w.actual)
            end
        end
        mui_app_end()
    end
end
