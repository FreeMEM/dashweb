# Visor de páginas sin MUI (fase A): abre un fichero HTML o una URL, la pinta en una ventana
# normal y la desplaza con las teclas. Sin argumentos muestra una página de demostración.
#
#   visor pagina.html
#   visor http://ejemplo.org/
#
# Teclas: abajo/arriba (una línea), espacio/retroceso (una pantalla), Esc o el botón de cerrar.
# Un clic llega al JavaScript de la página (onclick, addEventListener); setTimeout/setInterval
# corren mientras el visor espera. Si el JS cambia el documento, se vuelve a maquetar y pintar.
# Al acabar escribe cuánto tardó cada fase.

import "../lib/pintor.dash"
import "../lib/jsdom.dash"

Window Visor
    title "dashweb"
    width 600
    height 230
end

func demostracion() -> String
    h = "<html><head><title>dashweb</title><style>"
    h = h + "body { background: #fff; color: #222; font-family: sans-serif }"
    h = h + "h1 { color: #036; } .nota { background: #ffd; border: 1px solid #cc8; padding: 4px }"
    h = h + "a { color: #00c } code { background: #eee }</style></head><body>"
    h = h + "<h1>dashweb</h1><p>Un navegador ligero para <b>AmigaOS</b> escrito en <i>Dash</i>.</p>"
    h = h + "<p class=nota>Esta página la ha leído <code>lib/html.dash</code>, le ha dado estilo "
    h = h + "<code>lib/estilo.dash</code>, la ha maquetado <code>lib/maqueta.dash</code> y la pinta "
    h = h + "<code>lib/pintor.dash</code>.</p><h2>Lo que ya hace</h2><ul><li>HTML y XHTML tolerantes"
    h = h + "<li>CSS: cascada, herencia, atajos<li>Red: HTTP y HTTPS (AmiSSL)<li>Fuentes del Amiga</ul>"
    h = h + "<ol><li>Leer<li>Dar estilo<li>Maquetar<li>Pintar</ol>"
    h = h + "<p style='text-align: center'>Más en <a href=https://github.com/FreeMEM/dashweb>github.com/FreeMEM/dashweb</a></p>"
    h = h + "<table border=1><tr><th>Fase<th>Módulo</tr><tr><td>Red<td>red.dash</tr><tr><td>HTML<td>html.dash</tr></table>"
    h = h + "</body></html>"
    return h
end

# El texto de la página (en Latin-1) y su URL base
func cargar(direccion: String) -> String
    if str_starts(direccion, "http://") or str_starts(direccion, "https://")
        r = http_get(direccion, 20000)
        if r.error != ""
            return "<h1>Error</h1><p>" + r.error + "</p>"
        end
        return http_texto(r)
    end
    t = file_read_text(direccion)
    if t == nil
        return "<h1>Error</h1><p>No se puede leer " + direccion + "</p>"
    end
    return utf8_a_latin1(t)
end

# Estilo, imágenes nuevas y maqueta otra vez (tras cambios del JavaScript)
func rehacer(doc: Nodo, hojas: Hojas, im: Imagenes, direccion: String, ancho: Int) -> Pagina
    estilo_aplicar(doc, hojas)
    imagenes_cargar(im, doc, direccion)
    return maquetar(doc, ancho)
end

Main
    direccion = "demo"
    texto = ""
    libre0 = mem_total()
    t0 = time_ms()
    if arg_count() > 0
        direccion = arg(0)
        texto = cargar(direccion)
    else
        texto = demostracion()
    end
    t_carga = time_ms() - t0
    Visor.open
    x0 = Visor.inner_left
    y0 = Visor.inner_top
    ancho = Visor.inner_width
    alto = Visor.inner_height
    t1 = time_ms()
    doc = dom_desde_html(texto)
    t_html = time_ms() - t1
    # los <script> antes del estilo: lo que cambien ya sale maquetado
    t1 = time_ms()
    js = 0
    if dom_buscar(doc, "script") != nil
        js = js_nuevo()
        jsdom_preparar(js, doc)
        jsdom_ejecutar_scripts(js, doc, direccion)
    end
    t_js = time_ms() - t1
    t1 = time_ms()
    hojas = estilo_hojas(doc, direccion)
    estilo_aplicar(doc, hojas)
    t_estilo = time_ms() - t1
    t1 = time_ms()
    im = imagenes_nuevas()
    imagenes_cargar(im, doc, direccion)
    t_imagenes = time_ms() - t1
    t1 = time_ms()
    pagina = maquetar(doc, ancho)
    t_maqueta = time_ms() - t1
    t1 = time_ms()
    desde = 0
    pintar(pagina, im, desde, x0, y0, ancho, alto)
    t_pintar = time_ms() - t1
    Print "visor: " + direccion + " " + texto.length + " bytes, " + pagina.dibujos.length + " dibujos, alto " + pagina.alto + ", " + (libre0 - mem_total()) / 1024 + " KB de memoria"
    Print "tiempos ms: carga " + t_carga + ", html " + t_html + ", js " + t_js + ", estilo " + t_estilo + ", imagenes " + t_imagenes + ", maqueta " + t_maqueta + ", pintar " + t_pintar
    paso = 0
    cambios = 0
    espera = 1000
    if js != 0
        cambios = jsdom_cambios(js)
        espera = jsdom_temporizadores(js)
        if espera < 0
            espera = 1000
        end
    end
    EventLoop
        On Click
            if js != 0
                n = maqueta_nodo_en(pagina, click_x() - x0, click_y() - y0 + desde)
                if n != nil
                    jsdom_clic(js, n)
                end
                if jsdom_cambios(js) != cambios
                    cambios = jsdom_cambios(js)
                    pagina = rehacer(doc, hojas, im, direccion, ancho)
                    pintar(pagina, im, desde, x0, y0, ancho, alto)
                end
            end
        end
        On Timer espera
            if js != 0
                espera = jsdom_temporizadores(js)
                if espera < 0
                    espera = 1000
                end
                if jsdom_cambios(js) != cambios
                    cambios = jsdom_cambios(js)
                    pagina = rehacer(doc, hojas, im, direccion, ancho)
                    pintar(pagina, im, desde, x0, y0, ancho, alto)
                end
            end
        end
        On Key "DOWN"
            paso = 20
        end
        On Key "UP"
            paso = -20
        end
        On Key "SPACE"
            paso = alto - 20
        end
        On Key "BACKSPACE"
            paso = 20 - alto
        end
        On Key
            if paso != 0
                nuevo = desde + paso
                if nuevo > pagina.alto - alto
                    nuevo = pagina.alto - alto
                end
                if nuevo < 0
                    nuevo = 0
                end
                if nuevo != desde
                    desde = nuevo
                    pintar(pagina, im, desde, x0, y0, ancho, alto)
                end
                paso = 0
            end
        end
        On Key "ESC"
            Stop
        end
        On Close
            Stop
        end
    end
    imagenes_liberar(im)
    if js != 0
        js_liberar(js)
    end
end
