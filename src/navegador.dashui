      "size": [
        96,
        90
      ]
    },
    {
      "name": "Acerca",
      "title": "About Tachyon",
      "id": 2,
      "close": 8,
      "root": {
        "type": "vgroup",
        "children": [
          {
            "type": "image",
            "name": "logo",
            "file": "PROGDIR:iconos/logo.iff"
          },
          {
            "type": "text",
            "name": "version",
            "text": "\u001bcTachyon"
          },
          {
            "type": "text",
            "text": "\u001bc© 2026 Francisco Antonio Tapias Bravo\n\u001bcMIT License · github.com/FreeMEM/tachyon\n\n\u001bcA browser for the Amiga made in Dash, with MUI and AmiSSL.\n\u001bcIt includes, adapted for AmigaOS:\n\u001bcQuickJS (Fabrice Bellard and Charlie Gordon)\n\u001bcHubbub and LibParserUtils (NetSurf)\n\u001bcand also stb, NanoSVG, Brotli, libwebp,\n\u001bcTJpgDec, fdlibm, Ryu and MintVID.\n\u001bcTheir licences are in the Licencias drawer.",
            "tr": 43
          },
          {
            "type": "button",
            "name": "cerrar",
            "label": "_Close",
            "event": 8,
            "tr": 42
          }
        ]
      },
      "tr": 41
    }
  ]
