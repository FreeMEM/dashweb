          {
            "type": "hgroup",
            "children": [
              {
                "type": "canvas",
                "name": "pagina",
                "min_width": 500,
                "min_height": 100
              },
              {
                "type": "scrollbar",
                "name": "barra",
                "vertical": true,
                "change": 5
              }
            ]
          },
          {
            "type": "hgroup",
            "children": [
              {
                "type": "canvas",
                "name": "led",
                "min_width": 14,
                "min_height": 12,
                "weight": 0
              },
              {
                "type": "text",
                "name": "estado",
                "text": "Ready",
                "tr": 40
              },
              {
                "type": "gauge",
                "name": "progreso",
                "max": 100,
                "weight": 30,
                "hidden": true
