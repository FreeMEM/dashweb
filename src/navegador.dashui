{
  "dashui": 1,
  "windows": [
    {
      "name": "Navegador",
      "title": "Tachyon",
      "id": 1,
      "menus": [
        {
          "title": "Proyecto",
          "items": [
            {
              "label": "Nueva ventana",
              "key": "N",
              "event": 18
            },
            {
              "label": "Cerrar ventana",
              "key": "K",
              "event": 19
            },
            {
              "separator": true
            },
            {
              "label": "Ir a la dirección",
              "key": "L",
              "event": 24
            },
            {
              "separator": true
            },
            {
              "label": "Acerca de...",
              "key": "?",
              "event": 8
            },
            {
              "separator": true
            },
            {
              "label": "Salir",
              "key": "Q",
              "event": 9
            }
          ]
        },
        {
          "title": "Navegar",
          "items": [
            {
              "label": "Atrás",
              "event": 1
            },
            {
              "label": "Adelante",
              "event": 2
            },
            {
              "label": "Recargar",
              "key": "R",
              "event": 3
            },
            {
              "label": "Parar",
              "event": 13
            },
            {
              "separator": true
            },
            {
              "label": "Página de inicio",
              "key": "H",
              "event": 17
            },
            {
              "label": "Historial",
              "key": "Y",
              "event": 20
            }
          ]
        },
        {
          "title": "Marcadores",
          "items": [
            {
              "label": "Ver marcadores",
              "key": "B",
              "event": 14
            },
            {
              "label": "Añadir o quitar esta página",
              "key": "D",
              "event": 15
            },
            {
              "separator": true
            },
            {
              "label": "Usar como página de inicio",
              "event": 16
            }
          ]
        },
        {
          "title": "Herramientas",
          "items": [
            {
              "label": "Cookies",
              "event": 25
            },
            {
              "label": "Descargas",
              "key": "J",
              "event": 29
            },
            {
              "label": "Buscador...",
              "event": 28
            },
            {
              "separator": true
            },
            {
              "label": "Buscar actualizaciones",
              "event": 22
            },
            {
              "label": "No avisar de versiones nuevas",
              "event": 23
            }
          ]
        }
      ],
      "root": {
        "type": "vgroup",
        "children": [
          {
            "type": "hgroup",
            "children": [
              {
                "type": "image_button",
                "name": "atras",
                "file": "PROGDIR:iconos/atras.iff",
                "event": 1,
                "help": "Atrás",
                "hidden": true
              },
              {
                "type": "image_button",
                "name": "atras_no",
                "file": "PROGDIR:iconos/atras_apagado.iff",
                "event": 1,
                "help": "Atrás"
              },
              {
                "type": "image_button",
                "name": "adelante",
                "file": "PROGDIR:iconos/adelante.iff",
                "event": 2,
                "help": "Adelante",
                "hidden": true
              },
              {
                "type": "image_button",
                "name": "adelante_no",
                "file": "PROGDIR:iconos/adelante_apagado.iff",
                "event": 2,
                "help": "Adelante"
              },
              {
                "type": "image_button",
                "name": "recargar",
                "file": "PROGDIR:iconos/recargar.iff",
                "event": 3,
                "help": "Recargar la página"
              },
              {
                "type": "image_button",
                "name": "parar",
                "file": "PROGDIR:iconos/parar.iff",
                "event": 13,
                "help": "Parar la carga",
                "hidden": true
              },
              {
                "type": "image_button",
                "name": "inicio",
                "file": "PROGDIR:iconos/inicio.iff",
                "event": 17,
                "help": "Página de inicio"
              },
              {
                "type": "image_button",
                "name": "candado",
                "file": "PROGDIR:iconos/candado.iff",
                "event": 27,
                "help": "Conexión cifrada (HTTPS)",
                "hidden": true
              },
              {
                "type": "image_button",
                "name": "candado_abierto",
                "file": "PROGDIR:iconos/candado_abierto.iff",
                "event": 27,
                "help": "Conexión sin cifrar (HTTP)",
                "hidden": true
              },
              {
                "type": "string",
                "name": "url",
                "text": "",
                "max": 1024,
                "ack": 4,
                "weight": 400,
                "help": "Dirección: escríbela y pulsa Return"
              },
              {
                "type": "image_button",
                "name": "estrella",
                "file": "PROGDIR:iconos/estrella.iff",
                "event": 26,
                "help": "Añadir a marcadores"
              },
              {
                "type": "image_button",
                "name": "estrella_llena",
                "file": "PROGDIR:iconos/estrella_llena.iff",
                "event": 26,
                "help": "En marcadores: pulsa para quitarla",
                "hidden": true
              },
              {
                "type": "image_button",
                "name": "ver_historial",
                "file": "PROGDIR:iconos/historial.iff",
                "event": 20,
                "help": "Historial: lo que has visto"
              },
              {
                "type": "image_button",
                "name": "ver_descargas",
                "file": "PROGDIR:iconos/descargas.iff",
                "event": 29,
                "help": "Descargas",
                "hidden": true
              },
              {
                "type": "image_button",
                "name": "actualizar",
                "file": "PROGDIR:iconos/actualizar.iff",
                "event": 21,
                "help": "Hay una versión nueva de Tachyon: pulsa para instalarla",
                "hidden": true
              },
              {
                "type": "image_button",
                "name": "reiniciar",
                "file": "PROGDIR:iconos/reiniciar.iff",
                "event": 21,
                "help": "Instalada la versión nueva: pulsa para reiniciar Tachyon con ella",
                "hidden": true
              }
            ]
          },
          {
            "type": "hgroup",
            "children": [
              {
                "type": "canvas",
                "name": "pagina",
                "min_width": 500,
                "min_height": 100
              },
              {
                "type": "scrollbar",
                "name": "barra",
                "vertical": true,
                "change": 5
              }
            ]
          },
          {
            "type": "hgroup",
            "children": [
              {
                "type": "canvas",
                "name": "led",
                "min_width": 14,
                "min_height": 12,
                "weight": 0
              },
              {
                "type": "text",
                "name": "estado",
                "text": "Listo"
              },
              {
                "type": "gauge",
                "name": "progreso",
                "max": 100,
                "weight": 30,
                "hidden": true
              }
            ]
          }
        ]
      },
      "size": [
        96,
        90
      ]
    },
    {
      "name": "Acerca",
      "title": "Acerca de Tachyon",
      "id": 2,
      "close": 8,
      "root": {
        "type": "vgroup",
        "children": [
          {
            "type": "image",
            "name": "logo",
            "file": "PROGDIR:iconos/logo.iff"
          },
          {
            "type": "text",
            "name": "version",
            "text": "\u001bcTachyon"
          },
          {
            "type": "text",
            "text": "\u001bc© 2026 Francisco Antonio Tapias Bravo\n\u001bcLicencia MIT · github.com/FreeMEM/tachyon\n\n\u001bcUn navegador para Amiga hecho en Dash, con MUI y AmiSSL.\n\u001bcLleva, adaptados para AmigaOS:\n\u001bcQuickJS (Fabrice Bellard y Charlie Gordon)\n\u001bcHubbub y LibParserUtils (NetSurf)\n\u001bcy también stb, NanoSVG, Brotli, libwebp,\n\u001bcTJpgDec, fdlibm y MintVID.\n\u001bcSus licencias, en el cajón Licencias."
          },
          {
            "type": "button",
            "name": "cerrar",
            "label": "_Cerrar",
            "event": 8
          }
        ]
      }
    }
  ]
}
